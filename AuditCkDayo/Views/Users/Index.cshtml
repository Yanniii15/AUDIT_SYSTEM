@model IEnumerable<AuditCkDayo.Models.User>
@using System.Security.Claims
@using AuditCkDayo.Models

@{
    ViewData["Title"] = "Manage Staff";
    var isOwner = User.IsInRole("Owner");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 text-dark font-weight-bold">Manage Staff</h1>
            <p class="text-muted">Manage staff members, PCF balances, and manager assignments</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">← Dashboard</a>
    </div>

    @* Banners / Alerts *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>PCF Balance</th>
                    <th>Daily Starting Float</th>
                    @if (isOwner)
                    {
                        <th>Manager</th>
                    }
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model)
                {
                    <tr>
                        <td><strong>@staff.Name</strong></td>
                        <td>@staff.Email</td>
                        <td>
                            @if (staff.Role == UserRole.Owner)
                            {
                                <span class="badge bg-primary">Owner</span>
                            }
                            else if (staff.Role == UserRole.Manager)
                            {
                                <span class="badge bg-info text-dark">Manager</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Buyer</span>
                            }
                        </td>
                        <td>₱@staff.PcfBalance.ToString("N2")</td>
                        <td>₱@staff.DailyStartingFloat.ToString("N2")</td>
                        @if (isOwner)
                        {
                            <td>
                                @if (staff.Role == UserRole.Buyer)
                                {
                                    <form asp-controller="Users" asp-action="AssignManager" asp-route-id="@staff.Id" method="post" class="d-flex gap-2 align-items-center">
                                        <select name="managerId" class="form-select form-select-sm" style="max-width: 200px;">
                                            <option value="">No Manager Assigned</option>
                                            @if (ViewBag.Managers != null)
                                            {
                                                foreach (var mgr in (IEnumerable<User>)ViewBag.Managers)
                                                {
                                                    if (staff.ManagerId == mgr.Id)
                                                    {
                                                        <option value="@mgr.Id" selected="selected">@mgr.Name (@mgr.Email)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@mgr.Id">@mgr.Name (@mgr.Email)</option>
                                                    }
                                                }
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-dark">Update</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                        }
                        <td>
                            <form asp-controller="Users" asp-action="AddPcf" asp-route-id="@staff.Id" method="post" class="d-flex gap-2 align-items-center">
                                <div class="input-group input-group-sm" style="max-width: 150px;">
                                    <span class="input-group-text">₱</span>
                                    <input type="number" name="amount" class="form-control" placeholder="0.00" step="0.01" min="0.01" required />
                                </div>
                                <button type="submit" name="actionType" value="Add" class="btn btn-sm btn-success">+ Add</button>
                                <button type="submit" name="actionType" value="Subtract" class="btn btn-sm btn-danger">- Subtract</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
