@model AuditCkDayo.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="relative flex flex-col lg:flex-row gap-space-6 items-start justify-between">
    <div class="flex flex-col gap-space-2 max-w-2xl">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">manage_accounts</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">User Administration</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Edit User</h1>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            Update staff profile details, access role, manager assignment, branch assignment, and treasury access.
        </p>
    </div>
</div>

<div class="flex justify-center my-space-6">
    <div class="w-full max-w-3xl bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden border border-surface-border">
        <div class="bg-primary px-space-6 py-space-4 flex justify-between items-center">
            <span class="text-on-primary font-label-caps uppercase tracking-tighter text-[11px]">Staff Account Details</span>
            <span class="text-on-primary/60 text-[10px] font-data-mono">USER #@Model.Id</span>
        </div>

        <form asp-controller="Users" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="p-space-8 grid grid-cols-1 md:grid-cols-2 gap-x-space-8 gap-y-space-6" id="userEditForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="md:col-span-2 text-audit-error bg-audit-error/10 border border-audit-error/20 p-space-4 rounded-lg text-body-md text-center"></div>
            <input type="hidden" asp-for="Id" />

            <div class="flex flex-col gap-space-2">
                <label asp-for="Name" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Full Name</label>
                <input asp-for="Name" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-space-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required />
                <span asp-validation-for="Name" class="text-audit-error text-[11px]"></span>
            </div>

            <div class="flex flex-col gap-space-2">
                <label asp-for="Email" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Email Address</label>
                <input asp-for="Email" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-space-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required />
                <span asp-validation-for="Email" class="text-audit-error text-[11px]"></span>
            </div>

            <div class="flex flex-col gap-space-2">
                <label asp-for="Role" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">System Role</label>
                <select asp-for="Role" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-space-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all appearance-none cursor-pointer text-on-surface" id="roleSelect">
                    @foreach (var val in Enum.GetValues(typeof(AuditCkDayo.Models.UserRole)))
                    {
                        <option value="@val">@val</option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-audit-error text-[11px]"></span>
            </div>

            <div class="flex flex-col gap-space-2" id="managerField">
                <label asp-for="ManagerId" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Assigned Manager</label>
                <select asp-for="ManagerId" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-space-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all appearance-none cursor-pointer text-on-surface">
                    <option value="">Select reporting manager...</option>
                    @if (ViewBag.Managers != null)
                    {
                        foreach (var mgr in (IEnumerable<AuditCkDayo.Models.User>)ViewBag.Managers)
                        {
                            <option value="@mgr.Id">@mgr.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="ManagerId" class="text-audit-error text-[11px]"></span>
            </div>

            <div class="flex flex-col gap-space-2" id="branchField">
                <label asp-for="EstablishmentId" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Assigned Branch / Location</label>
                <select asp-for="EstablishmentId" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-space-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all appearance-none cursor-pointer text-on-surface" asp-items="ViewBag.Establishments">
                    <option value="">Select branch location...</option>
                </select>
                <span asp-validation-for="EstablishmentId" class="text-audit-error text-[11px]"></span>
            </div>

            <div class="md:col-span-2 flex items-center gap-space-3 bg-surface-container-low rounded-lg border border-surface-border p-space-4">
                <input asp-for="IsTreasury" class="h-4 w-4" />
                <div>
                    <label asp-for="IsTreasury" class="font-label-caps text-on-surface uppercase text-[11px] font-semibold">Treasury User</label>
                    <p class="text-[11px] text-on-surface-variant">Allow this user to own treasury cash-flow days.</p>
                </div>
            </div>

            <div class="md:col-span-2 pt-space-6 flex flex-col sm:flex-row gap-space-4 border-t border-surface-border mt-space-4">
                <button class="bg-primary text-on-primary px-space-8 py-space-3 rounded-lg font-label-caps uppercase tracking-widest hover:bg-on-primary-fixed-variant transition-colors flex items-center justify-center gap-space-2 shadow-md text-[12px]" type="submit">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    Save User Changes
                </button>
                <a asp-controller="Account" asp-action="Register" class="bg-surface-container text-on-surface-variant border border-surface-border px-space-8 py-space-3 rounded-lg font-label-caps uppercase tracking-widest hover:bg-surface-container-high transition-colors text-[12px] text-center decoration-none">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const roleSelect = document.getElementById("roleSelect");
        const managerField = document.getElementById("managerField");
        const branchField = document.getElementById("branchField");

        const setDisabled = (field, disabled) => {
            field.classList.toggle("opacity-30", disabled);
            field.classList.toggle("pointer-events-none", disabled);
            if (disabled) {
                const select = field.querySelector("select");
                if (select) select.value = "";
            }
        };

        const updateRoleFields = () => {
            const role = roleSelect.value;
            setDisabled(managerField, role !== "Buyer" && role !== "BranchStaff");
            setDisabled(branchField, role !== "BranchStaff");
        };

        roleSelect.addEventListener("change", updateRoleFields);
        updateRoleFields();
    });
</script>
