@model AuditCkDayo.ViewModels.AuditSettlementViewModel
@{
    ViewData["Title"] = "Audit Settlement";
}

<div class="space-y-6">
    <div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Audit Settlement</h1>
        <p class="text-on-surface-variant">Compare PCF released, accepted expenses, actual change returned, and short/over result.</p>
    </div>

    @if (TempData["Message"] is string message)
    {
        <div class="rounded-lg bg-green-50 px-4 py-3 text-green-800" role="status">@message</div>
    }

    <section class="rounded-xl border border-outline-variant bg-surface-container-low p-6 mb-6">
        <div class="mb-4">
            <h2 class="font-headline-sm text-on-surface">Record New Audit Settlement</h2>
            <p class="text-sm text-on-surface-variant">Perform petty cash reconciliation comparing released funds, expenses, and returned change.</p>
        </div>
        <form asp-action="Settlement" method="post" class="flex flex-col gap-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-audit-error text-sm"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <label class="flex flex-col gap-2">
                    <span class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Select PCF Release</span>
                    <select asp-for="PcfReleaseId" asp-items="ViewBag.PcfReleases" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-4 py-2.5 text-on-surface focus:outline-none focus:border-primary" id="pcfReleaseSelect">
                        <option value="">-- Select PCF Release (Optional) --</option>
                    </select>
                    <span asp-validation-for="PcfReleaseId" class="text-audit-error text-[11px]"></span>
                </label>

                <label class="flex flex-col gap-2">
                    <span class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Receiver Name</span>
                    <input asp-for="ReceiverName" maxlength="100" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-4 py-2.5 text-on-surface focus:outline-none focus:border-primary" placeholder="e.g. Ate Beth" id="receiverNameInput" />
                    <span asp-validation-for="ReceiverName" class="text-audit-error text-[11px]"></span>
                </label>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <label class="flex flex-col gap-2">
                    <span class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Total PC Released (₱)</span>
                    <input asp-for="TotalPCReleased" type="number" step="0.01" min="0" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-4 py-2.5 text-on-surface focus:outline-none focus:border-primary" placeholder="0.00" id="totalPcReleasedInput" required />
                    <span asp-validation-for="TotalPCReleased" class="text-audit-error text-[11px]"></span>
                </label>

                <label class="flex flex-col gap-2">
                    <span class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Total Accepted Expenses (₱)</span>
                    <input asp-for="TotalAcceptedExpenses" type="number" step="0.01" min="0" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-4 py-2.5 text-on-surface focus:outline-none focus:border-primary" placeholder="0.00" id="totalAcceptedExpensesInput" required />
                    <span asp-validation-for="TotalAcceptedExpenses" class="text-audit-error text-[11px]"></span>
                </label>

                <label class="flex flex-col gap-2">
                    <span class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Actual Change Returned (₱)</span>
                    <input asp-for="ActualChangeReturned" type="number" step="0.01" min="0" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-4 py-2.5 text-on-surface focus:outline-none focus:border-primary" placeholder="0.00" id="actualChangeReturnedInput" required />
                    <span asp-validation-for="ActualChangeReturned" class="text-audit-error text-[11px]"></span>
                </label>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-surface-container-lowest p-4 rounded-xl border border-surface-border">
                <div class="flex justify-between items-center">
                    <span class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Expected Change:</span>
                    <span class="font-data-mono font-bold text-on-surface text-lg" id="expectedChangeDisplay">₱0.00</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Short / Over:</span>
                    <span class="font-data-mono font-bold text-on-surface text-lg" id="shortOverDisplay">₱0.00</span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <label class="flex flex-col gap-2">
                    <span class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Responsible Manager</span>
                    <select asp-for="ResponsibleManagerId" asp-items="ViewBag.ResponsibleManagers" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-4 py-2.5 text-on-surface focus:outline-none focus:border-primary">
                        <option value="">-- Select Responsible Manager --</option>
                    </select>
                    <span asp-validation-for="ResponsibleManagerId" class="text-audit-error text-[11px]"></span>
                </label>
            </div>

            <div class="flex justify-end pt-2">
                <button type="submit" class="bg-primary text-on-primary rounded-lg px-6 py-2.5 font-medium hover:opacity-90 transition-opacity">Save Settlement</button>
            </div>
        </form>
    </section>
    <section class="rounded-xl border border-outline-variant bg-surface-container-low p-6">
        <div class="mb-4">
            <h2 class="font-headline-sm text-on-surface">Download settlement workbook</h2>
            <p class="text-sm text-on-surface-variant">Exports the PCF settlement, daily cash flow, and source details in an Excel workbook based on the branch templates.</p>
        </div>
        <form asp-action="ExportSettlementExcel" method="get" class="grid gap-4 md:grid-cols-4">
            <div>
                <label asp-for="StartDate" class="block text-sm font-medium text-on-surface">Start date</label>
                <input asp-for="StartDate" type="date" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2" />
            </div>
            <div>
                <label asp-for="EndDate" class="block text-sm font-medium text-on-surface">End date</label>
                <input asp-for="EndDate" type="date" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2" />
            </div>
            <div>
                <label asp-for="ReceiverUserId" class="block text-sm font-medium text-on-surface">Buyer / receiver</label>
                <select asp-for="ReceiverUserId" asp-items="ViewBag.SettlementReceivers" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2">
                    <option value="">All buyers</option>
                </select>
            </div>
            <div class="flex items-end">
                <button type="submit" class="w-full rounded-lg bg-primary px-4 py-2 font-medium text-on-primary">Download Excel</button>
            </div>
        </form>
    </section>

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const releaseSelect = document.getElementById("pcfReleaseSelect");
            const receiverInput = document.getElementById("receiverNameInput");
            const totalPcInput = document.getElementById("totalPcReleasedInput");
            const expensesInput = document.getElementById("totalAcceptedExpensesInput");
            const actualChangeInput = document.getElementById("actualChangeReturnedInput");
            
            const expectedDisplay = document.getElementById("expectedChangeDisplay");
            const shortOverDisplay = document.getElementById("shortOverDisplay");

            // Fetch release details if selected
            if (releaseSelect) {
                releaseSelect.addEventListener("change", function () {
                    const text = releaseSelect.options[releaseSelect.selectedIndex].text;
                    if (releaseSelect.value) {
                        // Display text format: "#ID - Receiver - Amount"
                        const parts = text.split(" - ");
                        if (parts.length >= 3) {
                            receiverInput.value = parts[1];
                            const amount = parseFloat(parts[2].replace(/,/g, ''));
                            if (!isNaN(amount)) {
                                totalPcInput.value = amount.toFixed(2);
                            }
                        }
                    }
                    calculateReconciliation();
                });
            }

            function calculateReconciliation() {
                const totalPc = parseFloat(totalPcInput.value) || 0;
                const expenses = parseFloat(expensesInput.value) || 0;
                const actualChange = parseFloat(actualChangeInput.value) || 0;

                const expectedChange = totalPc - expenses;
                const shortOver = actualChange - expectedChange;

                expectedDisplay.textContent = "₱" + expectedChange.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                
                if (shortOver < 0) {
                    shortOverDisplay.textContent = "-₱" + Math.abs(shortOver).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    shortOverDisplay.className = "font-data-mono font-bold text-audit-error text-lg";
                } else if (shortOver > 0) {
                    shortOverDisplay.textContent = "+₱" + shortOver.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    shortOverDisplay.className = "font-data-mono font-bold text-audit-success text-lg";
                } else {
                    shortOverDisplay.textContent = "₱0.00";
                    shortOverDisplay.className = "font-data-mono font-bold text-on-surface text-lg";
                }
            }

            totalPcInput.addEventListener("input", calculateReconciliation);
            expensesInput.addEventListener("input", calculateReconciliation);
            actualChangeInput.addEventListener("input", calculateReconciliation);
        });
    </script>
}
