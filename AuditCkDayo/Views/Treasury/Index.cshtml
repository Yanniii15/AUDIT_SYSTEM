@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" integrity="sha512-BNaRQnYJYiPSqHHDb58B0yaPfCu+Wgds8Gp/gU33kqBtgNS4tSPHuGibyoeqMV/TJlSKda6FXzoEyYGjTe+vXA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        (() => {
            const category = document.getElementById('manual-cashout-category');
            const purposeWrap = document.getElementById('manual-cashout-purpose-wrap');
            const purpose = document.getElementById('manual-cashout-purpose');
            const acrossEstablishments = document.getElementById('manual-cashout-across-establishments');
            const syncPurpose = () => {
                const isOthers = category?.value === '@CashFlowCategory.Others';
                const appliesAcrossEstablishments = acrossEstablishments?.checked === true;
                const estWrap = document.getElementById('manual-cashout-establishment-wrap');
                const establishment = document.getElementById('ManualCashOut_EstablishmentId');
                purposeWrap?.classList.toggle('hidden', !isOthers);
                estWrap?.classList.toggle('opacity-50', appliesAcrossEstablishments);
                if (establishment) {
                    establishment.disabled = appliesAcrossEstablishments;
                    if (appliesAcrossEstablishments) {
                        establishment.value = '';
                    }
                }
                if (purpose) {
                    purpose.required = isOthers;
                    if (!isOthers) {
                        purpose.value = '';
                    }
                }
            };
            category?.addEventListener('change', syncPurpose);
            acrossEstablishments?.addEventListener('change', syncPurpose);
            syncPurpose();

            // Listen audio summary trigger
            const listenBtn = document.getElementById('listen-audio-summary-btn');
            if (listenBtn && 'speechSynthesis' in window) {
                let isSpeaking = false;
                listenBtn.addEventListener('click', () => {
                    const label = document.getElementById('listen-audio-btn-label');
                    if (isSpeaking) {
                        window.speechSynthesis.cancel();
                        isSpeaking = false;
                        if (label) label.textContent = 'Listen Summary';
                        return;
                    }
                    const summaryText = listenBtn.getAttribute('data-summary');
                    if (!summaryText) return;

                    window.speechSynthesis.cancel();
                    let cleanText = summaryText.replace(/₱/g, ' Philippine pesos ');
                    cleanText = cleanText.replace(/\bpesos\b/gi, 'Philippine pesos');
                    cleanText = cleanText.replace(/\bdollars?\b/gi, 'Philippine pesos');
                    const utterance = new SpeechSynthesisUtterance(cleanText);
                    utterance.lang = 'en-PH';
                    utterance.rate = 0.95;
                    utterance.pitch = 1;
                    const voices = window.speechSynthesis.getVoices();
                    if (voices && voices.length > 0) {
                        const phVoice = voices.find(v => v.lang === 'en-PH' || v.lang === 'fil-PH' || v.lang.startsWith('fil') || v.name.toLowerCase().includes('philippine'));
                        if (phVoice) {
                            utterance.voice = phVoice;
                        }
                    }
                    utterance.onend = () => {
                        isSpeaking = false;
                        if (label) label.textContent = 'Listen Summary';
                    };
                    utterance.onerror = () => {
                        isSpeaking = false;
                        if (label) label.textContent = 'Listen Summary';
                    };
                    isSpeaking = true;
                    if (label) label.textContent = 'Stop Listening';
                    window.speechSynthesis.speak(utterance);
                });
            }
            // Image export trigger script
            const exportBtn = document.getElementById('export-treasury-image-btn');
            if (exportBtn) {
                exportBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const element = document.getElementById('treasury-capture-area');
                    if (!element) return;

                    // Clone the pre-rendered template element
                    const originalBtnHtml = exportBtn.innerHTML;
                    exportBtn.disabled = true;
                    exportBtn.innerHTML = '<span class="material-symbols-outlined text-[15px] animate-spin">progress_activity</span> Generating...';

                    // Clone the pre-rendered template element
                    const clone = element.cloneNode(true);
                    clone.style.position = 'fixed';
                    clone.style.top = '0';
                    clone.style.left = '0';
                    clone.style.zIndex = '-9999';
                    clone.style.opacity = '1';
                    clone.style.visibility = 'visible';
                    clone.style.pointerEvents = 'none';
                    clone.style.display = 'block';
                    clone.classList.remove('hidden');

                    document.body.appendChild(clone);

                    html2canvas(clone, {
                        scale: 2,
                        useCORS: true,
                        allowTaint: true,
                        scrollX: 0,
                        scrollY: 0,
                        backgroundColor: '#ffffff'
                    }).then(async canvas => {
                        document.body.removeChild(clone);
                        exportBtn.disabled = false;
                        exportBtn.innerHTML = originalBtnHtml;
                        const dateStr = '@Model.SelectedDate.ToString("yyyy-MM-dd")';
                        if (window.deliverExportedImage) {
                            await window.deliverExportedImage(canvas, `Treasury_CashFlow_${dateStr}.png`, 'Treasury Cash Flow');
                        }
                    }).catch(err => {
                        console.error("Error generating image:", err);
                        alert("Could not export treasury as image. Please try again.");
                        exportBtn.disabled = false;
                        exportBtn.innerHTML = originalBtnHtml;
                        if (clone.parentNode) {
                            document.body.removeChild(clone);
                        }
                    });
                });
            }
        })();

        // Deposit Slip Upload Modal Handlers
        let currentExpectedAmount = 0;
        window.openDepositModal = function(reportId, establishmentName, handoverAmount) {
            const modal = document.getElementById('treasuryDepositSlipModal');
            const form = document.getElementById('treasuryDepositSlipForm');
            const errorBox = document.getElementById('depositModalError');
            if (!modal || !form) return;

            if (!reportId || reportId === 0) {
                alert('This sales entry is not linked to a daily sales report.');
                return;
            }

            document.getElementById('depositModalSalesReportId').value = reportId;
            document.getElementById('depositModalEstName').textContent = establishmentName || 'Sales Handover';
            document.getElementById('depositModalHandoverAmount').textContent = '₱' + Number(handoverAmount || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('depositModalAmount').value = Number(handoverAmount || 0).toFixed(2);
            currentExpectedAmount = Number(handoverAmount || 0);

            const varianceGroup = document.getElementById('depositVarianceReasonGroup');
            const varianceInput = document.getElementById('depositModalVarianceReason');
            if (varianceGroup) varianceGroup.classList.add('hidden');
            if (varianceInput) {
                varianceInput.required = false;
                varianceInput.value = '';
            }

            if (errorBox) {
                errorBox.classList.add('hidden');
                errorBox.textContent = '';
            }

            modal.classList.remove('hidden');
        };

        window.closeDepositModal = function() {
            const modal = document.getElementById('treasuryDepositSlipModal');
            if (modal) modal.classList.add('hidden');
        };

        document.getElementById('depositModalAmount')?.addEventListener('input', function() {
            const entered = parseFloat(this.value) || 0;
            const diff = Math.abs(entered - currentExpectedAmount);
            const varianceGroup = document.getElementById('depositVarianceReasonGroup');
            const varianceInput = document.getElementById('depositModalVarianceReason');
            if (varianceGroup && varianceInput) {
                if (diff >= 0.01) {
                    varianceGroup.classList.remove('hidden');
                    varianceInput.required = true;
                } else {
                    varianceGroup.classList.add('hidden');
                    varianceInput.required = false;
                }
            }
        });

        window.handleDepositSlipSubmit = async function(event) {
            event.preventDefault();
            const form = document.getElementById('treasuryDepositSlipForm');
            const errorBox = document.getElementById('depositModalError');
            const submitBtn = document.getElementById('depositModalSubmitBtn');
            const submitText = document.getElementById('depositModalSubmitBtnText');
            if (!form) return;

            if (errorBox) {
                errorBox.classList.add('hidden');
                errorBox.textContent = '';
            }

            const formData = new FormData(form);
            const originalText = submitText?.textContent || 'Upload & Record';
            if (submitBtn) submitBtn.disabled = true;
            if (submitText) submitText.textContent = 'Uploading...';

            try {
                const response = await fetch('/SalesReports/UploadDepositSlip', {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    window.location.reload();
                } else {
                    let errorMsg = 'Failed to upload deposit slip.';
                    try {
                        const data = await response.json();
                        if (data && data.message) {
                            errorMsg = data.message;
                        } else if (typeof data === 'string') {
                            errorMsg = data;
                        }
                    } catch {
                        const text = await response.text();
                        if (text) errorMsg = text;
                    }
                    if (errorBox) {
                        errorBox.textContent = errorMsg;
                        errorBox.classList.remove('hidden');
                    } else {
                        alert(errorMsg);
                    }
                }
            } catch (err) {
                console.error('Upload error:', err);
                if (errorBox) {
                    errorBox.textContent = 'An error occurred during upload. Please try again.';
                    errorBox.classList.remove('hidden');
                } else {
                    alert('An error occurred during upload.');
                }
            } finally {
                if (submitBtn) submitBtn.disabled = false;
                if (submitText) submitText.textContent = originalText;
            }
        };
    </script>
}
