@model AuditCkDayo.ViewModels.TreasuryCashFlowViewModel
@{
    ViewData["Title"] = "Treasury Cash Flow";
}

<div id="pageVoiceSummary" class="sr-only">
    Treasury cash flow summary for @Model.CashFlowDate.ToString("MMMM dd, yyyy").
    Starting balance: ₱@Model.StartingBalance.ToString("N2").
    Total cash in: ₱@Model.TotalCashIn.ToString("N2").
    Total cash out: ₱@Model.TotalCashOut.ToString("N2").
    Closing balance: ₱@Model.ClosingBalance.ToString("N2").
</div>

<div id="treasury-capture-area" class="space-y-6 bg-surface p-4 rounded-xl">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Treasury Cash Flow</h1>
            <p class="text-on-surface-variant">Daily cash-in, cash-out, net cash flow, and closing balance.</p>
        </div>

        <div class="flex flex-wrap gap-3" data-html2canvas-ignore="true">
            @if (Model.FlowId.HasValue && Model.Status == TreasuryCashFlowStatus.Closed)
            {
                <span class="inline-flex items-center rounded-lg bg-surface-container-highest px-4 py-2 text-sm font-semibold text-on-surface-variant">
                    &check; Closed
                </span>
            }
            else if (Model.FlowId.HasValue)
            {
                <form asp-controller="Treasury" asp-action="CloseTreasury" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    <button type="submit" class="inline-flex items-center rounded-lg bg-tertiary px-4 py-2 text-sm font-semibold text-on-tertiary shadow-sm hover:bg-tertiary/90" onclick="return confirm('Close this treasury day? This locks the day.')">
                        Close Treasury
                    </button>
                </form>
            }
            <button id="export-treasury-image-btn" class="inline-flex items-center gap-2 rounded-lg bg-secondary px-4 py-2 text-sm font-semibold text-on-secondary shadow-sm hover:bg-secondary/90">
                <span class="material-symbols-outlined text-[18px]">image</span>
                Export Image
            </button>
            <a asp-controller="Treasury" asp-action="ReleasePcf" class="inline-flex items-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-on-primary shadow-sm hover:bg-primary/90">
                Release PCF
            </a>
            <a asp-controller="Treasury" asp-action="Settlement" class="inline-flex items-center rounded-lg border border-outline px-4 py-2 text-sm font-semibold text-primary hover:bg-primary/10">
                Settlement
            </a>
        </div>
    </div>

    <form asp-controller="Treasury" asp-action="Index" method="get" class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm" data-html2canvas-ignore="true">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
            <div>
                <label for="date" class="block text-sm font-medium text-on-surface">Cash flow date</label>
                <input id="date" name="date" type="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="mt-1 rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface" />
            </div>
            <button type="submit" class="rounded-lg bg-secondary px-4 py-2 text-sm font-semibold text-on-secondary hover:bg-secondary/90">
                View day
            </button>
        </div>
    </form>

    <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        <div class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <p class="text-sm text-on-surface-variant">Starting Balance</p>
            <p class="mt-2 text-2xl font-semibold text-on-surface">₱@Model.StartingBalance.ToString("N2")</p>
        </div>
        <div class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <p class="text-sm text-on-surface-variant">Total Cash In</p>
            <p class="mt-2 text-2xl font-semibold text-green-700">₱@Model.TotalCashIn.ToString("N2")</p>
        </div>
        <div class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <p class="text-sm text-on-surface-variant">Total Cash Out</p>
            <p class="mt-2 text-2xl font-semibold text-red-700">₱@Model.TotalCashOut.ToString("N2")</p>
        </div>
        <div class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <p class="text-sm text-on-surface-variant">Net Cash Flow</p>
            <p class="mt-2 text-2xl font-semibold text-on-surface">₱@Model.NetCashFlow.ToString("N2")</p>
        </div>
        <div class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <p class="text-sm text-on-surface-variant">Closing Balance</p>
            <p class="mt-2 text-2xl font-semibold text-primary">₱@Model.ClosingBalance.ToString("N2")</p>
        </div>
    </section>

    <div class="grid gap-6 md:grid-cols-2" data-html2canvas-ignore="true">
        <!-- Record Cash In -->
        <section class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <div class="mb-4">
                <h2 class="text-lg font-semibold text-on-surface">Record cash in</h2>
                <p class="text-sm text-on-surface-variant">Record cash flowing into the Treasury.</p>
            </div>
            <form asp-controller="Treasury" asp-action="RecordCashIn" method="post" class="grid gap-4 md:grid-cols-2">
                @Html.AntiForgeryToken()
                <input asp-for="ManualCashIn.CashInDate" type="hidden" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                <div>
                    <label asp-for="ManualCashIn.Category" class="block text-sm font-medium text-on-surface">Category</label>
                    <select asp-for="ManualCashIn.Category" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface">
                        <option value="@CashFlowCategory.Others">Others</option>
                        <option value="@CashFlowCategory.Sales">Sales</option>
                        <option value="@CashFlowCategory.ChangePcf">Change PCF</option>
                        <option value="@CashFlowCategory.OwnerFunding">Owner Funding</option>
                        <option value="@CashFlowCategory.CashSurrender">Cash Surrender</option>
                    </select>
                </div>
                <div>
                    <label asp-for="ManualCashIn.Amount" class="block text-sm font-medium text-on-surface">Amount</label>
                    <input asp-for="ManualCashIn.Amount" type="number" min="0.01" step="0.01" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface" />
                </div>
                <div class="md:col-span-2">
                    <label asp-for="ManualCashIn.Purpose" class="block text-sm font-medium text-on-surface">Purpose / remarks</label>
                    <input asp-for="ManualCashIn.Purpose" maxlength="255" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface" placeholder="Purpose or details" />
                </div>
                <div class="md:col-span-2">
                    <button type="submit" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-on-primary shadow-sm hover:bg-primary/90">
                        Save cash in
                    </button>
                </div>
            </form>
        </section>

        <!-- Record Cash Out -->
        <section class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <div class="mb-4">
                <h2 class="text-lg font-semibold text-on-surface">Record cash out</h2>
                <p class="text-sm text-on-surface-variant">Record cash paid out from the Treasury.</p>
            </div>
            <form asp-controller="Treasury" asp-action="RecordCashOut" method="post" class="grid gap-4 md:grid-cols-2">
                @Html.AntiForgeryToken()
                <input asp-for="ManualCashOut.CashOutDate" type="hidden" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                <div>
                    <label asp-for="ManualCashOut.Category" class="block text-sm font-medium text-on-surface">Cash-out category</label>
                    <select asp-for="ManualCashOut.Category" id="manual-cashout-category" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface">
                        <option value="@CashFlowCategory.Others">Others</option>
                        <option value="@CashFlowCategory.PcfRelease">PCF</option>
                        <option value="@CashFlowCategory.ChangePcf">Change PCF</option>
                        <option value="@CashFlowCategory.Expense">Expense</option>
                        <option value="@CashFlowCategory.Payroll">Payroll</option>
                        <option value="@CashFlowCategory.Utilities">Utilities</option>
                        <option value="@CashFlowCategory.Supplier">Supplier</option>
                    </select>
                </div>
                <div id="manual-cashout-amount-wrap">
                    <label asp-for="ManualCashOut.Amount" class="block text-sm font-medium text-on-surface">Amount</label>
                    <input asp-for="ManualCashOut.Amount" id="manual-cashout-amount" type="number" min="0.01" step="0.01" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface" />
                </div>
                <div id="manual-cashout-establishment-wrap" class="md:col-span-2">
                    <label asp-for="ManualCashOut.EstablishmentId" class="block text-sm font-medium text-on-surface">Establishment</label>
                    <select asp-for="ManualCashOut.EstablishmentId" asp-items="ViewBag.CashFlowEstablishments" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface">
                        <option value="">— none —</option>
                    </select>
                    <p class="mt-1 text-xs text-on-surface-variant">Leave as none for personal, treasury-wide, or non-branch cash-outs.</p>
                </div>
                <div id="manual-cashout-purpose-wrap" class="md:col-span-2">
                    <label asp-for="ManualCashOut.Purpose" class="block text-sm font-medium text-on-surface">Purpose / remarks</label>
                    <input asp-for="ManualCashOut.Purpose" id="manual-cashout-purpose" maxlength="255" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface" placeholder="Example: KEITH GAS AUG. 5" />
                </div>
                <div id="manual-cashout-reportedby-wrap" class="md:col-span-2">
                    <label asp-for="ManualCashOut.ReportedByUserId" class="block text-sm font-medium text-on-surface">Report under manager</label>
                    <select asp-for="ManualCashOut.ReportedByUserId" asp-items="ViewBag.ReportedByManagers" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface">
                        <option value="">— same as this treasury (default) —</option>
                    </select>
                    <p class="mt-1 text-xs text-on-surface-variant">Optional: shows this cash-out under another manager's report (e.g. covering manager). Treasury total stays with this handler.</p>
                </div>
                <label class="md:col-span-2 flex flex-col gap-1 text-sm font-medium text-on-surface">
                    <span class="inline-flex items-center gap-2">
                        <input asp-for="ManualCashOut.AppliesAcrossEstablishments" id="manual-cashout-across-establishments" type="checkbox" class="rounded border-outline text-primary focus:ring-primary" />
                        Applies across establishments
                    </span>
                    <span class="text-xs font-normal text-on-surface-variant">This one amount applies across establishments and is not split.</span>
                </label>
                <div class="md:col-span-2">
                    <button type="submit" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-on-primary shadow-sm hover:bg-primary/90">
                        Save cash out
                    </button>
                </div>
            </form>
        </section>
    </div>

    <div class="space-y-4">
        @if (!Model.Entries.Any())
        {
            <div class="p-6 text-center text-on-surface-variant">
                No cash-flow entries found for this date. Use Release PCF or Settlement when there is treasury activity to record.
            </div>
        }
        else
        {
            <div class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm overflow-hidden">
                <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-surface-border">
                    <!-- CASH IN COLUMN -->
                    <div class="flex flex-col">
                        <div class="bg-surface-container-low border-b border-surface-border px-space-6 py-space-3">
                            <h3 class="font-label-caps uppercase text-[12px] tracking-wider font-bold text-green-700">CASH IN</h3>
                        </div>
                        <div class="p-space-6 space-y-space-6">
                            <!-- SALES -->
                            <div class="space-y-space-3">
                                <h4 class="font-label-caps uppercase text-[10px] text-on-surface-variant font-bold tracking-wider">SALES</h4>
                                <div class="divide-y divide-surface-border border border-surface-border rounded-lg bg-surface-container-low/30 overflow-hidden">
                                    @{
                                        var salesIn = Model.Entries.Where(e => e.Direction == CashFlowDirection.In && e.Category == CashFlowCategory.Sales).ToList();
                                    }
                                    @foreach (var entry in salesIn)
                                    {
                                        <div class="flex justify-between items-center px-space-4 py-space-3 text-sm group hover:bg-surface-container-high/40">
                                            <span class="text-on-surface font-medium">
                                                @if (entry.Establishment != null)
                                                {
                                                    <span>@entry.Establishment.Name</span>
                                                    @if (!string.IsNullOrEmpty(entry.Notes))
                                                    {
                                                        <span class="text-xs text-on-surface-variant block mt-0.5">@entry.Notes</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>@(entry.Notes ?? "General")</span>
                                                }
                                            </span>
                                            <div class="flex items-center gap-2">
                                                <span class="font-data-mono text-primary font-bold">₱@entry.Amount.ToString("N2")</span>
                                                @if (Model.Status != TreasuryCashFlowStatus.Closed)
                                                {
                                                    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity" data-html2canvas-ignore="true">
                                                        <a asp-controller="Treasury" asp-action="EditEntry" asp-route-id="@entry.Id" class="text-xs text-secondary hover:underline">Edit</a>
                                                        <span class="text-outline text-xs">|</span>
                                                        <form asp-controller="Treasury" asp-action="DeleteEntry" method="post" class="inline" onsubmit="return confirm('Delete this entry?')">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@entry.Id" />
                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <button type="submit" class="text-xs text-red-600 hover:underline">Del</button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (!salesIn.Any())
                                    {
                                        <div class="px-space-4 py-space-3 text-xs text-on-surface-variant italic">No sales cash-in recorded</div>
                                    }
                                </div>
                            </div>

                            <!-- CHANGE PCF -->
                            <div class="space-y-space-3">
                                <h4 class="font-label-caps uppercase text-[10px] text-on-surface-variant font-bold tracking-wider">CHANGE PCF</h4>
                                <div class="divide-y divide-surface-border border border-surface-border rounded-lg bg-surface-container-low/30 overflow-hidden">
                                    @{
                                        var changeIn = Model.Entries.Where(e => e.Direction == CashFlowDirection.In && e.Category == CashFlowCategory.ChangePcf).ToList();
                                    }
                                    @foreach (var entry in changeIn)
                                    {
                                        <div class="flex justify-between items-center px-space-4 py-space-3 text-sm group hover:bg-surface-container-high/40">
                                            <span class="text-on-surface font-medium">
                                                @if (entry.Establishment != null)
                                                {
                                                    <span>@entry.Establishment.Name</span>
                                                    @if (!string.IsNullOrEmpty(entry.Notes))
                                                    {
                                                        <span class="text-xs text-on-surface-variant block mt-0.5">@entry.Notes</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>@(entry.Notes ?? "General")</span>
                                                }
                                            </span>
                                            <div class="flex items-center gap-2">
                                                <span class="font-data-mono text-primary font-bold">₱@entry.Amount.ToString("N2")</span>
                                                @if (Model.Status != TreasuryCashFlowStatus.Closed)
                                                {
                                                    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity" data-html2canvas-ignore="true">
                                                        <a asp-controller="Treasury" asp-action="EditEntry" asp-route-id="@entry.Id" class="text-xs text-secondary hover:underline">Edit</a>
                                                        <span class="text-outline text-xs">|</span>
                                                        <form asp-controller="Treasury" asp-action="DeleteEntry" method="post" class="inline" onsubmit="return confirm('Delete this entry?')">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@entry.Id" />
                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <button type="submit" class="text-xs text-red-600 hover:underline">Del</button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (!changeIn.Any())
                                    {
                                        <div class="px-space-4 py-space-3 text-xs text-on-surface-variant italic">No change PCF recorded</div>
                                    }
                                </div>
                            </div>

                            <!-- OTHERS -->
                            <div class="space-y-space-3">
                                <h4 class="font-label-caps uppercase text-[10px] text-on-surface-variant font-bold tracking-wider">OTHERS</h4>
                                <div class="divide-y divide-surface-border border border-surface-border rounded-lg bg-surface-container-low/30 overflow-hidden">
                                    @{
                                        var othersIn = Model.Entries.Where(e => e.Direction == CashFlowDirection.In && e.Category != CashFlowCategory.Sales && e.Category != CashFlowCategory.ChangePcf).ToList();
                                    }
                                    @foreach (var entry in othersIn)
                                    {
                                        <div class="flex justify-between items-center px-space-4 py-space-3 text-sm group hover:bg-surface-container-high/40">
                                            <span class="text-on-surface font-medium">@(entry.Notes ?? entry.Category.ToString())</span>
                                            <div class="flex items-center gap-2">
                                                <span class="font-data-mono text-primary font-bold">₱@entry.Amount.ToString("N2")</span>
                                                @if (Model.Status != TreasuryCashFlowStatus.Closed)
                                                {
                                                    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity" data-html2canvas-ignore="true">
                                                        <a asp-controller="Treasury" asp-action="EditEntry" asp-route-id="@entry.Id" class="text-xs text-secondary hover:underline">Edit</a>
                                                        <span class="text-outline text-xs">|</span>
                                                        <form asp-controller="Treasury" asp-action="DeleteEntry" method="post" class="inline" onsubmit="return confirm('Delete this entry?')">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@entry.Id" />
                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <button type="submit" class="text-xs text-red-600 hover:underline">Del</button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (!othersIn.Any())
                                    {
                                        <div class="px-space-4 py-space-3 text-xs text-on-surface-variant italic">No other cash-in recorded</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CASH OUT COLUMN -->
                    <div class="flex flex-col">
                        <div class="bg-surface-container-low border-b border-surface-border px-space-6 py-space-3">
                            <h3 class="font-label-caps uppercase text-[12px] tracking-wider font-bold text-red-700">CASH OUT</h3>
                        </div>
                        <div class="p-space-6 space-y-space-6">
                            <!-- PCF -->
                            <div class="space-y-space-3">
                                <h4 class="font-label-caps uppercase text-[10px] text-on-surface-variant font-bold tracking-wider">PCF</h4>
                                <div class="divide-y divide-surface-border border border-surface-border rounded-lg bg-surface-container-low/30 overflow-hidden">
                                    @{
                                        var pcfOut = Model.Entries.Where(e => e.Direction == CashFlowDirection.Out && e.Category == CashFlowCategory.PcfRelease).ToList();
                                    }
                                    @foreach (var entry in pcfOut)
                                    {
                                        <div class="flex justify-between items-center px-space-4 py-space-3 text-sm group hover:bg-surface-container-high/40">
                                            <span class="text-on-surface font-medium">
                                                @(entry.Establishment?.Name ?? entry.RelatedUser?.Name ?? entry.Notes ?? "General")
                                            </span>
                                            <div class="flex items-center gap-2">
                                                <span class="font-data-mono text-primary font-bold">₱@entry.Amount.ToString("N2")</span>
                                                @if (Model.Status != TreasuryCashFlowStatus.Closed)
                                                {
                                                    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity" data-html2canvas-ignore="true">
                                                        <a asp-controller="Treasury" asp-action="EditEntry" asp-route-id="@entry.Id" class="text-xs text-secondary hover:underline">Edit</a>
                                                        <span class="text-outline text-xs">|</span>
                                                        <form asp-controller="Treasury" asp-action="DeleteEntry" method="post" class="inline" onsubmit="return confirm('Delete this entry?')">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@entry.Id" />
                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <button type="submit" class="text-xs text-red-600 hover:underline">Del</button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (!pcfOut.Any())
                                    {
                                        <div class="px-space-4 py-space-3 text-xs text-on-surface-variant italic">No PCF cash-out recorded</div>
                                    }
                                </div>
                            </div>

                            <!-- OTHERS -->
                            <div class="space-y-space-3">
                                <h4 class="font-label-caps uppercase text-[10px] text-on-surface-variant font-bold tracking-wider">OTHERS</h4>
                                <div class="divide-y divide-surface-border border border-surface-border rounded-lg bg-surface-container-low/30 overflow-hidden">
                                    @{
                                        var othersOut = Model.Entries.Where(e => e.Direction == CashFlowDirection.Out && e.Category != CashFlowCategory.PcfRelease).ToList();
                                    }
                                    @foreach (var entry in othersOut)
                                    {
                                        <div class="flex justify-between items-center px-space-4 py-space-3 text-sm group hover:bg-surface-container-high/40">
                                            <span class="text-on-surface font-medium">
                                                @(entry.Notes ?? entry.Category.ToString())
                                                @if (entry.Establishment != null)
                                                {
                                                    <span class="text-xs text-on-surface-variant">(@entry.Establishment.Name)</span>
                                                }
                                            </span>
                                            <div class="flex items-center gap-2">
                                                <span class="font-data-mono text-primary font-bold">₱@entry.Amount.ToString("N2")</span>
                                                @if (Model.Status != TreasuryCashFlowStatus.Closed)
                                                {
                                                    <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity" data-html2canvas-ignore="true">
                                                        <a asp-controller="Treasury" asp-action="EditEntry" asp-route-id="@entry.Id" class="text-xs text-secondary hover:underline">Edit</a>
                                                        <span class="text-outline text-xs">|</span>
                                                        <form asp-controller="Treasury" asp-action="DeleteEntry" method="post" class="inline" onsubmit="return confirm('Delete this entry?')">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@entry.Id" />
                                                            <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                                                            <button type="submit" class="text-xs text-red-600 hover:underline">Del</button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (!othersOut.Any())
                                    {
                                        <div class="px-space-4 py-space-3 text-xs text-on-surface-variant italic">No other cash-out recorded</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" integrity="sha512-BNaRQnYcabqeeRYfyCRXXJQNLTvYFsTqVY75oTKtMJUYqAQCYiMXUF3gKDUM159CciVMp4vd37PjAlpMbpgT1w==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        (() => {
            const category = document.getElementById('manual-cashout-category');
            const purposeWrap = document.getElementById('manual-cashout-purpose-wrap');
            const purpose = document.getElementById('manual-cashout-purpose');
            const acrossEstablishments = document.getElementById('manual-cashout-across-establishments');
            const syncPurpose = () => {
                const isOthers = category?.value === '@CashFlowCategory.Others';
                const appliesAcrossEstablishments = acrossEstablishments?.checked === true;
                const estWrap = document.getElementById('manual-cashout-establishment-wrap');
                const establishment = document.getElementById('ManualCashOut_EstablishmentId');
                purposeWrap?.classList.toggle('hidden', !isOthers);
                estWrap?.classList.toggle('opacity-50', appliesAcrossEstablishments);
                if (establishment) {
                    establishment.disabled = appliesAcrossEstablishments;
                    if (appliesAcrossEstablishments) {
                        establishment.value = '';
                    }
                }
                if (purpose) {
                    purpose.required = isOthers;
                    if (!isOthers) {
                        purpose.value = '';
                    }
                }
            };
            category?.addEventListener('change', syncPurpose);
            acrossEstablishments?.addEventListener('change', syncPurpose);
            syncPurpose();

            // Image export trigger script
            const exportBtn = document.getElementById('export-treasury-image-btn');
            if (exportBtn) {
                exportBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const element = document.getElementById('treasury-capture-area');
                    if (!element) return;

                    // Temporarily enforce white background for snapshot capture
                    const originalBg = element.style.backgroundColor;
                    element.style.backgroundColor = '#ffffff';

                    html2canvas(element, {
                        scale: 2, // High resolution texts
                        useCORS: true,
                        allowTaint: true,
                        logging: true,
                        backgroundColor: '#ffffff'
                    }).then(canvas => {
                        element.style.backgroundColor = originalBg;

                        const dateStr = '@Model.SelectedDate.ToString("yyyy-MM-dd")';
                        const link = document.createElement('a');
                        link.download = `Treasury_CashFlow_${dateStr}.jpg`;
                        link.href = canvas.toDataURL('image/jpeg', 0.95);
                        document.body.appendChild(link);
                        link.click();
                        document.body.removeChild(link);
                    }).catch(err => {
                        console.error("Error generating image:", err);
                        alert("Could not export treasury as image. Please try again.");
                        element.style.backgroundColor = originalBg;
                    });
                });
            }
        })();
    </script>
}
