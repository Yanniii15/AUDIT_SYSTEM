@model AuditCkDayo.ViewModels.TreasuryCashFlowViewModel
@{
    ViewData["Title"] = "Treasury Cash Flow";
}

<div id="pageVoiceSummary" class="sr-only">
    Treasury cash flow summary for @Model.CashFlowDate.ToString("MMMM dd, yyyy").
    Starting balance: ₱@Model.StartingBalance.ToString("N2").
    Total cash in: ₱@Model.TotalCashIn.ToString("N2").
    Total cash out: ₱@Model.TotalCashOut.ToString("N2").
    Closing balance: ₱@Model.ClosingBalance.ToString("N2").
</div>

<div id="treasury-capture-area" class="hidden text-black font-sans relative" style="width: 800px; margin: 0 auto; color: #000000; background-color: #ffffff;">
    <!-- Print-only spreadsheet style layout -->
    <div class="border-2 border-black divide-y divide-black">
        <!-- Title Header -->
        <div class="text-center font-bold text-lg uppercase py-2 tracking-wider border-b border-black">
            CKR - DAILY CASH FLOW
        </div>

        <!-- Date & Starting Balance Row -->
        <div class="grid grid-cols-12 divide-x divide-black text-sm">
            <div class="col-span-4 px-3 py-2 font-bold uppercase">DATE</div>
            <div class="col-span-8 px-3 py-2 text-left">@Model.SelectedDate.ToString("MMMM dd, yyyy")</div>
        </div>
        <div class="grid grid-cols-12 divide-x divide-black text-sm">
            <div class="col-span-4 px-3 py-2 font-bold uppercase">STARTING BALANCE</div>
            <div class="col-span-8 px-3 py-2 font-bold text-left bg-yellow-100" style="background-color: #fef08a !important;">₱@Model.StartingBalance.ToString("N2")</div>
        </div>

        <!-- Double Columns Header -->
        <div class="grid grid-cols-2 divide-x divide-black font-bold uppercase text-center bg-gray-100 text-sm border-t border-b border-black" style="background-color: #f3f4f6 !important;">
            <div class="py-2">CASH IN</div>
            <div class="py-2">CASH OUT</div>
        </div>

        <!-- Main Ledger Rows Container -->
        <div class="grid grid-cols-2 divide-x divide-black text-[12px] min-h-[400px]">
            
            <!-- LEFT COLUMN: CASH IN -->
            <div class="flex flex-col divide-y divide-gray-300">
                <!-- Sales Group -->
                <div class="bg-gray-50 font-bold uppercase px-3 py-1 border-b border-black" style="background-color: #f9fafb !important;">SALES</div>
                @{ var printSales = Model.Entries.Where(e => e.Direction == CashFlowDirection.In && e.Category == CashFlowCategory.Sales).ToList(); }
                @foreach (var entry in printSales)
                {
                    <div class="grid grid-cols-12 px-3 py-1">
                        <div class="col-span-8 font-medium">@(entry.Establishment?.Name ?? "General")</div>
                        <div class="col-span-4 text-right font-mono font-semibold">@entry.Amount.ToString("N2")</div>
                    </div>
                }
                @if(!printSales.Any()) { <div class="px-3 py-1 text-gray-400 italic">No sales</div> }

                <!-- Change PCF Group -->
                <div class="bg-gray-50 font-bold uppercase px-3 py-1 border-t border-b border-black" style="background-color: #f9fafb !important;">CHANGE PCF</div>
                @{ var printChangeIn = Model.Entries.Where(e => e.Direction == CashFlowDirection.In && e.Category == CashFlowCategory.ChangePcf).ToList(); }
                @foreach (var entry in printChangeIn)
                {
                    <div class="grid grid-cols-12 px-3 py-1">
                        <div class="col-span-8 font-medium">
                            @if (entry.Establishment != null)
                            {
                                <span>@entry.Establishment.Name</span>
                                @if (!string.IsNullOrEmpty(entry.Notes)) { <span class="text-[10px] text-gray-600 block">(@entry.Notes)</span> }
                            }
                            else
                            {
                                <span>@(entry.Notes ?? "General")</span>
                            }
                        </div>
                        <div class="col-span-4 text-right font-mono font-semibold">@entry.Amount.ToString("N2")</div>
                    </div>
                }
                @if(!printChangeIn.Any()) { <div class="px-3 py-1 text-gray-400 italic">No change PCF</div> }

                <!-- Others Group -->
                <div class="bg-gray-50 font-bold uppercase px-3 py-1 border-t border-b border-black" style="background-color: #f9fafb !important;">OTHERS</div>
                @{ var printOthersIn = Model.Entries.Where(e => e.Direction == CashFlowDirection.In && e.Category != CashFlowCategory.Sales && e.Category != CashFlowCategory.ChangePcf).ToList(); }
                @foreach (var entry in printOthersIn)
                {
                    <div class="grid grid-cols-12 px-3 py-1">
                        <div class="col-span-8 font-medium">@(entry.Notes ?? entry.Category.ToString())</div>
                        <div class="col-span-4 text-right font-mono font-semibold">@entry.Amount.ToString("N2")</div>
                    </div>
                }
                @if(!printOthersIn.Any()) { <div class="px-3 py-1 text-gray-400 italic">No other cash-in</div> }
            </div>

            <!-- RIGHT COLUMN: CASH OUT -->
            <div class="flex flex-col divide-y divide-gray-300">
                <!-- PCF Releases -->
                <div class="bg-gray-50 font-bold uppercase px-3 py-1 border-b border-black" style="background-color: #f9fafb !important;">PCF</div>
                @{ var printPcfOut = Model.Entries.Where(e => e.Direction == CashFlowDirection.Out && e.Category == CashFlowCategory.PcfRelease).ToList(); }
                @foreach (var entry in printPcfOut)
                {
                    <div class="grid grid-cols-12 px-3 py-1">
                        <div class="col-span-8 font-medium">@(entry.Establishment?.Name ?? entry.RelatedUser?.Name ?? entry.Notes ?? "General")</div>
                        <div class="col-span-4 text-right font-mono font-semibold">@entry.Amount.ToString("N2")</div>
                    </div>
                }
                @if(!printPcfOut.Any()) { <div class="px-3 py-1 text-gray-400 italic">No PCF releases</div> }

                <!-- Others Cash Out -->
                <div class="bg-gray-50 font-bold uppercase px-3 py-1 border-t border-b border-black" style="background-color: #f9fafb !important;">OTHERS</div>
                @{ var printOthersOut = Model.Entries.Where(e => e.Direction == CashFlowDirection.Out && e.Category != CashFlowCategory.PcfRelease).ToList(); }
                @foreach (var entry in printOthersOut)
                {
                    <div class="grid grid-cols-12 px-3 py-1">
                        <div class="col-span-8 font-medium">
                            @(entry.Notes ?? entry.Category.ToString())
                            @if (entry.Establishment != null)
                            {
                                <span class="text-[10px] text-gray-600 block">(@entry.Establishment.Name)</span>
                            }
                        </div>
                        <div class="col-span-4 text-right font-mono font-semibold">@entry.Amount.ToString("N2")</div>
                    </div>
                }
                @if(!printOthersOut.Any()) { <div class="px-3 py-1 text-gray-400 italic">No other cash-out</div> }
            </div>

        </div>

        <!-- Totals Row -->
        <div class="grid grid-cols-2 divide-x divide-black text-sm font-bold border-t-2 border-black bg-gray-100" style="background-color: #f3f4f6 !important;">
            <div class="grid grid-cols-12 px-3 py-2">
                <div class="col-span-8 uppercase">TOTAL CASH IN:</div>
                <div class="col-span-4 text-right font-mono">₱@Model.TotalCashIn.ToString("N2")</div>
            </div>
            <div class="grid grid-cols-12 px-3 py-2">
                <div class="col-span-8 uppercase">TOTAL CASH OUT:</div>
                <div class="col-span-4 text-right font-mono">₱@Model.TotalCashOut.ToString("N2")</div>
            </div>
        </div>

        <!-- Net Cash Flow & Closing Balance Row -->
        <div class="grid grid-cols-12 divide-x divide-black text-sm border-t border-black">
            <div class="col-span-4 px-3 py-2 font-bold uppercase">NET CASH FLOW</div>
            <div class="col-span-8 px-3 py-2 font-bold text-left bg-yellow-100" style="background-color: #fef08a !important;">₱@Model.NetCashFlow.ToString("N2")</div>
        </div>
        <div class="grid grid-cols-12 divide-x divide-black text-sm">
            <div class="col-span-4 px-3 py-2 font-bold uppercase">CLOSING BALANCE</div>
            <div class="col-span-8 px-3 py-2 font-bold text-left bg-yellow-100" style="background-color: #fef08a !important;">₱@Model.ClosingBalance.ToString("N2")</div>
        </div>
    </div>
</div>

<div class="space-y-6 mt-6">
    @{
        var unDepositedSales = Model.Entries.Where(e => e.Direction == CashFlowDirection.In && e.Category == CashFlowCategory.Sales && (e.SalesReport == null || !e.SalesReport.HasDepositSlip)).ToList();
    }
    @if (unDepositedSales.Any())
    {
        <div class="rounded-xl border border-red-500/30 bg-red-500/10 p-4 shadow-sm flex items-center gap-3 text-red-500">
            <span class="material-symbols-outlined text-red-500 text-2xl animate-pulse">warning</span>
            <div class="font-medium text-sm">
                <span class="font-bold">ATTENTION:</span> @unDepositedSales.Count Sales Handover(s) totaling ₱@unDepositedSales.Sum(e => e.Amount).ToString("N2") are awaiting bank deposit slips.
            </div>
        </div>
    }
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Treasury Cash Flow</h1>
            <p class="text-on-surface-variant">Daily cash-in, cash-out, net cash flow, and closing balance.</p>
        </div>

        <div class="flex flex-wrap gap-3">
            @if (Model.FlowId.HasValue && Model.Status == TreasuryCashFlowStatus.Closed)
            {
                <span class="inline-flex items-center rounded-lg bg-surface-container-highest px-4 py-2 text-sm font-semibold text-on-surface-variant">
                    &check; Closed
                </span>
            }
            else if (Model.FlowId.HasValue)
            {
                <form asp-controller="Treasury" asp-action="CloseTreasury" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    <button type="submit" class="inline-flex items-center rounded-lg bg-tertiary px-4 py-2 text-sm font-semibold text-on-tertiary shadow-sm hover:bg-tertiary/90" onclick="return confirm('Close this treasury day? This locks the day.')">
                        Close Treasury
                    </button>
                </form>
            }
            @if (!string.IsNullOrWhiteSpace(ViewBag.SpokenSummary as string))
            {
                <button type="button" id="listen-audio-summary-btn" data-summary="@ViewBag.SpokenSummary" class="inline-flex items-center gap-2 rounded-lg bg-secondary px-4 py-2 text-sm font-semibold text-on-secondary shadow-sm hover:bg-secondary/90">
                    <span class="material-symbols-outlined text-[18px]">volume_up</span>
                    <span id="listen-audio-btn-label">Listen Summary</span>
                </button>
            }
            <a asp-controller="Treasury" asp-action="ExportAudioSummary" asp-route-date="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="inline-flex items-center gap-2 rounded-lg border border-outline px-4 py-2 text-sm font-semibold text-secondary hover:bg-secondary/10">
                <span class="material-symbols-outlined text-[18px]">download</span>
                Download Audio Summary
            </a>
            <button id="export-treasury-image-btn" class="inline-flex items-center gap-2 rounded-lg bg-secondary px-4 py-2 text-sm font-semibold text-on-secondary shadow-sm hover:bg-secondary/90">
                <span class="material-symbols-outlined text-[18px]">image</span>
                Export Image
            </button>
            <a asp-controller="Treasury" asp-action="ReleasePcf" class="inline-flex items-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-on-primary shadow-sm hover:bg-primary/90">
                Release PCF
            </a>
            <a asp-controller="Treasury" asp-action="Settlement" class="inline-flex items-center rounded-lg border border-outline px-4 py-2 text-sm font-semibold text-primary hover:bg-primary/10">
                Settlement
            </a>
        </div>
    </div>

    <form asp-controller="Treasury" asp-action="Index" method="get" class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
            <div>
                <label for="date" class="block text-sm font-medium text-on-surface">Cash flow date</label>
                <input id="date" name="date" type="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="mt-1 rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface" />
            </div>
            <button type="submit" class="rounded-lg bg-secondary px-4 py-2 text-sm font-semibold text-on-secondary hover:bg-secondary/90">
                View day
            </button>
        </div>
    </form>

    <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        <div class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <p class="text-sm text-on-surface-variant">Starting Balance</p>
            <p class="mt-2 text-2xl font-semibold text-on-surface">₱@Model.StartingBalance.ToString("N2")</p>
        </div>
        <div class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <p class="text-sm text-on-surface-variant">Total Cash In</p>
            <p class="mt-2 text-2xl font-semibold text-green-700">₱@Model.TotalCashIn.ToString("N2")</p>
        </div>
        <div class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <p class="text-sm text-on-surface-variant">Total Cash Out</p>
            <p class="mt-2 text-2xl font-semibold text-red-700">₱@Model.TotalCashOut.ToString("N2")</p>
        </div>
        <div class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <p class="text-sm text-on-surface-variant">Net Cash Flow</p>
            <p class="mt-2 text-2xl font-semibold text-on-surface">₱@Model.NetCashFlow.ToString("N2")</p>
        </div>
        <div class="rounded-xl border border-outline-variant bg-surface-container p-4 shadow-sm">
            <p class="text-sm text-on-surface-variant">Closing Balance</p>
            <p class="mt-2 text-2xl font-semibold text-primary">₱@Model.ClosingBalance.ToString("N2")</p>
        </div>
    </section>

    <div class="grid gap-6 md:grid-cols-2">
        <!-- Record Cash In -->
        <details class="group rounded-xl border border-outline-variant bg-surface-container shadow-sm transition-all">
            <summary class="flex cursor-pointer items-center justify-between p-4 font-semibold text-on-surface hover:bg-surface-container-high/50 select-none rounded-xl">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-green-600">add_circle</span>
                    <span>Record cash in</span>
                    <span class="text-xs font-normal text-on-surface-variant hidden sm:inline">— click to expand</span>
                </div>
                <span class="material-symbols-outlined transition-transform duration-200 group-open:rotate-180">expand_more</span>
            </summary>
            <div class="border-t border-outline-variant/50 p-4">
                <p class="mb-4 text-xs text-on-surface-variant">Record cash flowing into the Treasury.</p>
                <form asp-controller="Treasury" asp-action="RecordCashIn" method="post" class="grid gap-4 md:grid-cols-2">
                    @Html.AntiForgeryToken()
                    <input asp-for="ManualCashIn.CashInDate" type="hidden" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    <div>
                        <label asp-for="ManualCashIn.Category" class="block text-sm font-medium text-on-surface">Category</label>
                        <select asp-for="ManualCashIn.Category" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface">
                            <option value="@CashFlowCategory.Others">Others</option>
                            <option value="@CashFlowCategory.Sales">Sales</option>
                            <option value="@CashFlowCategory.ChangePcf">Change PCF</option>
                            <option value="@CashFlowCategory.OwnerFunding">Owner Funding</option>
                            <option value="@CashFlowCategory.CashSurrender">Cash Surrender</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="ManualCashIn.Amount" class="block text-sm font-medium text-on-surface">Amount</label>
                        <input asp-for="ManualCashIn.Amount" type="number" min="0.01" step="0.01" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface" />
                    </div>
                    <div class="md:col-span-2">
                        <label asp-for="ManualCashIn.Purpose" class="block text-sm font-medium text-on-surface">Purpose / remarks</label>
                        <input asp-for="ManualCashIn.Purpose" maxlength="255" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface" placeholder="Purpose or details" />
                    </div>
                    <div class="md:col-span-2">
                        <button type="submit" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-on-primary shadow-sm hover:bg-primary/90">
                            Save cash in
                        </button>
                    </div>
                </form>
            </div>
        </details>

        <!-- Record Cash Out -->
        <details class="group rounded-xl border border-outline-variant bg-surface-container shadow-sm transition-all">
            <summary class="flex cursor-pointer items-center justify-between p-4 font-semibold text-on-surface hover:bg-surface-container-high/50 select-none rounded-xl">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-red-600">remove_circle</span>
                    <span>Record cash out</span>
                    <span class="text-xs font-normal text-on-surface-variant hidden sm:inline">— click to expand</span>
                </div>
                <span class="material-symbols-outlined transition-transform duration-200 group-open:rotate-180">expand_more</span>
            </summary>
            <div class="border-t border-outline-variant/50 p-4">
                <p class="mb-4 text-xs text-on-surface-variant">Record cash paid out from the Treasury.</p>
                <form asp-controller="Treasury" asp-action="RecordCashOut" method="post" class="grid gap-4 md:grid-cols-2">
                    @Html.AntiForgeryToken()
                    <input asp-for="ManualCashOut.CashOutDate" type="hidden" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    <div>
                        <label asp-for="ManualCashOut.Category" class="block text-sm font-medium text-on-surface">Cash-out category</label>
                        <select asp-for="ManualCashOut.Category" id="manual-cashout-category" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface">
                            <option value="@CashFlowCategory.Others">Others</option>
                            <option value="@CashFlowCategory.PcfRelease">PCF</option>
                            <option value="@CashFlowCategory.ChangePcf">Change PCF</option>
                            <option value="@CashFlowCategory.Expense">Expense</option>
                            <option value="@CashFlowCategory.Payroll">Payroll</option>
                            <option value="@CashFlowCategory.Utilities">Utilities</option>
                            <option value="@CashFlowCategory.Supplier">Supplier</option>
                        </select>
                    </div>
                    <div id="manual-cashout-amount-wrap">
                        <label asp-for="ManualCashOut.Amount" class="block text-sm font-medium text-on-surface">Amount</label>
                        <input asp-for="ManualCashOut.Amount" id="manual-cashout-amount" type="number" min="0.01" step="0.01" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface" />
                    </div>
                    <div id="manual-cashout-establishment-wrap" class="md:col-span-2">
                        <label asp-for="ManualCashOut.EstablishmentId" class="block text-sm font-medium text-on-surface">Establishment</label>
                        <select asp-for="ManualCashOut.EstablishmentId" asp-items="ViewBag.CashFlowEstablishments" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface">
                            <option value="">— none —</option>
                        </select>
                        <p class="mt-1 text-xs text-on-surface-variant">Leave as none for personal, treasury-wide, or non-branch cash-outs.</p>
                    </div>
                    <div id="manual-cashout-purpose-wrap" class="md:col-span-2">
                        <label asp-for="ManualCashOut.Purpose" class="block text-sm font-medium text-on-surface">Purpose / remarks</label>
                        <input asp-for="ManualCashOut.Purpose" id="manual-cashout-purpose" maxlength="255" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface" placeholder="Example: KEITH GAS AUG. 5" />
                    </div>
                    <div id="manual-cashout-reportedby-wrap" class="md:col-span-2">
                        <label asp-for="ManualCashOut.ReportedByUserId" class="block text-sm font-medium text-on-surface">Report under manager</label>
                        <select asp-for="ManualCashOut.ReportedByUserId" asp-items="ViewBag.ReportedByManagers" class="mt-1 w-full rounded-lg border border-outline bg-surface px-3 py-2 text-on-surface">
                            <option value="">— same as this treasury (default) —</option>
                        </select>
                        <p class="mt-1 text-xs text-on-surface-variant">Optional: shows this cash-out under another manager's report (e.g. covering manager). Treasury total stays with this handler.</p>
                    </div>
                    <label class="md:col-span-2 flex flex-col gap-1 text-sm font-medium text-on-surface">
                        <span class="inline-flex items-center gap-2">
                            <input asp-for="ManualCashOut.AppliesAcrossEstablishments" id="manual-cashout-across-establishments" type="checkbox" class="rounded border-outline text-primary focus:ring-primary" />
                            Applies across establishments
                        </span>
                        <span class="text-xs font-normal text-on-surface-variant">This one amount applies across establishments and is not split.</span>
                    </label>
                    <div class="md:col-span-2">
                        <button type="submit" class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-on-primary shadow-sm hover:bg-primary/90">
                            Save cash out
                        </button>
                    </div>
                </form>
            </div>
        </details>
    </div>

    <div class="space-y-4">
        @if (!Model.Entries.Any())
        {
            <div class="p-6 text-center text-on-surface-variant">
                No cash-flow entries found for this date. Use Release PCF or Settlement when there is treasury activity to record.
            </div>
        }
        else
        {
            <div class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm overflow-hidden">
                <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-surface-border">
                    <!-- CASH IN COLUMN -->
                    <div class="flex flex-col">
                        <div class="bg-surface-container-low border-b border-surface-border px-space-6 py-space-3">
                            <h3 class="font-label-caps uppercase text-[12px] tracking-wider font-bold text-green-700">CASH IN</h3>
                        </div>
                        <div class="p-space-6 space-y-space-6">
                            <!-- SALES -->
                            <div class="space-y-space-3">
                                <h4 class="font-label-caps uppercase text-[10px] text-on-surface-variant font-bold tracking-wider">SALES</h4>
                                <div class="border border-surface-border rounded-lg bg-surface-container-low/30 overflow-hidden">
                                    <table class="w-full text-left border-collapse">
                                        <tbody>
                                            @{
                                                var salesIn = Model.Entries.Where(e => e.Direction == CashFlowDirection.In && e.Category == CashFlowCategory.Sales).ToList();
                                            }
                                            @foreach (var entry in salesIn)
                                            {
                                                var hasDepositSlip = entry.SalesReport != null && entry.SalesReport.HasDepositSlip;
                                                var rowClass = hasDepositSlip
                                                    ? "border-b last:border-0 border-surface-border hover:bg-surface-container-high/40 transition-colors group"
                                                    : "border-b last:border-0 border-surface-border bg-red-500/10 border-l-4 border-red-500 hover:bg-red-500/20 transition-colors group";
                                                <tr class="@rowClass">
                                                    <td class="px-4 py-3 text-sm text-on-surface font-medium">
                                                        <div class="flex flex-wrap items-center gap-2">
                                                            @if (entry.Establishment != null)
                                                            {
                                                                <span>@entry.Establishment.Name</span>
                                                            }
                                                            else
                                                            {
                                                                <span>@(entry.Notes ?? "General")</span>
                                                            }

                                                            @if (!hasDepositSlip)
                                                            {
                                                                <span class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-red-600 text-white animate-pulse">● NO DEPOSIT SLIP</span>
                                                                var reportId = entry.SalesReportId ?? entry.SalesReport?.Id ?? 0;
