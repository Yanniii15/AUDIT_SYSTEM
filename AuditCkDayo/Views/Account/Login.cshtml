@model AuditCkDayo.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="w-full max-w-[480px] bg-surface-container-lowest p-10 rounded-2xl shadow-xl border border-surface-border flex flex-col gap-6 z-10">
    <!-- Brand / Logo Header -->
    <div class="flex flex-col items-center text-center gap-2">
        <img src="/images/logo.png" alt="Makbie Companies Logo" class="w-48 h-auto" />
        <h1 class="font-headline-md text-headline-md text-primary tracking-tight mt-2">Makbie Companies</h1>
    </div>

    <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-surface-border to-transparent"></div>

    <form asp-action="Login" method="post" class="flex flex-col gap-space-4">
        <div asp-validation-summary="ModelOnly" class="text-audit-error bg-audit-error/10 border border-audit-error/20 p-space-3 rounded-lg text-body-md text-center"></div>

        <!-- Email -->
        <div class="flex flex-col gap-space-1.5">
            <label asp-for="Email" class="font-label-caps text-on-surface-variant uppercase text-[10px] tracking-wider font-bold">Email Address</label>
            <input asp-for="Email" class="w-full bg-surface-container-low border border-surface-border rounded-xl px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" placeholder="name@ckr.com" required />
            <span asp-validation-for="Email" class="text-audit-error text-[11px]"></span>
        </div>

        <!-- Password -->
        <div class="flex flex-col gap-space-1.5">
            <label asp-for="Password" class="font-label-caps text-on-surface-variant uppercase text-[10px] tracking-wider font-bold">Password</label>
            <div class="relative">
                <input asp-for="Password" type="password" class="w-full bg-surface-container-low border border-surface-border rounded-xl px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" id="loginPassInput" placeholder="••••••••" required />
                <button class="absolute right-space-3 top-1/2 -translate-y-1/2 text-on-surface-variant/50 hover:text-primary password-reveal-btn cursor-pointer bg-transparent border-0 flex items-center justify-center" data-input-id="loginPassInput" type="button">
                    <span class="material-symbols-outlined text-[20px] eye-icon">visibility</span>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-audit-error text-[11px]"></span>
        </div>

        <button type="submit" class="bg-primary text-on-primary px-space-8 py-3.5 rounded-xl font-label-caps uppercase tracking-widest hover:bg-primary/90 transition-colors flex items-center justify-center gap-space-2 shadow-md mt-space-3 font-semibold text-[13px]">
            <span class="material-symbols-outlined text-[18px]">login</span>
            Login
        </button>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        document.querySelectorAll('.password-reveal-btn').forEach(btn => {
            const inputId = btn.dataset.inputId;
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('.eye-icon');

            if (!input || !icon) return;

            const showPass = () => {
                input.type = 'text';
                icon.innerText = 'visibility_off';
            };

            const hidePass = () => {
                input.type = 'password';
                icon.innerText = 'visibility';
            };

            // Mouse events
            btn.addEventListener('mousedown', showPass);
            btn.addEventListener('mouseup', hidePass);
            btn.addEventListener('mouseleave', hidePass);

            // Touch events for mobile
            btn.addEventListener('touchstart', (e) => {
                e.preventDefault();
                showPass();
            });
            btn.addEventListener('touchend', (e) => {
                e.preventDefault();
                hidePass();
            });
        });
    });
</script>
