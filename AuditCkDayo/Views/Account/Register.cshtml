@model IEnumerable<AuditCkDayo.Models.User>
@{
    ViewData["Title"] = "User Administration";
    var recentUsers = (IEnumerable<AuditCkDayo.Models.User>)ViewBag.RecentUsers;
}

<!-- Header Section -->
<div class="relative flex flex-col lg:flex-row gap-space-6 items-start justify-between">
    <div class="flex flex-col gap-space-2 max-w-2xl">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">group</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">User Administration</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Staff & User Directory</h1>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            Manage system users, view access levels, and assign managers and branches.
        </p>
    </div>
    
    <!-- Action Button -->
    <div class="flex-none pt-space-2">
        <a asp-controller="Account" asp-action="RegisterForm" class="bg-primary text-on-primary px-space-6 py-space-3 rounded-lg font-label-caps uppercase tracking-widest hover:bg-on-primary-fixed-variant transition-colors flex items-center gap-space-2 shadow-md text-[12px] decoration-none">
            <span class="material-symbols-outlined text-[18px]">person_add</span>
            + Register new staff
        </a>
    </div>
</div>

<!-- Alert banner for success message -->
@if (TempData["Message"] != null)
{
    <div class="p-space-4 my-space-4 bg-audit-success/10 border border-audit-success/20 rounded-xl text-audit-success font-body-md flex items-center justify-between shadow-sm">
        <span><i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]</span>
        <button onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="p-space-4 my-space-4 bg-audit-error/10 border border-audit-error/20 rounded-xl text-audit-error font-body-md flex items-center justify-between shadow-sm">
        <span><i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]</span>
        <button onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
    </div>
}

<div class="flex flex-col lg:flex-row gap-space-8 items-start my-space-4">
    <!-- Staff Directory Table -->
    <div class="w-full lg:flex-1 bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden border border-surface-border">
        <div class="bg-primary px-space-6 py-space-4 flex justify-between items-center">
            <span class="text-on-primary font-label-caps uppercase tracking-tighter text-[11px]">Active Staff Directory</span>
            <span class="text-on-primary/60 text-[10px] font-data-mono">TOTAL_RECORDS: @Model.Count()</span>
        </div>
        
        <div class="hidden lg:block max-h-[520px] overflow-y-auto overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="sticky top-0 z-10">
                    <tr class="bg-surface-container-low border-b border-surface-border">
                        <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Name</th>
                        <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Email</th>
                        <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">System Role</th>
                        <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Reporting Manager</th>
                        <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Assigned Branch</th>
                        <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-border">
                    @foreach (var user in Model)
                    {
                        <tr class="hover:bg-surface-container-low/30 transition-colors group">
                            <td class="px-space-6 py-space-4">
                                <div class="font-body-md font-semibold text-on-surface">@user.Name</div>
                            </td>
                            <td class="px-space-6 py-space-4 font-body-md text-on-surface-variant">
                                @user.Email
                            </td>
                            <td class="px-space-6 py-space-4">
                                @{
                                    var badgeStyle = user.Role == AuditCkDayo.Models.UserRole.Owner ? "bg-primary/10 text-primary border-primary/20" : 
                                                     (user.Role == AuditCkDayo.Models.UserRole.Manager ? "bg-secondary-container text-on-secondary-container border-secondary/20" : 
                                                     (user.Role == AuditCkDayo.Models.UserRole.BranchStaff ? "bg-audit-pending/10 text-audit-pending border-audit-pending/20" : 
                                                     "bg-surface-container text-on-surface-variant border-surface-border"));
                                }
                                <span class="px-space-3 py-0.5 rounded-full text-[10px] font-label-caps uppercase border @badgeStyle">
                                    @user.Role
                                </span>
                            </td>
                            <td class="px-space-6 py-space-4">
                                @if (user.Role == AuditCkDayo.Models.UserRole.Buyer || user.Role == AuditCkDayo.Models.UserRole.BranchStaff)
                                {
                                    <form asp-controller="Users" asp-action="AssignManager" asp-route-id="@user.Id" method="post" class="flex gap-space-2 items-center">
                                        <select name="managerId" class="bg-surface-container-low border border-surface-border rounded-lg px-2 py-1 font-body-md focus:outline-none focus:border-primary/50 text-on-surface text-[12px] cursor-pointer">
                                            <option value="">No Manager Assigned</option>
                                            @if (ViewBag.Managers != null)
                                            {
                                                foreach (var mgr in (IEnumerable<AuditCkDayo.Models.User>)ViewBag.Managers)
                                                {
                                                    if (user.ManagerId == mgr.Id)
                                                    {
                                                        <option value="@mgr.Id" selected="selected">@mgr.Name</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@mgr.Id">@mgr.Name</option>
                                                    }
                                                }
                                            }
                                        </select>
                                        <button type="submit" class="bg-primary text-on-primary px-3 py-1 rounded font-label-caps hover:bg-primary/95 text-[10px] uppercase">
                                            Set
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-[12px] text-on-surface-variant font-label-caps">N/A</span>
                                }
                            </td>
                            <td class="px-space-6 py-space-4 font-body-md text-on-surface-variant">
                                @(user.Establishment?.Name ?? "N/A")
                            </td>
                            <td class="px-space-6 py-space-4 text-center">
                                @if (user.Id.ToString() != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                                {
                                    <form asp-controller="Users" asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Are you sure you want to delete user @user.Name?');" class="inline">
                                        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-2 py-1 rounded text-[10px] font-label-caps uppercase shadow-sm">
                                            Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-[10px] text-on-surface-variant font-label-caps uppercase">Current User</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Card Layout (Stitch Responsive Reference) -->
        <div class="block lg:hidden space-y-space-4 p-space-4 max-h-[520px] overflow-y-auto">
            @foreach (var user in Model)
            {
                var badgeStyle = user.Role == AuditCkDayo.Models.UserRole.Owner ? "bg-primary/10 text-primary border-primary/20" : 
                                 (user.Role == AuditCkDayo.Models.UserRole.Manager ? "bg-secondary-container text-on-secondary-container border-secondary/20" : 
                                 (user.Role == AuditCkDayo.Models.UserRole.BranchStaff ? "bg-audit-pending/10 text-audit-pending border-audit-pending/20" : 
                                 "bg-surface-container text-on-surface-variant border-surface-border"));

                <article class="bg-surface-container-lowest border border-surface-border rounded-xl p-space-4 flex flex-col gap-space-4 shadow-sm">
                    <div class="flex justify-between items-start">
                        <div>
                            <div class="font-body-md font-semibold text-on-surface">@user.Name</div>
                            <div class="text-[12px] text-on-surface-variant mt-0.5">@user.Email</div>
                        </div>
                        <span class="px-space-3 py-0.5 rounded-full text-[10px] font-label-caps uppercase border @badgeStyle">
                            @user.Role
                        </span>
                    </div>
                    <div class="grid grid-cols-2 gap-space-3">
                        <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                            <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Reporting Manager</div>
                            <div class="font-body-md text-on-surface text-[13px]">
                                @(user.Manager != null ? user.Manager.Name : "No Manager")
                            </div>
                        </div>
                        <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                            <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Assigned Branch</div>
                            <div class="font-body-md text-on-surface text-[13px]">
                                @(user.Establishment != null ? user.Establishment.Name : "No Branch")
                            </div>
                        </div>
                    </div>
                    
                    <!-- Actions inside Mobile Card -->
                    <div class="pt-space-3 border-t border-surface-border border-dashed space-y-3">
                        @if (user.Role == AuditCkDayo.Models.UserRole.Buyer)
                        {
                            <form asp-controller="Users" asp-action="AssignManager" asp-route-id="@user.Id" method="post" class="flex gap-space-2 items-center">
                                <select name="managerId" class="flex-1 bg-surface-container-low border border-surface-border rounded-lg px-2 py-1.5 font-body-md focus:outline-none focus:border-primary/50 text-on-surface text-[12px] cursor-pointer">
                                    <option value="">No Manager Assigned</option>
                                    @if (ViewBag.Managers != null)
                                    {
                                        foreach (var manager in ViewBag.Managers)
                                        {
                                            <!option value="@manager.Id" selected="@(user.ManagerId == manager.Id)">@manager.Name</!option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="bg-primary text-on-primary px-3 py-1.5 rounded-lg font-label-caps hover:bg-primary/95 text-[10px] uppercase shadow-sm whitespace-nowrap">
                                    Assign
                                </button>
                            </form>
                        }

                        @if (user.Id.ToString() != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <div class="flex justify-end">
                                <form asp-controller="Users" asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Are you sure you want to delete user @user.Name?');" class="inline">
                                    <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-4 py-1.5 rounded-lg text-[10px] font-label-caps uppercase shadow-sm">
                                        Delete Account
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
    
    <!-- Side Panel: Recent Activity -->
    <div class="w-full lg:w-80 flex flex-col gap-space-6">
        <div class="bg-surface-container-lowest rounded-xl shadow-sm p-space-6 border border-surface-border">
            <div class="flex items-center justify-between mb-space-6">
                <h3 class="font-headline-sm text-headline-sm text-on-surface">Recent Activity</h3>
                <span class="font-label-caps text-[10px] text-audit-success bg-audit-success/10 px-space-2 py-0.5 rounded-full font-bold">REGISTRATIONS</span>
            </div>
            
            <div class="flex flex-col gap-space-4">
                @if (recentUsers != null && recentUsers.Any())
                {
                    foreach (var user in recentUsers)
                    {
                        <div class="flex items-center gap-space-4 pb-space-4 border-b border-surface-border last:border-0">
                            <div class="w-10 h-10 rounded-full bg-secondary-container text-secondary flex items-center justify-center font-bold text-[12px] flex-none">
                                @user.Name.Substring(0, Math.Min(2, user.Name.Length)).ToUpper()
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="font-body-md font-semibold text-on-surface truncate">@user.Name</p>
                                <p class="font-label-caps text-[10px] text-on-surface-variant uppercase">@user.Role • Ref: #@user.Id</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-on-surface-variant font-body-md text-center py-2">No recent activity logs.</p>
                }
            </div>
        </div>
    </div>
</div>
