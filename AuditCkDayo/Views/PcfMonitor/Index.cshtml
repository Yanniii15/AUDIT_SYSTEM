@model AuditCkDayo.ViewModels.PcfMonitorViewModel
@{
    ViewData["Title"] = "PCF Monitor";
}

<div id="pageVoiceSummary" class="sr-only">
    Petty cash fund monitor. Monitored balance count: @Model.Users.Count accounts.
    Total active PCF: ₱@Model.Users.Sum(u => u.PcfBalance).ToString("N2").
</div>

<section class="space-y-space-6">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-space-4">
        <div class="space-y-space-2 max-w-3xl">
            <div class="flex items-center gap-space-2 text-primary">
                <span class="material-symbols-outlined text-[20px]">account_balance_wallet</span>
                <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Live Cash Visibility</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">PCF Monitor</h1>
            <p class="font-body-md text-on-surface-variant">@Model.ScopeLabel. Current PCF uses each user's live spendable balance, separate from the starting float issued for the day.</p>
        </div>
        <button onclick="location.reload()" class="self-start lg:self-auto flex items-center gap-space-2 text-[10px] font-label-caps uppercase text-on-primary bg-primary px-space-4 py-space-2 rounded-full hover:bg-primary/90 transition-colors">
            Refresh Balances <span class="material-symbols-outlined text-[14px]">sync</span>
        </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-4">
        <article class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm p-space-6">
            <span class="font-label-caps uppercase text-[10px] text-on-surface-variant">Starting PCF</span>
            <div class="font-headline-lg text-headline-lg text-on-surface mt-space-2">₱@Model.TotalStartingPcf.ToString("N2")</div>
        </article>
        <article class="bg-primary border border-primary rounded-xl shadow-sm p-space-6">
            <span class="font-label-caps uppercase text-[10px] text-primary-fixed-dim">Current PCF</span>
            <div class="font-headline-lg text-headline-lg text-on-primary mt-space-2">₱@Model.TotalCurrentPcf.ToString("N2")</div>
        </article>
        <article class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm p-space-6">
            <span class="font-label-caps uppercase text-[10px] text-on-surface-variant">Used Amount</span>
            <div class="font-headline-lg text-headline-lg text-audit-error mt-space-2">₱@Model.TotalUsedPcf.ToString("N2")</div>
        </article>
    </div>

    <section class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm overflow-hidden">
        <div class="px-space-6 py-space-4 border-b border-surface-border flex items-center justify-between gap-space-4">
            <h2 class="font-headline-sm text-on-surface">User PCF Balances</h2>
            <span class="text-[12px] text-on-surface-variant">@Model.Users.Count users</span>
        </div>
        <div class="hidden lg:block max-h-[620px] overflow-y-auto overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="sticky top-0 z-10 bg-surface-container-low border-b border-surface-border">
                    <tr>
                        <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant">User</th>
                        <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant">Role</th>
                        <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant">Establishment</th>
                        <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant text-right">Starting PCF</th>
                        <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant text-right">Current PCF</th>
                        <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant text-right">Used</th>
                        <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant text-right">Utilization</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-border">
                    @if (!Model.Users.Any())
                    {
                        <tr><td colspan="7" class="px-space-6 py-space-8 text-center text-on-surface-variant">No PCF balances in this scope.</td></tr>
                    }
                    else
                    {
                        @foreach (var user in Model.Users)
                        {
                            var used = user.DailyStartingFloat - user.PcfBalance;
                            var utilization = user.DailyStartingFloat <= 0 ? 0 : Math.Round((used / user.DailyStartingFloat) * 100, 1);
                            <tr class="hover:bg-surface-container-low/50 transition-colors">
                                <td class="px-space-6 py-space-4 text-on-surface font-semibold">@user.Name</td>
                                <td class="px-space-6 py-space-4 text-on-surface-variant">@user.Role</td>
                                <td class="px-space-6 py-space-4 text-on-surface-variant">@(user.Establishment?.Name ?? "Unassigned")</td>
                                <td class="px-space-6 py-space-4 text-right font-data-mono text-on-surface">₱@user.DailyStartingFloat.ToString("N2")</td>
                                <td class="px-space-6 py-space-4 text-right font-data-mono text-primary">₱@user.PcfBalance.ToString("N2")</td>
                                <td class="px-space-6 py-space-4 text-right font-data-mono @(used >= 0 ? "text-audit-error" : "text-audit-success")">₱@used.ToString("N2")</td>
                                <td class="px-space-6 py-space-4 text-right font-data-mono text-on-surface-variant">@utilization.ToString("N1")%</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="block lg:hidden max-h-[620px] overflow-y-auto space-y-space-4 p-space-4">
            @if (!Model.Users.Any())
            {
                <div class="text-center text-on-surface-variant font-body-md py-space-6">No PCF balances in this scope.</div>
            }
            else
            {
                @foreach (var user in Model.Users)
                {
                    var used = user.DailyStartingFloat - user.PcfBalance;
                    var utilization = user.DailyStartingFloat <= 0 ? 0 : Math.Round((used / user.DailyStartingFloat) * 100, 1);
                    <article class="bg-surface-container-low border border-surface-border rounded-xl p-space-4 space-y-space-3">
                        <div class="flex items-start justify-between gap-space-3">
                            <div>
                                <h3 class="font-body-md font-semibold text-on-surface">@user.Name</h3>
                                <p class="text-[11px] text-on-surface-variant">@user.Role • @(user.Establishment?.Name ?? "Unassigned")</p>
                            </div>
                            <span class="font-data-mono text-primary">₱@user.PcfBalance.ToString("N2")</span>
                        </div>
                        <div class="grid grid-cols-3 gap-space-2 text-[11px]">
                            <div class="bg-surface-container-lowest rounded-lg p-space-3 border border-surface-border"><div class="font-label-caps uppercase text-[9px] text-on-surface-variant">Starting</div><div class="font-data-mono text-on-surface">₱@user.DailyStartingFloat.ToString("N2")</div></div>
                            <div class="bg-surface-container-lowest rounded-lg p-space-3 border border-surface-border"><div class="font-label-caps uppercase text-[9px] text-on-surface-variant">Used</div><div class="font-data-mono @(used >= 0 ? "text-audit-error" : "text-audit-success")">₱@used.ToString("N2")</div></div>
                            <div class="bg-surface-container-lowest rounded-lg p-space-3 border border-surface-border"><div class="font-label-caps uppercase text-[9px] text-on-surface-variant">Use %</div><div class="font-data-mono text-on-surface">@utilization.ToString("N1")%</div></div>
                        </div>
                    </article>
                }
            }
        </div>
    </section>
</section>
