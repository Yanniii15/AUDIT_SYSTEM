                                 data-buyer="@item.Buyer.Name"
                                 data-establishment="@item.Establishment.Name"
                                 data-date="@item.EntryDate.ToString("MMM dd, yyyy")"
                                 data-amount="₱@item.Amount.ToString("N2")"
                                 data-description="@item.Description"
                                 data-notes="@item.Notes"
                                 data-details="@System.Text.Json.JsonSerializer.Serialize(item.Details.Select(d => new { name = d.ItemName, qty = d.Quantity, price = d.Price, total = d.Total }))"
                                 data-receipt-url="@(string.IsNullOrEmpty(item.ReceiptImageUrl) ? "#" : item.ReceiptImageUrl)">
                            <div class="flex justify-between items-start">
                                <div class="flex gap-space-3 items-center">
                                    <div class="w-10 h-10 rounded-full bg-secondary-container text-secondary flex items-center justify-center font-bold text-[12px]">
                                        @item.Buyer.Name.Substring(0, Math.Min(2, item.Buyer.Name.Length)).ToUpper()
                                    </div>
                                    <div>
                                        <div class="font-body-md font-semibold text-on-surface">@item.Buyer.Name</div>
