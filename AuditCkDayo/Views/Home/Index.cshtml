@model AuditCkDayo.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Financial Oversight";
    var currentUser = (AuditCkDayo.Models.User)ViewBag.CurrentUser;
    var pendingCount = Model.Audits.Count(a => a.Status == AuditCkDayo.Models.AuditStatus.AwaitingBranchVerification || a.Status == AuditCkDayo.Models.AuditStatus.AwaitingManagerApproval);
}

<!-- Status & Summary Bar: Asymmetric Bento Grid -->
<section class="grid grid-cols-12 gap-space-6 items-end">
    <div class="col-span-12 lg:col-span-4 space-y-space-4">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">analytics</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Performance Snapshot</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Financial Oversight</h1>
        <p class="font-body-md text-on-surface-variant max-w-md">
            Real-time reconciliation of Petty Cash Fund expenditures across all regional establishments.
        </p>
    </div>
    
    <div class="col-span-12 lg:col-span-8 grid grid-cols-1 md:grid-cols-3 gap-space-4">
        <!-- Total Audited Amount -->
        <div class="relative overflow-hidden bg-surface-container-lowest p-space-6 rounded-xl shadow-sm group hover:shadow-md transition-all duration-300 border border-surface-border">
            <div class="absolute top-0 right-0 p-space-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-[64px]">account_balance_wallet</span>
            </div>
            <div class="relative z-10">
                <span class="font-label-caps text-on-surface-variant uppercase text-[10px]">Filtered Total Audited</span>
                <div class="flex items-baseline gap-space-2 mt-space-2">
                    <span class="font-headline-lg text-headline-lg text-primary">₱@Model.TotalAmount.ToString("N2")</span>
                </div>
                <div class="mt-space-4 h-1 w-full bg-surface-container rounded-full overflow-hidden">
                    <div class="h-full bg-primary w-[75%] transition-all duration-1000 ease-out"></div>
                </div>
            </div>
        </div>
        
        <!-- Pending Audits -->
        <div class="relative overflow-hidden bg-surface-container-lowest p-space-6 rounded-xl shadow-sm group hover:shadow-md transition-all duration-300 border border-surface-border">
            <div class="absolute top-0 right-0 p-space-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-[64px]">pending_actions</span>
            </div>
            <div class="relative z-10">
                <span class="font-label-caps text-on-surface-variant uppercase text-[10px]">Pending Verification</span>
                <div class="flex items-baseline gap-space-2 mt-space-2">
                    <span class="font-headline-lg text-headline-lg text-audit-pending">@pendingCount</span>
                    <span class="font-body-md text-on-surface-variant">items</span>
                </div>
                <div class="mt-space-4 flex gap-space-1">
                    <div class="h-1 flex-1 bg-audit-pending rounded-full"></div>
                    <div class="h-1 flex-1 bg-audit-pending/30 rounded-full"></div>
                    <div class="h-1 flex-1 bg-audit-pending/30 rounded-full"></div>
                </div>
            </div>
        </div>
        
        <!-- Current PCF Balance -->
        <div class="relative overflow-hidden bg-primary p-space-6 rounded-xl shadow-sm group hover:shadow-md transition-all duration-300">
            <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-on-primary/5 rounded-full blur-3xl group-hover:scale-150 transition-transform duration-700"></div>
            <div class="relative z-10">
                <span class="font-label-caps text-primary-fixed-dim uppercase text-[10px]">Your PCF Balance</span>
                <div class="flex items-baseline gap-space-2 mt-space-2">
                    <span class="font-headline-lg text-headline-lg text-on-primary">₱@currentUser.PcfBalance.ToString("N2")</span>
                </div>
                <button onclick="location.reload()" class="mt-space-4 flex items-center gap-space-2 text-[10px] text-label-caps text-on-primary bg-on-primary/10 px-space-3 py-space-1 rounded-full hover:bg-on-primary/20 transition-colors">
                    REFRESH POOL <span class="material-symbols-outlined text-[14px]">sync</span>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Dashboard Role Tabs -->
<section class="pb-space-8">
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border/50 overflow-hidden">
        <div class="px-space-5 py-space-3 border-b border-surface-border bg-surface-container-low/40">
            <div class="ml-6 inline-flex items-center gap-1 bg-surface-container p-1 rounded-xl border border-surface-border" role="tablist" aria-label="Dashboard sections">
                <button type="button"
                        class="dashboard-tab-btn px-space-4 py-2.5 rounded-lg whitespace-nowrap text-center font-label-caps uppercase tracking-widest text-[10px] transition-all bg-primary text-on-primary shadow-sm"
                        data-dashboard-tab="overview"
                        aria-controls="overview-panel"
                        aria-selected="true">
                    Overview
                </button>
                <button type="button"
                        class="dashboard-tab-btn px-space-4 py-2.5 rounded-lg whitespace-nowrap text-center font-label-caps uppercase tracking-widest text-[10px] transition-all bg-transparent text-on-surface-variant hover:text-primary hover:bg-surface-container-low"
                        data-dashboard-tab="historical"
                        aria-controls="historical-panel"
                        aria-selected="false">
                    Historical Data
                </button>
            </div>
        </div>

        <div id="overview-panel" class="dashboard-tab-panel p-space-6" role="tabpanel">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-space-4 mb-space-4">
                <div>
                    <div class="flex items-center gap-space-2 text-primary mb-space-1">
                        <span class="material-symbols-outlined text-[20px]">today</span>
                        <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Overview</span>
                    </div>
                    <h2 class="font-headline-sm text-on-surface">Audits Today</h2>
                </div>
                <span class="font-data-mono text-primary text-[13px]">@Model.TodayAudits.Count records</span>
            </div>

            <div class="hidden lg:block overflow-x-auto rounded-xl border border-surface-border">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container-low border-b border-surface-border">
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">ID</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Buyer</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Establishment</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Description</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-right">Amount</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-border">
                        @if (!Model.TodayAudits.Any())
                        {
                            <tr>
                                <td colspan="6" class="px-space-6 py-space-8 text-center text-on-surface-variant font-body-md">
                                    No audits submitted today.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.TodayAudits)
                            {
                                var statusBg = item.Status == AuditCkDayo.Models.AuditStatus.Approved ? "bg-audit-success/10 text-audit-success border-audit-success/20" :
                                               (item.Status == AuditCkDayo.Models.AuditStatus.Rejected ? "bg-audit-error/10 text-audit-error border-audit-error/20" :
                                               "bg-audit-pending/10 text-audit-pending border-audit-pending/20");

                                <tr class="hover:bg-surface-container-low/30 transition-colors">
                                    <td class="px-space-6 py-space-4"><span class="font-data-mono text-on-surface-variant text-[13px]">#AUD-@item.Id</span></td>
                                    <td class="px-space-6 py-space-4"><span class="font-body-md font-semibold text-on-surface">@item.Buyer.Name</span></td>
                                    <td class="px-space-6 py-space-4"><span class="font-body-md text-on-surface">@item.Establishment.Name</span></td>
                                    <td class="px-space-6 py-space-4"><p class="font-body-md text-on-surface-variant truncate max-w-[280px]">@item.Description</p></td>
                                    <td class="px-space-6 py-space-4 text-right"><span class="font-data-mono text-primary font-bold">₱@item.Amount.ToString("N2")</span></td>
                                    <td class="px-space-6 py-space-4 text-center"><span class="px-space-3 py-1 @statusBg rounded-full text-[10px] font-label-caps uppercase border">@item.Status</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card Layout (Stitch Responsive Reference) -->
            <div class="block lg:hidden space-y-space-4 mt-space-4">
                @if (!Model.TodayAudits.Any())
                {
                    <div class="text-center text-on-surface-variant font-body-md py-space-6">
                        No audits submitted today.
                    </div>
                }
                else
                {
                    @foreach (var item in Model.TodayAudits)
                    {
                        var statusBg = item.Status == AuditCkDayo.Models.AuditStatus.Approved ? "bg-audit-success/10 text-audit-success border-audit-success/20" :
                                       (item.Status == AuditCkDayo.Models.AuditStatus.Rejected ? "bg-audit-error/10 text-audit-error border-audit-error/20" :
                                       "bg-audit-pending/10 text-audit-pending border-audit-pending/20");

                        <article class="bg-surface-container-lowest border border-surface-border rounded-xl p-space-4 flex flex-col gap-space-4 shadow-sm">
                            <div class="flex justify-between items-start">
                                <div class="flex gap-space-3 items-center">
                                    <div class="w-10 h-10 rounded-full bg-secondary-container text-secondary flex items-center justify-center font-bold text-[12px]">
                                        @item.Buyer.Name.Substring(0, Math.Min(2, item.Buyer.Name.Length)).ToUpper()
                                    </div>
                                    <div>
                                        <div class="font-body-md font-semibold text-on-surface">@item.Buyer.Name</div>
                                        <div class="text-[9px] text-on-surface-variant font-label-caps uppercase mt-0.5">Buyer</div>
                                    </div>
                                </div>
                                <span class="px-space-3 py-1 rounded-full text-[10px] font-label-caps uppercase border @statusBg">@item.Status</span>
                            </div>
                            <div class="grid grid-cols-2 gap-space-3">
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Establishment</div>
                                    <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface">
                                        <span class="material-symbols-outlined text-[16px] text-primary">storefront</span>
                                        @item.Establishment.Name
                                    </div>
                                </div>
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Description</div>
                                    <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface truncate max-w-[120px]">
                                        @item.Description
                                    </div>
                                </div>
                            </div>
                            <div class="flex justify-between items-end pt-space-3 border-t border-surface-border border-dashed">
                                <div>
                                    <div class="text-[10px] text-on-surface-variant uppercase mb-1">Amount</div>
                                    <div class="font-data-mono text-primary font-bold text-[16px]">₱@item.Amount.ToString("N2")</div>
                                </div>
                                <span class="font-data-mono text-on-surface-variant text-[12px]">#AUD-@item.Id</span>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>

        <div id="historical-panel" class="dashboard-tab-panel hidden" role="tabpanel">
            <div class="p-space-6 border-b border-surface-border bg-surface-container-low/40">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-space-4 mb-space-4">
                    <div>
                        <div class="flex items-center gap-space-2 text-primary mb-space-1">
                            <span class="material-symbols-outlined text-[20px]">manage_search</span>
                            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Historical Data</span>
                        </div>
                        <h2 class="font-headline-sm text-on-surface">All-Time Audit Filtering System</h2>
                    </div>
                    <span class="font-data-mono text-primary text-[13px]">@Model.Audits.Count records</span>
                </div>

                <form method="get" asp-controller="Home" asp-action="Index" class="flex flex-wrap gap-space-4 items-end">
                    <div class="flex flex-col min-w-[160px]">
                        <span class="font-label-caps text-[10px] text-on-surface-variant mb-1 ml-1 uppercase">Start Date</span>
                        <input asp-for="StartDate" class="w-full bg-surface-container-lowest border border-surface-border rounded-lg px-space-3 py-2 font-body-md text-on-surface focus:outline-none focus:border-primary/50 transition-colors cursor-pointer" type="date" />
                    </div>

                    <div class="flex flex-col min-w-[160px]">
                        <span class="font-label-caps text-[10px] text-on-surface-variant mb-1 ml-1 uppercase">End Date</span>
                        <input asp-for="EndDate" class="w-full bg-surface-container-lowest border border-surface-border rounded-lg px-space-3 py-2 font-body-md text-on-surface focus:outline-none focus:border-primary/50 transition-colors cursor-pointer" type="date" />
                    </div>

                    <div class="flex flex-col min-w-[140px]">
                        <span class="font-label-caps text-[10px] text-on-surface-variant mb-1 ml-1 uppercase">Status</span>
                        <select asp-for="Status" class="w-full bg-surface-container-lowest border border-surface-border rounded-lg px-space-3 py-2 font-body-md text-on-surface focus:outline-none focus:border-primary/50 appearance-none cursor-pointer" asp-items="ViewBag.Statuses">
                            <option value="">All Statuses</option>
                        </select>
                    </div>

                    <div class="flex flex-col min-w-[160px]">
                        <span class="font-label-caps text-[10px] text-on-surface-variant mb-1 ml-1 uppercase">Establishment</span>
                        <select asp-for="EstablishmentId" class="w-full bg-surface-container-lowest border border-surface-border rounded-lg px-space-3 py-2 font-body-md text-on-surface focus:outline-none focus:border-primary/50 appearance-none cursor-pointer" asp-items="ViewBag.Establishments">
                            <option value="">All Locations</option>
                        </select>
                    </div>

                    @if (User.IsInRole("Owner") || User.IsInRole("Manager"))
                    {
                        <div class="flex flex-col min-w-[160px]">
                            <span class="font-label-caps text-[10px] text-on-surface-variant mb-1 ml-1 uppercase">Buyer / Auditor</span>
                            <select asp-for="BuyerId" class="w-full bg-surface-container-lowest border border-surface-border rounded-lg px-space-3 py-2 font-body-md text-on-surface focus:outline-none focus:border-primary/50 appearance-none cursor-pointer" asp-items="ViewBag.Buyers">
                                <option value="">All Buyers</option>
                            </select>
                        </div>
                    }

                    <button type="submit" class="bg-primary text-on-primary px-space-6 py-2 rounded-lg font-label-caps hover:bg-primary/90 transition-all flex items-center gap-space-2 shadow-sm text-[12px] uppercase">
                        Apply <span class="material-symbols-outlined text-[18px]">done_all</span>
                    </button>
                    <button type="submit" asp-action="ExportHistorical" class="bg-audit-success text-white px-space-6 py-2 rounded-lg font-label-caps hover:brightness-110 transition-all flex items-center gap-space-2 shadow-sm text-[12px] uppercase">
                        Download Excel <span class="material-symbols-outlined text-[18px]">download</span>
                    </button>
                    <a asp-action="Index" class="bg-surface-container text-on-surface-variant border border-surface-border px-space-6 py-2 rounded-lg font-label-caps hover:bg-surface-container-high transition-all text-[12px] uppercase text-center decoration-none">
                        Clear
                    </a>
                </form>
            </div>

            <div class="hidden lg:block overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container-low border-b border-surface-border">
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">ID</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Buyer</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Establishment</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Description</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Date</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-right">Amount</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-border">
                        @if (!Model.Audits.Any())
                        {
                            <tr>
                                <td colspan="7" class="px-space-6 py-space-8 text-center text-on-surface-variant font-body-md">
                                    No audited items found matching criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Audits)
                            {
                                <tr class="historical-row hover:bg-surface-container-low/30 transition-colors group">
                                    <td class="px-space-6 py-space-4">
                                        <span class="font-data-mono text-on-surface-variant text-[13px]">#AUD-@item.Id</span>
                                    </td>
                                    <td class="px-space-6 py-space-4">
                                        <div class="flex items-center gap-space-3">
                                            <div class="w-8 h-8 rounded-full bg-secondary-container text-secondary flex items-center justify-center font-bold text-[12px]">
                                                @item.Buyer.Name.Substring(0, Math.Min(2, item.Buyer.Name.Length)).ToUpper()
                                            </div>
                                            <div>
                                                <div class="font-body-md font-semibold text-on-surface">@item.Buyer.Name</div>
                                                <div class="text-[9px] text-on-surface-variant font-label-caps uppercase">@item.Buyer.Role</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-space-6 py-space-4">
                                        <div class="flex items-center gap-space-2 text-on-surface">
                                            <span class="material-symbols-outlined text-[16px] text-primary">location_on</span>
                                            <span class="font-body-md">@item.Establishment.Name</span>
                                        </div>
                                    </td>
                                    <td class="px-space-6 py-space-4">
                                        <p class="font-body-md text-on-surface-variant truncate max-w-[240px]">@item.Description</p>
                                    </td>
                                    <td class="px-space-6 py-space-4">
                                        <span class="font-body-md text-on-surface">@item.EntryDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td class="px-space-6 py-space-4 text-right">
                                        <span class="font-data-mono text-primary font-bold">₱@item.Amount.ToString("N2")</span>
                                    </td>
                                    <td class="px-space-6 py-space-4 text-center">
                                        @{
                                            var statusBg = item.Status == AuditCkDayo.Models.AuditStatus.Approved ? "bg-audit-success/10 text-audit-success border-audit-success/20" :
                                                           (item.Status == AuditCkDayo.Models.AuditStatus.Rejected ? "bg-audit-error/10 text-audit-error border-audit-error/20" :
                                                           "bg-audit-pending/10 text-audit-pending border-audit-pending/20");
                                        }
                                        <span class="px-space-3 py-1 @statusBg rounded-full text-[10px] font-label-caps uppercase border">
                                            @item.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card Layout (Stitch Responsive Reference) -->
            <div class="block lg:hidden space-y-space-4 mt-space-4">
                @if (!Model.Audits.Any())
                {
                    <div class="text-center text-on-surface-variant font-body-md py-space-6">
                        No audited items found matching criteria.
                    </div>
                }
                else
                {
                    @foreach (var item in Model.Audits)
                    {
                        var statusBg = item.Status == AuditCkDayo.Models.AuditStatus.Approved ? "bg-audit-success/10 text-audit-success border-audit-success/20" :
                                       (item.Status == AuditCkDayo.Models.AuditStatus.Rejected ? "bg-audit-error/10 text-audit-error border-audit-error/20" :
                                       "bg-audit-pending/10 text-audit-pending border-audit-pending/20");

                        <article class="bg-surface-container-lowest border border-surface-border rounded-xl p-space-4 flex flex-col gap-space-4 shadow-sm">
                            <div class="flex justify-between items-start">
                                <div class="flex gap-space-3 items-center">
                                    <div class="w-10 h-10 rounded-full bg-secondary-container text-secondary flex items-center justify-center font-bold text-[12px]">
                                        @item.Buyer.Name.Substring(0, Math.Min(2, item.Buyer.Name.Length)).ToUpper()
                                    </div>
                                    <div>
                                        <div class="font-body-md font-semibold text-on-surface">@item.Buyer.Name</div>
                                        <div class="text-[9px] text-on-surface-variant font-label-caps uppercase mt-0.5">@item.Buyer.Role</div>
                                    </div>
                                </div>
                                <span class="px-space-3 py-1 rounded-full text-[10px] font-label-caps uppercase border @statusBg">@item.Status</span>
                            </div>
                            <div class="grid grid-cols-2 gap-space-3">
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Establishment</div>
                                    <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface">
                                        <span class="material-symbols-outlined text-[16px] text-primary">storefront</span>
                                        @item.Establishment.Name
                                    </div>
                                </div>
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Date</div>
                                    <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface">
                                        <span class="material-symbols-outlined text-[16px] text-primary">calendar_today</span>
                                        @item.EntryDate.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                            </div>
                            <div class="flex justify-between items-end pt-space-3 border-t border-surface-border border-dashed">
                                <div>
                                    <div class="text-[10px] text-on-surface-variant uppercase mb-1">Amount</div>
                                    <div class="font-data-mono text-primary font-bold text-[16px]">₱@item.Amount.ToString("N2")</div>
                                </div>
                                <div class="flex flex-col items-end">
                                    <span class="font-data-mono text-on-surface-variant text-[12px]">#AUD-@item.Id</span>
                                    <span class="text-[10px] text-on-surface-variant font-label-caps uppercase">@item.Description</span>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
    </div>
</section>

<!-- Decorative Analytics Layer (Floaters) -->
<div class="fixed bottom-space-8 right-space-8 pointer-events-none opacity-10">
    <svg class="animate-pulse" fill="none" height="160" viewbox="0 0 200 200" width="160" xmlns="http://www.w3.org/2000/svg">
        <circle class="text-primary" cx="100" cy="100" r="80" stroke="currentColor" stroke-dasharray="8 8" stroke-width="1"></circle>
        <circle class="text-primary" cx="100" cy="100" r="60" stroke="currentColor" stroke-width="0.5"></circle>
        <path class="text-primary" d="M100 40V20M100 180V160M40 100H20M180 100H160" stroke="currentColor" stroke-width="1"></path>
    </svg>
</div>

<script>
    document.querySelectorAll('.dashboard-tab-btn').forEach(button => {
        button.addEventListener('click', () => {
            const selectedTab = button.dataset.dashboardTab;

            document.querySelectorAll('.dashboard-tab-btn').forEach(tab => {
                const isSelected = tab.dataset.dashboardTab === selectedTab;
                tab.setAttribute('aria-selected', isSelected.toString());
                tab.classList.toggle('bg-transparent', !isSelected);
                tab.classList.toggle('bg-primary', isSelected);
                tab.classList.toggle('text-on-primary', isSelected);
                tab.classList.toggle('text-on-surface-variant', !isSelected);
                tab.classList.toggle('shadow-sm', isSelected);
                tab.classList.toggle('hover:text-primary', !isSelected);
                tab.classList.toggle('hover:bg-surface-container-low', !isSelected);
            });

            document.querySelectorAll('.dashboard-tab-panel').forEach(panel => {
                panel.classList.toggle('hidden', panel.id !== `${selectedTab}-panel`);
            });
        });
    });

    document.querySelectorAll('.historical-row').forEach(row => {
        row.addEventListener('click', () => {
            row.classList.toggle('bg-primary/5');
        });
    });
</script>
