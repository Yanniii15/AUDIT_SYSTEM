}

<div id="dashboardAuditViewerModal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-labelledby="dashboardAuditViewerTitle">
    <div id="dashboardAuditViewerBackdrop" class="absolute inset-0 bg-primary/80 backdrop-blur-sm"></div>
    <div class="relative z-10 h-full w-full p-space-6 flex items-center justify-center">
        <section class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-2xl w-full max-w-7xl max-h-[92vh] overflow-hidden grid grid-cols-1 lg:grid-cols-[minmax(0,1.4fr)_minmax(360px,0.6fr)]">
            <div class="bg-surface-container-highest min-h-[420px] max-h-[92vh] flex flex-col items-center justify-center gap-space-4 p-space-6 overflow-auto">
                <img id="dashboard-viewer-receipt" src="" alt="Full receipt image" class="max-w-full max-h-[78vh] object-contain rounded-lg shadow-lg bg-white" />
                <div id="dashboard-viewer-receipt-error" class="hidden max-w-md text-center text-on-primary bg-primary/90 border border-on-primary/10 rounded-xl p-space-4">
                    <p class="font-body-md text-[13px]">Receipt preview could not load here. Open the receipt image directly.</p>
                </div>
                <a id="dashboard-viewer-receipt-link" href="#" target="_blank" rel="noopener" class="inline-flex items-center gap-space-2 bg-primary text-on-primary px-space-4 py-space-2 rounded-lg font-label-caps uppercase text-[11px] hover:bg-on-primary-fixed-variant transition-colors">
                    <span class="material-symbols-outlined text-[16px]">open_in_new</span>
                    Open Receipt Image
                </a>
            </div>
            <aside class="p-space-6 overflow-y-auto max-h-[92vh] space-y-space-6">
                <div class="flex items-start justify-between gap-space-4">
                    <div>
                        <span class="font-label-caps text-on-surface-variant uppercase text-[10px]">Historical Audit</span>
                        <h2 id="dashboardAuditViewerTitle" class="font-headline-md text-headline-md text-on-surface mt-1">Audit Details</h2>
                    </div>
                    <button type="button" id="closeDashboardAuditViewerBtn" class="bg-surface-container text-on-surface-variant hover:text-error border border-surface-border rounded-lg p-2 transition-colors cursor-pointer" aria-label="Close audit viewer">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <dl class="grid grid-cols-1 gap-space-4 text-[13px]">
                    <div><dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Buyer</dt><dd id="dashboard-viewer-buyer" class="font-body-md text-on-surface"></dd></div>
                    <div><dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Establishment</dt><dd id="dashboard-viewer-establishment" class="font-body-md text-on-surface"></dd></div>
                    <div><dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Transaction Date</dt><dd id="dashboard-viewer-date" class="font-body-md text-on-surface"></dd></div>
                    <div><dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Amount</dt><dd id="dashboard-viewer-amount" class="font-data-mono text-primary text-[22px] font-bold"></dd></div>
                    <div><dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Description</dt><dd id="dashboard-viewer-description" class="font-body-md text-data-text"></dd></div>
                    <div><dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Notes</dt><dd id="dashboard-viewer-notes" class="font-body-md text-on-surface-variant"></dd></div>
                </dl>
                <div class="border-t border-surface-border pt-space-4">
                    <h3 class="font-label-caps text-on-surface-variant uppercase text-[10px] mb-space-2">Line Items</h3>
                    <div class="overflow-x-auto border border-surface-border rounded-lg">
                        <table class="w-full text-left text-[11px]">
                            <thead><tr class="border-b border-surface-border text-on-surface-variant bg-surface-container-low"><th class="px-3 py-2">Item</th><th class="px-3 py-2 text-center">Qty</th><th class="px-3 py-2 text-right">Price</th><th class="px-3 py-2 text-right">Total</th></tr></thead>
                            <tbody id="dashboard-viewer-items-body"></tbody>
                        </table>
                    </div>
                </div>
            </aside>
        </section>
    </div>
</div>

<!-- Decorative Analytics Layer (Floaters) -->
<div class="fixed bottom-space-8 right-space-8 pointer-events-none opacity-10">
    <svg class="animate-pulse" fill="none" height="160" viewbox="0 0 200 200" width="160" xmlns="http://www.w3.org/2000/svg">
        <circle class="text-primary" cx="100" cy="100" r="80" stroke="currentColor" stroke-dasharray="8 8" stroke-width="1"></circle>
        <circle class="text-primary" cx="100" cy="100" r="60" stroke="currentColor" stroke-width="0.5"></circle>
        <path class="text-primary" d="M100 40V20M100 180V160M40 100H20M180 100H160" stroke="currentColor" stroke-width="1"></path>
    </svg>
</div>

<script>
    function renderDashboardLineItems(tbody, details) {
        if (!tbody) return;
        tbody.innerHTML = '';
        if (!details || details.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center py-2 text-on-surface-variant">No items listed.</td></tr>';
            return;
        }

        details.forEach(item => {
            const tr = document.createElement('tr');
            tr.className = 'border-b border-surface-border last:border-0 text-on-surface';
            tr.innerHTML = `
                <td class="px-3 py-2">${item.name}</td>
                <td class="px-3 py-2 text-center">${item.qty}</td>
                <td class="px-3 py-2 text-right">₱${Number(item.price).toFixed(2)}</td>
                <td class="px-3 py-2 text-right">₱${Number(item.total).toFixed(2)}</td>
            `;
            tbody.appendChild(tr);
        });
    }

    function openDashboardAuditViewer(row) {
        if (!row) return;
        const details = JSON.parse(row.dataset.details || "[]");
        const receiptUrl = row.dataset.receiptUrl;
        const receipt = document.getElementById('dashboard-viewer-receipt');
        const receiptLink = document.getElementById('dashboard-viewer-receipt-link');
        const receiptError = document.getElementById('dashboard-viewer-receipt-error');

        receiptError?.classList.add('hidden');
        receipt?.classList.toggle('hidden', !receiptUrl || receiptUrl === '#');
        if (receiptUrl && receiptUrl !== '#') {
            receipt.src = receiptUrl;
        }
        receipt.onerror = function () {
            receipt.classList.add('hidden');
            receiptError?.classList.remove('hidden');
        };
        receiptLink.href = receiptUrl || '#';

        document.getElementById('dashboard-viewer-buyer').innerText = row.dataset.buyer;
        document.getElementById('dashboard-viewer-establishment').innerText = row.dataset.establishment;
        document.getElementById('dashboard-viewer-date').innerText = row.dataset.date;
        document.getElementById('dashboard-viewer-amount').innerText = row.dataset.amount;
        document.getElementById('dashboard-viewer-description').innerText = row.dataset.description;
        document.getElementById('dashboard-viewer-notes').innerText = row.dataset.notes || "None";
        renderDashboardLineItems(document.getElementById('dashboard-viewer-items-body'), details);

        document.getElementById('dashboardAuditViewerModal').classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }

    function closeDashboardAuditViewer() {
        document.getElementById('dashboardAuditViewerModal').classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    document.getElementById('closeDashboardAuditViewerBtn')?.addEventListener('click', closeDashboardAuditViewer);
    document.getElementById('dashboardAuditViewerBackdrop')?.addEventListener('click', closeDashboardAuditViewer);

    const initialDashboardTab = '@Model.ActiveTab';

    function activateDashboardTab(selectedTab) {
        document.querySelectorAll('.dashboard-tab-btn').forEach(tab => {
            const isSelected = tab.dataset.dashboardTab === selectedTab;
            tab.setAttribute('aria-selected', isSelected.toString());
            tab.classList.toggle('bg-transparent', !isSelected);
            tab.classList.toggle('bg-primary', isSelected);
            tab.classList.toggle('text-on-primary', isSelected);
            tab.classList.toggle('text-on-surface-variant', !isSelected);
            tab.classList.toggle('shadow-sm', isSelected);
            tab.classList.toggle('hover:text-primary', !isSelected);
            tab.classList.toggle('hover:bg-surface-container-low', !isSelected);
        });

        document.querySelectorAll('.dashboard-tab-panel').forEach(panel => {
            panel.classList.toggle('hidden', panel.id !== `${selectedTab}-panel`);
        });
    }

    document.querySelectorAll('.dashboard-tab-btn').forEach(button => {
        button.addEventListener('click', () => activateDashboardTab(button.dataset.dashboardTab));
    });

    activateDashboardTab(initialDashboardTab === 'historical' ? 'historical' : 'overview');

    document.querySelectorAll('.historical-row').forEach(row => {
        row.addEventListener('click', () => {
            row.classList.toggle('bg-primary/5');
        });
    });
</script>
