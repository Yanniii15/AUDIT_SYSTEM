                                                        Void
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                            @foreach (var report in Model.HistoricalSalesReports)
                            {
                                var salesStatusBg = report.Status == AuditCkDayo.Models.SalesReportStatus.Confirmed ? "bg-audit-success/10 text-audit-success border-audit-success/20" :
                                                    (report.Status == AuditCkDayo.Models.SalesReportStatus.Rejected ? "bg-audit-error/10 text-audit-error border-audit-error/20" :
