                                <div class="flex flex-col items-end gap-space-2">
                                    <span class="font-data-mono text-on-surface-variant text-[12px]">#DSR-@report.Id</span>
                                    <a asp-controller="SalesReports" asp-action="Review" asp-route-id="@report.Id" class="border border-primary/20 text-primary px-space-4 py-2 rounded-lg font-label-caps text-[11px] uppercase tracking-wider hover:bg-primary hover:text-on-primary transition-all">
                                        Review
                                    </a>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
    </div>
</section>

@if (Model.CashOnHandUsers.Any())
{
    <section class="pb-space-8">
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border/50 overflow-hidden">
            <div class="px-space-6 py-space-4 border-b border-surface-border flex items-center justify-between">
                <div>
                    <span class="font-label-caps uppercase tracking-widest text-on-surface-variant text-[10px]">Cash on Hand</span>
                    <h2 class="font-headline-sm text-on-surface">Current PCF Balances</h2>
                </div>
                <span class="font-data-mono text-primary text-[13px]">₱@cashOnHandTotal.ToString("N2")</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-space-4 p-space-6 max-h-[520px] overflow-y-auto">
                @foreach (var cashUser in Model.CashOnHandUsers)
                {
                    <article class="border border-surface-border rounded-xl p-space-4 bg-surface-container-low">
                        <div class="flex items-start justify-between gap-space-3">
                            <div>
                                <p class="font-body-md font-semibold text-on-surface">@cashUser.Name</p>
