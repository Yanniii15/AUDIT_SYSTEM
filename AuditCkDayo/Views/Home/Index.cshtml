                                </div>
                            </div>
                            <div class="flex justify-between items-end pt-space-3 border-t border-surface-border border-dashed">
                                <div>
                                    <div class="text-[10px] text-on-surface-variant uppercase mb-1">Gross Sales</div>
                                    <div class="font-data-mono text-primary font-bold text-[16px]">₱@report.GrossSales.ToString("N2")</div>
