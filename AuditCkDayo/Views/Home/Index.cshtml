@model AuditCkDayo.ViewModels.DashboardViewModel
@inject AuditCkDayo.Data.AuditDbContext db
@{
    ViewData["Title"] = "Financial Oversight";
    var currentUser = (AuditCkDayo.Models.User)ViewBag.CurrentUser;
    var isBranchStaff = currentUser.Role == AuditCkDayo.Models.UserRole.BranchStaff;
    var sharedEst = isBranchStaff && currentUser.EstablishmentId.HasValue ? db.Establishments.Find(currentUser.EstablishmentId.Value) : null;
    var displayStartingPcf = sharedEst != null ? sharedEst.DailyStartingFloat : currentUser.DailyStartingFloat;
    var displayCurrentPcf = sharedEst != null ? sharedEst.PcfBalance : currentUser.PcfBalance;
    var cashOnHandTotal = Model.CashOnHandUsers.Where(u => u.Role == AuditCkDayo.Models.UserRole.BranchStaff && u.EstablishmentId.HasValue).Select(u => u.Establishment!.PcfBalance).Distinct().Sum()
        + Model.CashOnHandUsers.Where(u => !(u.Role == AuditCkDayo.Models.UserRole.BranchStaff && u.EstablishmentId.HasValue)).Sum(u => u.PcfBalance);
    var pendingCount = Model.Audits.Count(a => a.Status == AuditCkDayo.Models.AuditStatus.AwaitingBranchVerification || a.Status == AuditCkDayo.Models.AuditStatus.AwaitingManagerApproval);
    
    var userIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    int userId = 0;
    int pendingAuditsVoiceCount = 0;
    int pendingSurrendersVoiceCount = 0;
    if (int.TryParse(userIdStr, out userId))
    {
        if (userRole == "Manager")
        {
            pendingAuditsVoiceCount = db.AuditItems.Count(a => a.Status == AuditCkDayo.Models.AuditStatus.AwaitingManagerApproval && (a.AssignedReviewerId == userId || a.Buyer.ManagerId == userId));
            pendingSurrendersVoiceCount = db.SurrenderRequests.Count(s => s.Status == AuditCkDayo.Models.SurrenderStatus.Pending && (s.AssignedReceiverId == userId || s.Buyer.ManagerId == userId));
        }
        else
        {
            pendingAuditsVoiceCount = db.AuditItems.Count(a => a.Status == AuditCkDayo.Models.AuditStatus.AwaitingManagerApproval);
            pendingSurrendersVoiceCount = db.SurrenderRequests.Count(s => s.Status == AuditCkDayo.Models.SurrenderStatus.Pending);
        }
    }
}

<div id="pageVoiceSummary" class="sr-only">
    Dashboard. Role: @(userRole).
    Pending daily sales reports count: @(Model.PendingSalesReports?.Count() ?? 0).
    Pending audit approvals: @pendingAuditsVoiceCount.
    Pending cash surrenders: @pendingSurrendersVoiceCount.
</div>

<!-- Status & Summary Bar: Asymmetric Bento Grid -->
<section class="grid grid-cols-12 gap-space-6 items-end">
    <div class="col-span-12 lg:col-span-4 space-y-space-4">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">analytics</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Performance Snapshot</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Financial Oversight</h1>
        <p class="font-body-md text-on-surface-variant max-w-md">
            Real-time reconciliation of Petty Cash Fund expenditures across all regional establishments.
        </p>
    </div>
    
    <div class="col-span-12 lg:col-span-8 grid grid-cols-1 md:grid-cols-2 gap-space-4">
        
        <!-- Starting PCF -->
        <div class="relative overflow-hidden bg-surface-container-lowest p-space-6 rounded-xl shadow-sm group hover:shadow-md transition-all duration-300 border border-surface-border">
            <div class="absolute top-0 right-0 p-space-4 opacity-10 group-hover:opacity-20 transition-opacity">
                <span class="material-symbols-outlined text-[64px]">savings</span>
            </div>
            <div class="relative z-10">
                <span class="font-label-caps text-on-surface-variant uppercase text-[10px]">Branch Starting PCF</span>
                <div class="flex items-baseline gap-space-2 mt-space-2">
                    <span class="font-headline-lg text-headline-lg text-on-surface">₱@displayStartingPcf.ToString("N2")</span>
                </div>
                <div class="mt-space-4 flex gap-space-1">
                    <div class="h-1 flex-1 bg-primary rounded-full"></div>
                    <div class="h-1 flex-1 bg-primary/30 rounded-full"></div>
                    <div class="h-1 flex-1 bg-primary/30 rounded-full"></div>
                </div>
            </div>
        </div>
        
        <!-- Current PCF -->
        <div class="relative overflow-hidden bg-primary p-space-6 rounded-xl shadow-sm group hover:shadow-md transition-all duration-300">
            <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-on-primary/5 rounded-full blur-3xl group-hover:scale-150 transition-transform duration-700"></div>
            <div class="relative z-10">
                <span class="font-label-caps text-primary-fixed-dim uppercase text-[10px]">Branch Current PCF</span>
                <div class="flex items-baseline gap-space-2 mt-space-2">
                    <span class="font-headline-lg text-headline-lg text-on-primary">₱@displayCurrentPcf.ToString("N2")</span>
                </div>
                <button onclick="location.reload()" class="mt-space-4 flex items-center gap-space-2 text-[10px] text-label-caps text-on-primary bg-on-primary/10 px-space-3 py-space-1 rounded-full hover:bg-on-primary/20 transition-colors">
                    REFRESH POOL <span class="material-symbols-outlined text-[14px]">sync</span>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- Dashboard Role Tabs -->
<section class="pb-space-8">
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border/50 overflow-hidden">
        <div class="px-space-5 py-space-3 border-b border-surface-border bg-surface-container-low/40">
            <div class="ml-6 inline-flex items-center gap-1 bg-surface-container p-1 rounded-xl border border-surface-border" role="tablist" aria-label="Dashboard sections">
                <button type="button"
                        class="dashboard-tab-btn px-space-4 py-2.5 rounded-lg whitespace-nowrap text-center font-label-caps uppercase tracking-widest text-[10px] transition-all bg-primary text-on-primary shadow-sm"
                        data-dashboard-tab="overview"
                        aria-controls="overview-panel"
                        aria-selected="true">
                    Overview
                </button>
                <button type="button"
                        class="dashboard-tab-btn px-space-4 py-2.5 rounded-lg whitespace-nowrap text-center font-label-caps uppercase tracking-widest text-[10px] transition-all bg-transparent text-on-surface-variant hover:text-primary hover:bg-surface-container-low"
                        data-dashboard-tab="historical"
                        aria-controls="historical-panel"
                        aria-selected="false">
                    Historical Data
                </button>
            </div>
        </div>

        <div id="overview-panel" class="dashboard-tab-panel p-space-6" role="tabpanel">
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-space-4 mb-space-4">
                <div>
                    <div class="flex items-center gap-space-2 text-primary mb-space-1">
                        <span class="material-symbols-outlined text-[20px]">today</span>
                        <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Overview</span>
                    </div>
                    <h2 class="font-headline-sm text-on-surface">Audits Today</h2>
                </div>
                <span class="font-data-mono text-primary text-[13px]">@Model.TodayAudits.Count records</span>
            </div>

            <div class="hidden lg:block max-h-[520px] overflow-y-auto overflow-x-auto rounded-xl border border-surface-border">
                <table class="w-full text-left border-collapse">
                    <thead class="sticky top-0 z-10">
                        <tr class="bg-surface-container-low border-b border-surface-border">
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">ID</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Buyer</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Establishment</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Description</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-right">Amount</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-center">Status</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-border">
                        @if (!Model.TodayAudits.Any())
                        {
                            <tr>
                                <td colspan="7" class="px-space-6 py-space-8 text-center text-on-surface-variant font-body-md">
                                    No audits submitted today.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.TodayAudits)
                            {
                                var statusBg = item.Status == AuditCkDayo.Models.AuditStatus.Approved ? "bg-audit-success/10 text-audit-success border-audit-success/20" :
                                               (item.Status == AuditCkDayo.Models.AuditStatus.Rejected ? "bg-audit-error/10 text-audit-error border-audit-error/20" :
                                               "bg-audit-pending/10 text-audit-pending border-audit-pending/20");
                                var isPending = item.Status == AuditCkDayo.Models.AuditStatus.AwaitingBranchVerification || item.Status == AuditCkDayo.Models.AuditStatus.AwaitingManagerApproval || item.Status == AuditCkDayo.Models.AuditStatus.Pending;
                                var canCorrect = isPending && item.BuyerId == currentUser.Id;


                                <tr class="hover:bg-surface-container-low/30 transition-colors">
                                    <td class="px-space-6 py-space-4"><span class="font-data-mono text-on-surface-variant text-[13px]">#AUD-@item.Id</span></td>
                                    <td class="px-space-6 py-space-4"><span class="font-body-md font-semibold text-on-surface">@item.Buyer.Name</span></td>
                                    <td class="px-space-6 py-space-4"><span class="font-body-md text-on-surface">@item.Establishment.Name</span></td>
                                    <td class="px-space-6 py-space-4"><p class="font-body-md text-on-surface-variant truncate max-w-[280px]">@item.Description</p></td>
                                    <td class="px-space-6 py-space-4 text-right"><span class="font-data-mono text-primary font-bold">₱@item.Amount.ToString("N2")</span></td>
                                    <td class="px-space-6 py-space-4 text-center"><span class="px-space-3 py-1 @statusBg rounded-full text-[10px] font-label-caps uppercase border">@item.Status</span></td>
                                    <td class="px-space-6 py-space-4">
                                        @if (canCorrect)
                                        {
                                            <div class="flex justify-end gap-space-2">
                                                <a asp-controller="Audits" asp-action="Edit" asp-route-id="@item.Id" class="px-space-3 py-1.5 rounded-lg border border-primary/20 text-primary font-label-caps text-[10px] uppercase hover:bg-primary hover:text-on-primary transition-colors">
                                                    Edit
                                                </a>
                                                <form asp-controller="Audits" asp-action="Void" method="post" onsubmit="return confirm('Void this pending audit and refund your PCF balance?');">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="px-space-3 py-1.5 rounded-lg border border-error/20 text-error font-label-caps text-[10px] uppercase hover:bg-error hover:text-on-primary transition-colors">
                                                        Void
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card Layout (Stitch Responsive Reference) -->
            <div class="block lg:hidden space-y-space-4 mt-space-4 max-h-[520px] overflow-y-auto">
                @if (!Model.TodayAudits.Any())
                {
                    <div class="text-center text-on-surface-variant font-body-md py-space-6">
                        No audits submitted today.
                    </div>
                }
                else
                {
                    @foreach (var item in Model.TodayAudits)
                    {
                        var statusBg = item.Status == AuditCkDayo.Models.AuditStatus.Approved ? "bg-audit-success/10 text-audit-success border-audit-success/20" :
                                       (item.Status == AuditCkDayo.Models.AuditStatus.Rejected ? "bg-audit-error/10 text-audit-error border-audit-error/20" :
                                       "bg-audit-pending/10 text-audit-pending border-audit-pending/20");
                        var isPending = item.Status == AuditCkDayo.Models.AuditStatus.AwaitingBranchVerification || item.Status == AuditCkDayo.Models.AuditStatus.AwaitingManagerApproval || item.Status == AuditCkDayo.Models.AuditStatus.Pending;
                        var canCorrect = isPending && item.BuyerId == currentUser.Id;


                        <article class="bg-surface-container-lowest border border-surface-border rounded-xl p-space-4 flex flex-col gap-space-4 shadow-sm">
                            <div class="flex justify-between items-start">
                                <div class="flex gap-space-3 items-center">
                                    <div class="w-10 h-10 rounded-full bg-secondary-container text-secondary flex items-center justify-center font-bold text-[12px]">
                                        @item.Buyer.Name.Substring(0, Math.Min(2, item.Buyer.Name.Length)).ToUpper()
                                    </div>
                                    <div>
                                        <div class="font-body-md font-semibold text-on-surface">@item.Buyer.Name</div>
                                        <div class="text-[9px] text-on-surface-variant font-label-caps uppercase mt-0.5">Buyer</div>
                                    </div>
                                </div>
                                <span class="px-space-3 py-1 rounded-full text-[10px] font-label-caps uppercase border @statusBg">@item.Status</span>
                            </div>
                            <div class="grid grid-cols-2 gap-space-3">
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Establishment</div>
                                    <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface">
                                        <span class="material-symbols-outlined text-[16px] text-primary">storefront</span>
                                        @item.Establishment.Name
                                    </div>
                                </div>
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Description</div>
                                    <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface truncate max-w-[120px]">
                                        @item.Description
                                    </div>
                                </div>
                            </div>
                            <div class="flex justify-between items-end pt-space-3 border-t border-surface-border border-dashed">
                                <div>
                                    <div class="text-[10px] text-on-surface-variant uppercase mb-1">Amount</div>
                                    <div class="font-data-mono text-primary font-bold text-[16px]">₱@item.Amount.ToString("N2")</div>
                                </div>
                                <span class="font-data-mono text-on-surface-variant text-[12px]">#AUD-@item.Id</span>
                            </div>
                            @if (canCorrect)
                            {
                                <div class="flex flex-wrap justify-end gap-space-2">
                                    <a asp-controller="Audits" asp-action="Edit" asp-route-id="@item.Id" class="border border-primary/20 text-primary px-space-4 py-2 rounded-lg font-label-caps text-[11px] uppercase tracking-wider hover:bg-primary hover:text-on-primary transition-all">
                                        Edit
                                    </a>
                                    <form asp-controller="Audits" asp-action="Void" method="post" onsubmit="return confirm('Void this pending audit and refund your PCF balance?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="border border-error/20 text-error px-space-4 py-2 rounded-lg font-label-caps text-[11px] uppercase tracking-wider hover:bg-error hover:text-on-primary transition-all">
                                            Void
                                        </button>
                                    </form>
                                </div>
                            }
                        </article>
                    }
                }
            </div>

            <div class="mt-space-8 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-space-4 mb-space-4">
                <div>
                    <div class="flex items-center gap-space-2 text-primary mb-space-1">
                        <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                        <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Daily Sales Queue</span>
                    </div>
                    <h2 class="font-headline-sm text-on-surface">Pending Daily Sales Reports</h2>
                </div>
                <div class="flex flex-wrap gap-space-3 font-data-mono text-[13px]">
                    <span class="text-primary">@Model.PendingSalesReports.Count records</span>
                    <span class="text-on-surface-variant">Sales ₱@Model.PendingSalesGrossTotal.ToString("N2")</span>
                    <span class="text-on-surface-variant">Cash ₱@Model.PendingSalesCashToHandoverTotal.ToString("N2")</span>
                </div>
            </div>

            <div class="hidden lg:block max-h-[420px] overflow-y-auto overflow-x-auto rounded-xl border border-surface-border">
                <table class="w-full text-left border-collapse">
                    <thead class="sticky top-0 z-10">
                        <tr class="bg-surface-container-low border-b border-surface-border">
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">ID</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Date</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Branch</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Cashier</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-right">Gross Sales</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-right">Cash to Handover</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-center">Status</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-border">
                        @if (!Model.PendingSalesReports.Any())
                        {
                            <tr>
                                <td colspan="8" class="px-space-6 py-space-8 text-center text-on-surface-variant font-body-md">
                                    No pending daily sales reports.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var report in Model.PendingSalesReports)
                            {
                                <tr class="hover:bg-surface-container-low/30 transition-colors">
                                    <td class="px-space-6 py-space-4"><span class="font-data-mono text-on-surface-variant text-[13px]">#DSR-@report.Id</span></td>
                                    <td class="px-space-6 py-space-4"><span class="font-body-md text-on-surface">@report.BusinessDate.ToString("MMM dd, yyyy")</span></td>
                                    <td class="px-space-6 py-space-4"><span class="font-body-md font-semibold text-on-surface">@report.Establishment.Name</span></td>
                                    <td class="px-space-6 py-space-4"><span class="font-body-md text-on-surface-variant">@(string.IsNullOrWhiteSpace(report.CashierName) ? "—" : report.CashierName)</span></td>
                                    <td class="px-space-6 py-space-4 text-right"><span class="font-data-mono text-primary font-bold">₱@report.GrossSales.ToString("N2")</span></td>
                                    <td class="px-space-6 py-space-4 text-right"><span class="font-data-mono text-on-surface">₱@report.ConfirmedCashToHandover.ToString("N2")</span></td>
                                    <td class="px-space-6 py-space-4 text-center">
                                        <span class="px-space-3 py-1 bg-audit-pending/10 text-audit-pending border-audit-pending/20 rounded-full text-[10px] font-label-caps uppercase border">Pending Manager Verification</span>
                                    </td>
                                    <td class="px-space-6 py-space-4 text-right">
                                        <a asp-controller="SalesReports" asp-action="Review" asp-route-id="@report.Id" class="px-space-3 py-1.5 rounded-lg border border-primary/20 text-primary font-label-caps text-[10px] uppercase hover:bg-primary hover:text-on-primary transition-colors">
                                            Review
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="block lg:hidden space-y-space-4 mt-space-4 max-h-[420px] overflow-y-auto">
                @if (!Model.PendingSalesReports.Any())
                {
                    <div class="text-center text-on-surface-variant font-body-md py-space-6">
                        No pending daily sales reports.
                    </div>
                }
                else
                {
                    @foreach (var report in Model.PendingSalesReports)
                    {
                        <article class="bg-surface-container-lowest border border-surface-border rounded-xl p-space-4 flex flex-col gap-space-4 shadow-sm">
                            <div class="flex justify-between items-start">
                                <div>
                                    <div class="font-body-md font-semibold text-on-surface">@report.Establishment.Name</div>
                                    <div class="text-[9px] text-on-surface-variant font-label-caps uppercase mt-0.5">@report.BusinessDate.ToString("MMM dd, yyyy")</div>
                                </div>
                                <span class="px-space-3 py-1 rounded-full text-[10px] font-label-caps uppercase border bg-audit-pending/10 text-audit-pending border-audit-pending/20">Pending</span>
                            </div>
                            <div class="grid grid-cols-2 gap-space-3">
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Gross Sales</div>
                                    <div class="font-data-mono text-primary font-bold">₱@report.GrossSales.ToString("N2")</div>
                                </div>
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Cash Handover</div>
                                    <div class="font-data-mono text-on-surface">₱@report.ConfirmedCashToHandover.ToString("N2")</div>
                                </div>
                            </div>
                            <div class="flex justify-between items-center pt-space-3 border-t border-surface-border border-dashed">
                                <span class="font-data-mono text-on-surface-variant text-[12px]">#DSR-@report.Id</span>
                                <a asp-controller="SalesReports" asp-action="Review" asp-route-id="@report.Id" class="border border-primary/20 text-primary px-space-4 py-2 rounded-lg font-label-caps text-[11px] uppercase tracking-wider hover:bg-primary hover:text-on-primary transition-all">
                                    Review
                                </a>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>

        <div id="historical-panel" class="dashboard-tab-panel hidden" role="tabpanel">
            <div class="p-space-6 border-b border-surface-border bg-surface-container-low/40">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-space-4 mb-space-4">
                    <div>
                        <div class="flex items-center gap-space-2 text-primary mb-space-1">
                            <span class="material-symbols-outlined text-[20px]">manage_search</span>
                            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Historical Data</span>
                        </div>
                        <h2 class="font-headline-sm text-on-surface">All-Time Audit & Daily Sales Filtering System</h2>
                    </div>
                    <span class="font-data-mono text-primary text-[13px]">@(Model.Audits.Count + Model.HistoricalSalesReports.Count) records</span>
                </div>

                <form method="get" asp-controller="Home" asp-action="Index" class="flex flex-wrap gap-space-4 items-end">
                    <input type="hidden" name="ActiveTab" value="historical" />
                    <div class="flex flex-col min-w-[160px]">
                        <span class="font-label-caps text-[10px] text-on-surface-variant mb-1 ml-1 uppercase">Start Date</span>
                        <input asp-for="StartDate" class="w-full bg-surface-container-lowest border border-surface-border rounded-lg px-space-3 py-2 font-body-md text-on-surface focus:outline-none focus:border-primary/50 transition-colors cursor-pointer" type="date" />
                    </div>

                    <div class="flex flex-col min-w-[160px]">
                        <span class="font-label-caps text-[10px] text-on-surface-variant mb-1 ml-1 uppercase">End Date</span>
                        <input asp-for="EndDate" class="w-full bg-surface-container-lowest border border-surface-border rounded-lg px-space-3 py-2 font-body-md text-on-surface focus:outline-none focus:border-primary/50 transition-colors cursor-pointer" type="date" />
                    </div>

                    <div class="flex flex-col min-w-[140px]">
                        <span class="font-label-caps text-[10px] text-on-surface-variant mb-1 ml-1 uppercase">Status</span>
                        <select asp-for="Status" class="w-full bg-surface-container-lowest border border-surface-border rounded-lg px-space-3 py-2 font-body-md text-on-surface focus:outline-none focus:border-primary/50 appearance-none cursor-pointer" asp-items="ViewBag.Statuses">
