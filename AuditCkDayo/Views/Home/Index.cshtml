                            </div>
                            <span class="font-data-mono text-primary font-bold">₱@((cashUser.Role == AuditCkDayo.Models.UserRole.BranchStaff && cashUser.Establishment != null) ? cashUser.Establishment.PcfBalance : cashUser.PcfBalance).ToString("N2")</span>
