                            <div class="grid grid-cols-2 gap-space-3">
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Establishment</div>
                                    <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface">
                                        <span class="material-symbols-outlined text-[16px] text-primary">storefront</span>
