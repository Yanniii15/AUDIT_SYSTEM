                                    <td class="px-space-6 py-space-4">
                                        <div class="flex items-center gap-space-3">
                                            <div class="w-8 h-8 rounded-full bg-tertiary-container text-tertiary flex items-center justify-center font-bold text-[12px]">
                                                @((string.IsNullOrWhiteSpace(report.CashierName) ? "DS" : report.CashierName).Substring(0, Math.Min(2, string.IsNullOrWhiteSpace(report.CashierName) ? 2 : report.CashierName.Length)).ToUpper())
                                            </div>
                                            <div>
                                                <div class="font-body-md font-semibold text-on-surface">@(string.IsNullOrWhiteSpace(report.CashierName) ? "Daily Sales" : report.CashierName)</div>
                                                <div class="text-[9px] text-on-surface-variant font-label-caps uppercase">Cashier</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-space-6 py-space-4">
                                        <div class="flex items-center gap-space-2 text-on-surface">
                                            <span class="material-symbols-outlined text-[16px] text-primary">location_on</span>
                                            <span class="font-body-md">@report.Establishment.Name</span>
                                        </div>
                                    </td>
                                    <td class="px-space-6 py-space-4">
                                        <p class="font-body-md text-on-surface-variant truncate max-w-[240px]">Daily Sales Report</p>
                                    </td>
                                    <td class="px-space-6 py-space-4">
                                        <span class="font-body-md text-on-surface">@report.BusinessDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td class="px-space-6 py-space-4 text-right">
                                        <span class="font-data-mono text-primary font-bold">₱@report.GrossSales.ToString("N2")</span>
                                    </td>
                                    <td class="px-space-6 py-space-4 text-center">
                                        <span class="px-space-3 py-1 @salesStatusBg rounded-full text-[10px] font-label-caps uppercase border">@report.Status</span>
                                    </td>
                                    <td class="px-space-6 py-space-4 text-right">
                                        <a asp-controller="SalesReports" asp-action="Review" asp-route-id="@report.Id" class="px-space-3 py-1.5 rounded-lg border border-primary/20 text-primary font-label-caps text-[10px] uppercase hover:bg-primary hover:text-on-primary transition-colors">
                                            Review
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card Layout (Stitch Responsive Reference) -->
            <div class="block lg:hidden space-y-space-4 mt-space-4 max-h-[520px] overflow-y-auto">
                @if (!Model.Audits.Any() && !Model.HistoricalSalesReports.Any())
                {
                    <div class="text-center text-on-surface-variant font-body-md py-space-6">
                        No audits or daily sales reports found matching criteria.
                    </div>
                }
                else
                {
                    @foreach (var item in Model.Audits)
                    {
                        var statusBg = item.Status == AuditCkDayo.Models.AuditStatus.Approved ? "bg-audit-success/10 text-audit-success border-audit-success/20" :
                                       (item.Status == AuditCkDayo.Models.AuditStatus.Rejected ? "bg-audit-error/10 text-audit-error border-audit-error/20" :
                                       "bg-audit-pending/10 text-audit-pending border-audit-pending/20");
                        var isPending = item.Status == AuditCkDayo.Models.AuditStatus.AwaitingBranchVerification || item.Status == AuditCkDayo.Models.AuditStatus.AwaitingManagerApproval || item.Status == AuditCkDayo.Models.AuditStatus.Pending;
                        var canCorrect = isPending && item.BuyerId == currentUser.Id;


                        <article class="historical-row bg-surface-container-lowest border border-surface-border rounded-xl p-space-4 flex flex-col gap-space-4 shadow-sm cursor-pointer hover:bg-surface-container-low/30 transition-colors"
