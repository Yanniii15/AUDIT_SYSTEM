<body class="bg-background font-body-md text-on-surface">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Sidebar Navigation -->
        <aside id="sidebarNav" class="fixed left-0 top-0 h-full w-72 bg-primary z-50 flex flex-col transition-transform duration-300 -translate-x-full lg:translate-x-0">
            <div class="h-16 flex items-center justify-between px-space-6 lg:px-space-8 border-b border-on-primary/10">
                <span class="text-headline-sm font-headline-sm text-on-primary tracking-tight">AuditCkDayo</span>
                <button type="button" id="sidebarCloseBtn" class="flex lg:hidden p-2 text-primary-fixed-dim/70 hover:text-on-primary transition-colors focus:outline-none bg-transparent border-0 items-center justify-center cursor-pointer" aria-label="Close Navigation">
                    <span class="material-symbols-outlined text-[24px]">close</span>
                </button>
            </div>
            
            <nav class="flex-1 py-space-6 px-space-4 space-y-space-1">
                <!-- Shared Dashboard Link -->
