                    </a>
                    
                    <a class="flex items-center px-space-4 py-space-3 rounded-xl transition-all group hover:bg-on-primary/5 text-primary-fixed-dim/70 hover:text-on-primary justify-between" 
                       asp-controller="Audits" asp-action="SurrenderQueue">
                        <div class="flex items-center">
                            <span class="material-symbols-outlined mr-space-3">payments</span>
                            <span class="font-label-caps uppercase">Cash Surrender Requests</span>
                        </div>
                        @if (pendingSurrendersCount > 0)
                        {
                            <span class="badge bg-danger ml-auto bg-red-600 text-white text-[11px] font-bold px-2 py-0.5 rounded-full">@pendingSurrendersCount</span>
                        }
                    </a>
                    
                    <a class="flex items-center px-space-4 py-space-3 rounded-xl transition-all group hover:bg-on-primary/5 text-primary-fixed-dim/70 hover:text-on-primary" 
                       asp-controller="Users" asp-action="Index">
                        <span class="material-symbols-outlined mr-space-3">account_balance</span>
                        <span class="font-label-caps uppercase">Vault Cash Control</span>
                    </a>
                    
                    <a class="flex items-center px-space-4 py-space-3 rounded-xl transition-all group hover:bg-on-primary/5 text-primary-fixed-dim/70 hover:text-on-primary" 
                       asp-controller="Reports" asp-action="Index">
                        <span class="material-symbols-outlined mr-space-3">assessment</span>
                        <span class="font-label-caps uppercase">Reports</span>
                    </a>

                }

                @if (User.IsInRole("Admin"))
                {
                    <a class="flex items-center px-space-4 py-space-3 rounded-xl transition-all group hover:bg-on-primary/5 text-primary-fixed-dim/70 hover:text-on-primary" 
                       asp-controller="Account" asp-action="Register">
                        <span class="material-symbols-outlined mr-space-3">group</span>
                        <span class="font-label-caps uppercase">Users Directory</span>
                    </a>
                    <a class="flex items-center px-space-4 py-space-3 rounded-xl transition-all group hover:bg-on-primary/5 text-primary-fixed-dim/70 hover:text-on-primary" 
                       asp-controller="Establishments" asp-action="Index">
                        <span class="material-symbols-outlined mr-space-3">storefront</span>
                        <span class="font-label-caps uppercase">Establishments</span>
                    </a>
                    
                    <a class="flex items-center px-space-4 py-space-3 rounded-xl transition-all group hover:bg-on-primary/5 text-primary-fixed-dim/70 hover:text-on-primary" 
                       href="#">
                        <span class="material-symbols-outlined mr-space-3">settings</span>
                        <span class="font-label-caps uppercase">System Settings</span>
                    </a>
                }

                @if (User.IsInRole("BranchStaff"))
                {
                    <a class="flex items-center px-space-4 py-space-3 rounded-xl transition-all group hover:bg-on-primary/5 text-primary-fixed-dim/70 hover:text-on-primary justify-between" 
                       asp-controller="Audits" asp-action="BranchVerifyList">
                        <div class="flex items-center">
                            <span class="material-symbols-outlined mr-space-3">local_shipping</span>
                            <span class="font-label-caps uppercase">Verify Deliveries</span>
                        </div>
                        @if (pendingBranchVerificationsCount > 0)
                        {
                            <span class="badge bg-danger ml-auto bg-red-600 text-white text-[11px] font-bold px-2 py-0.5 rounded-full">@pendingBranchVerificationsCount</span>
                        }
                    </a>
                    
                    <a class="flex items-center px-space-4 py-space-3 rounded-xl transition-all group hover:bg-on-primary/5 text-primary-fixed-dim/70 hover:text-on-primary" 
                       asp-controller="Reports" asp-action="Index">
                        <span class="material-symbols-outlined mr-space-3">assessment</span>
                        <span class="font-label-caps uppercase">Reports</span>
                    </a>
                }
            </nav>
            
            <div class="px-space-6 py-space-4 border-t border-on-primary/10 flex items-center justify-between gap-space-3 lg:hidden">
                <div class="flex items-center gap-space-3 min-w-0">
                    <div class="w-10 h-10 rounded-full bg-on-primary/10 text-on-primary flex items-center justify-center flex-shrink-0">
                        <span class="material-symbols-outlined text-[20px]">person</span>
                    </div>
                    <div class="flex flex-col min-w-0">
                        <span class="text-body-md font-semibold text-on-primary truncate">@User.Identity.Name</span>
                        <span class="text-label-caps text-primary-fixed-dim/70 text-[10px] uppercase">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                    </div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="flex-none">
                    <button type="submit" class="material-symbols-outlined text-primary-fixed-dim/70 hover:text-on-primary transition-colors bg-transparent border-0 p-2 flex items-center justify-center cursor-pointer" title="Logout">
                        logout
                    </button>
                </form>
            </div>

            <div class="p-space-6 border-t border-on-primary/10">
                <div class="flex items-center gap-space-3 text-primary-fixed-dim/50 text-label-caps">
                    <span class="material-symbols-outlined text-[16px]">verified_user</span>
                    <span>SYSTEM ENFORCED</span>
                </div>
