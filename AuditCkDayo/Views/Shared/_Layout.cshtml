@using Microsoft.EntityFrameworkCore
@inject AuditCkDayo.Data.AuditDbContext dbContext
@{
    var userIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    AuditCkDayo.Models.User dbUser = null;
    int userId = 0;
    if (User.Identity?.IsAuthenticated == true && !string.IsNullOrEmpty(userIdStr) && int.TryParse(userIdStr, out userId))
    {
        dbUser = dbContext.Users.AsNoTracking().FirstOrDefault(u => u.Id == userId && !u.IsDeleted);
    }

    int pendingAuditsCount = 0;
    int pendingSurrendersCount = 0;
    int pendingBranchVerificationsCount = 0;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var isHomeActive = currentController == "Home";
    var isAuditsActive = currentController == "Audits";
    var isReportsActive = currentController == "Reports";

    if (dbUser != null)
    {
        if (userRole == "Manager")
        {
            pendingAuditsCount = dbContext.AuditItems.Count(a => a.Status == AuditCkDayo.Models.AuditStatus.AwaitingManagerApproval && a.Buyer.ManagerId == userId);
            pendingSurrendersCount = dbContext.SurrenderRequests.Count(s => s.Status == AuditCkDayo.Models.SurrenderStatus.Pending && s.Buyer.ManagerId == userId);
        }
        else if (userRole == "Owner")
        {
            pendingAuditsCount = dbContext.AuditItems.Count(a => a.Status == AuditCkDayo.Models.AuditStatus.AwaitingManagerApproval);
            pendingSurrendersCount = dbContext.SurrenderRequests.Count(s => s.Status == AuditCkDayo.Models.SurrenderStatus.Pending);
        }
        else if (userRole == "BranchStaff" && dbUser.EstablishmentId.HasValue)
        {
            pendingBranchVerificationsCount = dbContext.AuditItems.Count(a => a.Status == AuditCkDayo.Models.AuditStatus.AwaitingBranchVerification && a.EstablishmentId == dbUser.EstablishmentId);
        }
    }
}
<!DOCTYPE html>
