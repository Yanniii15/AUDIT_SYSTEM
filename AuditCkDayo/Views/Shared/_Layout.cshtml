        <div id="sidebarBackdrop" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden"></div>

        <div class="pl-0 lg:pl-72">
            <!-- Top Header -->
            <header class="fixed top-0 left-0 lg:left-72 right-0 h-16 bg-surface-container-lowest/80 backdrop-blur-xl border-b border-surface-border z-40 flex items-center justify-between px-space-4 lg:px-space-8">
                <div class="flex items-center gap-space-2 lg:gap-space-4">
                    <button type="button" id="sidebarToggleBtn" class="flex lg:hidden p-2 text-on-surface-variant hover:text-primary transition-colors focus:outline-none bg-transparent border-0 items-center justify-center cursor-pointer" aria-label="Toggle Navigation">
                        <span class="material-symbols-outlined text-[24px]">menu</span>
                    </button>
                    <div class="h-8 w-[2px] bg-surface-border hidden lg:block"></div>
                    <span class="text-label-caps text-on-surface-variant font-medium uppercase tracking-widest text-[11px] lg:text-[12px] truncate max-w-[150px] sm:max-w-none">PCF Auditing Suite</span>
                </div>
                <div class="flex items-center gap-space-6">
                    <!-- Notification Bell Dropdown -->
                    <div class="relative hidden lg:block" id="notificationBellContainer">
                        <button type="button" id="notificationBellBtn" class="relative p-2 text-on-surface-variant hover:text-primary transition-colors focus:outline-none bg-transparent border-0 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[24px]">notifications</span>
                            <span id="notificationBadge" class="absolute top-1 right-1 hidden min-w-[16px] h-[16px] bg-red-600 text-white text-[10px] font-bold rounded-full flex items-center justify-center px-1">0</span>
                        </button>
                        
                        <!-- Dropdown panel -->
                        <div id="notificationDropdown" class="hidden absolute right-0 mt-2 w-96 bg-white border border-surface-border rounded-xl shadow-xl z-50 overflow-hidden">
                            <div class="px-4 py-3 border-b border-surface-border flex justify-between items-center bg-surface-container-lowest">
                                <div>
                                    <span class="font-semibold text-body-md text-on-surface block">Notifications</span>
                                    <span class="text-[11px] text-on-surface-variant">Unread system alerts</span>
                                </div>
                                <button type="button" id="markAllAsReadBtn" class="text-[11px] text-primary hover:underline bg-transparent border-0 p-0 font-medium">Mark all read</button>
                            </div>
                            <div id="notificationList" class="max-h-72 overflow-y-auto divide-y divide-surface-border">
                                <!-- Dynamic items loaded via JS -->
                                <div class="px-4 py-3 text-sm text-secondary text-center">Loading...</div>
                            </div>
                            <div class="px-4 py-3 border-t border-surface-border bg-surface-container-lowest">
                                <a href="@Url.Action("Index", "Notifications")" class="w-full inline-flex items-center justify-center gap-space-2 px-space-4 py-2 rounded-lg bg-primary text-on-primary text-[11px] font-label-caps uppercase tracking-wider hover:brightness-110 transition-all">
                                    <span class="material-symbols-outlined text-[16px]">inbox</span>
                                    Notification Center
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="hidden lg:flex items-center gap-space-2 lg:gap-space-3 pl-space-2 lg:pl-space-4">
                        <div class="hidden md:flex flex-col items-end">
                            <span class="text-body-md font-semibold text-on-surface whitespace-nowrap">@User.Identity.Name</span>
                            <span class="text-label-caps text-on-surface-variant">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                        </div>
                        <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
                        </div>
                        
                        <form asp-controller="Account" asp-action="Logout" method="post" class="hidden lg:inline">
                            <button type="submit" class="material-symbols-outlined text-on-surface-variant hover:text-error transition-colors bg-transparent border-0 p-0" title="Logout">
                                logout
                            </button>
                        </form>
                    </div>
                </div>
            </header>

            <!-- Main Workspace -->
            <main class="relative pt-16 min-h-screen bg-surface-container-low">
                <div class="flex flex-col w-full p-space-4 lg:p-space-8 gap-space-4 lg:gap-space-8">
                    @RenderBody()
                </div>
            </main>

        </div>
    }
    else
    {
        <!-- Simple wrapper for Login/Register Pages when not Authenticated -->
        <main class="min-h-screen bg-surface-container-low flex items-center justify-center p-space-4">
            @RenderBody()
        </main>
    }

    <!-- Anti-Forgery Token form for JS -->
    <form id="antiForgeryForm" class="hidden">
        @Html.AntiForgeryToken()
    </form>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const bellBtn = document.getElementById("notificationBellBtn");
            const dropdown = document.getElementById("notificationDropdown");
            const badge = document.getElementById("notificationBadge");
            const list = document.getElementById("notificationList");
            const markAllBtn = document.getElementById("markAllAsReadBtn");
            const afForm = document.getElementById("antiForgeryForm");
            if (!afForm) return;
            const tokenInput = afForm.querySelector("input[name='__RequestVerificationToken']");
            if (!tokenInput) return;
            const afToken = tokenInput.value;

            async function fetchNotifications() {
                try {
                    const response = await fetch('/Notifications/GetLatestUnread');
                    if (response.ok) {
                        const data = await response.json();
                        updateBadge(data.unreadCount);
                        updateDropdownList(data.notifications);
                    }
                } catch (err) {
                    console.error("Error fetching notifications:", err);
                }
            }

            function updateBadge(count) {
                if (count > 0) {
                    badge.textContent = count;
                    badge.classList.remove("hidden");
                    badge.classList.add("flex");
                } else {
                    badge.classList.add("hidden");
                    badge.classList.remove("flex");
                }
            }

            function updateDropdownList(notifications) {
                if (!notifications || notifications.length === 0) {
                    list.innerHTML = `<div class="px-4 py-3 text-sm text-secondary text-center">No new notifications</div>`;
                    return;
                }

                list.innerHTML = notifications.map(n => `
                    <div class="px-4 py-3 hover:bg-surface-container-low flex flex-col gap-1 transition-colors text-left" data-id="${n.id}">
                        <div class="flex justify-between items-start gap-2">
                            <span class="font-semibold text-xs text-on-surface text-left">${escapeHtml(n.title)}</span>
                            <small class="text-on-surface-variant text-[10px] whitespace-nowrap">${n.createdAt}</small>
                        </div>
                        <p class="text-xs text-on-surface-variant text-left leading-relaxed">${escapeHtml(n.message)}</p>
                        <div class="flex justify-between items-center mt-1">
                            <span class="text-[10px] bg-surface-container text-on-surface-variant px-1.5 py-0.5 rounded">${escapeHtml(n.category)}</span>
                            <button type="button" class="mark-single-read-btn text-[10px] text-primary hover:underline bg-transparent border-0 p-0 font-semibold" data-id="${n.id}">Mark read</button>
                        </div>
                    </div>
                `).join('');
            }

            function escapeHtml(str) {
                if (!str) return '';
                return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
            }

            // Poll notifications every 30 seconds
            fetchNotifications();
            setInterval(fetchNotifications, 30000);

            // Toggle Dropdown
            bellBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                dropdown.classList.toggle("hidden");
                fetchNotifications();
            });

            // Close dropdown when clicking outside
            document.addEventListener("click", function (e) {
                if (!dropdown.classList.contains("hidden") && !dropdown.contains(e.target) && !bellBtn.contains(e.target)) {
                    dropdown.classList.add("hidden");
                }
            });

            // Handle actions inside the dropdown list
            list.addEventListener("click", async function (e) {
                const markBtn = e.target.closest(".mark-single-read-btn");
                if (markBtn) {
                    e.stopPropagation();
                    const id = markBtn.getAttribute("data-id");
                    await markAsRead(id);
                }
            });

            async function markAsRead(id) {
                const formData = new FormData();
                formData.append("__RequestVerificationToken", afToken);
                formData.append("id", id);

                try {
                    const response = await fetch('/Notifications/MarkAsRead', {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    });
                    if (response.ok) {
                        await fetchNotifications();
                    }
                } catch (err) {
                    console.error("Error marking notification read:", err);
                }
            }

            markAllBtn.addEventListener("click", async function (e) {
                e.stopPropagation();
                const formData = new FormData();
                formData.append("__RequestVerificationToken", afToken);

                try {
                    const response = await fetch('/Notifications/MarkAllAsRead', {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    });
                    if (response.ok) {
                        await fetchNotifications();
                    }
                } catch (err) {
                    console.error("Error marking all notifications read:", err);
                }
            });

            // Responsive Sidebar Handlers
            const sidebar = document.getElementById("sidebarNav");
            const backdrop = document.getElementById("sidebarBackdrop");
            const toggleBtn = document.getElementById("sidebarToggleBtn");
            const closeBtn = document.getElementById("sidebarCloseBtn");

            function openSidebar() {
                sidebar?.classList.remove("-translate-x-full");
                backdrop?.classList.remove("hidden");
            }

            function closeSidebar() {
                sidebar?.classList.add("-translate-x-full");
                backdrop?.classList.add("hidden");
            }

            toggleBtn?.addEventListener("click", openSidebar);
            closeBtn?.addEventListener("click", closeSidebar);
            backdrop?.addEventListener("click", closeSidebar);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
