@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Upload Daily Sales Report";
    var establishments = ViewBag.Establishments as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var selectedEstablishment = establishments.FirstOrDefault(item => item.Selected) ?? establishments.FirstOrDefault();
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="space-y-6">
    <div class="flex flex-col gap-space-2 max-w-3xl">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">receipt_long</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Treasury Intake</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Upload Daily Sales Report</h1>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            Upload cashier closing reports, then review the extracted or manually entered values before posting to treasury cash-in.
        </p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="p-space-4 bg-audit-success/10 border border-audit-success/20 rounded-xl text-audit-success font-body-md flex items-center justify-between shadow-sm">
            <span><i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="p-space-4 bg-audit-pending/10 border border-audit-pending/20 rounded-xl text-audit-pending font-body-md flex items-center justify-between shadow-sm">
            <span><i class="bi bi-info-circle-fill me-2"></i> @TempData["Warning"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
        </div>
    }

    <section class="max-w-4xl bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border/50 overflow-hidden">
        <div class="bg-primary px-space-6 py-space-4 flex justify-between items-center">
            <span class="text-on-primary font-label-caps uppercase tracking-tighter text-[11px]">Sales Report Intake</span>
            <span class="text-on-primary/60 text-[10px] font-data-mono">MULTI-IMAGE</span>
        </div>

        <form id="uploadForm" asp-controller="SalesReports" asp-action="Upload" method="post" enctype="multipart/form-data" class="p-space-8 grid grid-cols-1 md:grid-cols-2 gap-space-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="md:col-span-2 text-audit-error bg-audit-error/10 border border-audit-error/20 p-space-3 rounded-lg text-body-md text-center"></div>

            @if (User.IsInRole("BranchStaff") && selectedEstablishment != null)
            {
                <div class="flex flex-col gap-space-2 md:col-span-2">
                    <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Operating Branch</span>
                    <input id="establishmentId" name="establishmentId" type="hidden" value="@(ViewBag.PreselectedEstablishmentId ?? selectedEstablishment.Value)" />
                    <div class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md text-on-surface">
                        @selectedEstablishment.Text
                    </div>
                    <span class="text-on-surface-variant text-[11px]">Assigned operating branch</span>
                 </div>
            }
            else
            {
                <label class="flex flex-col gap-space-2 md:col-span-2">
                    <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Operating Branch</span>
                    <select id="establishmentId" name="establishmentId" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required>
                        <option value="">Select branch...</option>
                        @foreach (var item in establishments)
                        {
                            if (ViewBag.PreselectedEstablishmentId != null && item.Value == ViewBag.PreselectedEstablishmentId.ToString())
                            {
                                <option value="@item.Value" selected>@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                    <span class="text-audit-error text-[11px]" data-valmsg-for="establishmentId"></span>
                </label>
            }

            <label class="flex flex-col gap-space-2 md:col-span-2">
                <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Report Section</span>
                <select id="reportSection" name="reportSection" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required>
                    @if (ViewBag.PreselectedSection != null && (int)ViewBag.PreselectedSection == 0)
                    {
                        <option value="1">Opening Daily Sales Log Book</option>
                        <option value="0" selected>Closing Daily Sales Log Book</option>
                    }
                    else
                    {
                        <option value="1" selected>Opening Daily Sales Log Book</option>
                        <option value="0">Closing Daily Sales Log Book</option>
                    }
                </select>
            </label>

            <label class="flex flex-col gap-space-2">
                <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Business Date</span>
                <input id="businessDate" name="businessDate" type="date" value="@(ViewBag.PreselectedBusinessDate ?? today)" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required />
                <span class="text-audit-error text-[11px]" data-valmsg-for="businessDate"></span>
            </label>

            <label class="flex flex-col gap-space-2">
                <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Handover Date</span>
                <input id="handoverDate" name="handoverDate" type="date" value="@(ViewBag.PreselectedHandoverDate ?? today)" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required />
                <span class="text-audit-error text-[11px]" data-valmsg-for="handoverDate"></span>
            </label>

            <label class="flex flex-col gap-space-2 md:col-span-2">
                <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Cashier Name</span>
                <input id="cashierName" name="cashierName" value="@ViewBag.PreselectedCashierName" maxlength="100" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" placeholder="Cashier or branch staff name" />
            </label>

            <div class="flex flex-col gap-space-2 md:col-span-2">
                <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Sales Report Images</span>
                <div id="drop-zone" class="border-2 border-dashed border-surface-border rounded-xl p-space-8 text-center flex flex-col items-center justify-center gap-space-4 cursor-pointer hover:border-primary/40 hover:bg-primary/5 transition-all relative min-h-[160px]">
                    <input type="file" id="file-input" class="hidden" accept="image/*" multiple />
                    
                    <div id="upload-prompt" class="flex flex-col items-center gap-space-3">
                        <span class="material-symbols-outlined text-[48px] text-primary">receipt_long</span>
                        <div>
                            <p class="font-headline-sm text-on-surface text-[15px]">Click or drag cashier reports here (up to 5 images)</p>
                            <p class="text-on-surface-variant text-body-md text-[13px] mt-1">Accepts PNG, JPG, JPEG, or WEBP up to 10MB each</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Previews Grid -->
            <div class="md:col-span-2">
                <div id="previews-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 hidden font-body-sm text-on-surface">
                    <!-- Preview items will be dynamically generated here -->
                </div>
            </div>

            <div class="md:col-span-2 flex flex-col sm:flex-row gap-space-3 pt-space-3 border-t border-surface-border">
                <button type="submit" id="process-btn" class="bg-primary text-on-primary px-space-8 py-3 rounded-lg font-label-caps uppercase tracking-widest hover:bg-primary/95 transition-all flex items-center justify-center gap-space-2 shadow-md text-[12px]" disabled>
                    <span class="material-symbols-outlined text-[18px]">upload_file</span>
                    Upload and Review
                </button>
            </div>
        </form>
    </section>
</div>

<script>
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const previewsContainer = document.getElementById('previews-container');
    const processBtn = document.getElementById('process-btn');
    const form = document.getElementById('uploadForm');

    let fileItems = []; // Array of { id: number, file: File, rotation: number }
    let nextId = 1;

    // Trigger file input
    dropZone.addEventListener('click', () => fileInput.click());

    // Handle drag and drop
    dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.classList.add('border-primary/40', 'bg-primary/5');
    });

    dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('border-primary/40', 'bg-primary/5');
    });

    dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-primary/40', 'bg-primary/5');
        if (e.dataTransfer.files.length) {
            addFiles(e.dataTransfer.files);
        }
    });

    fileInput.addEventListener('change', (e) => {
        if (e.target.files.length) {
            addFiles(e.target.files);
            fileInput.value = ''; // Reset input to allow adding same files again
        }
    });

    function addFiles(files) {
        for (let i = 0; i < files.length; i++) {
            if (fileItems.length >= 5) {
                alert('You can only upload up to 5 images.');
                break;
            }
            const file = files[i];
            const allowedExtensions = ['.png', '.jpg', '.jpeg', '.webp'];
            const ext = file.name.substring(file.name.lastIndexOf('.')).toLowerCase();
            if (!allowedExtensions.includes(ext)) {
                alert(`File format of ${file.name} is not supported.`);
                continue;
            }
            fileItems.push({
                id: nextId++,
                file: file,
                rotation: 0
            });
        }
        renderPreviews();
    }

    function renderPreviews() {
        previewsContainer.innerHTML = '';
        if (fileItems.length === 0) {
            previewsContainer.classList.add('hidden');
            processBtn.disabled = true;
            return;
        }

        previewsContainer.classList.remove('hidden');
        processBtn.disabled = false;

        fileItems.forEach((item, index) => {
            const card = document.createElement('div');
            card.className = "relative bg-surface-container-low rounded-lg p-2 border border-surface-border flex flex-col items-center gap-2 group";

            const imgContainer = document.createElement('div');
            imgContainer.className = "w-full h-32 flex items-center justify-center overflow-hidden bg-black rounded relative";

            const img = document.createElement('img');
            img.src = URL.createObjectURL(item.file);
            img.className = "max-h-full max-w-full object-contain transition-transform duration-200";
            img.style.transform = `rotate(${item.rotation}deg)`;
            imgContainer.appendChild(img);

            // Reorder, Rotate, Delete Actions Overlay
            const controlsOverlay = document.createElement('div');
            controlsOverlay.className = "absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 flex flex-col justify-between p-1.5 transition-opacity duration-200";

            const topRow = document.createElement('div');
            topRow.className = "flex justify-between items-center w-full";
            
            // Delete button
            const delBtn = document.createElement('button');
            delBtn.type = "button";
            delBtn.className = "p-1 rounded bg-audit-error text-white hover:brightness-110 flex items-center justify-center";
            delBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">delete</span>';
            delBtn.onclick = (e) => { e.stopPropagation(); removeFile(item.id); };

            // Rotate button
            const rotateBtn = document.createElement('button');
            rotateBtn.type = "button";
            rotateBtn.className = "p-1 rounded bg-primary text-white hover:brightness-110 flex items-center justify-center";
            rotateBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">rotate_right</span>';
            rotateBtn.onclick = (e) => { e.stopPropagation(); rotateFile(item.id); };

            topRow.appendChild(rotateBtn);
            topRow.appendChild(delBtn);

            const bottomRow = document.createElement('div');
            bottomRow.className = "flex justify-center gap-2 w-full";

            // Move Left
            const moveLeftBtn = document.createElement('button');
            moveLeftBtn.type = "button";
            moveLeftBtn.className = "p-1 rounded bg-surface-border text-white disabled:opacity-40 flex items-center justify-center" + (index === 0 ? " cursor-not-allowed" : "");
            moveLeftBtn.disabled = index === 0;
            moveLeftBtn.innerHTML = '<span class="material-symbols-outlined text-[14px]">arrow_back</span>';
            moveLeftBtn.onclick = (e) => { e.stopPropagation(); moveFile(index, index - 1); };

            // Move Right
            const moveRightBtn = document.createElement('button');
            moveRightBtn.type = "button";
            moveRightBtn.className = "p-1 rounded bg-surface-border text-white disabled:opacity-40 flex items-center justify-center" + (index === fileItems.length - 1 ? " cursor-not-allowed" : "");
            moveRightBtn.disabled = index === fileItems.length - 1;
            moveRightBtn.innerHTML = '<span class="material-symbols-outlined text-[14px]">arrow_forward</span>';
            moveRightBtn.onclick = (e) => { e.stopPropagation(); moveFile(index, index + 1); };

            bottomRow.appendChild(moveLeftBtn);
            bottomRow.appendChild(moveRightBtn);

            controlsOverlay.appendChild(topRow);
            controlsOverlay.appendChild(bottomRow);
            imgContainer.appendChild(controlsOverlay);

            const label = document.createElement('span');
            label.className = "text-[11px] text-on-surface truncate w-full text-center font-data-mono";
            label.innerText = `${index + 1}. ${item.file.name}`;

            card.appendChild(imgContainer);
            card.appendChild(label);
            previewsContainer.appendChild(card);
        });
    }

    function removeFile(id) {
        fileItems = fileItems.filter(item => item.id !== id);
        renderPreviews();
    }

    function rotateFile(id) {
        const item = fileItems.find(item => item.id === id);
        if (item) {
            item.rotation = (item.rotation + 90) % 360;
            renderPreviews();
        }
    }

    function moveFile(fromIndex, toIndex) {
        if (toIndex < 0 || toIndex >= fileItems.length) return;
        const temp = fileItems[fromIndex];
        fileItems[fromIndex] = fileItems[toIndex];
        fileItems[toIndex] = temp;
        renderPreviews();
    }

    async function getRotatedFile(fileItem) {
        if (fileItem.rotation === 0) {
            return fileItem.file;
        }
        return new Promise((resolve) => {
            const img = new Image();
            img.onload = () => {
                const canvas = document.createElement('canvas');
                const ctx = canvas.getContext('2d');
                const angle = (fileItem.rotation % 360 + 360) % 360;
                if (angle === 90 || angle === 270) {
                    canvas.width = img.height;
                    canvas.height = img.width;
                } else {
                    canvas.width = img.width;
                    canvas.height = img.height;
                }
                ctx.translate(canvas.width / 2, canvas.height / 2);
                ctx.rotate((angle * Math.PI) / 180);
                ctx.drawImage(img, -img.width / 2, -img.height / 2);
                canvas.toBlob((blob) => {
                    URL.revokeObjectURL(img.src);
                    const rotatedFile = new File([blob], fileItem.file.name, { type: fileItem.file.type });
                    resolve(rotatedFile);
                }, fileItem.file.type);
            };
            img.onerror = () => {
                URL.revokeObjectURL(img.src);
                resolve(fileItem.file);
            };
            img.src = URL.createObjectURL(fileItem.file);
        });
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (fileItems.length === 0) return;

        processBtn.disabled = true;
        processBtn.innerHTML = `
            <span class="material-symbols-outlined animate-spin text-[18px]">sync</span>
            <span>Uploading & Processing OCR...</span>
        `;

        const formData = new FormData();
        const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
        formData.append('__RequestVerificationToken', token);
        formData.append('establishmentId', document.getElementById('establishmentId').value);
        formData.append('businessDate', document.getElementById('businessDate').value);
        formData.append('handoverDate', document.getElementById('handoverDate').value);
        formData.append('cashierName', document.getElementById('cashierName').value);
        formData.append('reportSection', document.getElementById('reportSection').value);

        for (let i = 0; i < fileItems.length; i++) {
            const rotatedFile = await getRotatedFile(fileItems[i]);
            formData.append('reportImages', rotatedFile);
        }

        try {
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData
            });
            if (response.ok) {
                // Determine redirect URL from response or default
                const url = response.url;
                window.location.href = url;
            } else {
                const html = await response.text();
                document.open();
                document.write(html);
                document.close();
            }
        } catch (err) {
            console.error(err);
            alert('An error occurred during submission. Please try again.');
            processBtn.disabled = false;
            processBtn.innerHTML = `
                <span class="material-symbols-outlined text-[18px]">upload_file</span>
                <span>Upload and Review</span>
            `;
        }
    });
</script>
