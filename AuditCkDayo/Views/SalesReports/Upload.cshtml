@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Upload Daily Sales Report";
    var establishments = ViewBag.Establishments as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="space-y-6">
    <div class="flex flex-col gap-space-2 max-w-3xl">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">receipt_long</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Treasury Intake</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Upload Daily Sales Report</h1>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            Upload one cashier closing report, then review the extracted or manually entered values before posting to treasury cash-in.
        </p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="p-space-4 bg-audit-success/10 border border-audit-success/20 rounded-xl text-audit-success font-body-md flex items-center justify-between shadow-sm">
            <span><i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="p-space-4 bg-audit-pending/10 border border-audit-pending/20 rounded-xl text-audit-pending font-body-md flex items-center justify-between shadow-sm">
            <span><i class="bi bi-info-circle-fill me-2"></i> @TempData["Warning"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
        </div>
    }

    <section class="max-w-4xl bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border/50 overflow-hidden">
        <div class="bg-primary px-space-6 py-space-4 flex justify-between items-center">
            <span class="text-on-primary font-label-caps uppercase tracking-tighter text-[11px]">Sales Report Intake</span>
            <span class="text-on-primary/60 text-[10px] font-data-mono">ONE-IMAGE</span>
        </div>

        <form asp-controller="SalesReports" asp-action="Upload" method="post" enctype="multipart/form-data" class="p-space-8 grid grid-cols-1 md:grid-cols-2 gap-space-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="md:col-span-2 text-audit-error bg-audit-error/10 border border-audit-error/20 p-space-3 rounded-lg text-body-md text-center"></div>

            <label class="flex flex-col gap-space-2 md:col-span-2">
                <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Operating Branch</span>
                <select id="establishmentId" name="establishmentId" asp-items="establishments" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required>
                    <option value="">Select branch...</option>
                </select>
                <span class="text-audit-error text-[11px]" data-valmsg-for="establishmentId"></span>
            </label>

            <label class="flex flex-col gap-space-2">
                <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Business Date</span>
                <input id="businessDate" name="businessDate" type="date" value="@today" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required />
                <span class="text-audit-error text-[11px]" data-valmsg-for="businessDate"></span>
            </label>

            <label class="flex flex-col gap-space-2">
                <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Handover Date</span>
                <input id="handoverDate" name="handoverDate" type="date" value="@today" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required />
                <span class="text-audit-error text-[11px]" data-valmsg-for="handoverDate"></span>
            </label>

            <label class="flex flex-col gap-space-2 md:col-span-2">
                <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Cashier Name</span>
                <input id="cashierName" name="cashierName" maxlength="100" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" placeholder="Cashier or branch staff name" />
            </label>

            <label class="flex flex-col gap-space-2 md:col-span-2">
                <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Sales Report Image</span>
                <div class="border-2 border-dashed border-surface-border rounded-xl p-space-6 bg-surface-container-low flex flex-col gap-space-3">
                    <input id="reportImage" name="reportImage" type="file" accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" class="w-full text-on-surface file:mr-space-4 file:rounded-lg file:border-0 file:bg-primary file:px-space-4 file:py-space-2 file:text-on-primary file:font-label-caps file:uppercase file:text-[11px]" required />
                    <p class="text-xs text-on-surface-variant">Accepted formats: PNG, JPG, JPEG, WEBP. Upload one non-empty image.</p>
                </div>
                <span class="text-audit-error text-[11px]" data-valmsg-for="reportImage"></span>
            </label>

            <div class="md:col-span-2 flex flex-col sm:flex-row gap-space-3 pt-space-3 border-t border-surface-border">
                <button type="submit" class="bg-primary text-on-primary px-space-8 py-3 rounded-lg font-label-caps uppercase tracking-widest hover:bg-primary/95 transition-all flex items-center justify-center gap-space-2 shadow-md text-[12px]">
                    <span class="material-symbols-outlined text-[18px]">upload_file</span>
                    Upload and Review
                </button>
            </div>
        </form>
    </section>
</div>
