@model AuditCkDayo.ViewModels.SalesReportReviewViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Reconciliation Review Daily Sales Report";
    var establishments = ViewBag.Establishments as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
}

<div class="space-y-6">
    <div class="flex flex-col gap-space-2 max-w-3xl">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">fact_check</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Manager Reconciliation Review</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Review Daily Sales Report</h1>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            Verify the morning/evening logs, adjust any errors, and confirm to post cash-in.
        </p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="p-space-4 bg-audit-success/10 border border-audit-success/20 rounded-xl text-audit-success font-body-md flex items-center justify-between shadow-sm">
            <span><i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
        </div>
    }

    <!-- ROW 1: Control Panel Header and Combined Handover Metrics -->
    <div class="bg-surface-container-lowest p-space-6 rounded-xl border border-surface-border shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <span class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider">Business Date: @Model.BusinessDate.ToString("MMM d, yyyy")</span>
                <h2 class="text-headline-sm font-bold text-on-surface">Verification & Reconciliation Control Panel</h2>
            </div>
            
            <div class="flex gap-3 w-full sm:w-auto items-center">
                <!-- Export Section Images dropdown -->
                <div class="relative inline-block text-left" id="exportDropdownContainer">
                    <button type="button" onclick="document.getElementById('exportMenu').classList.toggle('hidden')" class="bg-surface-container text-primary border border-primary/20 px-4 py-2 rounded-lg font-label-caps uppercase tracking-wider hover:bg-primary/10 transition-all text-[11px] flex items-center gap-2">
                        <span class="material-symbols-outlined text-[16px]">image</span> Export Report Image
                    </button>
                    <div id="exportMenu" class="origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white border border-surface-border ring-1 ring-black ring-opacity-5 focus:outline-none hidden z-50">
                        <div class="py-1">
                            <button type="button" onclick="exportReportAsImage('opening')" class="text-on-surface hover:bg-surface-container-low block w-full text-left px-4 py-2 text-[11px] font-label-caps uppercase tracking-wide flex items-center gap-2">
                                <span class="material-symbols-outlined text-[16px]">wb_twilight</span> Export Opening Sales
                            </button>
                            <button type="button" onclick="exportReportAsImage('closing')" class="text-on-surface hover:bg-surface-container-low block w-full text-left px-4 py-2 text-[11px] font-label-caps uppercase tracking-wide flex items-center gap-2 border-t border-surface-border">
                                <span class="material-symbols-outlined text-[16px]">nights_stay</span> Export Closing Sales
                            </button>
                        </div>
                    </div>
                </div>

                <button type="button" onclick="triggerTopForm('SaveDraft')" class="bg-surface-container text-primary border border-primary/20 px-5 py-2 rounded-lg font-label-caps uppercase tracking-wider hover:bg-primary/10 transition-all text-[11px] flex items-center gap-2">
                    <span class="material-symbols-outlined text-[16px]">save</span> Save Draft
                </button>
                <button type="button" onclick="triggerTopForm('@Model.PrimaryActionType')" class="bg-primary text-on-primary px-6 py-2 rounded-lg font-label-caps uppercase tracking-wider hover:bg-primary/95 transition-all text-[11px] flex items-center gap-2 shadow-sm">
                    <span class="material-symbols-outlined text-[16px]">@Model.PrimaryActionIcon</span> @Model.PrimaryActionText
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-space-4 pt-2">
            <div class="bg-surface-container-low rounded-lg p-space-4 border border-surface-border">
                <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Opening Cash Sales</div>
                <div class="text-body-md font-bold text-on-surface font-data-mono text-[18px]">
                    ₱@Model.OpeningCashSales.ToString("N2")
                </div>
            </div>
            <div class="bg-surface-container-low rounded-lg p-space-4 border border-surface-border">
                <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Closing Cash Sales</div>
                <div class="text-body-md font-bold text-on-surface font-data-mono text-[18px]" id="display_closing_cash_sales">
                    ₱@Model.CashSales.ToString("N2")
                </div>
            </div>
            <div class="bg-surface-container-low rounded-lg p-space-4 border-l-4 border-primary shadow-sm">
                <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Combined Cash Sales</div>
                <div class="text-primary font-bold font-data-mono text-[18px]" id="display_combined_cash_sales">
                    ₱@Model.CombinedCashSales.ToString("N2")
                </div>
            </div>
            <div class="bg-surface-container-low rounded-lg p-space-4 border border-surface-border ring-2 ring-primary/20">
                <div class="text-[9px] uppercase font-bold text-primary tracking-wider mb-1">Total Handover Cash (Editable)</div>
                @if (Model.CanConfirmToTreasury)
                {
                    <input type="number" step="0.01" value="@Model.ConfirmedCashToHandover.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="w-full bg-transparent border-0 border-b border-primary focus:outline-none font-bold font-data-mono text-[22px] text-primary p-0" id="HandoverCashInput" />
                }
                else
                {
                    <div class="text-body-md font-bold text-on-surface font-data-mono text-[18px]">
                        ₱@Model.ConfirmedCashToHandover.ToString("N2")
                    </div>
                }
            </div>
            @{
                var initialVariance = Model.ConfirmedCashToHandover - Model.CombinedCashSales;
                var initialLabel = initialVariance < 0 ? "Short" : initialVariance > 0 ? "Over" : "Balanced";
            }
            <div class="bg-surface-container-low rounded-lg p-space-4 border-l-4 @(initialVariance == 0m ? "border-audit-success" : "border-audit-error") shadow-sm" id="short-over-card">
                <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1" id="short-over-label">Short / Over Notice (@initialLabel)</div>
                <div class="font-bold font-data-mono text-[18px] @(initialVariance == 0m ? "text-audit-success" : "text-audit-error")" id="short-over-amount">
                    ₱@Math.Abs(initialVariance).ToString("N2")
                </div>
            </div>
        </div>
    </div>


    <!-- Main post form wrap -->
    <form asp-controller="SalesReports" asp-action="Review" method="post" enctype="multipart/form-data" class="space-y-6" id="topActionForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-audit-error bg-audit-error/10 border border-audit-error/20 p-space-4 rounded-lg text-body-md text-center"></div>
        
        <input type="hidden" asp-for="SalesReportId" />
        <input type="hidden" asp-for="DocumentRecordId" />
        <input type="hidden" asp-for="ImageUrl" />
        <input type="hidden" asp-for="EstablishmentId" />
        <input type="hidden" asp-for="BusinessDate" />
        <input type="hidden" asp-for="HandoverDate" />
        <input type="hidden" asp-for="CashierName" />
        <input type="hidden" asp-for="ConfirmedCashToHandover" id="topHandoverMirror" />
        <input type="hidden" asp-for="ManagerCountedTotalCash" id="topCountedMirror" />
        <input type="hidden" asp-for="GCashAmount" id="GCashAmount" />
        <input type="hidden" asp-for="CreditAmount" id="CreditAmount" />
        <input type="hidden" asp-for="OtherPaymentAmount" id="OtherPaymentAmount" />
        <input type="hidden" asp-for="CashOut" id="CashOut" />
        <input type="hidden" name="actionType" id="actionTypeField" value="SaveDraft" />

        @if (Model.ImageUrls != null)
        {
            for (int i = 0; i < Model.ImageUrls.Count; i++)
            {
                <input type="hidden" name="ImageUrls[@i]" value="@Model.ImageUrls[i]" />
            }
        }

        <!-- ROW 2: Forms Side-by-Side Comparison -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-8 items-start">
            
            <!-- LEFT COLUMN: Opening Shift & Opening Deposit -->
            <div class="space-y-4">
                <!-- OPENING DEPOSIT SLIP DROPDOWN (Above Opening Log) -->
                <div class="rounded-xl border border-surface-border bg-surface-container-lowest shadow-sm overflow-hidden transition-all">
                    <div class="px-4 py-2.5 bg-surface-container-low flex items-center justify-between cursor-pointer hover:bg-surface-container transition-colors select-none" onclick="toggleDepositDrawer('opening')">
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="material-symbols-outlined text-primary text-[18px]">account_balance</span>
                            <span class="text-xs font-bold text-on-surface truncate">Opening Deposit Slip:</span>
                            @if (Model.HasOpeningDepositSlip)
                            {
                                if (Model.IsOpeningDepositMatched)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
                                        ✓ ₱@Model.OpeningDepositedAmount?.ToString("N2") Matched
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/30" title="@Model.OpeningDepositVarianceReason">
                                        ⚠️ ₱@Model.OpeningDepositedAmount?.ToString("N2") (@(Model.OpeningDepositVariance > 0 ? "+" : "")₱@Model.OpeningDepositVariance.ToString("N2"))
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30">
                                    Awaiting Opening Slip
                                </span>
                            }
                        </div>
                        <div class="flex items-center gap-1 text-primary text-[11px] font-bold">
                            <span id="openingDrawerToggleLabel">@(Model.HasOpeningDepositSlip ? "View / Edit" : "Upload Slip")</span>
                            <span id="openingDrawerChevron" class="material-symbols-outlined text-[16px] transition-transform duration-200">expand_more</span>
                        </div>
                    </div>

                    <!-- Opening Drawer Content -->
                    <div id="openingDepositDrawer" class="hidden p-4 border-t border-surface-border bg-surface-container-lowest space-y-3 text-xs">
                        @if (Model.HasOpeningDepositSlip)
                        {
                            <div class="flex items-start gap-3 p-3 bg-surface-container-low rounded-lg border border-surface-border">
                                <img src="@Model.OpeningDepositSlipImageUrl" class="w-16 h-16 object-contain rounded border border-surface-border cursor-pointer hover:opacity-90" alt="Opening Deposit Slip" onclick="openLightbox(this.src)" />
                                <div class="flex-1 text-[11px] space-y-0.5">
                                    <div><b class="text-on-surface">Bank:</b> @(Model.OpeningDepositBankName ?? "—") | <b class="text-on-surface">Ref:</b> <span class="font-mono">@(Model.OpeningDepositReferenceNumber ?? "—")</span></div>
                                    <div><b class="text-on-surface">Deposited:</b> <span class="text-primary font-mono font-bold">₱@Model.OpeningDepositedAmount?.ToString("N2")</span> vs <b class="text-on-surface">Sales:</b> <span class="font-mono">₱@Model.OpeningCashSales.ToString("N2")</span></div>
                                    @if (!string.IsNullOrWhiteSpace(Model.OpeningDepositVarianceReason))
                                    {
                                        <div class="text-red-500"><b>Variance Reason:</b> @Model.OpeningDepositVarianceReason</div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Opening Upload / Edit Form -->
                        <div class="space-y-3 pt-1">
                            <div id="openingDepositDropzone" onclick="document.getElementById('openingFileInput').click()" class="border-2 border-dashed border-outline-variant hover:border-primary rounded-xl p-3 text-center cursor-pointer transition bg-surface-container-low/50">
                                <input type="file" id="openingFileInput" accept=".png,.jpg,.jpeg,.webp" class="hidden" onchange="handleDepositFileSelected('opening', event)" />
                                <div id="openingDropzonePlaceholder" class="flex items-center justify-center gap-2 text-on-surface-variant text-[11px]">
                                    <span class="material-symbols-outlined text-primary text-xl">cloud_upload</span>
                                    <span>Click or drag deposit slip image</span>
                                </div>
                                <div id="openingFilePreviewContainer" class="hidden flex items-center justify-between gap-2 text-left">
                                    <span id="openingFileNameText" class="font-mono text-[10px] text-on-surface truncate"></span>
                                    <button type="button" id="btnOpeningScanOcr" onclick="event.stopPropagation(); scanDepositSlipOcr('opening')" class="px-2.5 py-1 bg-primary text-white rounded text-[10px] font-bold inline-flex items-center gap-1 shadow-sm">
                                        <span class="material-symbols-outlined text-[13px]">document_scanner</span>
                                        <span id="btnOpeningScanOcrText">Scan OCR</span>
                                    </button>
                                </div>
                            </div>
                            <div id="openingOcrStatusNote" class="hidden"></div>

                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div>
                                    <label class="block text-[10px] font-bold text-on-surface-variant mb-0.5">Bank</label>
                                    <input type="text" id="openingDepositBankName" value="@Model.OpeningDepositBankName" placeholder="e.g. Metrobank" class="w-full rounded-lg border border-outline bg-surface px-2.5 py-1.5 text-xs text-on-surface" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-on-surface-variant mb-0.5">Reference #</label>
                                    <input type="text" id="openingDepositRef" value="@Model.OpeningDepositReferenceNumber" placeholder="e.g. 262309-627-..." class="w-full rounded-lg border border-outline bg-surface px-2.5 py-1.5 text-xs text-on-surface font-mono" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-on-surface-variant mb-0.5">Deposited (₱) *</label>
                                    <input type="number" step="0.01" min="0.01" id="openingDepositAmount" value="@(Model.OpeningDepositedAmount.HasValue ? Model.OpeningDepositedAmount.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : Model.OpeningCashSales.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" class="w-full rounded-lg border border-outline bg-surface px-2.5 py-1.5 text-xs font-bold text-on-surface font-mono" oninput="updateDepositComparison('opening')" />
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-on-surface-variant mb-0.5">Deposit Date *</label>
                                    <input type="date" id="openingDepositDate" value="@(Model.OpeningDepositDate.HasValue ? Model.OpeningDepositDate.Value.ToString("yyyy-MM-dd") : Model.BusinessDate.ToString("yyyy-MM-dd"))" class="w-full rounded-lg border border-outline bg-surface px-2.5 py-1.5 text-xs text-on-surface" />
                                </div>
                            </div>

                            <div id="openingVarianceGroup" class="hidden">
                                <label class="block text-[10px] font-bold text-red-500 mb-0.5">Opening Variance Explanation *</label>
                                <textarea id="openingDepositVarianceReason" rows="2" placeholder="Explain difference from opening cash sales..." class="w-full rounded-lg border border-red-500/50 bg-surface px-2.5 py-1.5 text-xs text-on-surface">@Model.OpeningDepositVarianceReason</textarea>
                            </div>

                            <div class="flex items-center justify-between pt-1">
                                <div id="openingDepositComparisonText" class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">Opening Cash: ₱@Model.OpeningCashSales.ToString("N2")</div>
                                <button type="button" onclick="handleDepositSubmit('opening', event)" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-primary text-on-primary hover:brightness-110 shadow-sm transition inline-flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[15px]">save</span> Save Opening Slip
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Opening Daily Sales Logbook Form Box -->
                <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border overflow-hidden space-y-space-6 pb-space-6">
                <div class="bg-primary/95 px-space-6 py-space-4 flex justify-between items-center text-on-primary">
                    <span class="font-label-caps uppercase tracking-tighter text-[11px] font-bold">1. Opening Daily Sales Log</span>
                    <span class="text-[10px] font-data-mono bg-white/20 px-2 py-0.5 rounded text-white font-semibold">READONLY</span>
                </div>
                <div class="px-space-6 pt-space-4">
                    <div class="rounded-lg border border-surface-border bg-surface-container-low px-4 py-3">
                        <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Opening Inputted By</span>
                        <div class="font-body-md text-on-surface font-semibold">@Model.OpeningInputtedByName</div>
                    </div>
                </div>

                <!-- Opening Image Viewer -->
                <div class="px-space-6">
                    <div class="p-space-4 bg-surface-container-highest flex flex-col items-center justify-center min-h-[300px] relative border border-surface-border rounded-xl">
                        <img id="opening-main-preview" src="@(Model.ImageUrls != null && Model.ImageUrls.Count > 0 ? Model.ImageUrls[0] : "/img/placeholder.png")" class="max-w-full max-h-[350px] object-contain rounded-lg border border-surface-border/50 shadow-sm cursor-pointer hover:opacity-90 transition-opacity" alt="Opening Logbook" onclick="openLightbox(this.src)" />
                        <span class="text-on-surface-variant text-[10px] uppercase font-label-caps mt-2">Click photo to zoom</span>
                    </div>
                    @if (Model.ImageUrls != null && Model.ImageUrls.Count > 0)
                    {
                        <div class="p-space-3 mt-3 bg-surface-container-low border border-surface-border rounded-lg flex gap-2 overflow-x-auto">
                            @for (int i = 0; i < Model.ImageUrls.Count; i++)
                            {
                                <div class="w-12 h-12 flex-shrink-0 bg-black rounded border border-surface-border overflow-hidden cursor-pointer hover:border-primary transition-all @(i == 0 ? "ring-2 ring-primary" : "")" onclick="setOpeningPreview(this, '@Model.ImageUrls[i]')">
                                    <img src="@Model.ImageUrls[i]" class="w-full h-full object-contain" />
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Opening Financial Figures -->
                <div class="px-space-6 space-y-space-4">
                    <div class="rounded-xl border border-surface-border bg-surface-container-low/20 p-space-4 space-y-4">
                        <h3 class="font-label-caps text-on-surface uppercase text-[10px] tracking-wider font-bold">Financial Figures</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Gross Sales (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningGrossSales.ToString("N2")</div>
                            </div>
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Cash Sales (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningCashSales.ToString("N2")</div>
                            </div>
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Food Sales (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningFoodSales.ToString("N2")</div>
                            </div>
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Beer Sales (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningBeerSales.ToString("N2")</div>
                            </div>
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Beverage Sales (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningBeverageSales.ToString("N2")</div>
                            </div>
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Hard Sales (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningHardSales.ToString("N2")</div>
                            </div>
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Other Sales (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningOtherSales.ToString("N2")</div>
                            </div>
                        </div>
                    </div>

                    <div class="rounded-xl border border-surface-border bg-surface-container-low/20 p-space-4 space-y-4">
                        <h3 class="font-label-caps text-on-surface uppercase text-[10px] tracking-wider font-bold">Discounts Breakdown</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Senior Discount (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningSeniorDiscount.ToString("N2")</div>
                            </div>
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">PWD Discount (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningPwdDiscount.ToString("N2")</div>
                            </div>
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Loyalty Discount (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningLoyaltyCardDiscount.ToString("N2")</div>
                            </div>
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Voucher Discount (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningGiftVoucherDiscount.ToString("N2")</div>
                            </div>
                        </div>
                    </div>

                    <div class="rounded-xl border border-surface-border bg-surface-container-low/20 p-space-4 space-y-4">
                        <h3 class="font-label-caps text-on-surface uppercase text-[10px] tracking-wider font-bold">Variances & PCF</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Resto PCF (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningRestoPcf.ToString("N2")</div>
                            </div>
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">PCF from Sales (₱)</span>
