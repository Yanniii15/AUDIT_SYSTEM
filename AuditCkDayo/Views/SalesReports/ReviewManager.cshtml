                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </div> <!-- END RIGHT COLUMN -->
        </div>
    </form>
</div>

<script>
    function setOpeningPreview(el, src) {
        document.getElementById('opening-main-preview').src = src;
        el.parentElement.querySelectorAll('.ring-2').forEach(thumb => {
            thumb.classList.remove('ring-2', 'ring-primary');
        });
        el.classList.add('ring-2', 'ring-primary');
    }

    function setClosingPreview(el, src) {
        document.getElementById('closing-main-preview').src = src;
        el.parentElement.querySelectorAll('.ring-2').forEach(thumb => {
            thumb.classList.remove('ring-2', 'ring-primary');
        });
        el.classList.add('ring-2', 'ring-primary');
    }

    function triggerTopForm(actionType) {
        document.getElementById('actionTypeField').value = actionType;
        document.getElementById('topActionForm').submit();
    }

    // Mathematical dynamic updates
    const expectedBaseline = @(Model.CombinedExpectedCashToHandover.ToString(System.Globalization.CultureInfo.InvariantCulture));
    const openingCashSales = @(Model.OpeningCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture));
    const combinedCashSales = @(Model.CombinedCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture));

    function updateShortOverNotice(handoverCash) {
        // Combined Expected Handover Cash is compared directly against Combined Cash Sales
        const expected = combinedCashSales;
        const variance = handoverCash - expected;
        const label = document.getElementById('short-over-label');
        const amount = document.getElementById('short-over-amount');
        if (label) {
            label.innerText = variance < 0 ? 'Short / Over Notice (Short)' : variance > 0 ? 'Short / Over Notice (Over)' : 'Short / Over Notice (Balanced)';
        }
        if (amount) {
            amount.innerText = `₱${Math.abs(variance).toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
        }
        const card = document.getElementById('short-over-card');
        if (card) {
            card.className = `bg-surface-container-low rounded-lg p-space-4 border-l-4 ${variance === 0 ? 'border-audit-success' : 'border-audit-error'} shadow-sm`;
        }
    }

    const depositFiles = {
        opening: null,
        closing: null
    };

    window.toggleDepositDrawer = function(section) {
        const drawer = document.getElementById(section + 'DepositDrawer');
        const chevron = document.getElementById(section + 'DrawerChevron');
        if (!drawer) return;
        const isHidden = drawer.classList.contains('hidden');
        drawer.classList.toggle('hidden');
        if (chevron) {
            chevron.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
        }
    };

    window.handleDepositFileSelected = function(section, e) {
        const files = e.target.files;
        if (files && files.length > 0) {
            const file = files[0];
            const allowed = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
            if (!allowed.includes(file.type) && !file.name.match(/\.(png|jpe?g|webp)$/i)) {
                alert('Please upload a valid image (PNG, JPG, JPEG, WEBP).');
                return;
            }
            depositFiles[section] = file;
            const previewContainer = document.getElementById(section + 'FilePreviewContainer');
            const fileNameSpan = document.getElementById(section + 'FileNameText');
            const dropzonePlaceholder = document.getElementById(section + 'DropzonePlaceholder');
            if (fileNameSpan) fileNameSpan.textContent = file.name;
            if (previewContainer) previewContainer.classList.remove('hidden');
            if (dropzonePlaceholder) dropzonePlaceholder.classList.add('hidden');
        }
    };

    window.scanDepositSlipOcr = async function(section) {
        const file = depositFiles[section];
        if (!file) {
            alert('Please select a deposit slip image first.');
            return;
        }
        const cap = section.charAt(0).toUpperCase() + section.slice(1);
        const scanBtn = document.getElementById('btn' + cap + 'ScanOcr');
        const scanBtnText = document.getElementById('btn' + cap + 'ScanOcrText');
        const statusNote = document.getElementById(section + 'OcrStatusNote');

        if (scanBtn) scanBtn.disabled = true;
        if (scanBtnText) scanBtnText.textContent = 'Scanning...';

        try {
            const formData = new FormData();
            formData.append('depositSlipImage', file);
            const res = await fetch('/SalesReports/ExtractDepositSlipOcr', {
                method: 'POST',
                body: formData
            });
            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    let filled = [];
                    if (data.detectedBank) {
                        document.getElementById(section + 'DepositBankName').value = data.detectedBank;
                        filled.push('Bank: ' + data.detectedBank);
                    }
                    if (data.detectedAmount) {
                        document.getElementById(section + 'DepositAmount').value = Number(data.detectedAmount).toFixed(2);
                        filled.push('Amount: ₱' + Number(data.detectedAmount).toFixed(2));
                        updateDepositComparison(section);
                    }
                    if (data.detectedReference) {
                        document.getElementById(section + 'DepositRef').value = data.detectedReference;
                        filled.push('Ref: ' + data.detectedReference);
                    }
                    if (data.detectedDate) {
                        document.getElementById(section + 'DepositDate').value = data.detectedDate;
                        filled.push('Date: ' + data.detectedDate);
                    }
                    if (statusNote) {
                        statusNote.className = 'text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1 mt-1';
                        statusNote.innerHTML = '<span class="material-symbols-outlined text-[14px]">check</span> <span></span>';
                        statusNote.querySelector('span:last-child').textContent = 'Auto-filled via OCR (' + (filled.join(', ') || 'Fields detected') + ')';
                        statusNote.classList.remove('hidden');
                    }
                } else {
                    if (statusNote) {
                        statusNote.className = 'text-[11px] text-amber-500 font-semibold flex items-center gap-1 mt-1';
                        statusNote.innerHTML = '<span class="material-symbols-outlined text-[14px]">info</span> OCR could not read all fields clearly. Please verify inputs manually.';
                        statusNote.classList.remove('hidden');
                    }
                }
            }
        } catch (err) {
            console.error('OCR Error:', err);
        } finally {
            if (scanBtn) scanBtn.disabled = false;
            if (scanBtnText) scanBtnText.textContent = 'Scan OCR';
        }
    };

    window.updateDepositComparison = function(section) {
        const amountInput = document.getElementById(section + 'DepositAmount');
        const varianceGroup = document.getElementById(section + 'VarianceGroup');
        const comparisonText = document.getElementById(section + 'DepositComparisonText');
        if (!amountInput) return;

        const deposited = parseFloat(amountInput.value) || 0;
        const expected = section === 'opening' 
            ? @(Model.OpeningCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture)) 
            : (parseFloat(document.getElementById('HandoverCashInput')?.value) || @(Model.CashSales.ToString(System.Globalization.CultureInfo.InvariantCulture)));
        
        const diff = deposited - expected;
        if (Math.abs(diff) < 0.01) {
            if (varianceGroup) varianceGroup.classList.add('hidden');
            if (comparisonText) {
                comparisonText.className = 'text-[11px] font-semibold text-emerald-600 dark:text-emerald-400';
                comparisonText.textContent = (section === 'opening' ? 'Opening Cash: ' : 'Closing Cash: ') + '₱' + expected.toFixed(2) + ' (Matched)';
            }
        } else {
            if (varianceGroup) varianceGroup.classList.remove('hidden');
            if (comparisonText) {
                comparisonText.className = 'text-[11px] font-semibold text-red-500';
                comparisonText.textContent = (section === 'opening' ? 'Opening Cash: ' : 'Closing Cash: ') + '₱' + expected.toFixed(2) + ' (Diff: ' + (diff > 0 ? '+' : '') + '₱' + diff.toFixed(2) + ')';
            }
        }
    };

    window.handleDepositSubmit = async function(section, event) {
        event.preventDefault();
        const reportId = @(Model.SalesReportId ?? 0);
        if (!reportId) return;

        const bankName = document.getElementById(section + 'DepositBankName')?.value || '';
        const refNum = document.getElementById(section + 'DepositRef')?.value || '';
        const amountVal = parseFloat(document.getElementById(section + 'DepositAmount')?.value) || 0;
        const dateVal = document.getElementById(section + 'DepositDate')?.value || '';
        const varianceReason = document.getElementById(section + 'DepositVarianceReason')?.value || '';

        const expected = section === 'opening' 
            ? @(Model.OpeningCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture)) 
            : (parseFloat(document.getElementById('HandoverCashInput')?.value) || @(Model.CashSales.ToString(System.Globalization.CultureInfo.InvariantCulture)));
        
        const diff = Math.abs(amountVal - expected);
        if (diff >= 0.01 && (!varianceReason || !varianceReason.trim())) {
            alert('A Deposit Variance explanation is required when the deposited amount differs from cash sales.');
            document.getElementById(section + 'DepositVarianceReason')?.focus();
            return;
        }

        const formData = new FormData();
        formData.append('SalesReportId', reportId);
        formData.append('Section', section === 'opening' ? 'Opening' : 'Closing');
        formData.append('DepositedAmount', amountVal.toFixed(2));
        formData.append('DepositBankName', bankName);
        formData.append('DepositReferenceNumber', refNum);
        if (dateVal) formData.append('DepositDate', dateVal);
        if (varianceReason) formData.append('DepositVarianceReason', varianceReason);

        if (depositFiles[section]) {
            formData.append('depositSlipFile', depositFiles[section]);
        }

        try {
            const response = await fetch('/SalesReports/UploadDepositSlip', {
                method: 'POST',
                body: formData
            });
            if (response.ok) {
                const data = await response.json();
                alert(data.message || 'Deposit slip saved successfully!');
                window.location.reload();
            } else {
                const text = await response.text();
                alert('Error: ' + text);
            }
        } catch (err) {
            console.error(err);
            alert('Network error saving deposit slip.');
        }
    };
    document.addEventListener('DOMContentLoaded', () => {
        const inputEl = document.getElementById('HandoverCashInput');
        if (inputEl) {
            // Force value initialization to match combined total cash sales if it was loading closing sales placeholder (3000)
            const currentValue = parseFloat(inputEl.value) || 0;
            if (currentValue === @(Model.CashSales.ToString(System.Globalization.CultureInfo.InvariantCulture)) && combinedCashSales > currentValue) {
                inputEl.value = combinedCashSales.toFixed(2);
            }

            inputEl.addEventListener('input', (e) => {
                const handoverCash = parseFloat(e.target.value) || 0;
                document.getElementById('topHandoverMirror').value = handoverCash.toFixed(2);
                document.getElementById('topCountedMirror').value = (handoverCash + openingCashSales).toFixed(2);
                updateShortOverNotice(handoverCash);
                updateMgrDepositComparison();
            });
        }

        // Initialize values
        const initialHandover = parseFloat(inputEl?.value) || 0;
        document.getElementById('topHandoverMirror').value = initialHandover.toFixed(2);
        document.getElementById('topCountedMirror').value = (initialHandover + openingCashSales).toFixed(2);
        updateShortOverNotice(initialHandover);
        updateMgrDepositComparison();

        const mgrDropzone = document.getElementById('mgrDepositDropzone');
        if (mgrDropzone) {
            ['dragenter', 'dragover'].forEach(eventName => {
                mgrDropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    mgrDropzone.classList.add('border-primary', 'bg-surface-container-low');
                }, false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                mgrDropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    mgrDropzone.classList.remove('border-primary', 'bg-surface-container-low');
                }, false);
            });
            mgrDropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files && files.length > 0) {
                    setMgrDepositFile(files[0]);
                }
            });
        }
    });

    // Close export dropdown when clicking outside
    document.addEventListener('click', (e) => {
        const container = document.getElementById('exportDropdownContainer');
        const menu = document.getElementById('exportMenu');
        if (container && menu && !container.contains(e.target)) {
            menu.classList.add('hidden');
        }
    });

    // Dynamic Image Export Renderer (Gemini reference template)
    function exportReportAsImage(section) {
        document.getElementById('exportMenu').classList.add('hidden');
        
        // Create an offscreen layout canvas container following the Gemini reference report layout card design
        const reportContainer = document.createElement('div');
        reportContainer.style.position = 'fixed';
        reportContainer.style.top = '0';
        reportContainer.style.left = '0';
        reportContainer.style.zIndex = '-9999';
        reportContainer.style.opacity = '1';
        reportContainer.style.visibility = 'visible';
        reportContainer.style.pointerEvents = 'none';
        reportContainer.style.width = '960px';
        reportContainer.style.background = '#f8fafc';
        reportContainer.style.padding = '48px';
        reportContainer.style.color = '#0f172a';
        reportContainer.style.boxSizing = 'border-box';

        const isOpening = section === 'opening';
        const selectEl = document.getElementById('EstablishmentId');
        const estName = selectEl && selectEl.options[selectEl.selectedIndex] && selectEl.options[selectEl.selectedIndex].text !== "Select branch..." 
            ? selectEl.options[selectEl.selectedIndex].text.toUpperCase() 
            : "MAIN";
        const sectionTitle = isOpening ? `OPENING ${estName} SALES` : `CLOSING ${estName} SALES`;
        const cashierVal = isOpening ? "@Model.OpeningInputtedByName" : "@Model.ClosingInputtedByName";

        // Mappings
        const grossVal = isOpening ? "@Model.OpeningGrossSales.ToString("N2")" : "@Model.ClosingGrossSales.ToString("N2")";
        const combinedGross = "@Model.CombinedGrossSales.ToString("N2")";
        const foodVal = isOpening ? "@Model.OpeningFoodSales.ToString("N2")" : "@Model.FoodSales.ToString("N2")";
        const beerVal = isOpening ? "@Model.OpeningBeerSales.ToString("N2")" : "@Model.BeerSales.ToString("N2")";
        const bevVal = isOpening ? "@Model.OpeningBeverageSales.ToString("N2")" : "@Model.BeverageSales.ToString("N2")";
        const hardVal = isOpening ? "@Model.OpeningHardSales.ToString("N2")" : "@Model.HardSales.ToString("N2")";
        const otherVal = isOpening ? "@Model.OpeningOtherSales.ToString("N2")" : "@Model.OtherSales.ToString("N2")";

        const cashVal = isOpening ? "@Model.OpeningCashSales.ToString("N2")" : "@Model.CashSales.ToString("N2")";
        
        // Detailed collection list items compiled server-side
        const gcashItems = [];
        @foreach (var line in Model.GCashLines)
        {
            @:if (!isOpening) {
            @:    gcashItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "GCash Line"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningGCashLines)
        {
            @:if (isOpening) {
            @:    gcashItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "GCash Line"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const bankItems = [];
        @foreach (var line in Model.BankTransferLines)
        {
            @:if (!isOpening) {
            @:    bankItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Bank Transfer"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningBankTransferLines)
        {
            @:if (isOpening) {
            @:    bankItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Bank Transfer"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const cardItems = [];
        @foreach (var line in Model.CardLines)
        {
            @:if (!isOpening) {
            @:    cardItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Card"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningCardLines)
        {
            @:if (isOpening) {
            @:    cardItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Card"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const creditItems = [];
        @foreach (var line in Model.CreditLines)
        {
            @:if (!isOpening) {
            @:    creditItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Credit"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningCreditLines)
        {
            @:if (isOpening) {
            @:    creditItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Credit"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const runawayItems = [];
        @foreach (var line in Model.RunawayCustomerLines)
        {
            @:if (!isOpening) {
            @:    runawayItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Run-away"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningRunawayCustomerLines)
        {
            @:if (isOpening) {
            @:    runawayItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Run-away"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const expenseItems = [];
        @foreach (var line in Model.ExpenseFromSalesLines)
        {
            @:if (!isOpening) {
            @:    expenseItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Expense"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningExpenseFromSalesLines)
        {
            @:if (isOpening) {
            @:    expenseItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Expense"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const discountVal = isOpening ? "@Model.OpeningTotalDiscounts.ToString("N2")" : "@Model.TotalDiscounts.ToString("N2")";
        const runawayVal = isOpening ? "@Model.OpeningTotalRunawayCustomer.ToString("N2")" : "@Model.TotalRunawayCustomer.ToString("N2")";
        const expensesVal = isOpening ? "@Model.OpeningTotalExpensesFromSales.ToString("N2")" : "@Model.TotalExpensesFromSales.ToString("N2")";
        
        const restoPcfVal = isOpening ? "@Model.OpeningRestoPcf.ToString("N2")" : "@Model.RestoPcf.ToString("N2")";
        const pcfFromSalesVal = isOpening ? "@Model.OpeningPcfFromSales.ToString("N2")" : "@Model.PcfFromSales.ToString("N2")";
        const shortageVal = isOpening ? "@Model.OpeningSalesShortageAmount.ToString("N2")" : "@Model.SalesShortageAmount.ToString("N2")";
        const overageVal = isOpening ? "@Model.OpeningSalesOverageAmount.ToString("N2")" : "@Model.SalesOverageAmount.ToString("N2")";

        // Mappings for totals
        const gcashVal = isOpening ? "@Model.OpeningTotalGCash.ToString("N2")" : "@Model.TotalGCash.ToString("N2")";
        const transferVal = isOpening ? "@Model.OpeningTotalBankTransfer.ToString("N2")" : "@Model.TotalBankTransfer.ToString("N2")";
        const cardCreditVal = isOpening ? "@Model.OpeningTotalCredit.ToString("N2")" : "@Model.TotalCredit.ToString("N2")";

        const renderDetailedLines = (label, list, sumVal) => {
            let html = `
                <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px; font-weight: bold; background-color: #f8fafc; padding: 4px 8px; border-radius: 6px; margin-top: 8px;">
                    <span>${label}</span>
                    <span style="font-family: monospace; color: #041632;">₱ ${sumVal}</span>
                </div>
            `;
            if (list.length > 0) {
                list.forEach(item => {
                    html += `
                        <div style="display: flex; justify-content: space-between; padding-left: 28px; font-size: 14px; color: #475569; padding-bottom: 4px;">
                            <span>↳ ${item.label}</span>
                            <span style="font-family: monospace;">₱ ${item.amount}</span>
                        </div>
                    `;
                });
            }
            return html;
        };

        reportContainer.innerHTML = `
            <div style="margin-bottom: 24px;">
                <h1 style="font-size: 40px; font-weight: 900; color: #041632; margin: 0; text-transform: uppercase; letter-spacing: -0.02em; font-family: 'Inter', sans-serif; font-style: normal; font-weight: 900;">${sectionTitle}</h1>
                <p style="font-size: 18px; color: #475569; margin: 8px 0 0 0; font-weight: 700;">
                    @Model.BusinessDate.ToString("MMMM d, yyyy") • @Model.BusinessDate.ToString("dddd") | Cashier: ${cashierVal}
                </p>
            </div>

            <!-- SALES SUMMARY SECTION -->
            <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05); margin-bottom: 20px; overflow: hidden;">
                <div style="background: #3B5B92; padding: 16px 20px; color: #ffffff; font-size: 15px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">
                    SALES SUMMARY
                </div>
                <div style="padding: 20px; font-size: 17px; color: #334155; line-height: 2.15;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px; font-weight: bold;">
                        <span>Total Gross Sales (Opening + Closing)</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 19px;">₱ ${isOpening ? grossVal : combinedGross}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px;">
                        <span>${isOpening ? 'Opening' : 'Closing'} Gross Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 19px; font-weight: 700;">₱ ${grossVal}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px;">
                        <span>Food Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 19px; font-weight: 700;">₱ ${foodVal}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px;">
                        <span>Beer Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 19px; font-weight: 700;">₱ ${beerVal}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span>Beverages Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 19px; font-weight: 700;">₱ ${bevVal}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px;">
                        <span>Hard Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 19px; font-weight: 700;">₱ ${hardVal}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span>Other Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 19px; font-weight: 700;">₱ ${otherVal}</strong>
                    </div>
                </div>
            </div>

            <!-- COLLECTION & PAYMENTS SECTION -->
            <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05); margin-bottom: 20px; overflow: hidden;">
                <div style="background: #3B5B92; padding: 16px 20px; color: #ffffff; font-size: 15px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">
                    COLLECTION & PAYMENTS
                </div>
                <div style="padding: 20px; font-size: 17px; color: #334155; line-height: 2.15;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px; font-weight: bold;">
                        <span>Cash Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 19px;">₱ ${cashVal}</strong>
                    </div>
                    
                    ${renderDetailedLines('G-Cash Sales', gcashItems, gcashVal)}
                    ${renderDetailedLines('Bank Transfers', bankItems, transferVal)}
                    ${renderDetailedLines('Card & Credit Payments', [...cardItems, ...creditItems], cardCreditVal)}
                </div>
            </div>

            <!-- DEDUCTIONS & EXPENSES SECTION -->
            <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05); margin-bottom: 24px; overflow: hidden;">
                <div style="background: #475569; padding: 16px 20px; color: #ffffff; font-size: 15px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">
                    DEDUCTIONS & EXPENSES
                </div>
                <div style="padding: 20px; font-size: 17px; color: #334155; line-height: 2.15;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px;">
                        <span>Discounts / Vouchers</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 19px; font-weight: 700;">₱ ${discountVal}</strong>
                    </div>

                    ${renderDetailedLines('Run-away Customers', runawayItems, runawayVal)}
                    ${renderDetailedLines('Expenses from Sales', expenseItems, expensesVal)}

                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px; margin-top: 8px;">
                        <span>Resto PCF / PCF from Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 19px; font-weight: 700;">₱ ${restoPcfVal} / ₱ ${pcfFromSalesVal}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span>Shortage / Overage</span>
                        <strong style="font-family: monospace; color: #b91c1c; font-size: 19px; font-weight: 700;">-₱ ${shortageVal} / +₱ ${overageVal}</strong>
                    </div>
                </div>
            </div>

            <!-- FOOTER NOTICE -->
            <div style="text-align: center; font-size: 14px; color: #94a3b8; font-weight: 600;">
                Verified Report - @DateTime.Today.ToString("MMMM d, yyyy")
            </div>
        `;

        document.body.appendChild(reportContainer);

        // Load html2canvas dynamically if not loaded
        const capture = () => {
            html2canvas(reportContainer, {
                backgroundColor: '#f8fafc',
                scale: 2,
                logging: false,
                useCORS: true,
                allowTaint: true,
                scrollX: 0,
                scrollY: 0,
                windowWidth: 960
            }).then(async canvas => {
                if (reportContainer.parentNode) {
                    document.body.removeChild(reportContainer);
                }
                const filename = `DailySales_${section.toUpperCase()}_@((Model.BusinessDate).ToString("yyyyMMdd")).png`;
                if (window.deliverExportedImage) {
                    await window.deliverExportedImage(canvas, filename, 'Daily Sales Report');
                }
            }).catch(err => {
                console.error("Export failed:", err);
                if (reportContainer.parentNode) {
                    document.body.removeChild(reportContainer);
                }
                alert('Could not export report as image. Please try again.');
            });
        };

        if (typeof html2canvas === 'undefined') {
            const script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
            script.onload = capture;
            document.head.appendChild(script);
        } else {
            capture();
        }
    }

    // Zoom Lightbox Handlers
    function openLightbox(src) {
        const lightbox = document.getElementById('lightboxModal');
        const lightboxImg = document.getElementById('lightbox-img');
        if (lightbox && lightboxImg) {
            lightboxImg.src = src;
            lightbox.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        }
    }
    function closeLightbox() {
        const lightbox = document.getElementById('lightboxModal');
        if (lightbox) {
            lightbox.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }
    }
    window.closeLightbox = closeLightbox;
</script>

<!-- Lightbox Modal for Full Image View -->
<div id="lightboxModal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true">
    <div class="absolute inset-0 bg-primary/90 backdrop-blur-sm cursor-pointer" onclick="closeLightbox()"></div>
    <div class="relative z-10 h-full w-full p-space-6 flex flex-col items-center justify-center" onclick="closeLightbox()">
        <img src="" id="lightbox-img" class="max-w-full max-h-[88vh] object-contain rounded-lg shadow-2xl bg-white border border-surface-border" />
        <span class="text-on-primary/60 text-[11px] font-label-caps uppercase mt-space-3 pointer-events-none">Click anywhere to close</span>
    </div>
</div>
