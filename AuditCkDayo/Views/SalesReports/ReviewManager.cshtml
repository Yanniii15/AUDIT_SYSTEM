<script>
    function setOpeningPreview(el, src) {
        document.getElementById('opening-main-preview').src = src;
        el.parentElement.querySelectorAll('.ring-2').forEach(thumb => {
            thumb.classList.remove('ring-2', 'ring-primary');
        });
        el.classList.add('ring-2', 'ring-primary');
    }

    function setClosingPreview(el, src) {
        document.getElementById('closing-main-preview').src = src;
        el.parentElement.querySelectorAll('.ring-2').forEach(thumb => {
            thumb.classList.remove('ring-2', 'ring-primary');
        });
        el.classList.add('ring-2', 'ring-primary');
    }

    function triggerTopForm(actionType) {
        document.getElementById('actionTypeField').value = actionType;
        document.getElementById('topActionForm').submit();
    }

    // Mathematical dynamic updates
    const expectedBaseline = @(Model.CombinedExpectedCashToHandover.ToString(System.Globalization.CultureInfo.InvariantCulture));
    const openingCashSales = @(Model.OpeningCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture));
    const combinedCashSales = @(Model.CombinedCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture));

    function updateShortOverNotice(handoverCash) {
        // Combined Expected Handover Cash is compared directly against Combined Cash Sales
        const expected = combinedCashSales;
        const variance = handoverCash - expected;
        const label = document.getElementById('short-over-label');
        const amount = document.getElementById('short-over-amount');
        if (label) {
            label.innerText = variance < 0 ? 'Short / Over Notice (Short)' : variance > 0 ? 'Short / Over Notice (Over)' : 'Short / Over Notice (Balanced)';
        }
        if (amount) {
            amount.innerText = `₱${Math.abs(variance).toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
        }
        const card = document.getElementById('short-over-card');
        if (card) {
            card.className = `bg-surface-container-low rounded-lg p-space-4 border-l-4 ${variance === 0 ? 'border-audit-success' : 'border-audit-error'} shadow-sm`;
        }
    }

    function updateMgrDepositComparison() {
        const handoverInput = document.getElementById('HandoverCashInput');
        const handoverVal = parseFloat(handoverInput ? handoverInput.value : @(Model.ConfirmedCashToHandover.ToString(System.Globalization.CultureInfo.InvariantCulture))) || @(Model.CombinedCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture));
        const depositInput = document.getElementById('mgrDepositAmount');
        const banner = document.getElementById('mgrDepositComparisonBanner');
        const bannerText = document.getElementById('mgrDepositComparisonText');
        const varianceGroup = document.getElementById('mgrVarianceGroup');
        const varianceInput = document.getElementById('mgrDepositVarianceReason');
        if (!depositInput || !banner) return;

        const entered = parseFloat(depositInput.value) || 0;
        const diff = entered - handoverVal;
        const absDiff = Math.abs(diff);

        if (absDiff < 0.01) {
            banner.className = 'rounded-lg p-3 text-xs flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400';
            if (bannerText) {
                bannerText.innerHTML = `<strong>Balanced:</strong> Deposited amount matches cash handover (₱${handoverVal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}).`;
            }
            if (varianceGroup) varianceGroup.classList.add('hidden');
            if (varianceInput) varianceInput.required = false;
        } else {
            const sign = diff > 0 ? '+' : '-';
            const statusType = diff > 0 ? 'Over' : 'Short';
            banner.className = 'rounded-lg p-3 text-xs flex items-center gap-2 bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400';
            if (bannerText) {
                bannerText.innerHTML = `<strong>Discrepancy (${statusType}):</strong> Variance of ${sign}₱${absDiff.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} between deposited amount and cash handover. A variance explanation is mandatory.`;
            }
            if (varianceGroup) varianceGroup.classList.remove('hidden');
            if (varianceInput) varianceInput.required = true;
        }
    }

    let selectedMgrDepositFile = null;

    window.handleMgrModalFileSelected = function(e) {
        const files = e.target.files;
        if (files && files.length > 0) {
            setMgrDepositFile(files[0]);
        }
    };

    function setMgrDepositFile(file) {
        if (!file) return;
        const allowed = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
        if (!allowed.includes(file.type) && !file.name.match(/\.(png|jpe?g|webp)$/i)) {
            alert('Please upload a valid image (PNG, JPG, JPEG, WEBP).');
            return;
        }
        selectedMgrDepositFile = file;
        const previewContainer = document.getElementById('mgrFilePreviewContainer');
        const previewImg = document.getElementById('mgrFilePreviewImg');
        const fileNameSpan = document.getElementById('mgrFileNameText');
        const dropzonePlaceholder = document.getElementById('mgrDropzonePlaceholder');
        const scanOcrBtn = document.getElementById('btnMgrScanOcr');

        if (fileNameSpan) fileNameSpan.textContent = file.name;
        if (previewImg) {
            const reader = new FileReader();
            reader.onload = (e) => {
                previewImg.src = e.target.result;
                if (previewContainer) previewContainer.classList.remove('hidden');
                if (dropzonePlaceholder) dropzonePlaceholder.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        }
        if (scanOcrBtn) {
            scanOcrBtn.disabled = false;
        }
    }

    window.scanMgrDepositSlipOcr = async function() {
        if (!selectedMgrDepositFile) {
            alert('Please select or drop a deposit slip image first.');
            return;
        }
        const scanBtn = document.getElementById('btnMgrScanOcr');
        const scanBtnText = document.getElementById('btnMgrScanOcrText');
        const scanOcrSpinner = document.getElementById('mgrScanOcrSpinner');
        const statusNote = document.getElementById('mgrOcrStatusNote');

        if (scanBtn) scanBtn.disabled = true;
        if (scanOcrSpinner) scanOcrSpinner.classList.remove('hidden');
        if (scanBtnText) scanBtnText.textContent = 'Scanning...';

        try {
            const formData = new FormData();
            formData.append('depositSlipImage', selectedMgrDepositFile);
            const res = await fetch('/SalesReports/ExtractDepositSlipOcr', {
                method: 'POST',
                body: formData
            });
            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    let filled = [];
                    if (data.detectedBank) {
                        document.getElementById('mgrDepositBankName').value = data.detectedBank;
                        filled.push('Bank: ' + data.detectedBank);
                    }
                    if (data.detectedAmount) {
                        document.getElementById('mgrDepositAmount').value = Number(data.detectedAmount).toFixed(2);
                        filled.push('Amount: ₱' + Number(data.detectedAmount).toFixed(2));
                        updateMgrDepositComparison();
                    }
                    if (data.detectedReference) {
                        document.getElementById('mgrDepositRef').value = data.detectedReference;
                        filled.push('Ref: ' + data.detectedReference);
                    }
                    if (data.detectedDate) {
                        document.getElementById('mgrDepositDate').value = data.detectedDate;
                        filled.push('Date: ' + data.detectedDate);
                    }
                    if (statusNote) {
                        statusNote.className = 'text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1';
                        statusNote.innerHTML = '<span class="material-symbols-outlined text-[14px]">check</span> <span></span>';
                        statusNote.querySelector('span:last-child').textContent = 'Auto-filled via OCR (' + (filled.join(', ') || 'Fields detected') + ')';
                        statusNote.classList.remove('hidden');
                    }
                } else {
                    if (statusNote) {
                        statusNote.className = 'text-[11px] text-amber-500 font-semibold flex items-center gap-1';
                        statusNote.innerHTML = '<span class="material-symbols-outlined text-[14px]">info</span> OCR could not read all fields clearly. Please verify inputs manually.';
                        statusNote.classList.remove('hidden');
                    }
                }
            } else {
                if (statusNote) {
                    statusNote.className = 'text-[11px] text-red-500 font-semibold';
                    statusNote.textContent = 'OCR extraction failed. Please enter details manually.';
                    statusNote.classList.remove('hidden');
                }
            }
        } catch (err) {
            console.error('OCR Error:', err);
            if (statusNote) {
                statusNote.className = 'text-[11px] text-red-500 font-semibold';
                statusNote.textContent = 'Error connecting to OCR service.';
                statusNote.classList.remove('hidden');
            }
        } finally {
            if (scanBtn) scanBtn.disabled = false;
            if (scanOcrSpinner) scanOcrSpinner.classList.add('hidden');
            if (scanBtnText) scanBtnText.textContent = 'Scan with OCR';
        }
    };

    window.handleMgrDepositSubmit = async function(event) {
        event.preventDefault();
        const errorBox = document.getElementById('mgrDepositErrorBox');
        const submitBtn = document.getElementById('btnMgrDepositSubmit');
        const submitText = document.getElementById('btnMgrDepositSubmitText');

        const reportId = @(Model.SalesReportId ?? 0);
        if (!reportId) {
            alert('Missing Sales Report ID.');
            return;
        }

        const bankName = document.getElementById('mgrDepositBankName')?.value || '';
        const refNum = document.getElementById('mgrDepositRef')?.value || '';
        const amountVal = parseFloat(document.getElementById('mgrDepositAmount')?.value) || 0;
        const dateVal = document.getElementById('mgrDepositDate')?.value || '';
        const varianceReason = document.getElementById('mgrDepositVarianceReason')?.value || '';

        const handoverInput = document.getElementById('HandoverCashInput');
        const handoverVal = parseFloat(handoverInput ? handoverInput.value : @(Model.ConfirmedCashToHandover.ToString(System.Globalization.CultureInfo.InvariantCulture))) || @(Model.CombinedCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture));
        const absDiff = Math.abs(amountVal - handoverVal);

        if (absDiff >= 0.01 && (!varianceReason || !varianceReason.trim())) {
            if (errorBox) {
                errorBox.textContent = 'A Deposit Variance explanation is required when the deposited amount differs from cash handover.';
                errorBox.classList.remove('hidden');
            }
            document.getElementById('mgrDepositVarianceReason')?.focus();
            return;
        }

        const formData = new FormData();
        formData.append('SalesReportId', reportId);
        formData.append('DepositedAmount', amountVal.toFixed(2));
        formData.append('DepositBankName', bankName);
        formData.append('DepositReferenceNumber', refNum);
        if (dateVal) formData.append('DepositDate', dateVal);
        if (varianceReason) formData.append('DepositVarianceReason', varianceReason);

        if (selectedMgrDepositFile) {
            formData.append('depositSlipFile', selectedMgrDepositFile);
        } else if (!@((Model.HasDepositSlip).ToString().ToLowerInvariant())) {
            if (errorBox) {
                errorBox.textContent = 'Please choose a deposit slip image.';
                errorBox.classList.remove('hidden');
            }
            return;
        }

        if (errorBox) {
            errorBox.classList.add('hidden');
            errorBox.textContent = '';
        }

        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.textContent = 'Saving...';

        try {
            const response = await fetch('/SalesReports/UploadDepositSlip', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const data = await response.json();
                alert(data.message || 'Deposit slip verified and recorded successfully!');
                window.location.reload();
            } else {
                let errorMsg = 'Failed to record deposit slip.';
                try {
                    const data = await response.json();
                    if (data && data.message) errorMsg = data.message;
                    else if (typeof data === 'string') errorMsg = data;
                } catch {
                    const text = await response.text();
                    if (text) errorMsg = text;
                }
                if (errorBox) {
                    errorBox.textContent = errorMsg;
                    errorBox.classList.remove('hidden');
                } else {
                    alert(errorMsg);
                }
            }
        } catch (err) {
            console.error('Upload Error:', err);
            if (errorBox) {
                errorBox.textContent = 'Network or server error while saving deposit slip.';
                errorBox.classList.remove('hidden');
            }
        } finally {
            if (submitBtn) submitBtn.disabled = false;
            if (submitText) submitText.textContent = 'Save & Record Deposit';
        }
    };

    document.addEventListener('DOMContentLoaded', () => {
        const inputEl = document.getElementById('HandoverCashInput');
        if (inputEl) {
            // Force value initialization to match combined total cash sales if it was loading closing sales placeholder (3000)
            const currentValue = parseFloat(inputEl.value) || 0;
            if (currentValue === @(Model.CashSales.ToString(System.Globalization.CultureInfo.InvariantCulture)) && combinedCashSales > currentValue) {
                inputEl.value = combinedCashSales.toFixed(2);
            }

            inputEl.addEventListener('input', (e) => {
                const handoverCash = parseFloat(e.target.value) || 0;
                document.getElementById('topHandoverMirror').value = handoverCash.toFixed(2);
                document.getElementById('topCountedMirror').value = (handoverCash + openingCashSales).toFixed(2);
                updateShortOverNotice(handoverCash);
                updateMgrDepositComparison();
            });
        }

        // Initialize values
        const initialHandover = parseFloat(inputEl?.value) || 0;
        document.getElementById('topHandoverMirror').value = initialHandover.toFixed(2);
        document.getElementById('topCountedMirror').value = (initialHandover + openingCashSales).toFixed(2);
        updateShortOverNotice(initialHandover);
        updateMgrDepositComparison();

        const mgrDropzone = document.getElementById('mgrDepositDropzone');
        if (mgrDropzone) {
            ['dragenter', 'dragover'].forEach(eventName => {
                mgrDropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    mgrDropzone.classList.add('border-primary', 'bg-surface-container-low');
                }, false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                mgrDropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    mgrDropzone.classList.remove('border-primary', 'bg-surface-container-low');
                }, false);
            });
            mgrDropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files && files.length > 0) {
                    setMgrDepositFile(files[0]);
                }
            });
        }
    });

    // Close export dropdown when clicking outside
    document.addEventListener('click', (e) => {
        const container = document.getElementById('exportDropdownContainer');
        const menu = document.getElementById('exportMenu');
        if (container && menu && !container.contains(e.target)) {
            menu.classList.add('hidden');
        }
    });

