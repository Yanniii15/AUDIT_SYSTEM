@model AuditCkDayo.ViewModels.SalesReportReviewViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Reconciliation Review Daily Sales Report";
    var establishments = ViewBag.Establishments as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
}

<div class="space-y-6">
    <div class="flex flex-col gap-space-2 max-w-3xl">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">fact_check</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Manager Reconciliation Review</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Review Daily Sales Report</h1>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            Verify the morning/evening logs, adjust any errors, and confirm to post cash-in.
        </p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="p-space-4 bg-audit-success/10 border border-audit-success/20 rounded-xl text-audit-success font-body-md flex items-center justify-between shadow-sm">
            <span><i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
        </div>
    }

    <!-- ROW 1: Control Panel Header and Combined Handover Metrics -->
    <div class="bg-surface-container-lowest p-space-6 rounded-xl border border-surface-border shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <span class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider">Business Date: @Model.BusinessDate.ToString("MMM d, yyyy")</span>
                <h2 class="text-headline-sm font-bold text-on-surface">Verification & Reconciliation Control Panel</h2>
            </div>
            
            <div class="flex gap-3 w-full sm:w-auto items-center">
                <!-- Export Section Images dropdown -->
                <div class="relative inline-block text-left" id="exportDropdownContainer">
                    <button type="button" onclick="document.getElementById('exportMenu').classList.toggle('hidden')" class="bg-surface-container text-primary border border-primary/20 px-4 py-2 rounded-lg font-label-caps uppercase tracking-wider hover:bg-primary/10 transition-all text-[11px] flex items-center gap-2">
                        <span class="material-symbols-outlined text-[16px]">image</span> Export Report Image
                    </button>
                    <div id="exportMenu" class="origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white border border-surface-border ring-1 ring-black ring-opacity-5 focus:outline-none hidden z-50">
                        <div class="py-1">
                            <button type="button" onclick="exportReportAsImage('opening')" class="text-on-surface hover:bg-surface-container-low block w-full text-left px-4 py-2 text-[11px] font-label-caps uppercase tracking-wide flex items-center gap-2">
                                <span class="material-symbols-outlined text-[16px]">wb_twilight</span> Export Opening Sales
                            </button>
                            <button type="button" onclick="exportReportAsImage('closing')" class="text-on-surface hover:bg-surface-container-low block w-full text-left px-4 py-2 text-[11px] font-label-caps uppercase tracking-wide flex items-center gap-2 border-t border-surface-border">
                                <span class="material-symbols-outlined text-[16px]">nights_stay</span> Export Closing Sales
                            </button>
                        </div>
                    </div>
                </div>

                <button type="button" onclick="triggerTopForm('SaveDraft')" class="bg-surface-container text-primary border border-primary/20 px-5 py-2 rounded-lg font-label-caps uppercase tracking-wider hover:bg-primary/10 transition-all text-[11px] flex items-center gap-2">
                    <span class="material-symbols-outlined text-[16px]">save</span> Save Draft
                </button>
                <button type="button" onclick="triggerTopForm('@Model.PrimaryActionType')" class="bg-primary text-on-primary px-6 py-2 rounded-lg font-label-caps uppercase tracking-wider hover:bg-primary/95 transition-all text-[11px] flex items-center gap-2 shadow-sm">
                    <span class="material-symbols-outlined text-[16px]">@Model.PrimaryActionIcon</span> @Model.PrimaryActionText
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-5 gap-space-4 pt-2">
            <div class="bg-surface-container-low rounded-lg p-space-4 border border-surface-border">
                <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Opening Cash Sales</div>
                <div class="text-body-md font-bold text-on-surface font-data-mono text-[18px]">
                    ₱@Model.OpeningCashSales.ToString("N2")
                </div>
            </div>
            <div class="bg-surface-container-low rounded-lg p-space-4 border border-surface-border">
                <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Closing Cash Sales</div>
                <div class="text-body-md font-bold text-on-surface font-data-mono text-[18px]" id="display_closing_cash_sales">
                    ₱@Model.CashSales.ToString("N2")
                </div>
            </div>
            <div class="bg-surface-container-low rounded-lg p-space-4 border-l-4 border-primary shadow-sm">
                <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Combined Cash Sales</div>
                <div class="text-primary font-bold font-data-mono text-[18px]" id="display_combined_cash_sales">
                    ₱@Model.CombinedCashSales.ToString("N2")
                </div>
            </div>
            <div class="bg-surface-container-low rounded-lg p-space-4 border border-surface-border ring-2 ring-primary/20">
                <div class="text-[9px] uppercase font-bold text-primary tracking-wider mb-1">Total Handover Cash (Editable)</div>
                @if (Model.CanConfirmToTreasury)
                {
                    <input type="number" step="0.01" value="@Model.ConfirmedCashToHandover.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="w-full bg-transparent border-0 border-b border-primary focus:outline-none font-bold font-data-mono text-[22px] text-primary p-0" id="HandoverCashInput" />
                }
                else
                {
                    <div class="text-body-md font-bold text-on-surface font-data-mono text-[18px]">
                        ₱@Model.ConfirmedCashToHandover.ToString("N2")
                    </div>
                }
            </div>
            @{
                var initialVariance = Model.ConfirmedCashToHandover - Model.CombinedCashSales;
                var initialLabel = initialVariance < 0 ? "Short" : initialVariance > 0 ? "Over" : "Balanced";
            }
            <div class="bg-surface-container-low rounded-lg p-space-4 border-l-4 @(initialVariance == 0m ? "border-audit-success" : "border-audit-error") shadow-sm" id="short-over-card">
                <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1" id="short-over-label">Short / Over Notice (@initialLabel)</div>
                <div class="font-bold font-data-mono text-[18px] @(initialVariance == 0m ? "text-audit-success" : "text-audit-error")" id="short-over-amount">
                    ₱@Math.Abs(initialVariance).ToString("N2")
                </div>
            </div>
        </div>
    </div>

    <!-- BANK DEPOSIT VERIFICATION CARD -->
    <div class="bg-surface-container-lowest p-space-6 rounded-xl border border-surface-border shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b border-surface-border pb-3">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[22px]">account_balance</span>
                <div>
                    <h3 class="font-headline-sm text-sm font-bold text-on-surface">Bank Deposit Verification</h3>
                    <span class="text-[11px] text-on-surface-variant">Verify branch bank deposit slip against cash handover.</span>
                </div>
            </div>
            <div>
                @if (Model.HasDepositSlip)
                {
                    if (Model.IsDepositMatched)
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
                            <span class="material-symbols-outlined text-[16px]">check_circle</span>
                            Deposit Matched (₱@Model.DepositedAmount?.ToString("N2"))
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/30" title="@Model.DepositVarianceReason">
                            <span class="material-symbols-outlined text-[16px]">warning</span>
                            Deposit Variance (@(Model.DepositVariance > 0 ? "+" : "")₱@Model.DepositVariance.ToString("N2"))
                        </span>
                    }
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30">
                        <span class="material-symbols-outlined text-[16px]">pending</span>
                        Awaiting Deposit Slip
                    </span>
                }
            </div>
        </div>

        <!-- Existing Deposit Slip Preview (if uploaded) -->
        @if (Model.HasDepositSlip)
        {
            <div class="rounded-xl border border-surface-border bg-surface-container-low p-4">
                <div class="flex flex-col md:flex-row gap-4 items-start">
                    <div class="w-full md:w-48 h-36 bg-surface-container-highest rounded-lg overflow-hidden flex items-center justify-center relative border border-surface-border flex-shrink-0 cursor-pointer group" onclick="openLightbox('@Model.DepositSlipImageUrl')">
                        <img src="@Model.DepositSlipImageUrl" class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform" alt="Deposit Slip" />
                        <div class="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity text-white text-xs font-semibold gap-1">
                            <span class="material-symbols-outlined text-sm">zoom_in</span> Zoom
                        </div>
                    </div>
                    <div class="flex-1 space-y-2 text-xs">
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                            <div>
                                <span class="text-on-surface-variant block text-[10px] font-label-caps uppercase font-bold">Bank</span>
                                <span class="text-on-surface font-semibold text-sm">@(string.IsNullOrWhiteSpace(Model.DepositBankName) ? "—" : Model.DepositBankName)</span>
                            </div>
                            <div>
                                <span class="text-on-surface-variant block text-[10px] font-label-caps uppercase font-bold">Reference #</span>
                                <span class="text-on-surface font-mono font-semibold text-sm">@(string.IsNullOrWhiteSpace(Model.DepositReferenceNumber) ? "—" : Model.DepositReferenceNumber)</span>
                            </div>
                            <div>
                                <span class="text-on-surface-variant block text-[10px] font-label-caps uppercase font-bold">Deposited Amount</span>
                                <span class="text-primary font-mono font-bold text-sm">₱@Model.DepositedAmount?.ToString("N2")</span>
                            </div>
                            <div>
                                <span class="text-on-surface-variant block text-[10px] font-label-caps uppercase font-bold">Deposit Date</span>
                                <span class="text-on-surface font-semibold text-sm">@(Model.DepositDate?.ToString("MMM d, yyyy") ?? "—")</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.DepositVarianceReason))
                        {
                            <div class="p-2.5 rounded-lg bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400">
                                <span class="font-bold block text-[10px] uppercase font-label-caps">Variance Explanation:</span>
                                <span>@Model.DepositVarianceReason</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.DepositUploadedByName))
                        {
                            <div class="text-[11px] text-on-surface-variant">
                                Uploaded by <strong class="text-on-surface">@Model.DepositUploadedByName</strong> @(Model.DepositUploadedAt.HasValue ? "on " + Model.DepositUploadedAt.Value.ToString("MMM d, yyyy h:mm tt") : "")
                            </div>
                        }
                        <div class="pt-2">
                            <button type="button" onclick="document.getElementById('mgrDepositUploadSection').classList.toggle('hidden')" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-surface-border text-on-surface-variant hover:text-on-surface hover:bg-surface-container font-label-caps uppercase text-[10px] font-bold transition">
                                <span class="material-symbols-outlined text-[16px]">edit</span> Replace / Update Slip
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Deposit Slip Upload & Verification Section -->
        <div id="mgrDepositUploadSection" class="@(Model.HasDepositSlip ? "hidden" : "") rounded-xl border border-surface-border bg-surface-container-low/50 p-4 space-y-4">
            <!-- Dynamic Comparison Banner -->
            <div id="mgrDepositComparisonBanner" class="rounded-lg p-3 text-xs flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                <span id="mgrDepositComparisonText"><strong>Balanced:</strong> Deposited amount matches cash handover.</span>
            </div>

            <!-- Error message container -->
            <div id="mgrDepositErrorBox" class="hidden rounded-lg bg-red-500/10 border border-red-500/30 p-3 text-xs text-red-500"></div>

            <!-- Slip Dropzone and OCR Scan -->
            <div class="space-y-2">
                <label class="block text-xs font-semibold text-on-surface">Deposit Slip Image @(Model.HasDepositSlip ? "(Optional if keeping current)" : "*")</label>
                <div id="mgrDepositDropzone" onclick="document.getElementById('mgrDepositFileInput').click()" class="border-2 border-dashed border-outline-variant hover:border-primary rounded-xl p-4 text-center cursor-pointer transition bg-surface-container-low/50 hover:bg-surface-container-low">
                    <input type="file" id="mgrDepositFileInput" accept=".png,.jpg,.jpeg,.webp" class="hidden" onchange="handleMgrModalFileSelected(event)" />
                    <div id="mgrDropzonePlaceholder" class="space-y-1">
                        <span class="material-symbols-outlined text-primary text-3xl">cloud_upload</span>
                        <div class="text-xs text-on-surface font-medium">Click or drag &amp; drop deposit slip image</div>
                        <div class="text-[10px] text-on-surface-variant">PNG, JPG, JPEG, WEBP up to 10MB</div>
                    </div>
                    <div id="mgrFilePreviewContainer" class="hidden flex items-center justify-between gap-3 text-left">
                        <div class="flex items-center gap-2 min-w-0">
                            <img id="mgrFilePreviewImg" class="w-12 h-12 object-cover rounded-lg border border-surface-border flex-shrink-0" alt="Preview" />
                            <div class="min-w-0">
                                <span id="mgrFileNameText" class="text-xs font-semibold text-on-surface truncate block">filename.jpg</span>
                                <span class="text-[10px] text-on-surface-variant">Click to choose another</span>
                            </div>
                        </div>
                        <span class="material-symbols-outlined text-primary text-xl">check_circle</span>
                    </div>
                </div>

                <!-- OCR Action Row -->
                <div class="flex items-center justify-between gap-2 pt-1">
                    <button type="button" id="btnMgrScanOcr" onclick="scanMgrDepositSlipOcr()" disabled class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-high hover:bg-surface-container-highest border border-surface-border text-on-surface text-xs font-semibold disabled:opacity-50 disabled:cursor-not-allowed transition shadow-sm">
                        <span class="material-symbols-outlined text-sm">document_scanner</span>
                        <span id="btnMgrScanOcrText">Scan with OCR</span>
                        <span id="mgrScanOcrSpinner" class="hidden w-3 h-3 border-2 border-primary border-t-transparent rounded-full animate-spin"></span>
                    </button>
                    <div id="mgrOcrStatusNote" class="hidden text-[11px]"></div>
                </div>
            </div>

            <!-- Deposit Fields -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
                <div>
                    <label for="mgrDepositBankName" class="block text-xs font-semibold text-on-surface mb-1">Bank Name *</label>
                    <input type="text" id="mgrDepositBankName" list="mgrBankList" value="@Model.DepositBankName" placeholder="e.g. BDO, BPI" class="w-full rounded-lg border border-outline bg-surface px-3 py-2 text-xs text-on-surface focus:ring-1 focus:ring-primary" />
                    <datalist id="mgrBankList">
                        <option value="BDO" />
                        <option value="BPI" />
                        <option value="Metrobank" />
                        <option value="Security Bank" />
                        <option value="Landbank" />
                        <option value="UnionBank" />
                        <option value="RCBC" />
                        <option value="PNB" />
                        <option value="China Bank" />
                    </datalist>
                </div>
                <div>
                    <label for="mgrDepositRef" class="block text-xs font-semibold text-on-surface mb-1">Reference / Trans #</label>
                    <input type="text" id="mgrDepositRef" value="@Model.DepositReferenceNumber" placeholder="e.g. TRN-12345" class="w-full rounded-lg border border-outline bg-surface px-3 py-2 text-xs text-on-surface focus:ring-1 focus:ring-primary" />
                </div>
                <div>
                    <label for="mgrDepositAmount" class="block text-xs font-semibold text-on-surface mb-1">Deposited Amount (₱) *</label>
                    <input type="number" step="0.01" min="0.01" id="mgrDepositAmount" value="@(Model.DepositedAmount.HasValue ? Model.DepositedAmount.Value.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) : Model.ConfirmedCashToHandover.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" class="w-full rounded-lg border border-outline bg-surface px-3 py-2 text-xs text-on-surface font-data-mono font-bold focus:ring-1 focus:ring-primary" oninput="updateMgrDepositComparison()" />
                </div>
                <div>
                    <label for="mgrDepositDate" class="block text-xs font-semibold text-on-surface mb-1">Deposit Date *</label>
                    <input type="date" id="mgrDepositDate" value="@(Model.DepositDate.HasValue ? Model.DepositDate.Value.ToString("yyyy-MM-dd") : Model.BusinessDate.ToString("yyyy-MM-dd"))" class="w-full rounded-lg border border-outline bg-surface px-3 py-2 text-xs text-on-surface focus:ring-1 focus:ring-primary" />
                </div>
            </div>

            <!-- Variance Explanation (Mandatory if amounts differ) -->
            <div id="mgrVarianceGroup" class="hidden">
                <label for="mgrDepositVarianceReason" class="block text-xs font-semibold text-red-500 mb-1">Variance Explanation *</label>
                <textarea id="mgrDepositVarianceReason" rows="2" placeholder="Explain why deposited amount differs from cash handover..." class="w-full rounded-lg border border-red-500/50 bg-surface px-3 py-2 text-xs text-on-surface focus:ring-1 focus:ring-red-500">@Model.DepositVarianceReason</textarea>
            </div>

            <div class="pt-2 flex justify-end gap-2 border-t border-surface-border">
                <button type="button" id="btnMgrDepositSubmit" onclick="handleMgrDepositSubmit(event)" class="px-4 py-2 text-xs font-semibold rounded-lg bg-primary text-on-primary hover:bg-primary/90 shadow-sm transition inline-flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm">cloud_upload</span>
                    <span id="btnMgrDepositSubmitText">Save &amp; Record Deposit</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Main post form wrap -->
    <form asp-controller="SalesReports" asp-action="Review" method="post" enctype="multipart/form-data" class="space-y-6" id="topActionForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-audit-error bg-audit-error/10 border border-audit-error/20 p-space-4 rounded-lg text-body-md text-center"></div>
        
        <input type="hidden" asp-for="SalesReportId" />
        <input type="hidden" asp-for="DocumentRecordId" />
        <input type="hidden" asp-for="ImageUrl" />
        <input type="hidden" asp-for="EstablishmentId" />
        <input type="hidden" asp-for="BusinessDate" />
        <input type="hidden" asp-for="HandoverDate" />
        <input type="hidden" asp-for="CashierName" />
        <input type="hidden" asp-for="ConfirmedCashToHandover" id="topHandoverMirror" />
        <input type="hidden" asp-for="ManagerCountedTotalCash" id="topCountedMirror" />
        <input type="hidden" asp-for="GCashAmount" id="GCashAmount" />
        <input type="hidden" asp-for="CreditAmount" id="CreditAmount" />
        <input type="hidden" asp-for="OtherPaymentAmount" id="OtherPaymentAmount" />
        <input type="hidden" asp-for="CashOut" id="CashOut" />
        <input type="hidden" name="actionType" id="actionTypeField" value="SaveDraft" />

        @if (Model.ImageUrls != null)
        {
            for (int i = 0; i < Model.ImageUrls.Count; i++)
            {
                <input type="hidden" name="ImageUrls[@i]" value="@Model.ImageUrls[i]" />
            }
        }

        <!-- ROW 2: Forms Side-by-Side Comparison -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-8 items-start">
            
            <!-- LEFT HALF: Opening Daily Sales (Readonly) -->
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border overflow-hidden space-y-space-6 pb-space-6">
                <div class="bg-primary/95 px-space-6 py-space-4 flex justify-between items-center text-on-primary">
                    <span class="font-label-caps uppercase tracking-tighter text-[11px] font-bold">1. Opening Daily Sales Log</span>
                    <span class="text-[10px] font-data-mono bg-white/20 px-2 py-0.5 rounded text-white font-semibold">READONLY</span>
                </div>
                <div class="px-space-6 pt-space-4">
                    <div class="rounded-lg border border-surface-border bg-surface-container-low px-4 py-3">
                        <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Opening Inputted By</span>
                        <div class="font-body-md text-on-surface font-semibold">@Model.OpeningInputtedByName</div>
                    </div>
                </div>

                <!-- Opening Image Viewer -->
                <div class="px-space-6">
                    <div class="p-space-4 bg-surface-container-highest flex flex-col items-center justify-center min-h-[300px] relative border border-surface-border rounded-xl">
                        <img id="opening-main-preview" src="@(Model.ImageUrls != null && Model.ImageUrls.Count > 0 ? Model.ImageUrls[0] : "/img/placeholder.png")" class="max-w-full max-h-[350px] object-contain rounded-lg border border-surface-border/50 shadow-sm cursor-pointer hover:opacity-90 transition-opacity" alt="Opening Logbook" onclick="openLightbox(this.src)" />
                        <span class="text-on-surface-variant text-[10px] uppercase font-label-caps mt-2">Click photo to zoom</span>
                    </div>
                    @if (Model.ImageUrls != null && Model.ImageUrls.Count > 0)
                    {
                        <div class="p-space-3 mt-3 bg-surface-container-low border border-surface-border rounded-lg flex gap-2 overflow-x-auto">
                            @for (int i = 0; i < Model.ImageUrls.Count; i++)
                            {
                                <div class="w-12 h-12 flex-shrink-0 bg-black rounded border border-surface-border overflow-hidden cursor-pointer hover:border-primary transition-all @(i == 0 ? "ring-2 ring-primary" : "")" onclick="setOpeningPreview(this, '@Model.ImageUrls[i]')">
                                    <img src="@Model.ImageUrls[i]" class="w-full h-full object-contain" />
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Opening Financial Figures -->
                <div class="px-space-6 space-y-space-4">
                    <div class="rounded-xl border border-surface-border bg-surface-container-low/20 p-space-4 space-y-4">
                        <h3 class="font-label-caps text-on-surface uppercase text-[10px] tracking-wider font-bold">Financial Figures</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Gross Sales (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningGrossSales.ToString("N2")</div>
                            </div>
                            <div>
                                <span class="text-[10px] font-label-caps text-on-surface-variant block mb-1">Cash Sales (₱)</span>
                                <div class="bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 font-data-mono text-[13px] text-on-surface">@Model.OpeningCashSales.ToString("N2")</div>
