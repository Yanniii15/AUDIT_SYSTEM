                                <span asp-validation-for="EmployeeTenPercentDiscount" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="EmployeeFivePercentDiscount" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">EMPLOYEE 5% Discount (₱)</label>
                                <input asp-for="EmployeeFivePercentDiscount" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" step="0.01" />
                                <span asp-validation-for="EmployeeFivePercentDiscount" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="EaglesDiscount" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Eagles 5% Discount (₱)</label>
