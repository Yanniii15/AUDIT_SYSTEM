                                    <label asp-for="WitnessName" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Witness Name</label>
                                    <input asp-for="WitnessName" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                                    <span asp-validation-for="WitnessName" class="text-audit-error text-[11px]"></span>
                                </div>
                                <div class="flex flex-col gap-space-2 md:col-span-2">
                                    <label asp-for="Notes" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Notes</label>
                                    <textarea asp-for="Notes" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface resize-none" rows="2"></textarea>
                                    <span asp-validation-for="Notes" class="text-audit-error text-[11px]"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Line Items / Cash Breakdown Grid -->
                        <div class="pt-space-4 border-t border-surface-border">
                            <h4 class="font-headline-sm text-headline-sm text-[16px] text-on-surface mb-space-4 flex items-center gap-space-2">
                                <span class="material-symbols-outlined text-primary">list_alt</span>
                                Cash Denomination Breakdown
                            </h4>
                            
                            <div class="border border-surface-border rounded-xl max-h-[520px] overflow-y-auto overflow-x-auto">
                                <table class="w-full text-left border-collapse block lg:table">
                                    <thead class="hidden lg:table-header-group lg:sticky lg:top-0 lg:z-10">
                                        <tr class="bg-surface-container-low border-b border-surface-border">
                                            <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px]">Denomination</th>
                                            <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] w-28">Quantity</th>
                                            <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] w-32 text-right">Total (₱)</th>
                                            <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] w-12 text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="line-items-body" class="divide-y divide-surface-border block lg:table-row-group space-y-space-4 lg:space-y-0 p-space-4 lg:p-0">
                                        @for (int i = 0; i < Model.Items.Count; i++)
                                        {
                                            <tr class="hover:bg-surface-container-low/30 transition-colors line-item-row block lg:table-row grid grid-cols-2 gap-x-space-4 gap-y-space-3 p-space-4 border border-surface-border lg:border-0 rounded-xl bg-surface-container-lowest lg:bg-transparent shadow-sm lg:shadow-none">
                                                <td class="col-span-2 lg:col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                                                    <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Denomination</label>
                                                    <input asp-for="Items[i].Denomination" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface focus:ring-2 focus:ring-primary/15 focus:outline-none denom-input" type="number" step="0.01" required />
                                                </td>
                                                <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                                                    <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Quantity</label>
                                                    <input asp-for="Items[i].Quantity" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-center qty-input" type="number" min="0" required />
                                                </td>
                                                <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-right">
                                                    <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Total (₱)</label>
                                                    <input asp-for="Items[i].Total" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-right total-input" type="number" step="0.01" readonly />
                                                </td>
                                                <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-center flex items-center justify-end lg:justify-center">
                                                    <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Action</label>
                                                    <button type="button" class="text-audit-error hover:scale-110 transition-transform remove-row-btn" onclick="removeRow(this)">
                                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="mt-space-3 flex justify-end">
                                <button type="button" class="bg-surface-container text-on-surface border border-surface-border px-4 py-2 rounded-lg font-label-caps hover:bg-surface-container-high transition-all text-[11px] uppercase flex items-center gap-1 shadow-sm" onclick="addRow()">
                                    <span class="material-symbols-outlined text-[16px]">add</span> Add Line
                                </button>
                            </div>
                        </div>
                    }
                    <!-- Hidden compatibility fields to bind correctly on form post -->
                    <input type="hidden" asp-for="GCashAmount" id="GCashAmount" />
                    <input type="hidden" asp-for="CreditAmount" id="CreditAmount" />
                    <input type="hidden" asp-for="OtherPaymentAmount" id="OtherPaymentAmount" />
                    <input type="hidden" asp-for="CashOut" id="CashOut" />
                    <input type="hidden" asp-for="ConfirmedCashToHandover" id="confirmedCashToHandover" />

                    <!-- Form Actions -->
                    <div class="flex flex-col sm:flex-row gap-space-3 pt-space-5 border-t border-surface-border">
                        <button type="submit" name="actionType" value="SaveDraft" class="bg-surface-container text-primary border border-primary/20 px-space-6 py-3 rounded-lg font-label-caps uppercase tracking-widest hover:bg-primary/10 transition-all flex items-center justify-center gap-space-2 text-[12px]">
                            <span class="material-symbols-outlined text-[18px]">save</span>
                            Save Draft
                        </button>
                        <button type="submit" name="actionType" value="@Model.PrimaryActionType" class="bg-primary text-on-primary px-space-8 py-3 rounded-lg font-label-caps uppercase tracking-widest hover:bg-primary/95 transition-all flex items-center justify-center gap-space-2 shadow-md text-[12px]">
                            <span class="material-symbols-outlined text-[18px]">@Model.PrimaryActionIcon</span>
                            @Model.PrimaryActionText
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function setPreview(el, src) {
        document.getElementById('main-preview').src = src;
        el.parentElement.querySelectorAll('.ring-2').forEach(thumb => {
            thumb.classList.remove('ring-2', 'ring-primary');
        });
        el.classList.add('ring-2', 'ring-primary');
    }

    function reindexRows() {
        const rows = document.querySelectorAll('#line-items-body .line-item-row');
        rows.forEach((row, idx) => {
            const denomInput = row.querySelector('.denom-input');
            if (denomInput) {
                denomInput.name = `Items[${idx}].Denomination`;
                denomInput.id = `Items_${idx}__Denomination`;
            }
            const qtyInput = row.querySelector('.qty-input');
            if (qtyInput) {
                qtyInput.name = `Items[${idx}].Quantity`;
                qtyInput.id = `Items_${idx}__Quantity`;
            }
            const totalInput = row.querySelector('.total-input');
            if (totalInput) {
                totalInput.name = `Items[${idx}].Total`;
                totalInput.id = `Items_${idx}__Total`;
            }
        });
    }

    function calculateRowTotal(row) {
        const denom = parseFloat(row.querySelector('.denom-input').value) || 0;
        const qty = parseInt(row.querySelector('.qty-input').value) || 0;
        const total = denom * qty;
        row.querySelector('.total-input').value = total.toFixed(2);
        calculateOverallTotal();
    }

    function calculateOverallTotal() {
        let sum = 0;
        document.querySelectorAll('#line-items-body .total-input').forEach(input => {
            sum += parseFloat(input.value) || 0;
        });
        const amountField = document.getElementById('confirmedCashToHandover');
        if (amountField) {
            amountField.value = sum.toFixed(2);
        }
        const displayVal = document.getElementById('claimed-amount-display');
        if (displayVal) {
            displayVal.innerText = sum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        updateShortOverNotice(canConfirmToTreasury ? sum + openingCashSales : sum);
    }

    const canConfirmToTreasury = @(Model.CanConfirmToTreasury ? "true" : "false");
    const openingCashSales = @(Model.OpeningCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture));

    const expectedBaseline = (() => {
        const f = document.getElementById('confirmedCashToHandover');
        const closingExpected = f ? (parseFloat(f.value) || 0) : 0;
        return canConfirmToTreasury ? closingExpected + openingCashSales : closingExpected;
    })();

    function updateShortOverNotice(countedCash) {
        const expected = expectedBaseline;
        const variance = countedCash - expected;
        const label = document.getElementById('short-over-label');
        const amount = document.getElementById('short-over-amount');
        const expectedDisplay = document.getElementById('expected-cash-display');
        if (label) {
            label.innerText = variance < 0 ? 'Short' : variance > 0 ? 'Over' : 'Balanced';
        }
        if (amount) {
            amount.innerText = `₱${Math.abs(variance).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        }
        if (expectedDisplay) {
            expectedDisplay.innerText = expected.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    }


    function removeRow(btn) {
        const row = btn.closest('.line-item-row');
        row.remove();
        reindexRows();
        calculateOverallTotal();
    }

    function addRow() {
        const tbody = document.getElementById('line-items-body');
        const index = tbody.querySelectorAll('.line-item-row').length;
        
        const tr = document.createElement('tr');
        tr.className = "hover:bg-surface-container-low/30 transition-colors line-item-row block lg:table-row grid grid-cols-2 gap-x-space-4 gap-y-space-3 p-space-4 border border-surface-border lg:border-0 rounded-xl bg-surface-container-lowest lg:bg-transparent shadow-sm lg:shadow-none";
        
        tr.innerHTML = `
            <td class="col-span-2 lg:col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Denomination</label>
                <input name="Items[${index}].Denomination" id="Items_${index}__Denomination" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface focus:ring-2 focus:ring-primary/15 focus:outline-none denom-input" type="number" step="0.01" value="0.00" required />
            </td>
            <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Quantity</label>
                <input name="Items[${index}].Quantity" id="Items_${index}__Quantity" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-center qty-input" type="number" min="0" value="0" required />
            </td>
            <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-right">
                <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Total (₱)</label>
                <input name="Items[${index}].Total" id="Items_${index}__Total" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-right total-input" type="number" step="0.01" value="0.00" readonly />
            </td>
            <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-center flex items-center justify-end lg:justify-center">
                <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Action</label>
                <button type="button" class="text-audit-error hover:scale-110 transition-transform remove-row-btn" onclick="removeRow(this)">
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                </button>
            </td>
        `;
        
        tbody.appendChild(tr);
        
        // Bind event listeners
        const denomInput = tr.querySelector('.denom-input');
        const qtyInput = tr.querySelector('.qty-input');
        
        denomInput.addEventListener('input', () => calculateRowTotal(tr));
        qtyInput.addEventListener('input', () => calculateRowTotal(tr));
        
        reindexRows();
    }
    function reindexPaymentLines(containerId, propertyPrefix) {
        const container = document.getElementById(containerId);
        const rows = container.querySelectorAll('.payment-row');
        rows.forEach((row, idx) => {
            row.querySelectorAll('input').forEach(input => {
                const name = input.name;
                if (name.includes('.Id')) {
                    input.name = `${propertyPrefix}[${idx}].Id`;
                } else if (name.includes('.LineType')) {
                    input.name = `${propertyPrefix}[${idx}].LineType`;
                } else if (name.includes('.Amount')) {
                    input.name = `${propertyPrefix}[${idx}].Amount`;
                } else if (name.includes('.Label')) {
                    input.name = `${propertyPrefix}[${idx}].Label`;
                } else if (name.includes('.SortOrder')) {
                    input.name = `${propertyPrefix}[${idx}].SortOrder`;
                }
            });
        });
        calculateCollectionTotals();
    }

    function addPaymentRow(containerId, propertyPrefix, hasLabel = false) {
        const container = document.getElementById(containerId);
        const idx = container.querySelectorAll('.payment-row').length;
        
        const row = document.createElement('div');
        row.className = "flex items-center gap-2 payment-row";
        
        const lineType = propertyPrefix.replace('Lines', '');
        
        let html = `
            <input type="hidden" name="${propertyPrefix}[${idx}].Id" value="0" />
            <input type="hidden" name="${propertyPrefix}[${idx}].LineType" value="${lineType}" />
        `;
        
        if (hasLabel) {
            html += `
                <input type="text" name="${propertyPrefix}[${idx}].Label" class="w-1/2 bg-surface-container-low border border-surface-border rounded px-3 py-1 font-body-md text-on-surface" placeholder="Label/Reason" />
                <input type="number" step="0.01" name="${propertyPrefix}[${idx}].Amount" class="w-1/2 bg-surface-container-low border border-surface-border rounded px-3 py-1 font-data-mono text-on-surface amount-input" placeholder="Amount (₱)" />
            `;
        } else {
            html += `
                <input type="number" step="0.01" name="${propertyPrefix}[${idx}].Amount" class="w-full bg-surface-container-low border border-surface-border rounded px-3 py-1 font-data-mono text-on-surface amount-input" placeholder="Amount (₱)" />
            `;
        }
        
        html += `
            <button type="button" class="text-audit-error material-symbols-outlined text-[18px]" onclick="removePaymentRow(this)">delete</button>
        `;
        
        row.innerHTML = html;
        container.appendChild(row);
        
        row.querySelector('.amount-input').addEventListener('input', calculateCollectionTotals);
        reindexPaymentLines(containerId, propertyPrefix);
    }

    function removePaymentRow(btn) {
        const row = btn.closest('.payment-row');
        const container = row.parentElement;
        const containerId = container.id;
        let prefix = '';
        if (containerId === 'gcash-container') prefix = 'GCashLines';
        else if (containerId === 'bank-container') prefix = 'BankTransferLines';
        else if (containerId === 'card-container') prefix = 'CardLines';
        else if (containerId === 'credit-container') prefix = 'CreditLines';
        else if (containerId === 'runaway-container') prefix = 'RunawayCustomerLines';
        else if (containerId === 'expense-container') prefix = 'ExpenseFromSalesLines';
        
        row.remove();
        reindexPaymentLines(containerId, prefix);
    }

    function calculateCollectionTotals() {
        let gcashSum = 0;
        document.querySelectorAll('#gcash-container .amount-input').forEach(input => {
            gcashSum += parseFloat(input.value) || 0;
        });
        const gcashField = document.getElementById('GCashAmount');
        if (gcashField) gcashField.value = gcashSum.toFixed(2);

        let creditSum = 0;
        document.querySelectorAll('#credit-container .amount-input').forEach(input => {
            creditSum += parseFloat(input.value) || 0;
        });
        const creditField = document.getElementById('CreditAmount');
        if (creditField) creditField.value = creditSum.toFixed(2);

        let bankSum = 0;
        document.querySelectorAll('#bank-container .amount-input').forEach(input => {
            bankSum += parseFloat(input.value) || 0;
        });
        let cardSum = 0;
        document.querySelectorAll('#card-container .amount-input').forEach(input => {
            cardSum += parseFloat(input.value) || 0;
        });
        let runawaySum = 0;
        document.querySelectorAll('#runaway-container .amount-input').forEach(input => {
            runawaySum += parseFloat(input.value) || 0;
        });
        let otherPaymentSum = bankSum + cardSum + runawaySum;
        const otherPaymentField = document.getElementById('OtherPaymentAmount');
        if (otherPaymentField) otherPaymentField.value = otherPaymentSum.toFixed(2);

        let expenseSum = 0;
        document.querySelectorAll('#expense-container .amount-input').forEach(input => {
            expenseSum += parseFloat(input.value) || 0;
        });
        const cashOutField = document.getElementById('CashOut');
        if (cashOutField) cashOutField.value = expenseSum.toFixed(2);

        const countedCash = parseFloat(document.getElementById('confirmedCashToHandover')?.value) || 0;
        updateShortOverNotice(countedCash);
    }

    // Set up initial event listeners
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('#line-items-body .line-item-row').forEach(row => {
            const denomInput = row.querySelector('.denom-input');
            const qtyInput = row.querySelector('.qty-input');
            
            denomInput.addEventListener('input', () => calculateRowTotal(row));
            qtyInput.addEventListener('input', () => calculateRowTotal(row));
        });

        document.querySelectorAll('.amount-input').forEach(input => {
            input.addEventListener('input', calculateCollectionTotals);
        });

        document.getElementById('BusinessDate')?.addEventListener('change', (e) => {
            const date = new Date(e.target.value);
            if (!isNaN(date.getTime())) {
                const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                const display = document.getElementById('dayOfWeekDisplay');
                if (display) display.innerText = days[date.getDay()];
            }
        });

        const isBranchStaff = @(User.IsInRole("BranchStaff") ? "true" : "false");
        const canConfirmToTreasury = @(Model.CanConfirmToTreasury ? "true" : "false");
        const openingCashSales = @(Model.OpeningCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture));
        const cashSalesField = document.getElementById('CashSales');
        const syncCashSales = () => {
            const val = parseFloat(cashSalesField.value) || 0;
            const amountField = document.getElementById('confirmedCashToHandover');
            if (amountField) {
                amountField.value = val.toFixed(2);
            }
            const displayVal = document.getElementById('claimed-amount-display');
            if (displayVal) {
                displayVal.innerText = val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            updateShortOverNotice(val);
        };
        if (isBranchStaff) {
            syncCashSales();
        }
        cashSalesField?.addEventListener('input', syncCashSales);

        ['GrossSales', 'CashOut', 'GCashAmount', 'CreditAmount', 'OtherPaymentAmount', 'confirmedCashToHandover'].forEach(id => {
            document.getElementById(id)?.addEventListener('input', () => {
                const closingCounted = parseFloat(document.getElementById('confirmedCashToHandover')?.value) || 0;
                updateShortOverNotice(canConfirmToTreasury ? closingCounted + openingCashSales : closingCounted);
            });
        });
        calculateCollectionTotals();
        if (!isBranchStaff) {
            const closingCounted = parseFloat(document.getElementById('confirmedCashToHandover')?.value) || 0;
            updateShortOverNotice(canConfirmToTreasury ? closingCounted + openingCashSales : closingCounted);
        }
        // Lightbox Modal Handlers
        const mainPreview = document.getElementById('main-preview');
        const lightbox = document.getElementById('lightboxModal');
        const lightboxImg = document.getElementById('lightbox-img');

        function openLightbox() {
            if (lightbox && lightboxImg && mainPreview) {
                lightboxImg.src = mainPreview.src;
                lightbox.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            }
        }

        function closeLightbox() {
            if (lightbox) {
                lightbox.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }

        mainPreview?.addEventListener('click', openLightbox);
        document.querySelector('.inspect-trigger')?.addEventListener('click', openLightbox);
        window.closeLightbox = closeLightbox;
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeLightbox();
        });
    });

    // Close export dropdown when clicking outside
    document.addEventListener('click', (e) => {
        const container = document.getElementById('exportDropdownContainer');
        const menu = document.getElementById('exportMenu');
        if (container && menu && !container.contains(e.target)) {
            menu.classList.add('hidden');
        }
    });

    // Dynamic Image Export Renderer (Gemini reference template)
    function exportReportAsImage(section) {
        document.getElementById('exportMenu').classList.add('hidden');
        
        // Create an offscreen layout canvas container following the Gemini reference report layout card design
        const reportContainer = document.createElement('div');
        reportContainer.style.position = 'fixed';
        reportContainer.style.top = '-9999px';
        reportContainer.style.left = '-9999px';
        reportContainer.style.width = '600px';
        reportContainer.style.background = '#f8fafc';
        reportContainer.style.padding = '32px';
        reportContainer.style.color = '#0f172a';
        reportContainer.style.boxSizing = 'border-box';

        const isOpening = section === 'opening';
        const selectEl = document.getElementById('EstablishmentId');
        const estName = selectEl && selectEl.options[selectEl.selectedIndex] && selectEl.options[selectEl.selectedIndex].text !== "Select branch..." 
            ? selectEl.options[selectEl.selectedIndex].text.toUpperCase() 
            : "MAIN";
        const sectionTitle = isOpening ? `OPENING ${estName} SALES` : `CLOSING ${estName} SALES`;
        const cashierVal = "@(Model.CashierName ?? "N/A")";

        // Mappings
        const grossVal = isOpening ? "@Model.OpeningGrossSales.ToString("N2")" : "@Model.ClosingGrossSales.ToString("N2")";
        const combinedGross = "@Model.CombinedGrossSales.ToString("N2")";
        const foodVal = isOpening ? "@Model.OpeningFoodSales.ToString("N2")" : "@Model.FoodSales.ToString("N2")";
        const beerVal = isOpening ? "@Model.OpeningBeerSales.ToString("N2")" : "@Model.BeerSales.ToString("N2")";
        const bevVal = isOpening ? "@Model.OpeningBeverageSales.ToString("N2")" : "@Model.BeverageSales.ToString("N2")";
        const otherVal = isOpening ? "@Model.OpeningOtherSales.ToString("N2")" : "@Model.OtherSales.ToString("N2")";

        const cashVal = isOpening ? "@Model.OpeningCashSales.ToString("N2")" : "@Model.CashSales.ToString("N2")";
        
        // Detailed collection list items compiled server-side
        const gcashItems = [];
        @foreach (var line in Model.GCashLines)
        {
            @:if (!isOpening) {
            @:    gcashItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "GCash Line"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningGCashLines)
        {
            @:if (isOpening) {
            @:    gcashItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "GCash Line"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const bankItems = [];
        @foreach (var line in Model.BankTransferLines)
        {
            @:if (!isOpening) {
            @:    bankItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Bank Transfer"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningBankTransferLines)
        {
            @:if (isOpening) {
            @:    bankItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Bank Transfer"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const cardItems = [];
        @foreach (var line in Model.CardLines)
        {
            @:if (!isOpening) {
            @:    cardItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Card"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningCardLines)
        {
            @:if (isOpening) {
            @:    cardItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Card"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const creditItems = [];
        @foreach (var line in Model.CreditLines)
        {
            @:if (!isOpening) {
            @:    creditItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Credit"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningCreditLines)
        {
            @:if (isOpening) {
            @:    creditItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Credit"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const runawayItems = [];
        @foreach (var line in Model.RunawayCustomerLines)
        {
            @:if (!isOpening) {
            @:    runawayItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Run-away"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningRunawayCustomerLines)
        {
            @:if (isOpening) {
            @:    runawayItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Run-away"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const expenseItems = [];
        @foreach (var line in Model.ExpenseFromSalesLines)
        {
            @:if (!isOpening) {
            @:    expenseItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Expense"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }
        @foreach (var line in Model.OpeningExpenseFromSalesLines)
        {
            @:if (isOpening) {
            @:    expenseItems.push({ label: "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(line.Label ?? "Expense"))", amount: "@line.Amount.ToString("N2")" });
            @:}
        }

        const discountVal = isOpening ? "@Model.OpeningTotalDiscounts.ToString("N2")" : "@Model.TotalDiscounts.ToString("N2")";
        const runawayVal = isOpening ? "@Model.OpeningTotalRunawayCustomer.ToString("N2")" : "@Model.TotalRunawayCustomer.ToString("N2")";
        const expensesVal = isOpening ? "@Model.OpeningTotalExpensesFromSales.ToString("N2")" : "@Model.TotalExpensesFromSales.ToString("N2")";
        
        const restoPcfVal = isOpening ? "@Model.OpeningRestoPcf.ToString("N2")" : "@Model.RestoPcf.ToString("N2")";
        const pcfFromSalesVal = isOpening ? "@Model.OpeningPcfFromSales.ToString("N2")" : "@Model.PcfFromSales.ToString("N2")";
        const shortageVal = isOpening ? "@Model.OpeningSalesShortageAmount.ToString("N2")" : "@Model.SalesShortageAmount.ToString("N2")";
        const overageVal = isOpening ? "@Model.OpeningSalesOverageAmount.ToString("N2")" : "@Model.SalesOverageAmount.ToString("N2")";

        // Mappings for totals
        const gcashVal = isOpening ? "@Model.OpeningTotalGCash.ToString("N2")" : "@Model.TotalGCash.ToString("N2")";
        const transferVal = isOpening ? "@Model.OpeningTotalBankTransfer.ToString("N2")" : "@Model.TotalBankTransfer.ToString("N2")";
        const cardCreditVal = isOpening ? "@Model.OpeningTotalCredit.ToString("N2")" : "@Model.TotalCredit.ToString("N2")";

        const renderDetailedLines = (label, list, sumVal) => {
            let html = `
                <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px; font-weight: bold; background-color: #f8fafc; padding: 4px 8px; border-radius: 6px; margin-top: 8px;">
                    <span>${label}</span>
                    <span style="font-family: monospace; color: #041632;">₱ ${sumVal}</span>
                </div>
            `;
            if (list.length > 0) {
                list.forEach(item => {
                    html += `
                        <div style="display: flex; justify-content: space-between; padding-left: 20px; font-size: 12px; color: #475569; padding-bottom: 2px;">
                            <span>↳ ${item.label}</span>
                            <span style="font-family: monospace;">₱ ${item.amount}</span>
                        </div>
                    `;
                });
            }
            return html;
        };

        reportContainer.innerHTML = `
            <div style="margin-bottom: 24px;">
                <h1 style="font-size: 32px; font-weight: 900; color: #041632; margin: 0; text-transform: uppercase; letter-spacing: -0.02em; font-family: 'Inter', sans-serif; font-style: normal; font-weight: 900;">${sectionTitle}</h1>
                <p style="font-size: 14px; color: #475569; margin: 6px 0 0 0; font-weight: 700;">
                    @Model.BusinessDate.ToString("MMMM d, yyyy") • @Model.BusinessDate.ToString("dddd") | Cashier: ${cashierVal}
                </p>
            </div>

            <!-- SALES SUMMARY SECTION -->
            <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05); margin-bottom: 20px; overflow: hidden;">
                <div style="background: #3B5B92; padding: 12px 16px; color: #ffffff; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">
                    SALES SUMMARY
                </div>
                <div style="padding: 16px; font-size: 13px; color: #334155; line-height: 2.2;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px; font-weight: bold;">
                        <span>Daily Gross Sales (Opening + Closing)</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 14px;">₱ ${combinedGross}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px;">
                        <span>${isOpening ? 'Opening' : 'Closing'} Gross Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 14px; font-weight: 700;">₱ ${grossVal}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px;">
                        <span>Food Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 14px; font-weight: 700;">₱ ${foodVal}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px;">
                        <span>Beer Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 14px; font-weight: 700;">₱ ${beerVal}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span>Beverages Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 14px; font-weight: 700;">₱ ${bevVal}</strong>
                    </div>
                </div>
            </div>

            <!-- COLLECTION & PAYMENTS SECTION -->
            <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05); margin-bottom: 20px; overflow: hidden;">
                <div style="background: #3B5B92; padding: 12px 16px; color: #ffffff; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">
                    COLLECTION & PAYMENTS
                </div>
                <div style="padding: 16px; font-size: 13px; color: #334155; line-height: 2.2;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding-bottom: 4px; font-weight: bold;">
                        <span>Cash Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 14px;">₱ ${cashVal}</strong>
                    </div>
                    
                    ${renderDetailedLines('G-Cash Sales', gcashItems, gcashVal)}
                    ${renderDetailedLines('Bank Transfers', bankItems, transferVal)}
                    ${renderDetailedLines('Card & Credit Payments', [...cardItems, ...creditItems], cardCreditVal)}
                </div>
            </div>

            <!-- DEDUCTIONS & EXPENSES SECTION -->
            <div style="background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05); margin-bottom: 24px; overflow: hidden;">
                <div style="background: #475569; padding: 12px 16px; color: #ffffff; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em;">
                    DEDUCTIONS & EXPENSES
                </div>
                <div style="padding: 16px; font-size: 13px; color: #334155; line-height: 2.2;">
                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px;">
                        <span>Discounts / Vouchers</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 14px; font-weight: 700;">₱ ${discountVal}</strong>
                    </div>

                    ${renderDetailedLines('Run-away Customers', runawayItems, runawayVal)}
                    ${renderDetailedLines('Expenses from Sales', expenseItems, expensesVal)}

                    <div style="display: flex; justify-content: space-between; border-bottom: 1px dashed #f1f5f9; padding-bottom: 4px; margin-top: 8px;">
                        <span>Resto PCF / PCF from Sales</span>
                        <strong style="font-family: monospace; color: #0f172a; font-size: 14px; font-weight: 700;">₱ ${restoPcfVal} / ₱ ${pcfFromSalesVal}</strong>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span>Shortage / Overage</span>
                        <strong style="font-family: monospace; color: #b91c1c; font-size: 14px; font-weight: 700;">-₱ ${shortageVal} / +₱ ${overageVal}</strong>
                    </div>
                </div>
            </div>

            <!-- FOOTER NOTICE -->
            <div style="text-align: center; font-size: 11px; color: #94a3b8; font-weight: 600;">
                Verified Report - @DateTime.Today.ToString("MMMM d, yyyy")
            </div>
        `;

        document.body.appendChild(reportContainer);

        // Load html2canvas dynamically if not loaded
        const capture = () => {
            html2canvas(reportContainer, {
                backgroundColor: '#f8fafc',
                scale: 2, // High resolution export
                logging: false,
                useCORS: true
            }).then(canvas => {
                const link = document.createElement('a');
                link.download = `DailySales_${section.toUpperCase()}_@((Model.BusinessDate).ToString("yyyyMMdd")).png`;
                link.href = canvas.toDataURL('image/png');
                link.click();
                document.body.removeChild(reportContainer);
            }).catch(err => {
                console.error("Export failed:", err);
                document.body.removeChild(reportContainer);
            });
        };

        if (typeof html2canvas === 'undefined') {
            const script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
            script.onload = capture;
            document.head.appendChild(script);
        } else {
            capture();
        }
    }
</script>

<!-- Lightbox Modal for Full Image View -->
<div id="lightboxModal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-labelledby="lightboxTitle">
    <div class="absolute inset-0 bg-primary/90 backdrop-blur-sm cursor-pointer" onclick="closeLightbox()"></div>
    <div class="relative z-10 h-full w-full p-space-6 flex flex-col items-center justify-center" onclick="closeLightbox()">
        <span id="lightboxTitle" class="sr-only">Receipt Lightbox View</span>
        <img src="" id="lightbox-img" class="max-w-full max-h-[88vh] object-contain rounded-lg shadow-2xl bg-white border border-surface-border" />
        <span class="text-on-primary/60 text-[11px] font-label-caps uppercase mt-space-3 pointer-events-none">Click anywhere to close</span>
    </div>
</div>
