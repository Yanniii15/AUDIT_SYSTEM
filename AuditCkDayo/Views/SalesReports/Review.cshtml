                                <span asp-validation-for="PcfFromSales" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="ChangeAmount" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Change Float (₱)</label>
                                <input asp-for="ChangeAmount" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" step="0.01" />
