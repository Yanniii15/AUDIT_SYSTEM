                                </div>
                                <div class="flex flex-col gap-space-2">
                                    <label asp-for="ReceiptNumberEnd" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Receipt Number End</label>
                                    <input asp-for="ReceiptNumberEnd" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                                    <span asp-validation-for="ReceiptNumberEnd" class="text-audit-error text-[11px]"></span>
                                </div>
                                <div class="flex flex-col gap-space-2 md:col-span-2">
                                    <label asp-for="WitnessName" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Witness Name</label>
                                    <input asp-for="WitnessName" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                                    <span asp-validation-for="WitnessName" class="text-audit-error text-[11px]"></span>
                                </div>
                                <div class="flex flex-col gap-space-2 md:col-span-2">
                                    <label asp-for="Notes" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Notes</label>
                                    <textarea asp-for="Notes" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface resize-none" rows="2"></textarea>
                                    <span asp-validation-for="Notes" class="text-audit-error text-[11px]"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Line Items / Cash Breakdown Grid -->
                        <div class="pt-space-4 border-t border-surface-border">
                            <h4 class="font-headline-sm text-headline-sm text-[16px] text-on-surface mb-space-4 flex items-center gap-space-2">
                                <span class="material-symbols-outlined text-primary">list_alt</span>
                                Cash Denomination Breakdown
                            </h4>
                            
                            <div class="border border-surface-border rounded-xl max-h-[520px] overflow-y-auto overflow-x-auto">
                                <table class="w-full text-left border-collapse block lg:table">
                                    <thead class="hidden lg:table-header-group lg:sticky lg:top-0 lg:z-10">
                                        <tr class="bg-surface-container-low border-b border-surface-border">
                                            <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px]">Denomination</th>
                                            <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] w-28">Quantity</th>
                                            <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] w-32 text-right">Total (₱)</th>
                                            <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] w-12 text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="line-items-body" class="divide-y divide-surface-border block lg:table-row-group space-y-space-4 lg:space-y-0 p-space-4 lg:p-0">
                                        @for (int i = 0; i < Model.Items.Count; i++)
                                        {
                                            <tr class="hover:bg-surface-container-low/30 transition-colors line-item-row block lg:table-row grid grid-cols-2 gap-x-space-4 gap-y-space-3 p-space-4 border border-surface-border lg:border-0 rounded-xl bg-surface-container-lowest lg:bg-transparent shadow-sm lg:shadow-none">
                                                <td class="col-span-2 lg:col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                                                    <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Denomination</label>
                                                    <input asp-for="Items[i].Denomination" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface focus:ring-2 focus:ring-primary/15 focus:outline-none denom-input" type="number" step="0.01" required />
                                                </td>
                                                <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                                                    <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Quantity</label>
                                                    <input asp-for="Items[i].Quantity" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-center qty-input" type="number" min="0" required />
                                                </td>
                                                <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-right">
                                                    <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Total (₱)</label>
                                                    <input asp-for="Items[i].Total" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-right total-input" type="number" step="0.01" readonly />
                                                </td>
                                                <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-center flex items-center justify-end lg:justify-center">
                                                    <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Action</label>
                                                    <button type="button" class="text-audit-error hover:scale-110 transition-transform remove-row-btn" onclick="removeRow(this)">
