                                <span asp-validation-for="EaglesDiscount" class="text-audit-error text-[11px]"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 5. Variances, PCF & Change -->
                    <div class="rounded-xl border border-surface-border bg-surface-container-lowest p-space-4 space-y-space-4">
                        <div class="flex items-center gap-space-2 mb-space-1">
                            <span class="material-symbols-outlined text-primary text-[18px]">balance</span>
                            <h2 class="font-label-caps text-on-surface uppercase tracking-wider text-[11px]">Variances, PCF & Change</h2>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-space-4">
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="SalesShortageAmount" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Shortage Amount (₱)</label>
                                <input asp-for="SalesShortageAmount" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" step="0.01" />
                                <span asp-validation-for="SalesShortageAmount" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2 sm:col-span-2">
                                <label asp-for="SalesShortageReason" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Shortage Reason</label>
                                <input asp-for="SalesShortageReason" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" placeholder="Reason for shortage" />
                                <span asp-validation-for="SalesShortageReason" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="SalesOverageAmount" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Overage Amount (₱)</label>
                                <input asp-for="SalesOverageAmount" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" step="0.01" />
                                <span asp-validation-for="SalesOverageAmount" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2 sm:col-span-2">
                                <label asp-for="SalesOverageReason" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Overage Reason</label>
                                <input asp-for="SalesOverageReason" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" placeholder="Reason for overage" />
                                <span asp-validation-for="SalesOverageReason" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="RestoPcf" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Resto PCF (₱)</label>
                                <input asp-for="RestoPcf" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" step="0.01" />
                                <span asp-validation-for="RestoPcf" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="PcfFromSales" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">PCF from Sales (₱)</label>
