@model AuditCkDayo.ViewModels.SalesReportReviewViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Review Daily Sales Report";
    var establishments = ViewBag.Establishments as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var metadataGridColumns = Model.CanConfirmToTreasury ? "md:grid-cols-3" : "md:grid-cols-2";
}

<div class="space-y-6">
    <div class="flex flex-col gap-space-2 max-w-3xl">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">fact_check</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Sales Report Review</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Review Daily Sales Report</h1>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            @(Model.CanConfirmToTreasury
                ? "Verify the daily sales report count, adjust any errors, and confirm to post cash-in."
                : "Review the daily sales report values, adjust any errors, and submit it for manager verification.")
        </p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="p-space-4 bg-audit-success/10 border border-audit-success/20 rounded-xl text-audit-success font-body-md flex items-center justify-between shadow-sm">
            <span><i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="p-space-4 bg-audit-pending/10 border border-audit-pending/20 rounded-xl text-audit-pending font-body-md flex items-center justify-between shadow-sm">
            <span><i class="bi bi-info-circle-fill me-2"></i> @TempData["Warning"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
        </div>
    }

    <div class="grid grid-cols-12 gap-space-8 items-start my-space-4">
        <!-- Left Column: Sales Report Images Preview -->
        <div class="col-span-12 lg:col-span-5">
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border overflow-hidden sticky top-24">
                <div class="p-space-4 bg-surface-container-low border-b border-surface-border flex justify-between items-center">
                    <span class="font-label-caps text-on-surface-variant uppercase text-[10px]">Uploaded Images (@(Model.ImageUrls?.Count ?? 1))</span>
                    <span class="material-symbols-outlined text-primary text-[18px]">image</span>
                </div>
                
                <!-- Large Image Preview -->
                <div class="p-space-4 bg-surface-container-highest flex flex-col items-center justify-center min-h-[350px] relative">
                    <img id="main-preview" src="@Model.ImageUrl" class="max-w-full max-h-[500px] object-contain rounded-lg border border-surface-border/50 shadow-sm cursor-pointer hover:scale-[1.01] transition-transform duration-300" alt="Sales Report Upload" />
                </div>
                <div class="p-space-3 bg-surface-container-low border-t border-surface-border text-center">
                    <span class="inspect-trigger cursor-pointer text-on-surface-variant text-[11px] font-label-caps uppercase"><span class="material-symbols-outlined text-[14px] align-middle">zoom_in</span> Tap to Inspect</span>
                </div>

                <!-- Thumbnail Selector -->
                @if (Model.ImageUrls != null && Model.ImageUrls.Count > 1)
                {
                    <div class="p-space-3 bg-surface-container-low border-t border-surface-border flex gap-2 overflow-x-auto">
                        @for (int i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            <div class="w-16 h-16 flex-shrink-0 bg-black rounded border border-surface-border overflow-hidden cursor-pointer hover:border-primary transition-all @(i == 0 ? "ring-2 ring-primary" : "")" onclick="setPreview(this, '@Model.ImageUrls[i]')">
                                <img src="@Model.ImageUrls[i]" class="w-full h-full object-contain" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Right Column: Reconciliation Form -->
        <div class="col-span-12 lg:col-span-7">
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border overflow-hidden">
                <div class="bg-primary px-space-6 py-space-4 flex justify-between items-center">
                    <span class="text-on-primary font-label-caps uppercase tracking-tighter text-[11px]">Sales Reconciliation Form</span>
                    <span class="text-on-primary/60 text-[10px] font-data-mono">DOC #@Model.DocumentRecordId</span>
                </div>

                <form asp-controller="SalesReports" asp-action="Review" method="post" class="p-space-8 space-y-space-6" id="reviewForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-audit-error bg-audit-error/10 border border-audit-error/20 p-space-4 rounded-lg text-body-md text-center"></div>
                    
                    <input type="hidden" asp-for="SalesReportId" />
                    <input type="hidden" asp-for="DocumentRecordId" />
                    <input type="hidden" asp-for="ImageUrl" />
                    @if (Model.ImageUrls != null)
                    {
                        for (int i = 0; i < Model.ImageUrls.Count; i++)
                        {
                            <input type="hidden" name="ImageUrls[@i]" value="@Model.ImageUrls[i]" />
                        }
                    }

                    <!-- Metadata summary -->
                    <div class="grid grid-cols-1 @metadataGridColumns gap-space-4 my-space-4">
                        <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                            <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Status</div>
                            <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface">
                                <span class="material-symbols-outlined text-[16px] text-primary">info</span>
                                @Model.StatusText
                            </div>
                        </div>
                        <div class="bg-surface-container-low rounded-xl p-space-4 border-l-4 border-primary shadow-sm flex flex-col justify-center">
                            <span class="font-label-caps text-on-surface-variant uppercase text-[9px] tracking-wider">Total Cash to Handover</span>
                            <div class="flex items-baseline gap-space-1 mt-1 font-body-md">
                                <span class="text-primary font-bold text-[20px]">₱</span>
                                <span class="font-data-mono text-primary font-bold text-[28px]" id="claimed-amount-display">@Model.ConfirmedCashToHandover.ToString("N2")</span>
                                <span class="text-on-surface-variant text-[10px] font-label-caps uppercase ml-2">PHP</span>
                            </div>
                        </div>
                        @if (Model.CanConfirmToTreasury)
                        {
                        <div class="bg-surface-container-low rounded-xl p-space-4 border-l-4 @(Model.ShortOverAmount == 0m ? "border-audit-success" : "border-audit-error") shadow-sm flex flex-col justify-center" id="short-over-card">
                            <span class="font-label-caps text-on-surface-variant uppercase text-[9px] tracking-wider">Short / Over Notice</span>
                            <div class="flex items-baseline gap-space-1 mt-1 font-body-md">
                                <span class="font-data-mono font-bold text-[22px] @(Model.ShortOverAmount == 0m ? "text-audit-success" : "text-audit-error")" id="short-over-label">@Model.ShortOverLabel</span>
                                <span class="font-data-mono font-bold text-[22px] @(Model.ShortOverAmount == 0m ? "text-audit-success" : "text-audit-error")" id="short-over-amount">₱@Math.Abs(Model.ShortOverAmount).ToString("N2")</span>
                            </div>
                            <p class="text-[11px] text-on-surface-variant mt-1">Expected: ₱<span id="expected-cash-display">@Model.ExpectedCashToHandover.ToString("N2")</span></p>
                        </div>
                        }
                    </div>

                    <!-- 1. Operating Branch & Header Details -->
                    <div class="rounded-xl border border-surface-border bg-surface-container-lowest p-space-4 space-y-space-4">
                        <div class="flex items-center gap-space-2 mb-space-1">
                            <span class="material-symbols-outlined text-primary text-[18px]">store</span>
                            <h2 class="font-label-caps text-on-surface uppercase tracking-wider text-[11px]">Upload Daily Sales</h2>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-space-4">
                            <div class="flex flex-col gap-space-2 md:col-span-2">
                                <label asp-for="EstablishmentId" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Operating Branch</label>
                                <select asp-for="EstablishmentId" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface appearance-none cursor-pointer" asp-items="establishments" required>
                                    <option value="">Select branch...</option>
                                </select>
                                <span asp-validation-for="EstablishmentId" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="BusinessDate" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Business Date</label>
                                <input asp-for="BusinessDate" id="BusinessDate" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="date" required />
                                <span asp-validation-for="BusinessDate" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="HandoverDate" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Handover Date</label>
                                <input asp-for="HandoverDate" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="date" required />
                                <span asp-validation-for="HandoverDate" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="CashierName" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Cashier Name</label>
                                <input asp-for="CashierName" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" placeholder="Cashier name" maxlength="100" />
                                <span asp-validation-for="CashierName" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <span class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Day of the Week</span>
                                <div id="dayOfWeekDisplay" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md text-on-surface font-semibold">
                                    @Model.BusinessDate.ToString("dddd")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Sales Totals -->
                    <div class="rounded-xl border border-surface-border bg-surface-container-lowest p-space-4 space-y-space-4">
                        <div class="flex items-center gap-space-2 mb-space-1">
                            <span class="material-symbols-outlined text-primary text-[18px]">payments</span>
                            <h2 class="font-label-caps text-on-surface uppercase tracking-wider text-[11px]">Daily Sales Totals</h2>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-space-4">
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="GrossSales" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Gross Sales (Opening + Closing) (₱)</label>
                                <input asp-for="GrossSales" id="GrossSales" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" min="0" step="0.01" required />
                                <span asp-validation-for="GrossSales" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="ClosingGrossSales" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Closing Gross Sales (₱)</label>
                                <input asp-for="ClosingGrossSales" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" min="0" step="0.01" />
                                <span asp-validation-for="ClosingGrossSales" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="FoodSales" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Food Sales (₱)</label>
                                <input asp-for="FoodSales" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" min="0" step="0.01" />
                                <span asp-validation-for="FoodSales" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="BeerSales" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Beer Sales (₱)</label>
                                <input asp-for="BeerSales" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" min="0" step="0.01" />
                                <span asp-validation-for="BeerSales" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="BeverageSales" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Beverages Sales (₱)</label>
                                <input asp-for="BeverageSales" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" min="0" step="0.01" />
                                <span asp-validation-for="BeverageSales" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="OtherSales" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Other Sales (₱)</label>
                                <input asp-for="OtherSales" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" min="0" step="0.01" />
                                <span asp-validation-for="OtherSales" class="text-audit-error text-[11px]"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Payment Collections (Lists) -->
                    <div class="rounded-xl border border-surface-border bg-surface-container-lowest p-space-4 space-y-space-4">
                        <div class="flex items-center gap-space-2 mb-space-1">
                            <span class="material-symbols-outlined text-primary text-[18px]">credit_card</span>
                            <h2 class="font-label-caps text-on-surface uppercase tracking-wider text-[11px]">Payment Collections</h2>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-space-4">
                            <!-- Cash Sales -->
                            <div class="flex flex-col gap-space-2 md:col-span-2 border-b border-surface-border pb-space-3">
                                <label asp-for="CashSales" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Cash Sales (₱)</label>
                                <input asp-for="CashSales" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" min="0" step="0.01" />
                                <span asp-validation-for="CashSales" class="text-audit-error text-[11px]"></span>
                            </div>

                            <!-- GCash Lines -->
                            <div class="flex flex-col gap-space-2 border border-surface-border rounded-lg p-space-3 bg-surface-container-low/20">
                                <div class="flex justify-between items-center">
                                    <span class="font-label-caps text-on-surface-variant uppercase text-[10px] font-bold">GCash Sales</span>
                                    <button type="button" class="text-primary hover:underline text-[11px] font-label-caps" onclick="addPaymentRow('gcash-container', 'GCashLines')">+ Add Line</button>
                                </div>
                                <div id="gcash-container" class="space-y-2">
                                    @for (int i = 0; i < Model.GCashLines.Count; i++)
                                    {
                                        <div class="flex items-center gap-2 payment-row">
                                            <input type="hidden" name="GCashLines[@i].Id" value="@Model.GCashLines[i].Id" />
                                            <input type="hidden" name="GCashLines[@i].LineType" value="GCash" />
                                            <input type="number" step="0.01" name="GCashLines[@i].Amount" value="@Model.GCashLines[i].Amount" class="w-full bg-surface-container-low border border-surface-border rounded px-3 py-1 font-data-mono text-on-surface amount-input" placeholder="Amount (₱)" />
                                            <button type="button" class="text-audit-error material-symbols-outlined text-[18px]" onclick="removePaymentRow(this)">delete</button>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Bank Transfer Lines -->
                            <div class="flex flex-col gap-space-2 border border-surface-border rounded-lg p-space-3 bg-surface-container-low/20">
                                <div class="flex justify-between items-center">
                                    <span class="font-label-caps text-on-surface-variant uppercase text-[10px] font-bold">Bank Transfers</span>
                                    <button type="button" class="text-primary hover:underline text-[11px] font-label-caps" onclick="addPaymentRow('bank-container', 'BankTransferLines', true)">+ Add Line</button>
                                </div>
                                <div id="bank-container" class="space-y-2">
                                    @for (int i = 0; i < Model.BankTransferLines.Count; i++)
                                    {
                                        <div class="flex items-center gap-2 payment-row">
                                            <input type="hidden" name="BankTransferLines[@i].Id" value="@Model.BankTransferLines[i].Id" />
                                            <input type="hidden" name="BankTransferLines[@i].LineType" value="BankTransfer" />
                                            <input type="text" name="BankTransferLines[@i].Label" value="@Model.BankTransferLines[i].Label" class="w-1/2 bg-surface-container-low border border-surface-border rounded px-3 py-1 font-body-md text-on-surface" placeholder="e.g. BDO" />
                                            <input type="number" step="0.01" name="BankTransferLines[@i].Amount" value="@Model.BankTransferLines[i].Amount" class="w-1/2 bg-surface-container-low border border-surface-border rounded px-3 py-1 font-data-mono text-on-surface amount-input" placeholder="Amount (₱)" />
                                            <button type="button" class="text-audit-error material-symbols-outlined text-[18px]" onclick="removePaymentRow(this)">delete</button>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Card Lines -->
                            <div class="flex flex-col gap-space-2 border border-surface-border rounded-lg p-space-3 bg-surface-container-low/20">
                                <div class="flex justify-between items-center">
                                    <span class="font-label-caps text-on-surface-variant uppercase text-[10px] font-bold">Cards</span>
                                    <button type="button" class="text-primary hover:underline text-[11px] font-label-caps" onclick="addPaymentRow('card-container', 'CardLines')">+ Add Line</button>
                                </div>
                                <div id="card-container" class="space-y-2">
                                    @for (int i = 0; i < Model.CardLines.Count; i++)
                                    {
                                        <div class="flex items-center gap-2 payment-row">
                                            <input type="hidden" name="CardLines[@i].Id" value="@Model.CardLines[i].Id" />
                                            <input type="hidden" name="CardLines[@i].LineType" value="Card" />
                                            <input type="number" step="0.01" name="CardLines[@i].Amount" value="@Model.CardLines[i].Amount" class="w-full bg-surface-container-low border border-surface-border rounded px-3 py-1 font-data-mono text-on-surface amount-input" placeholder="Amount (₱)" />
                                            <button type="button" class="text-audit-error material-symbols-outlined text-[18px]" onclick="removePaymentRow(this)">delete</button>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Credit Lines -->
                            <div class="flex flex-col gap-space-2 border border-surface-border rounded-lg p-space-3 bg-surface-container-low/20">
                                <div class="flex justify-between items-center">
                                    <span class="font-label-caps text-on-surface-variant uppercase text-[10px] font-bold">Credit</span>
                                    <button type="button" class="text-primary hover:underline text-[11px] font-label-caps" onclick="addPaymentRow('credit-container', 'CreditLines', true)">+ Add Line</button>
                                </div>
                                <div id="credit-container" class="space-y-2">
                                    @for (int i = 0; i < Model.CreditLines.Count; i++)
                                    {
                                        <div class="flex items-center gap-2 payment-row">
                                            <input type="hidden" name="CreditLines[@i].Id" value="@Model.CreditLines[i].Id" />
                                            <input type="hidden" name="CreditLines[@i].LineType" value="Credit" />
                                            <input type="text" name="CreditLines[@i].Label" value="@Model.CreditLines[i].Label" class="w-1/2 bg-surface-container-low border border-surface-border rounded px-3 py-1 font-body-md text-on-surface" placeholder="Reason/Note" />
                                            <input type="number" step="0.01" name="CreditLines[@i].Amount" value="@Model.CreditLines[i].Amount" class="w-1/2 bg-surface-container-low border border-surface-border rounded px-3 py-1 font-data-mono text-on-surface amount-input" placeholder="Amount (₱)" />
                                            <button type="button" class="text-audit-error material-symbols-outlined text-[18px]" onclick="removePaymentRow(this)">delete</button>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Runaway Customer Lines -->
                            <div class="flex flex-col gap-space-2 border border-surface-border rounded-lg p-space-3 bg-surface-container-low/20 md:col-span-2">
                                <div class="flex justify-between items-center">
                                    <span class="font-label-caps text-on-surface-variant uppercase text-[10px] font-bold">Run-away Customers</span>
                                    <button type="button" class="text-primary hover:underline text-[11px] font-label-caps" onclick="addPaymentRow('runaway-container', 'RunawayCustomerLines', true)">+ Add Line</button>
                                </div>
                                <div id="runaway-container" class="space-y-2">
                                    @for (int i = 0; i < Model.RunawayCustomerLines.Count; i++)
                                    {
                                        <div class="flex items-center gap-2 payment-row">
                                            <input type="hidden" name="RunawayCustomerLines[@i].Id" value="@Model.RunawayCustomerLines[i].Id" />
                                            <input type="hidden" name="RunawayCustomerLines[@i].LineType" value="RunawayCustomer" />
                                            <input type="text" name="RunawayCustomerLines[@i].Label" value="@Model.RunawayCustomerLines[i].Label" class="w-1/2 bg-surface-container-low border border-surface-border rounded px-3 py-1 font-body-md text-on-surface" placeholder="Table / Description" />
                                            <input type="number" step="0.01" name="RunawayCustomerLines[@i].Amount" value="@Model.RunawayCustomerLines[i].Amount" class="w-1/2 bg-surface-container-low border border-surface-border rounded px-3 py-1 font-data-mono text-on-surface amount-input" placeholder="Amount (₱)" />
                                            <button type="button" class="text-audit-error material-symbols-outlined text-[18px]" onclick="removePaymentRow(this)">delete</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Discounts Applied -->
                    <div class="rounded-xl border border-surface-border bg-surface-container-lowest p-space-4 space-y-space-4">
                        <div class="flex items-center gap-space-2 mb-space-1">
                            <span class="material-symbols-outlined text-primary text-[18px]">percent</span>
                            <h2 class="font-label-caps text-on-surface uppercase tracking-wider text-[11px]">Discounts Applied</h2>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-space-4">
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="SeniorDiscount" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">SENIOR Discount (₱)</label>
                                <input asp-for="SeniorDiscount" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" step="0.01" />
                                <span asp-validation-for="SeniorDiscount" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="PwdDiscount" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">PWD Discount (₱)</label>
                                <input asp-for="PwdDiscount" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" step="0.01" />
                                <span asp-validation-for="PwdDiscount" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="LoyaltyCardDiscount" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">LOYALTY CARD Discount (₱)</label>
                                <input asp-for="LoyaltyCardDiscount" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" step="0.01" />
                                <span asp-validation-for="LoyaltyCardDiscount" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="GiftVoucherDiscount" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">GIFT VOUCHER Discount (₱)</label>
                                <input asp-for="GiftVoucherDiscount" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="number" step="0.01" />
                                <span asp-validation-for="GiftVoucherDiscount" class="text-audit-error text-[11px]"></span>
                            </div>
                            <div class="flex flex-col gap-space-2">
                                <label asp-for="EmployeeTenPercentDiscount" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">EMPLOYEE 10% Discount (₱)</label>
