@model AuditCkDayo.ViewModels.SalesReportReviewViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Review Daily Sales Report";
    var establishments = ViewBag.Establishments as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
}

<div class="space-y-6">
    <div class="flex flex-col gap-space-2 max-w-3xl">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">fact_check</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Sales Report Review</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Review Daily Sales Report</h1>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            Edit the draft values, save work in progress, or confirm to post one cash-in entry to the handover date.
        </p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="p-space-4 bg-audit-success/10 border border-audit-success/20 rounded-xl text-audit-success font-body-md flex items-center justify-between shadow-sm">
            <span><i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="p-space-4 bg-audit-pending/10 border border-audit-pending/20 rounded-xl text-audit-pending font-body-md flex items-center justify-between shadow-sm">
            <span><i class="bi bi-info-circle-fill me-2"></i> @TempData["Warning"]</span>
            <button type="button" onclick="this.parentElement.remove()" class="material-symbols-outlined text-[18px] hover:scale-110 transition-transform">close</button>
        </div>
    }

    <div class="grid grid-cols-1 xl:grid-cols-[minmax(320px,420px)_1fr] gap-space-6 items-start">
        <aside class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border/50 overflow-hidden xl:sticky xl:top-24">
            <div class="bg-surface-container-low px-space-5 py-space-4 border-b border-surface-border flex items-center justify-between">
                <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Uploaded Image</span>
                <span class="material-symbols-outlined text-primary text-[18px]">image</span>
            </div>
            <div class="bg-surface-container-highest p-space-4 min-h-[320px] flex items-center justify-center">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <a href="@Model.ImageUrl" target="_blank" rel="noopener" class="block w-full">
                        <img src="@Model.ImageUrl" alt="Uploaded sales report" class="max-h-[560px] w-full object-contain rounded-lg border border-surface-border/50 bg-white shadow-sm" />
                    </a>
                }
                else
                {
                    <div class="text-center text-on-surface-variant font-body-md">No image is attached to this sales report.</div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <div class="p-space-3 bg-surface-container-low border-t border-surface-border text-center">
                    <a href="@Model.ImageUrl" target="_blank" rel="noopener" class="font-label-caps uppercase tracking-wider text-primary text-[11px] hover:underline">
                        Open image in new tab
                    </a>
                </div>
            }
        </aside>

        <section class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border/50 overflow-hidden">
            <div class="bg-primary px-space-6 py-space-4 flex justify-between items-center">
                <span class="text-on-primary font-label-caps uppercase tracking-tighter text-[11px]">Editable Report Values</span>
                <span class="text-on-primary/60 text-[10px] font-data-mono">DOC #@Model.DocumentRecordId</span>
            </div>

            <form asp-controller="SalesReports" asp-action="Review" method="post" class="p-space-8 space-y-space-6">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-audit-error bg-audit-error/10 border border-audit-error/20 p-space-4 rounded-lg text-body-md text-center"></div>

                <input type="hidden" asp-for="SalesReportId" />
                <input type="hidden" asp-for="DocumentRecordId" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-space-4">
                    <label class="flex flex-col gap-space-2 md:col-span-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Operating Branch</span>
                        <select asp-for="EstablishmentId" asp-items="establishments" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required>
                            <option value="">Select branch...</option>
                        </select>
                        <span asp-validation-for="EstablishmentId" class="text-audit-error text-[11px]"></span>
                    </label>

                    <label class="flex flex-col gap-space-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Business Date</span>
                        <input asp-for="BusinessDate" type="date" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required />
                        <span asp-validation-for="BusinessDate" class="text-audit-error text-[11px]"></span>
                    </label>

                    <label class="flex flex-col gap-space-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Handover Date</span>
                        <input asp-for="HandoverDate" type="date" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" required />
                        <span asp-validation-for="HandoverDate" class="text-audit-error text-[11px]"></span>
                    </label>

                    <label class="flex flex-col gap-space-2 md:col-span-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Cashier Name</span>
                        <input asp-for="CashierName" maxlength="100" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                        <span asp-validation-for="CashierName" class="text-audit-error text-[11px]"></span>
                    </label>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-space-4">
                    <label class="flex flex-col gap-space-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Gross Sales</span>
                        <input asp-for="GrossSales" type="number" min="0" step="0.01" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                        <span asp-validation-for="GrossSales" class="text-audit-error text-[11px]"></span>
                    </label>

                    <label class="flex flex-col gap-space-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Cash Out</span>
                        <input asp-for="CashOut" type="number" min="0" step="0.01" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                        <span asp-validation-for="CashOut" class="text-audit-error text-[11px]"></span>
                    </label>

                    <label class="flex flex-col gap-space-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Cash to Handover</span>
                        <input asp-for="ConfirmedCashToHandover" type="number" min="0" step="0.01" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                        <span asp-validation-for="ConfirmedCashToHandover" class="text-audit-error text-[11px]"></span>
                    </label>

                    <label class="flex flex-col gap-space-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">GCash</span>
                        <input asp-for="GCashAmount" type="number" min="0" step="0.01" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                        <span asp-validation-for="GCashAmount" class="text-audit-error text-[11px]"></span>
                    </label>

                    <label class="flex flex-col gap-space-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Credit</span>
                        <input asp-for="CreditAmount" type="number" min="0" step="0.01" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                        <span asp-validation-for="CreditAmount" class="text-audit-error text-[11px]"></span>
                    </label>

                    <label class="flex flex-col gap-space-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Other Payments</span>
                        <input asp-for="OtherPaymentAmount" type="number" min="0" step="0.01" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                        <span asp-validation-for="OtherPaymentAmount" class="text-audit-error text-[11px]"></span>
                    </label>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-space-4">
                    <label class="flex flex-col gap-space-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Receipt Start</span>
                        <input asp-for="ReceiptNumberStart" maxlength="50" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                        <span asp-validation-for="ReceiptNumberStart" class="text-audit-error text-[11px]"></span>
                    </label>

                    <label class="flex flex-col gap-space-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Receipt End</span>
                        <input asp-for="ReceiptNumberEnd" maxlength="50" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                        <span asp-validation-for="ReceiptNumberEnd" class="text-audit-error text-[11px]"></span>
                    </label>

                    <label class="flex flex-col gap-space-2 md:col-span-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Witness Name</span>
                        <input asp-for="WitnessName" maxlength="100" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
                        <span asp-validation-for="WitnessName" class="text-audit-error text-[11px]"></span>
                    </label>

                    <label class="flex flex-col gap-space-2 md:col-span-2">
                        <span class="font-label-caps uppercase tracking-wider text-on-surface-variant text-[11px]">Notes</span>
                        <textarea asp-for="Notes" rows="3" maxlength="255" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface resize-none"></textarea>
                        <span asp-validation-for="Notes" class="text-audit-error text-[11px]"></span>
                    </label>
                </div>

                <div class="flex flex-col sm:flex-row gap-space-3 pt-space-5 border-t border-surface-border">
                    <button type="submit" name="actionType" value="SaveDraft" class="bg-surface-container text-primary border border-primary/20 px-space-6 py-3 rounded-lg font-label-caps uppercase tracking-widest hover:bg-primary/10 transition-all flex items-center justify-center gap-space-2 text-[12px]">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        Save Draft
                    </button>
                    <button type="submit" name="actionType" value="Confirm" class="bg-primary text-on-primary px-space-8 py-3 rounded-lg font-label-caps uppercase tracking-widest hover:bg-primary/95 transition-all flex items-center justify-center gap-space-2 shadow-md text-[12px]">
                        <span class="material-symbols-outlined text-[18px]">check_circle</span>
                        Confirm to Treasury
                    </button>
                </div>
            </form>
        </section>
    </div>
</div>
