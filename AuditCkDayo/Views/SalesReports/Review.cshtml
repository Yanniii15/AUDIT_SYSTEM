                                <div class="flex items-center gap-2 payment-row">
                                    <input type="hidden" name="ExpenseFromSalesLines[@i].Id" value="@Model.ExpenseFromSalesLines[i].Id" />
                                    <input type="hidden" name="ExpenseFromSalesLines[@i].LineType" value="ExpenseFromSales" />
                                    <input type="text" name="ExpenseFromSalesLines[@i].Label" value="@Model.ExpenseFromSalesLines[i].Label" class="w-2/3 bg-surface-container-low border border-surface-border rounded px-3 py-1 font-body-md text-on-surface" placeholder="Expense description (e.g. rice)" />
                                    <input type="number" step="0.01" name="ExpenseFromSalesLines[@i].Amount" value="@Model.ExpenseFromSalesLines[i].Amount" class="w-1/3 bg-surface-container-low border border-surface-border rounded px-3 py-1 font-data-mono text-on-surface amount-input" placeholder="Amount (₱)" />
