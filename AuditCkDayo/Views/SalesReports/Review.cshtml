                                <span class="material-symbols-outlined text-primary text-[18px]">receipt</span>
                                <h2 class="font-label-caps text-on-surface uppercase tracking-wider text-[11px]">Receipt Ranges & Notes</h2>
                            </div>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-space-4">
                                <div class="flex flex-col gap-space-2">
                                    <label asp-for="ReceiptNumberStart" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Receipt Number Start</label>
                                    <input asp-for="ReceiptNumberStart" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" />
