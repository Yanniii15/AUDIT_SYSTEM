@model IEnumerable<AuditCkDayo.Models.SalesReport>
@{
    ViewData["Title"] = "Pending Sales Verification";
}

<div id="pageVoiceSummary" class="sr-only">
    Sales verification queue. Pending verification count: @Model.Count() reports.
    @if (Model.Any())
    {
        var first = Model.First();
        <text>First report: Branch @first.Establishment.Name, Business Date @first.BusinessDate.ToString("MMM d, yyyy"), Cash to handover ₱@first.TotalConfirmedCashToHandover.ToString("N2").</text>
    }
</div>

@if (ViewBag.IsBranchStaff == true)
{
    <div class="space-y-6">
        <div class="flex flex-col gap-space-2 max-w-3xl">
            <div class="flex items-center gap-space-2 text-primary">
                <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Daily Sales</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Daily Sales</h1>
            <p class="font-body-md text-on-surface-variant leading-relaxed">
                Add your establishment's opening and closing daily sales.
            </p>
        </div>

        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border overflow-hidden">
            <div class="bg-[#041632] px-space-6 py-space-4 flex flex-wrap gap-space-4 justify-between items-center">
                <div class="flex items-center gap-space-4">
                    <span class="text-on-primary font-label-caps uppercase tracking-tighter text-[11px]">Daily Sales Records</span>
                    <span class="text-on-primary/70 text-[10px] font-label-caps uppercase tracking-wider hidden sm:inline">Last 30 days</span>
                </div>
                <a asp-action="Upload" class="inline-flex items-center justify-center gap-space-2 rounded-lg bg-on-primary/10 text-on-primary border border-on-primary/20 px-space-4 py-2 font-label-caps uppercase tracking-wider text-[11px] hover:bg-on-primary/20 transition-all">
                    <span class="material-symbols-outlined text-[18px]">upload_file</span>
                    Upload Daily Sales Report
                </a>
            </div>
            <div class="hidden lg:block overflow-x-auto">
            <table class="w-full text-left border-collapse" style="min-width: 760px;">
                <thead class="hidden lg:table-header-group">
                    <tr class="bg-surface-container-low border-b border-surface-border">
                        <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px]" style="width: 20%;">Business Date</th>
                        <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px]" style="width: 12%;">Opening</th>
                        <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px]" style="width: 12%;">Closing</th>
                        <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] text-right" style="width: 18%;">Combined Cash Sales</th>
                        <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px]" style="width: 18%;">Deposit Slip</th>
                        <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] text-right" style="width: 20%;">Actions</th>
                </thead>
                <tbody class="divide-y divide-surface-border">
                    @foreach (var report in Model)
                    {
                        <tr class="hover:bg-surface-container-low/30 transition-colors">
                            <td class="px-space-4 py-space-3 font-data-mono text-on-surface">@report.BusinessDate.ToString("MMM d, yyyy")</td>
                            <td class="px-space-4 py-space-3">
                                @if (report.OpeningCashSales > 0m)
                                {
                                    <span class="text-audit-success font-body-md text-[12px]">Saved</span>
                                }
                                else
                                {
                                    <span class="text-on-surface-variant font-body-md text-[12px]">Not set</span>
                                }
                            </td>
                            <td class="px-space-4 py-space-3">
                                @if (report.CashSales > 0m || report.Status == SalesReportStatus.PendingManagerVerification || report.Status == SalesReportStatus.Confirmed)
                                {
                                    <span class="text-audit-success font-body-md text-[12px]">Saved</span>
                                }
                                else
                                {
                                    <span class="text-on-surface-variant font-body-md text-[12px]">Not set</span>
                                }
                            </td>
                            <td class="px-space-4 py-space-3 text-right font-data-mono text-primary font-bold">₱@report.TotalConfirmedCashToHandover.ToString("N2")</td>
                            <td class="px-space-4 py-space-3 font-data-mono">
                                @{
                                    var confirmedCash = (report.ConfirmedCashToHandover != 0m ? report.ConfirmedCashToHandover : (report.TotalConfirmedCashToHandover != 0m ? report.TotalConfirmedCashToHandover : (report.CashSales + report.OpeningCashSales))).ToString(System.Globalization.CultureInfo.InvariantCulture);
                                    var estName = report.Establishment?.Name?.Replace("'", "\\'") ?? "Branch";
                                    var bDate = report.BusinessDate.ToString("yyyy-MM-dd");
                                }
                                @if (report.Status == SalesReportStatus.Confirmed)
                                {
                                    <div class="space-y-1 text-[11px]">
                                        @if (report.OpeningCashSales > 0m)
                                        {
                                            <div class="flex items-center justify-between gap-1">
                                                <span class="text-on-surface-variant text-[10px]">Open:</span>
                                                @if (report.HasOpeningDepositSlip)
                                                {
                                                    <a href="@report.OpeningDepositSlipImageUrl" target="_blank" class="font-bold text-emerald-500 hover:underline">✓ ₱@report.OpeningDepositedAmount?.ToString("N2")</a>
                                                }
                                                else
                                                {
                                                    <span class="text-amber-500 font-bold text-[10px]">Awaiting</span>
                                                }
                                            </div>
                                        }
                                        <div class="flex items-center justify-between gap-1">
                                            <span class="text-on-surface-variant text-[10px]">Close:</span>
                                            @if (report.HasClosingDepositSlip)
                                            {
                                                <a href="@(report.ClosingDepositSlipImageUrl ?? report.DepositSlipImageUrl)" target="_blank" class="font-bold text-emerald-500 hover:underline">✓ ₱@((report.ClosingDepositedAmount ?? report.DepositedAmount)?.ToString("N2"))</a>
                                            }
                                            else
                                            {
                                                <span class="text-amber-500 font-bold text-[10px]">Awaiting</span>
                                            }
                                        </div>
                                        <button type="button" onclick="openDepositModal(@report.Id, @confirmedCash, '@estName', '@bDate', @report.OpeningCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture), @((report.CashSales > 0m ? report.CashSales : report.ConfirmedCashToHandover).ToString(System.Globalization.CultureInfo.InvariantCulture)))" class="w-full mt-0.5 px-2 py-0.5 rounded bg-primary text-on-primary text-[10px] font-bold hover:brightness-110">
                                            Upload Slip
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-slate-500 text-[11px]">—</span>
                                }
                            </td>
                            <td class="px-space-4 py-space-3 text-right space-x-2">
                                @if (report.OpeningCashSales > 0m)
                                {
                                    <a asp-controller="SalesReports" asp-action="OpeningReview" asp-route-id="@report.Id" class="px-3 py-1.5 rounded-lg border border-surface-border text-on-surface-variant font-label-caps text-[10px] uppercase hover:bg-surface-container-high transition-colors">Edit Opening</a>
                                }
                                else
                                {
                                    <a asp-controller="SalesReports" asp-action="Upload" asp-route-reportId="@report.Id" asp-route-section="Opening" class="px-3 py-1.5 rounded-lg border border-primary text-primary font-label-caps text-[10px] uppercase hover:bg-primary hover:text-on-primary transition-colors font-semibold">Add Opening</a>
                                }

                                @if (report.CashSales > 0m || report.Status == SalesReportStatus.PendingManagerVerification || report.Status == SalesReportStatus.Confirmed)
                                {
                                    <a asp-controller="SalesReports" asp-action="Review" asp-route-id="@report.Id" class="px-3 py-1.5 rounded-lg border border-surface-border text-on-surface-variant font-label-caps text-[10px] uppercase hover:bg-surface-container-high transition-colors">Edit Closing</a>
                                }
                                else
                                {
                                    <a asp-controller="SalesReports" asp-action="Upload" asp-route-reportId="@report.Id" asp-route-section="Closing" class="px-3 py-1.5 rounded-lg border border-primary text-primary font-label-caps text-[10px] uppercase hover:bg-primary hover:text-on-primary transition-colors font-semibold">Add Closing</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
            <div class="block lg:hidden space-y-3 p-4">
                @foreach (var report in Model)
                {
                    <article class="bg-surface-container-lowest border border-surface-border rounded-xl p-4 space-y-3 shadow-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <div class="font-body-md font-bold text-on-surface">@report.BusinessDate.ToString("MMM d, yyyy")</div>
                                <div class="text-[10px] font-label-caps uppercase text-on-surface-variant">Daily Sales</div>
                            </div>
                            <span class="font-data-mono text-primary font-bold text-[15px]">₱@report.TotalConfirmedCashToHandover.ToString("N2")</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2 text-xs">
                            <div class="bg-surface-container-low rounded-lg p-2.5 border border-surface-border">
                                <div class="font-label-caps uppercase text-[9px] text-on-surface-variant font-bold">Opening</div>
                                <div class="mt-0.5">
                                    @if (report.OpeningCashSales > 0m)
                                    {
                                        <span class="text-audit-success font-bold">Saved</span>
                                    }
                                    else
                                    {
                                        <span class="text-on-surface-variant">Not set</span>
                                    }
                                </div>
                            </div>
                            <div class="bg-surface-container-low rounded-lg p-2.5 border border-surface-border">
                                <div class="font-label-caps uppercase text-[9px] text-on-surface-variant font-bold">Closing</div>
                                <div class="mt-0.5">
                                    @if (report.CashSales > 0m || report.Status == SalesReportStatus.PendingManagerVerification || report.Status == SalesReportStatus.Confirmed)
                                    {
                                        <span class="text-audit-success font-bold">Saved</span>
                                    }
                                    else
                                    {
                                        <span class="text-on-surface-variant">Not set</span>
                                    }
                                </div>
                            </div>
                        </div>
                        @{
                            var mobileConfirmedCash = (report.ConfirmedCashToHandover != 0m ? report.ConfirmedCashToHandover : (report.TotalConfirmedCashToHandover != 0m ? report.TotalConfirmedCashToHandover : (report.CashSales + report.OpeningCashSales))).ToString(System.Globalization.CultureInfo.InvariantCulture);
                            var mobileEstName = report.Establishment?.Name?.Replace("'", "\\'") ?? "Branch";
                            var mobileBDate = report.BusinessDate.ToString("yyyy-MM-dd");
                        }
                        <div class="bg-surface-container-low rounded-lg p-2.5 border border-surface-border flex items-center justify-between">
                            <div class="font-label-caps uppercase text-[9px] text-on-surface-variant font-bold">Deposit Slip</div>
                            <div>
                                @if (report.Status == SalesReportStatus.Confirmed)
                                {
                                    @if (!report.HasDepositSlip)
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-500/20 text-amber-500 dark:text-amber-300 border border-amber-500/30">
                                                Awaiting Slip
                                            </span>
                                            <button type="button" onclick="openDepositModal(@report.Id, @mobileConfirmedCash, '@mobileEstName', '@mobileBDate')" class="px-2 py-0.5 rounded bg-primary text-on-primary text-[9px] font-bold hover:brightness-110">
                                                Upload
                                            </button>
                                        </div>
                                    }
                                    else if (report.IsDepositMatched)
                                    {
                                        <a href="@report.DepositSlipImageUrl" target="_blank" class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[12px]">check_circle</span> ✓ Matched (₱@report.DepositedAmount?.ToString("N2"))
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@report.DepositSlipImageUrl" target="_blank" class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/30 inline-flex items-center gap-1" title="@report.DepositVarianceReason">
                                            <span class="material-symbols-outlined text-[12px]">warning</span> ⚠️ Diff (@(report.DepositVariance > 0 ? "+" : "")₱@report.DepositVariance.ToString("N2"))
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="text-slate-500 text-[11px]">—</span>
                                }
                            </div>
                        </div>
                        <div class="flex gap-2 pt-1">
                            @if (report.OpeningCashSales > 0m)
                            {
                                <a asp-controller="SalesReports" asp-action="OpeningReview" asp-route-id="@report.Id" class="flex-1 py-2 rounded-lg border border-surface-border text-center text-on-surface font-label-caps text-[10px] uppercase font-bold bg-surface-container-low">Edit Opening</a>
                            }
                            else
                            {
                                <a asp-controller="SalesReports" asp-action="Upload" asp-route-reportId="@report.Id" asp-route-section="Opening" class="flex-1 py-2 rounded-lg border border-primary text-center text-primary font-label-caps text-[10px] uppercase font-bold bg-primary/5">Add Opening</a>
                            }
                            @if (report.CashSales > 0m || report.Status == SalesReportStatus.PendingManagerVerification || report.Status == SalesReportStatus.Confirmed)
                            {
                                <a asp-controller="SalesReports" asp-action="Review" asp-route-id="@report.Id" class="flex-1 py-2 rounded-lg border border-surface-border text-center text-on-surface font-label-caps text-[10px] uppercase font-bold bg-surface-container-low">Edit Closing</a>
                            }
                            else
                            {
                                <a asp-controller="SalesReports" asp-action="Upload" asp-route-reportId="@report.Id" asp-route-section="Closing" class="flex-1 py-2 rounded-lg border border-primary text-center text-primary font-label-caps text-[10px] uppercase font-bold bg-primary/5">Add Closing</a>
                            }
                        </div>
                    </article>
                }
            </div>
            @if (!Model.Any())
            {
                <div class="p-space-8 text-center text-on-surface-variant font-body-md">No daily sales records yet.</div>
            }
        </div>
    </div>
}
else
{
    <div class="space-y-6">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-space-4">
        <div class="flex flex-col gap-space-2 max-w-3xl">
            <div class="flex items-center gap-space-2 text-primary">
                <span class="material-symbols-outlined text-[20px]">fact_check</span>
                <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Manager Verification</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Pending Sales Verification</h1>
            <p class="font-body-md text-on-surface-variant leading-relaxed">
                Review branch-submitted daily sales reports, count the handed-over cash, then Confirm to Treasury.
            </p>
        </div>
        <a asp-action="Upload" class="inline-flex items-center justify-center gap-space-2 rounded-xl bg-surface-container border border-surface-border px-6 py-2.5 text-primary font-label-caps uppercase tracking-widest text-[12px] hover:bg-surface-container-high transition-all font-semibold">
            <span class="material-symbols-outlined text-[18px]">upload_file</span>
            Upload Daily Sales Report
        </a>
    </div>

    <section class="bg-surface-container-lowest rounded-2xl shadow-md border border-surface-border/60 overflow-hidden">
        <div class="bg-[#041632] px-space-6 py-space-4 flex justify-between items-center">
            <div class="flex items-center gap-space-2 text-on-primary">
                <span class="material-symbols-outlined text-[18px]">hourglass_empty</span>
                <span class="font-label-caps uppercase tracking-widest text-[11px] font-semibold">Awaiting Manager Verification</span>
            </div>
            <span class="bg-on-primary/10 text-on-primary text-[10px] font-data-mono px-space-3 py-1 rounded-full border border-on-primary/10">@Model.Count() pending</span>
        </div>

        @if (!Model.Any())
        {
            <div class="p-space-8 text-center text-on-surface-variant">
                <span class="material-symbols-outlined text-[48px] text-primary/50">task_alt</span>
                <p class="font-headline-sm text-on-surface mt-space-3">No pending daily sales reports</p>
                <p class="text-[13px] mt-space-1">Branch-submitted reports will appear here after they click Submit for Manager Verification.</p>
            </div>
        }
        else
        {
            <div class="hidden lg:block max-h-[520px] overflow-y-auto overflow-x-auto">
                <table class="w-full text-left text-sm" style="min-width: 1140px;">
                    <thead class="sticky top-0 z-10 bg-surface-container/80 text-on-surface-variant font-label-caps uppercase text-[10px] tracking-wider border-b border-surface-border">
                        <tr>
                            <th class="px-6 py-3.5" style="width: 17%; min-width: 160px;">Branch</th>
                            <th class="px-6 py-3.5" style="width: 12%; min-width: 125px;">Business Date</th>
                            <th class="px-6 py-3.5" style="width: 12%; min-width: 125px;">Handover Date</th>
                            <th class="px-6 py-3.5" style="width: 22%; min-width: 210px;">Cashier / Staff</th>
                            <th class="px-6 py-3.5 text-right" style="width: 12%; min-width: 130px;">Cash to Handover</th>
                            <th class="px-6 py-3.5 text-center" style="width: 8%; min-width: 85px;">Status</th>
                            <th class="px-6 py-3.5 text-center" style="width: 11%; min-width: 130px;">Deposit Slip</th>
                            <th class="px-6 py-3.5 text-right" style="width: 8%; min-width: 130px;">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-border bg-surface-container-lowest">
                        @foreach (var report in Model)
                        {
                            <tr class="hover:bg-primary/5 transition-colors duration-150">
                                <td class="px-6 py-4 font-semibold text-on-surface whitespace-nowrap">
                                    <div class="flex items-center gap-space-2">
                                        <span class="material-symbols-outlined text-primary/75 text-[18px]">location_on</span>
                                        <span>@report.Establishment.Name</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-on-surface-variant whitespace-nowrap">
                                    <div class="flex items-center gap-space-2">
                                        <span class="material-symbols-outlined text-on-surface-variant/70 text-[16px]">calendar_month</span>
                                        <span>@report.BusinessDate.ToString("MMM d, yyyy")</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-on-surface-variant whitespace-nowrap">
                                    <div class="flex items-center gap-space-2">
                                        <span class="material-symbols-outlined text-on-surface-variant/70 text-[16px]">calendar_today</span>
                                        <span>@report.HandoverDate.ToString("MMM d, yyyy")</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-on-surface">
                                    @if (!string.Equals(report.OpeningInputtedByDisplayName, report.ClosingInputtedByDisplayName, StringComparison.Ordinal)
                                        && !string.IsNullOrWhiteSpace(report.OpeningInputtedByDisplayName)
                                        && !string.IsNullOrWhiteSpace(report.ClosingInputtedByDisplayName))
                                    {
                                        <div class="flex flex-col gap-1 text-[12px]">
                                            <div class="flex items-center gap-1.5 min-w-0">
                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-label-caps uppercase tracking-wider bg-surface-container-high text-on-surface-variant font-bold">Open</span>
                                                <span class="font-body-md text-on-surface text-[12px] font-medium truncate">@report.OpeningInputtedByDisplayName</span>
                                            </div>
                                            <div class="flex items-center gap-1.5 min-w-0">
                                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-label-caps uppercase tracking-wider bg-surface-container-high text-on-surface-variant font-bold">Close</span>
                                                <span class="font-body-md text-on-surface text-[12px] font-medium truncate">@report.ClosingInputtedByDisplayName</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-space-2">
                                            <span class="material-symbols-outlined text-on-surface-variant/70 text-[16px]">person</span>
                                            <span class="font-body-md text-on-surface text-[13px] font-medium">@report.InputtedBySummary</span>
                                        </div>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right font-data-mono text-primary font-bold text-[14px] whitespace-nowrap">
                                    ₱@report.TotalConfirmedCashToHandover.ToString("N2")
                                </td>
                                <td class="px-6 py-4 text-center whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1.5 rounded-full border border-audit-pending/20 bg-audit-pending/10 px-3 py-1 text-[10px] font-label-caps uppercase tracking-wider text-audit-pending font-semibold whitespace-nowrap shadow-sm">
                                        <span class="w-1.5 h-1.5 rounded-full bg-audit-pending"></span>
                                        Pending
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-center whitespace-nowrap">
                                    @{
                                        var mgrConfirmedCash = (report.ConfirmedCashToHandover != 0m ? report.ConfirmedCashToHandover : (report.TotalConfirmedCashToHandover != 0m ? report.TotalConfirmedCashToHandover : (report.CashSales + report.OpeningCashSales))).ToString(System.Globalization.CultureInfo.InvariantCulture);
                                        var mgrEstName = report.Establishment?.Name?.Replace("'", "\\'") ?? "Branch";
                                        var mgrBDate = report.BusinessDate.ToString("yyyy-MM-dd");
                                    }
                                    @if (report.Status == SalesReportStatus.Confirmed)
                                    {
                                        <div class="space-y-1 text-[11px] text-left">
                                            @if (report.OpeningCashSales > 0m)
                                            {
                                                <div class="flex items-center justify-between gap-2">
                                                    <span class="text-on-surface-variant text-[10px]">Opener:</span>
                                                    @if (report.HasOpeningDepositSlip)
                                                    {
                                                        <a href="@report.OpeningDepositSlipImageUrl" target="_blank" class="font-bold text-emerald-500 hover:underline">✓ ₱@report.OpeningDepositedAmount?.ToString("N2")</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-amber-500 font-bold text-[10px]">Awaiting</span>
                                                    }
                                                </div>
                                            }
                                            <div class="flex items-center justify-between gap-2">
                                                <span class="text-on-surface-variant text-[10px]">Closer:</span>
                                                @if (report.HasClosingDepositSlip)
                                                {
                                                    <a href="@(report.ClosingDepositSlipImageUrl ?? report.DepositSlipImageUrl)" target="_blank" class="font-bold text-emerald-500 hover:underline">✓ ₱@((report.ClosingDepositedAmount ?? report.DepositedAmount)?.ToString("N2"))</a>
                                                }
                                                else
                                                {
                                                    <span class="text-amber-500 font-bold text-[10px]">Awaiting</span>
                                                }
                                            </div>
                                            <button type="button" onclick="openDepositModal(@report.Id, @mgrConfirmedCash, '@mgrEstName', '@mgrBDate', @report.OpeningCashSales.ToString(System.Globalization.CultureInfo.InvariantCulture), @((report.CashSales > 0m ? report.CashSales : report.ConfirmedCashToHandover).ToString(System.Globalization.CultureInfo.InvariantCulture)))" class="w-full mt-0.5 px-2 py-0.5 rounded bg-primary text-on-primary text-[10px] font-bold hover:brightness-110">
                                                Upload Slip
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-slate-500 text-[11px]">—</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <a asp-action="Review" asp-route-id="@report.Id" class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary hover:bg-primary/90 text-on-primary px-space-4 py-2 font-label-caps uppercase tracking-wider text-[11px] font-semibold shadow-sm hover:shadow transition-all duration-150 whitespace-nowrap">
                                        <span class="material-symbols-outlined text-[15px]">fact_check</span>
                                        Review & Confirm
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="block lg:hidden space-y-3 p-4 max-h-[520px] overflow-y-auto">
                @foreach (var report in Model)
                {
                    <article class="bg-surface-container-lowest border border-surface-border rounded-xl p-4 space-y-3 shadow-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <div class="flex items-center gap-1.5 font-bold text-on-surface text-sm">
                                    <span class="material-symbols-outlined text-primary text-[18px]">location_on</span>
                                    <span>@report.Establishment.Name</span>
                                </div>
                                <div class="text-[10px] font-label-caps uppercase text-on-surface-variant mt-0.5">
                                    @report.BusinessDate.ToString("MMM d, yyyy") &bull; Handover: @report.HandoverDate.ToString("MMM d")
                                </div>
                            </div>
                            <span class="inline-flex items-center gap-1 rounded-full border border-audit-pending/20 bg-audit-pending/10 px-2.5 py-0.5 text-[10px] font-label-caps uppercase tracking-wider text-audit-pending font-bold whitespace-nowrap">
                                <span class="w-1.5 h-1.5 rounded-full bg-audit-pending"></span>
                                Pending
                            </span>
                        </div>

                        <div class="bg-surface-container-low rounded-lg p-3 border border-surface-border flex items-center justify-between">
                            <div>
                                <div class="text-[9px] font-label-caps uppercase text-on-surface-variant font-bold">Cash to Handover</div>
                                <div class="font-data-mono text-primary font-extrabold text-[16px]">
                                    ₱@report.TotalConfirmedCashToHandover.ToString("N2")
                                </div>
                            </div>
                            <div class="text-right max-w-[50%]">
                                <div class="text-[9px] font-label-caps uppercase text-on-surface-variant font-bold">Inputted By</div>
                                <div class="text-xs font-semibold text-on-surface truncate">
                                    @report.InputtedBySummary
                                </div>
                            </div>
                        </div>
                        @{
                            var mgrMobileConfirmedCash = (report.ConfirmedCashToHandover != 0m ? report.ConfirmedCashToHandover : (report.TotalConfirmedCashToHandover != 0m ? report.TotalConfirmedCashToHandover : (report.CashSales + report.OpeningCashSales))).ToString(System.Globalization.CultureInfo.InvariantCulture);
                            var mgrMobileEstName = report.Establishment?.Name?.Replace("'", "\\'") ?? "Branch";
                            var mgrMobileBDate = report.BusinessDate.ToString("yyyy-MM-dd");
                        }
                        <div class="bg-surface-container-low rounded-lg p-3 border border-surface-border flex items-center justify-between">
                            <div class="text-[9px] font-label-caps uppercase text-on-surface-variant font-bold">Deposit Slip</div>
                            <div>
                                @if (report.Status == SalesReportStatus.Confirmed)
                                {
                                    @if (!report.HasDepositSlip)
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <span class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-amber-500/20 text-amber-500 dark:text-amber-300 border border-amber-500/30">
                                                Awaiting Slip
                                            </span>
                                            <button type="button" onclick="openDepositModal(@report.Id, @mgrMobileConfirmedCash, '@mgrMobileEstName', '@mgrMobileBDate')" class="px-2 py-0.5 rounded bg-primary text-on-primary text-[9px] font-bold hover:brightness-110">
                                                Upload
                                            </button>
                                        </div>
                                    }
                                    else if (report.IsDepositMatched)
                                    {
                                        <a href="@report.DepositSlipImageUrl" target="_blank" class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-[12px]">check_circle</span> ✓ Matched (₱@report.DepositedAmount?.ToString("N2"))
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@report.DepositSlipImageUrl" target="_blank" class="px-2 py-0.5 rounded-full text-[9px] font-bold bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/30 inline-flex items-center gap-1" title="@report.DepositVarianceReason">
                                            <span class="material-symbols-outlined text-[12px]">warning</span> ⚠️ Diff (@(report.DepositVariance > 0 ? "+" : "")₱@report.DepositVariance.ToString("N2"))
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="text-slate-500 text-[11px]">—</span>
                                }
                            </div>
                        </div>

                        <a asp-action="Review" asp-route-id="@report.Id" class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-primary hover:bg-primary/90 text-on-primary py-2.5 font-label-caps uppercase tracking-wider text-xs font-bold shadow-sm transition-all">
                            <span class="material-symbols-outlined text-[16px]">fact_check</span>
                            Review &amp; Confirm
                        </a>
                    </article>
                }
            </div>
        }
    </section>
</div>
}

<!-- Quick-Upload Deposit Slip Modal -->
<div id="salesReportDepositModal" class="fixed inset-0 z-[100] hidden bg-black/70 flex items-center justify-center p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="depositModalTitle">
    <div class="relative w-full max-w-lg bg-surface-container-lowest rounded-2xl shadow-2xl border border-surface-border overflow-hidden">
        <div class="px-5 py-4 border-b border-surface-border flex items-center justify-between bg-surface-container-low">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-xl">upload_file</span>
                <h3 id="depositModalTitle" class="font-headline-sm text-sm font-bold text-on-surface">Upload Bank Deposit Slip</h3>
            </div>
            <button type="button" onclick="closeDepositModal()" class="text-on-surface-variant hover:text-on-surface p-1 rounded-lg hover:bg-surface-container-high transition">
                <span class="material-symbols-outlined text-lg">close</span>
            </button>
        </div>

        <form id="salesReportDepositForm" onsubmit="handleDepositModalSubmit(event)" class="p-5 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="depositModalSalesReportId" name="SalesReportId" value="" />

            <!-- Summary Banner -->
            <div class="rounded-xl bg-surface-container p-3.5 border border-surface-border text-xs flex justify-between items-center">
                <div>
                    <span class="text-on-surface-variant block text-[10px] font-label-caps uppercase font-bold">Branch &amp; Date</span>
                    <span id="depositModalEstName" class="font-bold text-on-surface text-sm">--</span>
                    <span id="depositModalBusDate" class="text-on-surface-variant text-xs block">--</span>
                </div>
                <div class="text-right">
                    <span class="text-on-surface-variant block text-[10px] font-label-caps uppercase font-bold">Confirmed Cash Sales</span>
                    <span id="depositModalHandoverAmount" class="font-bold text-primary text-sm font-data-mono">₱0.00</span>
                </div>
            </div>

            <!-- Dynamic Comparison Banner -->
            <div id="depositModalComparisonBanner" class="rounded-lg p-3 text-xs flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                <span id="depositModalComparisonText"><strong>Balanced:</strong> Deposited amount matches confirmed cash sales.</span>
            </div>

            <!-- Error message container -->
            <div id="depositModalErrorBox" class="hidden rounded-lg bg-red-500/10 border border-red-500/30 p-3 text-xs text-red-500"></div>

            <!-- File dropzone & OCR section -->
            <div class="space-y-2">
                <label class="block text-xs font-semibold text-on-surface">Deposit Slip Image *</label>
                <div id="depositDropzone" onclick="document.getElementById('depositModalFileInput').click()" class="border-2 border-dashed border-outline-variant hover:border-primary rounded-xl p-4 text-center cursor-pointer transition bg-surface-container-low/50 hover:bg-surface-container-low">
                    <input type="file" id="depositModalFileInput" name="depositSlipFile" accept=".png,.jpg,.jpeg,.webp" class="hidden" onchange="handleModalFileSelected(event)" />
                    <div id="depositDropzonePlaceholder" class="space-y-1">
                        <span class="material-symbols-outlined text-primary text-3xl">cloud_upload</span>
                        <div class="text-xs text-on-surface font-medium">Click or drag &amp; drop deposit slip image</div>
                        <div class="text-[10px] text-on-surface-variant">PNG, JPG, JPEG, WEBP up to 10MB</div>
                    </div>
                    <div id="depositFilePreviewContainer" class="hidden flex items-center justify-between gap-3 text-left">
                        <div class="flex items-center gap-2 min-w-0">
                            <img id="depositFilePreviewImg" class="w-12 h-12 object-cover rounded-lg border border-surface-border flex-shrink-0" alt="Preview" />
                            <div class="min-w-0">
                                <span id="depositFileNameText" class="text-xs font-semibold text-on-surface truncate block">filename.jpg</span>
                                <span class="text-[10px] text-on-surface-variant">Click to choose another</span>
                            </div>
                        </div>
                        <span class="material-symbols-outlined text-primary text-xl">check_circle</span>
                    </div>
                </div>

                <!-- OCR Action Row -->
                <div class="flex items-center justify-between gap-2 pt-1">
                    <button type="button" id="btnScanOcr" onclick="scanModalDepositSlipOcr()" disabled class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-surface-container-high hover:bg-surface-container-highest border border-surface-border text-on-surface text-xs font-semibold disabled:opacity-50 disabled:cursor-not-allowed transition shadow-sm">
                        <span class="material-symbols-outlined text-sm">document_scanner</span>
                        <span id="btnScanOcrText">Scan with OCR</span>
                        <span id="scanOcrSpinner" class="hidden w-3 h-3 border-2 border-primary border-t-transparent rounded-full animate-spin"></span>
                    </button>
                    <div id="depositOcrStatusNote" class="hidden text-[11px]"></div>
                </div>
            </div>

            <!-- Form fields -->
            <div class="space-y-3">
                <div>
                    <label for="depositModalSection" class="block text-xs font-semibold text-on-surface mb-1">Select Shift *</label>
                    <select id="depositModalSection" name="Section" class="w-full rounded-lg border border-outline bg-surface px-3 py-2 text-xs text-on-surface focus:ring-1 focus:ring-primary font-bold" onchange="onModalSectionChanged()">
                        <option value="Closing">Closing Shift Deposit</option>
                        <option value="Opening">Opening Shift Deposit</option>
                    </select>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label for="depositModalBankName" class="block text-xs font-semibold text-on-surface mb-1">Bank Name *</label>
                        <input type="text" id="depositModalBankName" name="DepositBankName" list="modalBankList" required placeholder="e.g. BDO, BPI" class="w-full rounded-lg border border-outline bg-surface px-3 py-2 text-xs text-on-surface focus:ring-1 focus:ring-primary" />
                        <datalist id="modalBankList">
                            <option value="BDO" />
                            <option value="BPI" />
                            <option value="Metrobank" />
                            <option value="Security Bank" />
                            <option value="Landbank" />
                            <option value="UnionBank" />
                            <option value="RCBC" />
                            <option value="PNB" />
                            <option value="China Bank" />
                        </datalist>
                    </div>
                    <div>
                        <label for="depositModalRef" class="block text-xs font-semibold text-on-surface mb-1">Reference / Trans #</label>
                        <input type="text" id="depositModalRef" name="DepositReferenceNumber" placeholder="e.g. TRN-12345" class="w-full rounded-lg border border-outline bg-surface px-3 py-2 text-xs text-on-surface focus:ring-1 focus:ring-primary" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label for="depositModalAmount" class="block text-xs font-semibold text-on-surface mb-1">Deposited Amount (₱) *</label>
                        <input type="number" step="0.01" min="0.01" id="depositModalAmount" name="DepositedAmount" required class="w-full rounded-lg border border-outline bg-surface px-3 py-2 text-xs text-on-surface font-data-mono font-bold focus:ring-1 focus:ring-primary" oninput="updateDepositComparison()" />
                    </div>
                    <div>
                        <label for="depositModalDate" class="block text-xs font-semibold text-on-surface mb-1">Deposit Date *</label>
                        <input type="date" id="depositModalDate" name="DepositDate" required class="w-full rounded-lg border border-outline bg-surface px-3 py-2 text-xs text-on-surface focus:ring-1 focus:ring-primary" />
                    </div>
                </div>

                <!-- Discrepancy Variance Reason -->
                <div id="depositVarianceGroup" class="hidden">
                    <label for="depositModalVarianceReason" class="block text-xs font-semibold text-red-500 mb-1">Variance Explanation *</label>
                    <textarea id="depositModalVarianceReason" name="DepositVarianceReason" rows="2" placeholder="Explain why the deposited amount differs from confirmed cash..." class="w-full rounded-lg border border-red-500/50 bg-surface px-3 py-2 text-xs text-on-surface focus:ring-1 focus:ring-red-500"></textarea>
                </div>
            </div>

            <!-- Footer Buttons -->
            <div class="pt-3 border-t border-surface-border flex justify-end gap-2">
                <button type="button" onclick="closeDepositModal()" class="px-4 py-2 text-xs font-semibold rounded-lg border border-outline text-on-surface hover:bg-surface-container transition">
                    Cancel
                </button>
                <button type="submit" id="btnDepositModalSubmit" class="px-4 py-2 text-xs font-semibold rounded-lg bg-primary text-on-primary hover:bg-primary/90 shadow-sm transition inline-flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm">cloud_upload</span>
                    <span id="btnDepositModalSubmitText">Upload &amp; Record Deposit</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let currentExpectedCash = 0;
    let selectedDepositFile = null;

    let modalOpeningCash = 0;
    let modalClosingCash = 0;

    window.openDepositModal = function(reportId, confirmedCash, establishmentName, businessDate, openingCash, closingCash) {
        const modal = document.getElementById('salesReportDepositModal');
        const form = document.getElementById('salesReportDepositForm');
        const errorBox = document.getElementById('depositModalErrorBox');
        if (!modal || !form) return;

        form.reset();
        selectedDepositFile = null;
        document.getElementById('depositModalSalesReportId').value = reportId;
        document.getElementById('depositModalEstName').textContent = establishmentName || 'Branch';
        document.getElementById('depositModalBusDate').textContent = businessDate || '';

        modalOpeningCash = Number(openingCash) || 0;
        modalClosingCash = Number(closingCash) || Number(confirmedCash) || 0;

        const sectionSelect = document.getElementById('depositModalSection');
        if (sectionSelect) {
            sectionSelect.value = "Closing";
        }
        currentExpectedCash = modalClosingCash;

        document.getElementById('depositModalHandoverAmount').textContent = '₱' + currentExpectedCash.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('depositModalAmount').value = currentExpectedCash > 0 ? currentExpectedCash.toFixed(2) : '';

        const dateInput = document.getElementById('depositModalDate');
        if (dateInput) {
            dateInput.value = businessDate ? businessDate : new Date().toISOString().split('T')[0];
        }

        resetDepositModalFilePreview();

        if (errorBox) {
            errorBox.classList.add('hidden');
            errorBox.textContent = '';
        }

        updateDepositComparison();
        modal.classList.remove('hidden');
    };

    window.onModalSectionChanged = function() {
        const section = document.getElementById('depositModalSection')?.value || 'Closing';
        currentExpectedCash = section === 'Opening' ? modalOpeningCash : modalClosingCash;
        document.getElementById('depositModalHandoverAmount').textContent = '₱' + currentExpectedCash.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('depositModalAmount').value = currentExpectedCash > 0 ? currentExpectedCash.toFixed(2) : '';
        updateDepositComparison();
    };
        resetDepositModalFilePreview();

        if (errorBox) {
            errorBox.classList.add('hidden');
            errorBox.textContent = '';
        }

        updateDepositComparison();
        modal.classList.remove('hidden');
    };

    window.closeDepositModal = function() {
        const modal = document.getElementById('salesReportDepositModal');
        if (modal) modal.classList.add('hidden');
    };

    window.handleModalFileSelected = function(e) {
        const files = e.target.files;
        if (files && files.length > 0) {
            setDepositFile(files[0]);
        }
    };

    function setDepositFile(file) {
        if (!file) return;
        const allowed = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
        if (!allowed.includes(file.type) && !file.name.match(/\.(png|jpe?g|webp)$/i)) {
            alert('Please upload a valid image (PNG, JPG, JPEG, WEBP).');
            return;
        }
        selectedDepositFile = file;
        const previewContainer = document.getElementById('depositFilePreviewContainer');
        const previewImg = document.getElementById('depositFilePreviewImg');
        const fileNameSpan = document.getElementById('depositFileNameText');
        const dropzonePlaceholder = document.getElementById('depositDropzonePlaceholder');
        const scanOcrBtn = document.getElementById('btnScanOcr');

        if (fileNameSpan) fileNameSpan.textContent = file.name;
        if (previewImg) {
            const reader = new FileReader();
            reader.onload = (e) => {
                previewImg.src = e.target.result;
                if (previewContainer) previewContainer.classList.remove('hidden');
                if (dropzonePlaceholder) dropzonePlaceholder.classList.add('hidden');
            };
            reader.readAsDataURL(file);
        }
        if (scanOcrBtn) {
            scanOcrBtn.disabled = false;
        }
    }

    function resetDepositModalFilePreview() {
        const previewContainer = document.getElementById('depositFilePreviewContainer');
        const previewImg = document.getElementById('depositFilePreviewImg');
        const dropzonePlaceholder = document.getElementById('depositDropzonePlaceholder');
        const scanOcrBtn = document.getElementById('btnScanOcr');
        const statusNote = document.getElementById('depositOcrStatusNote');
        const fileInput = document.getElementById('depositModalFileInput');

        if (fileInput) fileInput.value = '';
        if (previewImg) previewImg.src = '';
        if (previewContainer) previewContainer.classList.add('hidden');
        if (dropzonePlaceholder) dropzonePlaceholder.classList.remove('hidden');
        if (scanOcrBtn) scanOcrBtn.disabled = true;
        if (statusNote) {
            statusNote.classList.add('hidden');
            statusNote.textContent = '';
        }
    }

    window.updateDepositComparison = function() {
        const amountInput = document.getElementById('depositModalAmount');
        const banner = document.getElementById('depositModalComparisonBanner');
        const bannerText = document.getElementById('depositModalComparisonText');
        const varianceGroup = document.getElementById('depositVarianceGroup');
        const varianceInput = document.getElementById('depositModalVarianceReason');
        if (!amountInput || !banner) return;

        const entered = parseFloat(amountInput.value) || 0;
        const diff = entered - currentExpectedCash;
        const absDiff = Math.abs(diff);

        if (absDiff < 0.01) {
            banner.className = 'rounded-lg p-3 text-xs flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400';
            if (bannerText) {
                bannerText.innerHTML = `<strong>Balanced:</strong> Deposited amount matches confirmed cash sales (₱${currentExpectedCash.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}).`;
            }
            if (varianceGroup) varianceGroup.classList.add('hidden');
            if (varianceInput) {
                varianceInput.required = false;
            }
        } else {
            const statusType = diff > 0 ? 'Over' : 'Short';
            const sign = diff > 0 ? '+' : '-';
            banner.className = 'rounded-lg p-3 text-xs flex items-center gap-2 bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400';
            if (bannerText) {
                bannerText.innerHTML = `<strong>Discrepancy (${statusType}):</strong> Variance of ${sign}₱${absDiff.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}. A variance explanation is mandatory.`;
            }
            if (varianceGroup) varianceGroup.classList.remove('hidden');
            if (varianceInput) {
                varianceInput.required = true;
            }
        }
    };

    window.scanModalDepositSlipOcr = async function() {
        if (!selectedDepositFile) {
            alert('Please select or drop a deposit slip image first.');
            return;
        }
        const scanBtn = document.getElementById('btnScanOcr');
        const scanBtnText = document.getElementById('btnScanOcrText');
        const scanOcrSpinner = document.getElementById('scanOcrSpinner');
        const statusNote = document.getElementById('depositOcrStatusNote');

        if (scanBtn) scanBtn.disabled = true;
        if (scanOcrSpinner) scanOcrSpinner.classList.remove('hidden');
        if (scanBtnText) scanBtnText.textContent = 'Scanning...';

        try {
            const formData = new FormData();
            formData.append('depositSlipImage', selectedDepositFile);
            const res = await fetch('/SalesReports/ExtractDepositSlipOcr', {
                method: 'POST',
                body: formData
            });
            if (res.ok) {
                const data = await res.json();
                if (data.success) {
                    let filledFields = [];
                    if (data.detectedBank) {
                        document.getElementById('depositModalBankName').value = data.detectedBank;
                        filledFields.push('Bank: ' + data.detectedBank);
                    }
                    if (data.detectedAmount) {
                        document.getElementById('depositModalAmount').value = Number(data.detectedAmount).toFixed(2);
                        filledFields.push('Amount: ₱' + Number(data.detectedAmount).toFixed(2));
                        updateDepositComparison();
                    }
                    if (data.detectedReference) {
                        document.getElementById('depositModalRef').value = data.detectedReference;
                        filledFields.push('Ref: ' + data.detectedReference);
                    }
                    if (data.detectedDate) {
                        document.getElementById('depositModalDate').value = data.detectedDate;
                        filledFields.push('Date: ' + data.detectedDate);
                    }
                    if (statusNote) {
                        statusNote.className = 'text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold flex items-center gap-1';
                        statusNote.innerHTML = '<span class="material-symbols-outlined text-[14px]">check</span> <span></span>';
                        statusNote.querySelector('span:last-child').textContent = 'Auto-filled via OCR (' + (filledFields.join(', ') || 'Fields detected') + ')';
                        statusNote.classList.remove('hidden');
                    }
                } else {
                    if (statusNote) {
                        statusNote.className = 'text-[11px] text-amber-500 font-semibold flex items-center gap-1';
                        statusNote.innerHTML = '<span class="material-symbols-outlined text-[14px]">info</span> OCR could not read all fields clearly. Please verify inputs manually.';
                        statusNote.classList.remove('hidden');
                    }
                }
            } else {
                if (statusNote) {
                    statusNote.className = 'text-[11px] text-red-500 font-semibold';
                    statusNote.textContent = 'OCR extraction failed. Please enter details manually.';
                    statusNote.classList.remove('hidden');
                }
            }
        } catch (err) {
            console.error('OCR Error:', err);
            if (statusNote) {
                statusNote.className = 'text-[11px] text-red-500 font-semibold';
                statusNote.textContent = 'Error connecting to OCR service.';
                statusNote.classList.remove('hidden');
            }
        } finally {
            if (scanBtn) scanBtn.disabled = false;
            if (scanOcrSpinner) scanOcrSpinner.classList.add('hidden');
            if (scanBtnText) scanBtnText.textContent = 'Scan with OCR';
        }
    };

    window.handleDepositModalSubmit = async function(event) {
        event.preventDefault();
        const form = document.getElementById('salesReportDepositForm');
        const errorBox = document.getElementById('depositModalErrorBox');
        const submitBtn = document.getElementById('btnDepositModalSubmit');
        const submitText = document.getElementById('btnDepositModalSubmitText');
        if (!form) return;

        if (!selectedDepositFile) {
            if (errorBox) {
                errorBox.textContent = 'Please choose a deposit slip image.';
                errorBox.classList.remove('hidden');
            }
            return;
        }

        const varianceInput = document.getElementById('depositModalVarianceReason');
        const amountInput = document.getElementById('depositModalAmount');
        const entered = parseFloat(amountInput.value) || 0;
        const absDiff = Math.abs(entered - currentExpectedCash);
        if (absDiff >= 0.01 && (!varianceInput.value || !varianceInput.value.trim())) {
            if (errorBox) {
                errorBox.textContent = 'A Deposit Variance explanation is required when the deposited amount differs from confirmed cash sales.';
                errorBox.classList.remove('hidden');
            }
            varianceInput.focus();
            return;
        }

        const formData = new FormData(form);
        formData.append('depositSlipFile', selectedDepositFile);

        if (errorBox) {
            errorBox.classList.add('hidden');
            errorBox.textContent = '';
        }

        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.textContent = 'Uploading...';

        try {
            const response = await fetch('/SalesReports/UploadDepositSlip', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const data = await response.json();
                alert(data.message || 'Deposit slip uploaded and recorded successfully!');
                window.location.reload();
            } else {
                let errorMsg = 'Failed to upload deposit slip.';
                try {
                    const data = await response.json();
                    if (data && data.message) {
                        errorMsg = data.message;
                    } else if (typeof data === 'string') {
                        errorMsg = data;
                    }
                } catch {
                    const text = await response.text();
                    if (text) errorMsg = text;
                }
                if (errorBox) {
                    errorBox.textContent = errorMsg;
                    errorBox.classList.remove('hidden');
                } else {
                    alert(errorMsg);
                }
            }
        } catch (err) {
            console.error('Upload Error:', err);
            if (errorBox) {
                errorBox.textContent = 'Network or server error while uploading.';
                errorBox.classList.remove('hidden');
            }
        } finally {
            if (submitBtn) submitBtn.disabled = false;
            if (submitText) submitText.textContent = 'Upload & Record Deposit';
        }
    };

    document.addEventListener('DOMContentLoaded', () => {
        const dropzone = document.getElementById('depositDropzone');
        if (dropzone) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.add('border-primary', 'bg-surface-container-low');
                }, false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                dropzone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.remove('border-primary', 'bg-surface-container-low');
                }, false);
            });
            dropzone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files && files.length > 0) {
                    setDepositFile(files[0]);
                }
            });
        }
    });
</script>
