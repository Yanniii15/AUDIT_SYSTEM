@model AuditCkDayo.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
}

<section class="space-y-space-6">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-space-4">
        <div class="space-y-space-2 max-w-3xl">
            <div class="flex items-center gap-space-2 text-primary">
                <span class="material-symbols-outlined text-[20px]">assessment</span>
                <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Role-scoped reports</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Reports</h1>
            <p class="font-body-md text-on-surface-variant leading-relaxed">@Model.ScopeLabel. Date and buyer filters narrow surrender and ledger activity; status filters apply to audits.</p>
        </div>
        <div class="shrink-0 min-w-[132px] max-w-[180px] bg-primary text-on-primary px-space-4 py-space-3 rounded-xl shadow-sm text-right">
            <span class="block text-[10px] leading-none font-label-caps uppercase text-primary-fixed-dim whitespace-nowrap">Current role</span>
            <span class="block font-headline-sm leading-tight mt-1 truncate">@Model.Role</span>
        </div>
    </div>

    <form method="get" asp-controller="Reports" asp-action="Index" class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm p-space-4 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-[repeat(6,minmax(140px,1fr))_auto_auto] gap-space-3 items-end">
        <div class="flex flex-col min-w-0">
            <span class="font-label-caps text-[10px] leading-none text-on-surface-variant mb-2 uppercase tracking-wider">Start Date</span>
            <input name="StartDate" value="@(Model.Filter.StartDate?.ToString("yyyy-MM-dd"))" class="h-11 w-full bg-surface-container-low border border-surface-border rounded-lg px-space-3 py-0 text-[14px] text-on-surface focus:outline-none focus:border-primary/50" type="date" />
        </div>
        <div class="flex flex-col min-w-0">
            <span class="font-label-caps text-[10px] leading-none text-on-surface-variant mb-2 uppercase tracking-wider">End Date</span>
            <input name="EndDate" value="@(Model.Filter.EndDate?.ToString("yyyy-MM-dd"))" class="h-11 w-full bg-surface-container-low border border-surface-border rounded-lg px-space-3 py-0 text-[14px] text-on-surface focus:outline-none focus:border-primary/50" type="date" />
        </div>
        <div class="flex flex-col min-w-0">
            <span class="font-label-caps text-[10px] leading-none text-on-surface-variant mb-2 uppercase tracking-wider">Status</span>
            <select name="Status" class="h-11 w-full bg-surface-container-low border border-surface-border rounded-lg px-space-3 py-0 text-[14px] text-on-surface focus:outline-none focus:border-primary/50" asp-items="ViewBag.Statuses">
                <option value="">All Statuses</option>
            </select>
        </div>
        <div class="flex flex-col min-w-0">
            <span class="font-label-caps text-[10px] leading-none text-on-surface-variant mb-2 uppercase tracking-wider">Establishment</span>
            <select name="EstablishmentId" class="h-11 w-full bg-surface-container-low border border-surface-border rounded-lg px-space-3 py-0 text-[14px] text-on-surface focus:outline-none focus:border-primary/50" asp-items="ViewBag.Establishments">
                <option value="">All Locations</option>
            </select>
        </div>
        <div class="flex flex-col min-w-0">
            <span class="font-label-caps text-[10px] leading-none text-on-surface-variant mb-2 uppercase tracking-wider">Buyer</span>
            <select name="BuyerId" class="h-11 w-full bg-surface-container-low border border-surface-border rounded-lg px-space-3 py-0 text-[14px] text-on-surface focus:outline-none focus:border-primary/50" asp-items="ViewBag.Buyers">
                <option value="">All Buyers</option>
            </select>
        </div>
        <div class="flex flex-col min-w-0">
            <span class="font-label-caps text-[10px] leading-none text-on-surface-variant mb-2 uppercase tracking-wider">Treasury Handler</span>
            <select name="TreasuryHandlerId" class="h-11 w-full bg-surface-container-low border border-surface-border rounded-lg px-space-3 py-0 text-[14px] text-on-surface focus:outline-none focus:border-primary/50" asp-items="ViewBag.TreasuryHandlers">
                <option value="">All Handlers</option>
            </select>
        </div>
        <button type="submit" class="h-11 min-w-[96px] bg-primary text-on-primary px-space-5 rounded-lg font-label-caps uppercase text-[11px] tracking-wider hover:brightness-110 transition-all inline-flex items-center justify-center gap-space-2 whitespace-nowrap">
            Apply <span class="material-symbols-outlined text-[17px]">done_all</span>
        </button>
        <a asp-controller="Reports" asp-action="Index" class="h-11 min-w-[84px] bg-surface-container text-on-surface-variant border border-surface-border px-space-5 rounded-lg font-label-caps uppercase text-[11px] tracking-wider hover:bg-surface-container-high transition-all decoration-none inline-flex items-center justify-center whitespace-nowrap">Clear</a>
    </form>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-space-6">
        <section class="xl:col-span-2 bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm overflow-hidden">
            <div class="px-space-6 py-space-4 border-b border-surface-border flex items-center justify-between">
                <h2 class="font-headline-sm text-on-surface">Recent Audits</h2>
                <span class="text-[12px] text-on-surface-variant">Latest 25</span>
            </div>
            <div class="hidden lg:block overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container-low border-b border-surface-border">
                            <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant">Date</th>
                            <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant">Buyer</th>
                            <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant">Establishment</th>
                            <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant text-right">Amount</th>
                            <th class="px-space-6 py-space-3 font-label-caps uppercase text-[11px] text-on-surface-variant text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-border">
                        @if (!Model.RecentAudits.Any())
                        {
                            <tr><td colspan="5" class="px-space-6 py-space-8 text-center text-on-surface-variant">No audits match the selected scope.</td></tr>
                        }
                        else
                        {
                            @foreach (var audit in Model.RecentAudits)
                            {
                                <tr class="hover:bg-surface-container-low/50 transition-colors cursor-pointer"
                                    onclick="openReportsViewer(this)"
                                    data-buyer="@audit.Buyer.Name"
                                    data-establishment="@audit.Establishment.Name"
                                    data-date="@audit.EntryDate.ToString("MMM dd, yyyy")"
                                    data-amount="₱@audit.Amount.ToString("N2")"
                                    data-description="@audit.Description"
                                    data-notes="@audit.Notes"
                                    data-details="@System.Text.Json.JsonSerializer.Serialize(audit.Details.Select(d => new { name = d.ItemName, qty = d.Quantity, price = d.Price, total = d.Total }))"
                                    data-receipt-url="@(string.IsNullOrEmpty(audit.ReceiptImageUrl) ? "https://images.unsplash.com/photo-1554415707-6e8cfc93fe23?q=80&w=600" : audit.ReceiptImageUrl)">
                                    <td class="px-space-6 py-space-4 text-on-surface">@audit.EntryDate.ToString("MMM dd, yyyy")</td>
                                    <td class="px-space-6 py-space-4 text-on-surface">@audit.Buyer.Name</td>
                                    <td class="px-space-6 py-space-4 text-on-surface-variant">@audit.Establishment.Name</td>
                                    <td class="px-space-6 py-space-4 text-right font-data-mono text-primary">₱@audit.Amount.ToString("N2")</td>
                                    @{
                                        var statusBg = audit.Status == AuditCkDayo.Models.AuditStatus.Approved ? "bg-audit-success/10 text-audit-success border-audit-success/20" :
                                                       (audit.Status == AuditCkDayo.Models.AuditStatus.Rejected ? "bg-audit-error/10 text-audit-error border-audit-error/20" :
                                                       "bg-audit-pending/10 text-audit-pending border-audit-pending/20");
                                    }
                                    <td class="px-space-6 py-space-4 text-center">
                                        <span class="px-space-3 py-1 rounded-full text-[10px] font-label-caps uppercase border @statusBg">@audit.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card Layout (Stitch Responsive Reference) -->
            <div class="block lg:hidden space-y-space-4 p-space-4">
                @if (!Model.RecentAudits.Any())
                {
                    <div class="text-center text-on-surface-variant font-body-md py-space-6">
                        No audits match the selected scope.
                    </div>
                }
                else
                {
                    @foreach (var audit in Model.RecentAudits)
                    {
                        var statusBg = audit.Status == AuditCkDayo.Models.AuditStatus.Approved ? "bg-audit-success/10 text-audit-success border-audit-success/20" :
                                       (audit.Status == AuditCkDayo.Models.AuditStatus.Rejected ? "bg-audit-error/10 text-audit-error border-audit-error/20" :
                                       "bg-audit-pending/10 text-audit-pending border-audit-pending/20");

                        <article class="bg-surface-container-lowest border border-surface-border rounded-xl p-space-4 flex flex-col gap-space-4 shadow-sm cursor-pointer hover:bg-surface-container-low/30 transition-colors"
                                 onclick="openReportsViewer(this)"
                                 data-buyer="@audit.Buyer.Name"
                                 data-establishment="@audit.Establishment.Name"
                                 data-date="@audit.EntryDate.ToString("MMM dd, yyyy")"
                                 data-amount="₱@audit.Amount.ToString("N2")"
                                 data-description="@audit.Description"
                                 data-notes="@audit.Notes"
                                 data-details="@System.Text.Json.JsonSerializer.Serialize(audit.Details.Select(d => new { name = d.ItemName, qty = d.Quantity, price = d.Price, total = d.Total }))"
                                 data-receipt-url="@(string.IsNullOrEmpty(audit.ReceiptImageUrl) ? "https://images.unsplash.com/photo-1554415707-6e8cfc93fe23?q=80&w=600" : audit.ReceiptImageUrl)">
                            <div class="flex justify-between items-start">
                                <div class="flex gap-space-3 items-center">
                                    <div class="w-10 h-10 rounded-full bg-secondary-container text-secondary flex items-center justify-center font-bold text-[12px]">
                                        @audit.Buyer.Name.Substring(0, Math.Min(2, audit.Buyer.Name.Length)).ToUpper()
                                    </div>
                                    <div>
                                        <div class="font-body-md font-semibold text-on-surface">@audit.Buyer.Name</div>
                                        <div class="text-[9px] text-on-surface-variant font-label-caps uppercase mt-0.5">@audit.Buyer.Role</div>
                                    </div>
                                </div>
                                <span class="px-space-3 py-1 rounded-full text-[10px] font-label-caps uppercase border @statusBg">@audit.Status</span>
                            </div>
                            <div class="grid grid-cols-2 gap-space-3">
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Establishment</div>
                                    <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface">
                                        <span class="material-symbols-outlined text-[16px] text-primary">storefront</span>
                                        @audit.Establishment.Name
                                    </div>
                                </div>
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Date</div>
                                    <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface">
                                        <span class="material-symbols-outlined text-[16px] text-primary">calendar_today</span>
                                        @audit.EntryDate.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                            </div>
                            <div class="flex justify-between items-end pt-space-3 border-t border-surface-border border-dashed">
                                <div>
                                    <div class="text-[10px] text-on-surface-variant uppercase mb-1">Amount</div>
                                    <div class="font-data-mono text-primary font-bold text-[16px]">₱@audit.Amount.ToString("N2")</div>
                                </div>
                                <div class="flex flex-col items-end">
                                    <span class="font-data-mono text-on-surface-variant text-[12px]">#AUD-@audit.Id</span>
                                    <span class="text-[10px] text-on-surface-variant font-label-caps uppercase">@audit.Description</span>
                                </div>
                            </div>
                        </article>
                    }
                }
            </div>
        </section>

        <aside class="space-y-space-6">
            <section class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm p-space-6">
                <h2 class="font-headline-sm text-on-surface mb-space-4">Status Breakdown</h2>
                <div class="space-y-space-3">
                    @foreach (var status in Model.StatusSummaries)
                    {
                        <div class="flex items-center justify-between gap-space-4">
                            <span class="text-[12px] text-on-surface-variant">@status.Status (@status.Count)</span>
                            <span class="font-data-mono text-primary text-[13px]">₱@status.Amount.ToString("N2")</span>
                        </div>
                    }
                    @if (!Model.StatusSummaries.Any())
                    {
                        <p class="text-[13px] text-on-surface-variant">No status data available.</p>
                    }
                </div>
            </section>

            <section class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm p-space-6">
                <h2 class="font-headline-sm text-on-surface mb-space-4">By Establishment</h2>
                <div class="space-y-space-3">
                    @foreach (var establishment in Model.EstablishmentSummaries.Take(5))
                    {
                        <div class="flex items-center justify-between gap-space-4">
                            <span class="text-[12px] text-on-surface-variant">@establishment.Establishment (@establishment.Count)</span>
                            <span class="font-data-mono text-primary text-[13px]">₱@establishment.Amount.ToString("N2")</span>
                        </div>
                    }
                    @if (!Model.EstablishmentSummaries.Any())
                    {
                        <p class="text-[13px] text-on-surface-variant">No establishment data available.</p>
                    }
                </div>
            </section>
        </aside>
    </div>

    <div class="mt-space-6 border-t border-surface-border pt-space-6">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-space-4">Generated Audit Sheets</h2>
        
        <!-- If Treasury Handler is selected (or by default if no buyer/branch is selected) -->
        @if (Model.Filter.TreasuryHandlerId.HasValue || (!Model.Filter.BuyerId.HasValue && !Model.Filter.EstablishmentId.HasValue))
        {
            <div class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm overflow-hidden mb-space-6">
                <div class="px-space-6 py-space-4 border-b border-surface-border flex items-center justify-between bg-surface-container-low">
                    <div>
                        <h3 class="font-headline-sm text-on-surface">Daily Cash Flow</h3>
                        <p class="text-xs text-on-surface-variant">Reconciliation for handler: @(Model.TreasuryAudit.TreasuryHandlerName) from @(Model.TreasuryAudit.StartDate.ToString("MMMM dd, yyyy")) to @(Model.TreasuryAudit.EndDate.ToString("MMMM dd, yyyy"))</p>
                    </div>
                    <span class="px-space-3 py-1 bg-primary/10 text-primary border border-primary/20 rounded-full text-[10px] font-label-caps uppercase">Treasury View</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-surface-container-low border-b border-surface-border text-xs uppercase text-on-surface-variant font-semibold">
                                <th class="px-space-6 py-space-3">Date</th>
                                @foreach (var col in Model.TreasuryAudit.CashInColumns)
                                {
                                    <th class="px-space-6 py-space-3 text-right">@col.Label</th>
                                }
                                <th class="px-space-6 py-space-3 text-right">Total Cash In</th>
                                <th class="px-space-6 py-space-3 text-right">Total Cash Out</th>
                                <th class="px-space-6 py-space-3 text-right">Net Cash Flow</th>
                                <th class="px-space-6 py-space-3 text-right">Closing Balance</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-surface-border font-data-mono">
                            @foreach (var row in Model.TreasuryAudit.CashInRows)
                            {
                                var dailyFlow = Model.TreasuryAudit.CashOutRows.Where(r => r.Date == row.Date).ToList();
                                var totalIn = row.Amounts.Values.Sum();
                                var totalOut = dailyFlow.Sum(r => r.Amount);
                                var netFlow = totalIn;
                                
                                <tr>
                                    <td class="px-space-6 py-space-4 text-on-surface font-body-md">@row.Date.ToString("MM-dd")</td>
                                    @foreach (var col in Model.TreasuryAudit.CashInColumns)
                                    {
                                        <td class="px-space-6 py-space-4 text-right">
                                            @(row.Amounts.ContainsKey(col.Label) ? row.Amounts[col.Label].ToString("N2") : "-")
                                        </td>
                                    }
                                    <td class="px-space-6 py-space-4 text-right text-audit-success font-bold">₱@totalIn.ToString("N2")</td>
                                    <td class="px-space-6 py-space-4 text-right text-audit-error font-bold">₱@totalOut.ToString("N2")</td>
                                    <td class="px-space-6 py-space-4 text-right">₱@netFlow.ToString("N2")</td>
                                    <td class="px-space-6 py-space-4 text-right text-primary font-bold">₱@((totalIn - totalOut).ToString("N2"))</td>
                                </tr>
                            }
                            @if (!Model.TreasuryAudit.CashInRows.Any())
                            {
                                <tr>
                                    <td colspan="@(Model.TreasuryAudit.CashInColumns.Count + 5)" class="px-space-6 py-space-8 text-center text-on-surface-variant font-body-md">No treasury records found for the selected handler and date range.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- If Buyer is selected -->
        @if (Model.Filter.BuyerId.HasValue && Model.BuyerAudit.BuyerId.HasValue)
        {
            <div class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm overflow-hidden mb-space-6 max-w-4xl">
                <div class="px-space-6 py-space-4 border-b border-surface-border flex items-center justify-between bg-surface-container-low">
                    <div>
                        <h3 class="font-headline-sm text-on-surface">Petty Cash Liquidation Audit</h3>
                        <p class="text-xs text-on-surface-variant">Accountability report for Buyer: <strong class="text-on-surface font-semibold">@Model.BuyerAudit.BuyerName</strong></p>
                    </div>
                    <span class="px-space-3 py-1 bg-secondary/10 text-secondary border border-secondary/20 rounded-full text-[10px] font-label-caps uppercase">Buyer View</span>
                </div>
                
                <!-- PCF Issuance Block -->
                <div class="p-space-6 border-b border-surface-border bg-surface-container-lowest">
                    <h4 class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold mb-space-3">Petty Cash Issuances</h4>
                    <div class="overflow-x-auto border border-surface-border rounded-lg">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low border-b border-surface-border text-xs uppercase text-on-surface-variant">
                                    <th class="px-4 py-2.5">Date</th>
                                    <th class="px-4 py-2.5 text-right">Amount</th>
                                    <th class="px-4 py-2.5">Issued By / Custodian</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-border font-data-mono">
                                @foreach (var rel in Model.BuyerAudit.Releases)
                                {
                                    <tr>
                                        <td class="px-4 py-3 font-body-md text-on-surface">@rel.Date.ToString("MMMM dd, yyyy")</td>
                                        <td class="px-4 py-3 text-right">₱@rel.Amount.ToString("N2")</td>
                                        <td class="px-4 py-3 font-body-md text-on-surface-variant">@rel.IssuedBy</td>
                                    </tr>
                                }
                                @if (!Model.BuyerAudit.Releases.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="px-4 py-4 text-center font-body-md text-on-surface-variant">No PCF releases recorded.</td>
                                    </tr>
                                }
                                <tr class="bg-surface-container-low font-bold">
                                    <td class="px-4 py-3 uppercase text-xs">Total PC</td>
                                    <td class="px-4 py-3 text-right text-primary">₱@Model.BuyerAudit.TotalPc.ToString("N2")</td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Expenses Block -->
                <div class="p-space-6 border-b border-surface-border bg-surface-container-lowest">
                    <h4 class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold mb-space-3">Itemized Expense Breakdown</h4>
                    <div class="overflow-x-auto border border-surface-border rounded-lg">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low border-b border-surface-border text-xs uppercase text-on-surface-variant">
                                    <th class="px-4 py-2.5">Date</th>
                                    <th class="px-4 py-2.5">Description</th>
                                    <th class="px-4 py-2.5 text-right">Amount</th>
                                    <th class="px-4 py-2.5">Allocation</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-border font-data-mono">
                                @foreach (var exp in Model.BuyerAudit.Expenses)
                                {
                                    <tr>
                                        <td class="px-4 py-3 font-body-md text-on-surface">@exp.Date.ToString("MM-dd")</td>
                                        <td class="px-4 py-3 font-body-md text-on-surface">@exp.Description</td>
                                        <td class="px-4 py-3 text-right">₱@exp.Amount.ToString("N2")</td>
                                        <td class="px-4 py-3 font-body-md text-on-surface-variant">@exp.Allocation</td>
                                    </tr>
                                }
                                @if (!Model.BuyerAudit.Expenses.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="px-4 py-4 text-center font-body-md text-on-surface-variant">No validated expenses.</td>
                                    </tr>
                                }
                                <tr class="bg-surface-container-low font-bold">
                                    <td class="px-4 py-3 uppercase text-xs">Total Expenses</td>
                                    <td class="px-4 py-3 text-right text-primary">₱@Model.BuyerAudit.TotalExpenses.ToString("N2")</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Reconciliation Summary Block -->
                <div class="p-space-6 bg-surface-container-low grid grid-cols-2 sm:grid-cols-5 gap-space-4 font-data-mono">
                    <div class="flex flex-col gap-1 border-r border-surface-border font-body-md">
                        <span class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider">Total PC</span>
                        <span class="text-sm font-bold text-on-surface">₱@Model.BuyerAudit.TotalPc.ToString("N2")</span>
                    </div>
                    <div class="flex flex-col gap-1 border-r border-surface-border font-body-md">
                        <span class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider">Total Exp</span>
                        <span class="text-sm font-bold text-on-surface">₱@Model.BuyerAudit.TotalExpenses.ToString("N2")</span>
                    </div>
                    <div class="flex flex-col gap-1 border-r border-surface-border font-bold">
                        <span class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider">Change (Expected)</span>
                        <span class="text-sm">₱@Model.BuyerAudit.ExpectedChange.ToString("N2")</span>
                    </div>
                    <div class="flex flex-col gap-1 border-r border-surface-border font-body-md">
                        <span class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider">A. Change (Returned)</span>
                        <span class="text-sm font-bold text-on-surface">₱@Model.BuyerAudit.ActualChangeReturned.ToString("N2")</span>
                    </div>
                    @{
                        var varianceColor = Model.BuyerAudit.ShortOverAmount < 0 ? "text-audit-error" : 
                                            (Model.BuyerAudit.ShortOverAmount > 0 ? "text-audit-success" : "text-on-surface");
                    }
                    <div class="flex flex-col gap-1 font-bold @varianceColor">
                        <span class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider">Short / Over</span>
                        <span class="text-sm">
                            @(Model.BuyerAudit.ShortOverAmount < 0 ? "-" : (Model.BuyerAudit.ShortOverAmount > 0 ? "+" : ""))₱@Math.Abs(Model.BuyerAudit.ShortOverAmount).ToString("N2")
                        </span>
                    </div>
                </div>
            </div>
        }

        <!-- If Branch is selected -->
        @if (Model.Filter.EstablishmentId.HasValue || (!Model.Filter.BuyerId.HasValue && !Model.Filter.TreasuryHandlerId.HasValue))
        {
            <div class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-sm overflow-hidden mb-space-6 max-w-4xl">
                <div class="px-space-6 py-space-4 border-b border-surface-border flex items-center justify-between bg-surface-container-low">
                    <div>
                        <h3 class="font-headline-sm text-on-surface">Branch Audit / Expense Allocations</h3>
                        <p class="text-xs text-on-surface-variant">Reconciliation for location: <strong class="text-on-surface font-semibold">@Model.BranchAudit.BranchName</strong></p>
                    </div>
                    <span class="px-space-3 py-1 bg-audit-success/10 text-audit-success border border-audit-success/20 rounded-full text-[10px] font-label-caps uppercase">Branch View</span>
                </div>
                <div class="overflow-x-auto p-space-6 bg-surface-container-lowest">
                    <div class="border border-surface-border rounded-lg overflow-hidden">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low border-b border-surface-border text-xs uppercase text-on-surface-variant font-semibold">
                                    <th class="px-4 py-2.5">Date</th>
                                    <th class="px-4 py-2.5">Description</th>
                                    <th class="px-4 py-2.5 text-right">Amount</th>
                                    <th class="px-4 py-2.5">Category / Allocation</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-surface-border font-data-mono">
                                @foreach (var exp in Model.BranchAudit.Expenses)
                                {
                                    <tr>
                                        <td class="px-4 py-3 font-body-md text-on-surface">@exp.Date.ToString("MM-dd")</td>
                                        <td class="px-4 py-3 font-body-md text-on-surface">@exp.Description</td>
                                        <td class="px-4 py-3 text-right">₱@exp.Amount.ToString("N2")</td>
                                        <td class="px-4 py-3 font-body-md text-on-surface-variant">@exp.Allocation</td>
                                    </tr>
                                }
                                @if (!Model.BranchAudit.Expenses.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="px-4 py-6 text-center font-body-md text-on-surface-variant">No itemized branch allocation records found.</td>
                                    </tr>
                                }
                                <tr class="bg-surface-container-low font-bold">
                                    <td class="px-4 py-3 uppercase text-xs">Total Expenses</td>
                                    <td class="px-4 py-3 text-right text-primary">₱@Model.BranchAudit.TotalExpenses.ToString("N2")</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Full Audit Viewer Modal -->
<div id="reportsViewerModal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-labelledby="reportsViewerTitle">
    <div id="reportsViewerBackdrop" class="absolute inset-0 bg-primary/80 backdrop-blur-sm"></div>
    <div class="relative z-10 h-full w-full p-space-6 flex items-center justify-center">
        <section class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-2xl w-full max-w-7xl max-h-[92vh] overflow-hidden grid grid-cols-1 lg:grid-cols-[minmax(0,1.4fr)_minmax(360px,0.6fr)]">
            <div class="bg-surface-container-highest min-h-[420px] max-h-[92vh] flex flex-col items-center justify-center gap-space-4 p-space-6 overflow-auto">
                <img id="viewer-receipt" src="" alt="Full receipt image" class="max-w-full max-h-[78vh] object-contain rounded-lg shadow-lg bg-white" />
                <div id="viewer-receipt-error" class="hidden max-w-md text-center text-on-primary bg-primary/90 border border-on-primary/10 rounded-xl p-space-4">
                    <p class="font-body-md text-[13px]">Receipt preview could not load here. Open the receipt image directly.</p>
                </div>
                <a id="viewer-receipt-link" href="#" target="_blank" rel="noopener" class="inline-flex items-center gap-space-2 bg-primary text-on-primary px-space-4 py-space-2 rounded-lg font-label-caps uppercase text-[11px] hover:bg-on-primary-fixed-variant transition-colors">
                    <span class="material-symbols-outlined text-[16px]">open_in_new</span>
                    Open Receipt Image
                </a>
            </div>
            <aside class="p-space-6 overflow-y-auto max-h-[92vh] space-y-space-6">
                <div class="flex items-start justify-between gap-space-4">
                    <div>
                        <span class="font-label-caps text-on-surface-variant uppercase text-[10px]">Full Audit Viewer</span>
                        <h2 id="reportsViewerTitle" class="font-headline-md text-headline-md text-on-surface mt-1">Audit Details</h2>
                    </div>
                    <button type="button" id="closeReportsViewerBtn" class="bg-surface-container text-on-surface-variant hover:text-error border border-surface-border rounded-lg p-2 transition-colors cursor-pointer" aria-label="Close audit viewer">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <dl class="grid grid-cols-1 gap-space-4 text-[13px]">
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Buyer</dt>
                        <dd id="viewer-buyer" class="font-body-md text-on-surface"></dd>
                    </div>
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Establishment</dt>
                        <dd id="viewer-establishment" class="font-body-md text-on-surface"></dd>
                    </div>
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Transaction Date</dt>
                        <dd id="viewer-date" class="font-body-md text-on-surface"></dd>
                    </div>
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Amount</dt>
                        <dd id="viewer-amount" class="font-data-mono text-primary text-[22px] font-bold"></dd>
                    </div>
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Description</dt>
                        <dd id="viewer-description" class="font-body-md text-data-text"></dd>
                    </div>
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Notes</dt>
                        <dd id="viewer-notes" class="font-body-md text-on-surface-variant"></dd>
                    </div>
                </dl>
                <div class="border-t border-surface-border pt-space-4">
                    <h3 class="font-label-caps text-on-surface-variant uppercase text-[10px] mb-space-2">Line Items</h3>
                    <div class="overflow-x-auto border border-surface-border rounded-lg">
                        <table class="w-full text-left text-[11px]">
                            <thead>
                                <tr class="border-b border-surface-border text-on-surface-variant bg-surface-container-low">
                                    <th class="px-3 py-2">Item</th>
                                    <th class="px-3 py-2 text-center">Qty</th>
                                    <th class="px-3 py-2 text-right">Price</th>
                                    <th class="px-3 py-2 text-right">Total</th>
                                </tr>
                            </thead>
                            <tbody id="viewer-items-body"></tbody>
                        </table>
                    </div>
                </div>
            </aside>
        </section>
    </div>
</div>

<script>
    function renderLineItems(tbody, details) {
        if (!tbody) return;
        tbody.innerHTML = '';
        if (!details || details.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center py-2 text-on-surface-variant">No items listed.</td></tr>';
            return;
        }

        details.forEach(item => {
            const tr = document.createElement('tr');
            tr.className = 'border-b border-surface-border last:border-0 text-on-surface';
            tr.innerHTML = `
                <td class="px-3 py-2">${item.name}</td>
                <td class="px-3 py-2 text-center">${item.qty}</td>
                <td class="px-3 py-2 text-right">₱${Number(item.price).toFixed(2)}</td>
                <td class="px-3 py-2 text-right">₱${Number(item.total).toFixed(2)}</td>
            `;
            tbody.appendChild(tr);
        });
    }

    function openReportsViewer(row) {
        if (!row) return;
        const details = JSON.parse(row.dataset.details || "[]");
        const receiptUrl = row.dataset.receiptUrl;
        const receipt = document.getElementById('viewer-receipt');
        const receiptLink = document.getElementById('viewer-receipt-link');
        const receiptError = document.getElementById('viewer-receipt-error');
        
        receiptError?.classList.add('hidden');
        receipt?.classList.remove('hidden');
        receipt.src = receiptUrl;
        receipt.onerror = function () {
            receipt.classList.add('hidden');
            receiptError?.classList.remove('hidden');
        };
        receiptLink.href = receiptUrl;
        
        document.getElementById('viewer-buyer').innerText = row.dataset.buyer;
        document.getElementById('viewer-establishment').innerText = row.dataset.establishment;
        document.getElementById('viewer-date').innerText = row.dataset.date;
        document.getElementById('viewer-amount').innerText = row.dataset.amount;
        document.getElementById('viewer-description').innerText = row.dataset.description;
        document.getElementById('viewer-notes').innerText = row.dataset.notes || "None";
        
        renderLineItems(document.getElementById('viewer-items-body'), details);

        document.getElementById('reportsViewerModal').classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }

    function closeReportsViewer() {
        document.getElementById('reportsViewerModal').classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    document.addEventListener("DOMContentLoaded", function () {
        document.getElementById('closeReportsViewerBtn')?.addEventListener('click', closeReportsViewer);
        document.getElementById('reportsViewerBackdrop')?.addEventListener('click', closeReportsViewer);
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') closeReportsViewer();
        });
    });
</script>
