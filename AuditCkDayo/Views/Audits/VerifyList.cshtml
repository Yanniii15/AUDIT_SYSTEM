@model IEnumerable<AuditCkDayo.Models.AuditItem>
@{
    ViewData["Title"] = "Pending Verifications";
    var firstAudit = Model.FirstOrDefault();
}

<!-- Header Section -->
<div class="relative flex flex-col lg:flex-row gap-space-6 items-start justify-between">
    <div class="flex flex-col gap-space-2 max-w-2xl">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">pending_actions</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Quality Control</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Pending Verifications</h1>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            Verify submitted invoices and receipts. Tap on any audit item in the queue to load the receipt image and detail scan in the inspector.
        </p>
    </div>

    <!-- Quick Stats -->
    <div class="bg-surface-container-lowest p-space-4 rounded-xl shadow-sm border border-surface-border flex flex-col gap-space-1 min-w-[180px]">
        <span class="font-label-caps text-on-surface-variant uppercase text-[10px]">Queue Size</span>
        <div class="flex items-baseline gap-space-2">
            <span class="font-headline-md text-headline-md text-audit-pending">@Model.Count()</span>
            <span class="text-on-surface-variant text-[12px]">Pending</span>
        </div>
    </div>
</div>

<div class="grid grid-cols-12 gap-space-8 items-start">
    <!-- Queue List -->
    <div class="col-span-12 lg:col-span-8">
        <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden border border-surface-border/50">
            <div class="p-space-6 border-b border-surface-border flex items-center justify-between">
                <h3 class="font-headline-sm text-headline-sm text-on-surface">Audit Queue</h3>
            </div>
            
            <div class="hidden lg:block overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container-low border-b border-surface-border">
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Buyer</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Establishment</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px]">Date</th>
                            <th class="px-space-6 py-space-4 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[11px] text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-border">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="px-space-6 py-space-8 text-center text-on-surface-variant font-body-md">
                                    No pending audits for verification.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var audit in Model)
                            {
                                <tr class="hover:bg-surface-container-low/30 transition-colors cursor-pointer group @(audit.Id == firstAudit?.Id ? "bg-primary/5" : "")" 
                                    onclick="selectAudit(this)"
                                    data-id="@audit.Id"
                                    data-buyer="@audit.Buyer.Name"
                                    data-establishment="@audit.Establishment.Name"
                                    data-amount="₱@audit.Amount.ToString("N2")"
                                    data-description="@audit.Description"
                                    data-date="@audit.EntryDate.ToString("MMM dd, yyyy")"
                                    data-notes="@audit.Notes"
                                    data-details="@System.Text.Json.JsonSerializer.Serialize(audit.Details.Select(d => new { name = d.ItemName, qty = d.Quantity, price = d.Price, total = d.Total, destination = d.AssignedEstablishment?.Name ?? d.CostCenter?.Name ?? "", remarks = d.AllocationNotes ?? "" }))"
                                    data-receipt-url="@(string.IsNullOrEmpty(audit.ReceiptImageUrl) ? "https://images.unsplash.com/photo-1554415707-6e8cfc93fe23?q=80&w=600" : audit.ReceiptImageUrl)">
                                    <td class="px-space-6 py-space-4">
                                        <div class="flex items-center gap-space-3">
                                            <div class="w-8 h-8 rounded-full bg-secondary-container text-secondary flex items-center justify-center font-bold text-[12px]">
                                                @audit.Buyer.Name.Substring(0, Math.Min(2, audit.Buyer.Name.Length)).ToUpper()
                                            </div>
                                            <div>
                                                <div class="font-body-md font-semibold text-on-surface">@audit.Buyer.Name</div>
                                                <div class="text-[9px] text-on-surface-variant font-label-caps uppercase">Buyer</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-space-6 py-space-4">
                                        <div class="flex items-center gap-space-2 text-on-surface">
                                            <span class="material-symbols-outlined text-[16px] text-primary">location_on</span>
                                            <span class="font-body-md">@audit.Establishment.Name</span>
                                        </div>
                                    </td>
                                    <td class="px-space-6 py-space-4">
                                        <span class="font-body-md text-on-surface">@audit.EntryDate.ToString("MMM dd, yyyy")</span>
                                    </td>
                                    <td class="px-space-6 py-space-4 text-right">
                                        <span class="font-data-mono text-primary font-bold">₱@audit.Amount.ToString("N2")</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

            <!-- Mobile Queue Cards (Stitch Responsive Reference) -->
            <div class="block lg:hidden space-y-space-4 p-space-4">
                @if (!Model.Any())
                {
                    <div class="text-center text-on-surface-variant font-body-md py-space-6">
                        No pending audits for verification.
                    </div>
                }
                else
                {
                    @foreach (var audit in Model)
                    {
                        <article class="bg-surface-container-lowest border border-surface-border rounded-xl p-space-4 flex flex-col gap-space-4 shadow-sm hover:bg-surface-container-low/50 transition-colors cursor-pointer group"
                                 onclick="selectAudit(this); openAuditViewer();"
                                 data-id="@audit.Id"
                                 data-buyer="@audit.Buyer.Name"
                                 data-establishment="@audit.Establishment.Name"
                                 data-amount="₱@audit.Amount.ToString("N2")"
                                 data-description="@audit.Description"
                                 data-date="@audit.EntryDate.ToString("MMM dd, yyyy")"
                                 data-notes="@audit.Notes"
                                 data-details="@System.Text.Json.JsonSerializer.Serialize(audit.Details.Select(d => new { name = d.ItemName, qty = d.Quantity, price = d.Price, total = d.Total, destination = d.AssignedEstablishment?.Name ?? d.CostCenter?.Name ?? "", remarks = d.AllocationNotes ?? "" }))"
                                 data-receipt-url="@(string.IsNullOrEmpty(audit.ReceiptImageUrl) ? "https://images.unsplash.com/photo-1554415707-6e8cfc93fe23?q=80&w=600" : audit.ReceiptImageUrl)">
                            
                            <!-- Top Row: Buyer Avatar & Status -->
                            <div class="flex justify-between items-start">
                                <div class="flex gap-space-3 items-center">
                                    <div class="w-10 h-10 rounded-full bg-secondary-container text-secondary flex items-center justify-center font-bold text-[12px]">
                                        @audit.Buyer.Name.Substring(0, Math.Min(2, audit.Buyer.Name.Length)).ToUpper()
                                    </div>
                                    <div>
                                        <div class="font-body-md font-semibold text-on-surface">@audit.Buyer.Name</div>
                                        <div class="text-[9px] text-on-surface-variant font-label-caps uppercase mt-0.5">Buyer</div>
                                    </div>
                                </div>
                                <span class="px-space-3 py-1 rounded-full text-[10px] font-label-caps uppercase border bg-audit-pending/10 text-audit-pending border-audit-pending/20">Pending</span>
                            </div>Precision-fit bento cards for establishment/date -->
                            <div class="grid grid-cols-2 gap-space-3">
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Establishment</div>
                                    <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface">
                                        <span class="material-symbols-outlined text-[16px] text-primary">storefront</span>
                                        @audit.Establishment.Name
                                    </div>
                                </div>
                                <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Date</div>
                                    <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface">
                                        <span class="material-symbols-outlined text-[16px] text-primary">calendar_today</span>
                                        @audit.EntryDate.ToString("MMM dd, yyyy")
                                    </div>
                                </div>
                            </div>

                            <!-- Bottom Row: Amount & Actions -->
                            <div class="flex justify-between items-end pt-space-3 border-t border-surface-border border-dashed">
                                <div>
                                    <div class="text-[10px] text-on-surface-variant uppercase mb-1">Amount</div>
                                    <div class="font-data-mono text-primary font-bold text-[16px]">₱@audit.Amount.ToString("N2")</div>
                                </div>
                                <button type="button" class="bg-primary text-on-primary px-space-4 py-2 rounded-lg font-label-caps text-[11px] uppercase tracking-wider hover:bg-primary/95 transition-all shadow-sm">
                                    Review
                                </button>
                            </div>
                        </article>
                    }
                }
            </div>
    </div>
    
    <!-- Detail Inspection Panel -->
    <div class="col-span-12 lg:col-span-4 lg:sticky lg:top-24 h-fit">
        @if (firstAudit != null)
        {
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border overflow-hidden" id="detail-panel">
                <div class="aspect-[4/3] relative bg-surface-container-highest overflow-hidden">
                    <img class="w-full h-full object-cover" id="receipt-preview" src="@(string.IsNullOrEmpty(firstAudit.ReceiptImageUrl) ? "https://images.unsplash.com/photo-1554415707-6e8cfc93fe23?q=80&w=600" : firstAudit.ReceiptImageUrl)" alt="Receipt Scan" />
                    <div class="absolute bottom-0 left-0 right-0 p-space-6 bg-gradient-to-t from-primary/80 to-transparent">
                        <h3 class="font-headline-sm text-on-primary text-[16px]" id="preview-buyer">@firstAudit.Buyer.Name</h3>
                        <p class="text-on-primary/70 text-[12px]" id="preview-establishment">@firstAudit.Establishment.Name</p>
                    </div>
                </div>
                
                <div class="p-space-6 space-y-space-6">
                    <div class="space-y-space-4">
                        <div class="flex items-center justify-between border-b border-surface-border pb-space-2">
                            <span class="font-label-caps text-on-surface-variant uppercase text-[10px]">Audit Inspector</span>
                            <span class="material-symbols-outlined text-[16px] text-audit-pending">pending_actions</span>
                        </div>
                        
                        <div class="grid grid-cols-1 gap-space-4">
                            <div>
                                <label class="font-label-caps text-on-surface-variant text-[10px] uppercase block mb-1">Description</label>
                                <span class="font-body-md text-data-text block text-[13px]" id="preview-description">@firstAudit.Description</span>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-space-4">
                                <div>
                                    <label class="font-label-caps text-on-surface-variant text-[10px] uppercase block mb-1">Amount</label>
                                    <span class="font-data-mono text-primary text-[18px] font-bold block" id="preview-amount">₱@firstAudit.Amount.ToString("N2")</span>
                                </div>
                                <div>
                                    <label class="font-label-caps text-on-surface-variant text-[10px] uppercase block mb-1">Notes</label>
                                    <span class="font-body-md text-on-surface-variant text-[12px] block" id="preview-notes">@(string.IsNullOrEmpty(firstAudit.Notes) ? "None" : firstAudit.Notes)</span>
                                </div>
                            </div>
                        </div>
                        <!-- Line Items List in Inspector -->
                        <div class="border-t border-surface-border pt-space-4">
                            <label class="font-label-caps text-on-surface-variant text-[10px] uppercase block mb-2">Receipt Line Items</label>
                            <div class="max-h-48 overflow-y-auto border border-surface-border rounded-lg p-2 bg-surface-container-lowest">
                                <table class="w-full text-left text-[11px] border-collapse">
                                    <thead>
                                        <tr class="border-b border-surface-border text-on-surface-variant">
                                            <th class="py-1">Item</th>
                                            <th class="py-1 text-center w-12">Qty</th>
                                            <th class="py-1 text-right w-16">Price</th>
                                            <th class="py-1 text-right w-16">Total</th>
                                            <th class="py-1 w-20">Split</th>
                                            <th class="py-1 w-24">Remarks</th>
                                        </tr>
                                    </thead>
                                    <tbody id="preview-items-body">
                                        @if (firstAudit != null)
                                        {
                                            foreach (var item in firstAudit.Details)
                                            {
                                                <tr class="border-b border-surface-border last:border-0 text-on-surface">
                                                    <td class="py-1">@item.ItemName</td>
                                                    <td class="py-1 text-center">@item.Quantity</td>
                                                    <td class="py-1 text-right">₱@item.Price.ToString("N2")</td>
                                                    <td class="py-1 text-right">₱@item.Total.ToString("N2")</td>
                                                    <td class="py-1">@(item.AssignedEstablishment?.Name ?? item.CostCenter?.Name ?? "-")</td>
                                                    <td class="py-1 text-on-surface-variant">@(item.AllocationNotes ?? "-")</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    
                    <button type="button" id="openAuditViewerBtn" class="w-full bg-surface-container text-primary border border-primary/20 font-label-caps py-space-3 rounded-lg hover:bg-primary hover:text-on-primary transition-all flex items-center justify-center gap-space-2 text-[12px] uppercase shadow-sm">
                        <span class="material-symbols-outlined text-[18px]">open_in_full</span>
                        View Full Audit
                    </button>

                    <div class="pt-space-4 border-t border-surface-border flex gap-space-3">
                        <!-- Approve Form -->
                        <form asp-action="Verify" method="post" class="flex-1" id="approveForm">
                            <input type="hidden" name="id" id="approve-id" value="@firstAudit.Id" />
                            <input type="hidden" name="action" value="Approved" />
                            <button type="submit" id="approveSubmitBtn" class="w-full bg-primary text-on-primary font-label-caps py-space-3 rounded-lg hover:bg-primary/90 transition-all flex items-center justify-center gap-space-2 shadow-md active:scale-95 text-[12px] uppercase">
                                <span class="material-symbols-outlined text-[18px]">verified</span>
                                Approve Audit
                            </button>
                        </form>
                        
                        <!-- Reject Form -->
                        <form asp-action="Verify" method="post" class="flex-none" id="rejectForm">
                            <input type="hidden" name="id" id="reject-id" value="@firstAudit.Id" />
                            <input type="hidden" name="action" value="Rejected" />
                            <button type="submit" id="rejectSubmitBtn" class="w-12 bg-error/10 text-error hover:bg-error hover:text-on-primary font-label-caps py-space-3 rounded-lg transition-all flex items-center justify-center shadow-sm active:scale-95">
                                <span class="material-symbols-outlined">flag</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border p-space-8 text-center text-on-surface-variant font-body-md">
                No active item loaded in inspector.
            </div>
        }
    </div>
</div>

<div id="auditViewerModal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-labelledby="auditViewerTitle">
    <div id="auditViewerBackdrop" class="absolute inset-0 bg-primary/80 backdrop-blur-sm"></div>
    <div class="relative z-10 h-full w-full p-space-6 flex items-center justify-center">
        <section class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-2xl w-full max-w-7xl max-h-[92vh] overflow-hidden grid grid-cols-1 lg:grid-cols-[minmax(0,1.4fr)_minmax(360px,0.6fr)]">
            <div class="bg-surface-container-highest min-h-[420px] max-h-[92vh] flex flex-col items-center justify-center gap-space-4 p-space-6 overflow-auto">
                <img id="viewer-receipt" src="" alt="Full receipt image" class="max-w-full max-h-[78vh] object-contain rounded-lg shadow-lg bg-white" />
                <div id="viewer-receipt-error" class="hidden max-w-md text-center text-on-primary bg-primary/90 border border-on-primary/10 rounded-xl p-space-4">
                    <p class="font-body-md text-[13px]">Receipt preview could not load here. Open the receipt image directly.</p>
                </div>
                <a id="viewer-receipt-link" href="#" target="_blank" rel="noopener" class="inline-flex items-center gap-space-2 bg-primary text-on-primary px-space-4 py-space-2 rounded-lg font-label-caps uppercase text-[11px] hover:bg-on-primary-fixed-variant transition-colors">
                    <span class="material-symbols-outlined text-[16px]">open_in_new</span>
                    Open Receipt Image
                </a>
            </div>
            <aside class="p-space-6 overflow-y-auto max-h-[92vh] space-y-space-6">
                <div class="flex items-start justify-between gap-space-4">
                    <div>
                        <span class="font-label-caps text-on-surface-variant uppercase text-[10px]">Full Audit Viewer</span>
                        <h2 id="auditViewerTitle" class="font-headline-md text-headline-md text-on-surface mt-1">Audit Details</h2>
                    </div>
                    <button type="button" id="closeAuditViewerBtn" class="bg-surface-container text-on-surface-variant hover:text-error border border-surface-border rounded-lg p-2 transition-colors" aria-label="Close audit viewer">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <dl class="grid grid-cols-1 gap-space-4 text-[13px]">
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Buyer</dt>
                        <dd id="viewer-buyer" class="font-body-md text-on-surface"></dd>
                    </div>
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Establishment</dt>
                        <dd id="viewer-establishment" class="font-body-md text-on-surface"></dd>
                    </div>
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Transaction Date</dt>
                        <dd id="viewer-date" class="font-body-md text-on-surface"></dd>
                    </div>
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Amount</dt>
                        <dd id="viewer-amount" class="font-data-mono text-primary text-[22px] font-bold"></dd>
                    </div>
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Description</dt>
                        <dd id="viewer-description" class="font-body-md text-data-text"></dd>
                    </div>
                    <div>
                        <dt class="font-label-caps text-on-surface-variant uppercase text-[10px]">Notes</dt>
                        <dd id="viewer-notes" class="font-body-md text-on-surface-variant"></dd>
                    </div>
                </dl>
                <div class="border-t border-surface-border pt-space-4">
                    <h3 class="font-label-caps text-on-surface-variant uppercase text-[10px] mb-space-2">Line Items</h3>
                    <div class="overflow-x-auto border border-surface-border rounded-lg">
                        <table class="w-full text-left text-[11px]">
                            <thead>
                                <tr class="border-b border-surface-border text-on-surface-variant bg-surface-container-low">
                                    <th class="px-3 py-2">Item</th>
                                    <th class="px-3 py-2 text-center">Qty</th>
                                    <th class="px-3 py-2 text-right">Price</th>
                                    <th class="px-3 py-2 text-right">Total</th>
                                    <th class="px-3 py-2 w-28">Split</th>
                                    <th class="px-3 py-2 w-32">Remarks</th>
                                </tr>
                            </thead>
                            <tbody id="viewer-items-body"></tbody>
                        </table>
                    </div>
                </div>

                <!-- Action buttons inside modal for mobile responsiveness -->
                <div class="pt-space-6 border-t border-surface-border flex gap-space-3 lg:hidden">
                    <button type="button" onclick="submitModalApprove()" class="flex-grow bg-primary text-on-primary py-3.5 rounded-lg font-label-caps uppercase tracking-widest hover:brightness-110 active:scale-95 transition-all text-[12px] flex items-center justify-center gap-space-2 shadow-md">
                        <span class="material-symbols-outlined text-[18px]">verified</span>
                        Approve Audit
                    </button>
                    <button type="button" onclick="submitModalReject()" class="flex-none bg-error/10 text-error hover:bg-error hover:text-on-primary px-space-4 py-3.5 rounded-lg transition-colors flex items-center justify-center shadow-sm">
                        <span class="material-symbols-outlined">flag</span>
                    </button>
                </div>
            </aside>
        </section>
    </div>
</div>

<script>
    function submitModalApprove() {
        const btn = document.getElementById('approveSubmitBtn');
        if (btn) btn.click();
    }

    function submitModalReject() {
        const btn = document.getElementById('rejectSubmitBtn');
        if (btn) btn.click();
    }

    function renderLineItems(tbody, details) {
        if (!tbody) return;
        tbody.innerHTML = '';
        if (details.length === 0) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-2 text-on-surface-variant">No items listed.</td></tr>';
            return;
        }

        details.forEach(item => {
            const tr = document.createElement('tr');
            tr.className = 'border-b border-surface-border last:border-0 text-on-surface';
            tr.innerHTML = `
                <td class="px-3 py-2">${item.name}</td>
                <td class="px-3 py-2 text-center">${item.qty}</td>
                <td class="px-3 py-2 text-right">₱${Number(item.price).toFixed(2)}</td>
                <td class="px-3 py-2 text-right">₱${Number(item.total).toFixed(2)}</td>
                <td class="px-3 py-2">${item.destination || '-'}</td>
                <td class="px-3 py-2 text-on-surface-variant">${item.remarks || '-'}</td>
            `;
            tbody.appendChild(tr);
        });
    }

    function updateAuditViewerFromRow(row) {
        if (!row) return;
        const details = JSON.parse(row.dataset.details || "[]");
        const receiptUrl = row.dataset.receiptUrl;
        const receipt = document.getElementById('viewer-receipt');
        const receiptLink = document.getElementById('viewer-receipt-link');
        const receiptError = document.getElementById('viewer-receipt-error');
        receiptError?.classList.add('hidden');
        receipt?.classList.remove('hidden');
        receipt.src = receiptUrl;
        receipt.onerror = function () {
            receipt.classList.add('hidden');
            receiptError?.classList.remove('hidden');
        };
        receiptLink.href = receiptUrl;
        document.getElementById('viewer-buyer').innerText = row.dataset.buyer;
        document.getElementById('viewer-establishment').innerText = row.dataset.establishment;
        document.getElementById('viewer-date').innerText = row.dataset.date;
        document.getElementById('viewer-amount').innerText = row.dataset.amount;
        document.getElementById('viewer-description').innerText = row.dataset.description;
        document.getElementById('viewer-notes').innerText = row.dataset.notes || "None";
        renderLineItems(document.getElementById('viewer-items-body'), details);
    }

    function openAuditViewer() {
        const modal = document.getElementById('auditViewerModal');
        updateAuditViewerFromRow(document.querySelector('tbody tr.bg-primary\\/5') || document.querySelector('tbody tr[data-id]'));
        modal?.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }

    function closeAuditViewer() {
        document.getElementById('auditViewerModal')?.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    function selectAudit(row) {
        document.querySelectorAll('tbody tr').forEach(r => r.classList.remove('bg-primary/5'));
        row.classList.add('bg-primary/5');

        const id = row.dataset.id;
        const details = JSON.parse(row.dataset.details || "[]");

        document.getElementById('receipt-preview').src = row.dataset.receiptUrl;
        document.getElementById('preview-buyer').innerText = row.dataset.buyer;
        document.getElementById('preview-establishment').innerText = row.dataset.establishment;
        document.getElementById('preview-amount').innerText = row.dataset.amount;
        document.getElementById('preview-description').innerText = row.dataset.description;
        document.getElementById('preview-notes').innerText = row.dataset.notes || "None";
        renderLineItems(document.getElementById('preview-items-body'), details);
        updateAuditViewerFromRow(row);

        document.getElementById('approve-id').value = id;
        document.getElementById('reject-id').value = id;
    }

    document.addEventListener("DOMContentLoaded", function () {
        updateAuditViewerFromRow(document.querySelector('tbody tr[data-id]'));
        document.getElementById('openAuditViewerBtn')?.addEventListener('click', openAuditViewer);
        document.getElementById('closeAuditViewerBtn')?.addEventListener('click', closeAuditViewer);
        document.getElementById('auditViewerBackdrop')?.addEventListener('click', closeAuditViewer);
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') closeAuditViewer();
        });
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const approveForm = document.getElementById("approveForm");
        const rejectForm = document.getElementById("rejectForm");
        const approveBtn = document.getElementById("approveSubmitBtn");
        const rejectBtn = document.getElementById("rejectSubmitBtn");

        if (approveForm && approveBtn) {
            approveForm.addEventListener("submit", function () {
                approveBtn.disabled = true;
                if (rejectBtn) rejectBtn.disabled = true;
                approveBtn.innerText = "Approving...";
            });
        }
        if (rejectForm && rejectBtn) {
            rejectForm.addEventListener("submit", function () {
                rejectBtn.disabled = true;
                if (approveBtn) approveBtn.disabled = true;
            });
        }
    });
</script>
