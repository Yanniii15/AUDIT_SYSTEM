@model IEnumerable<AuditCkDayo.Models.SurrenderRequest>
@{
    ViewData["Title"] = "Return PCF Change";
    var availableBalance = (decimal)ViewBag.AvailableBalance;
    var hasAvailableBalance = availableBalance > 0m;
}

<!-- Header Section -->
<div class="relative flex flex-col lg:flex-row gap-space-6 items-start justify-between mb-6">
    <div class="flex flex-col gap-space-2 max-w-2xl">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">payments</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">PCF Change Verification</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Return PCF Change</h1>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            Submit unused PCF/change for manager verification. Treasury records this as Cash In → Change PCF only after manager verification.
        </p>
    </div>
</div>

<!-- Stats / Balance Cards -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-surface-container-lowest p-space-4 rounded-xl shadow-sm border border-surface-border flex flex-col gap-space-1">
        <span class="font-label-caps text-on-surface-variant uppercase text-[11px] tracking-wider">Current PCF</span>
        <div class="flex items-baseline gap-space-2">
            <span class="font-headline-md text-headline-md text-on-surface font-bold">₱@(((decimal)ViewBag.PcfBalance).ToString("N2"))</span>
        </div>
    </div>
    
    <div class="bg-surface-container-lowest p-space-4 rounded-xl shadow-sm border border-surface-border flex flex-col gap-space-1">
        <span class="font-label-caps text-on-surface-variant uppercase text-[11px] tracking-wider text-audit-pending">Reserved Pending Surrenders</span>
        <div class="flex items-baseline gap-space-2">
            <span class="font-headline-md text-headline-md text-error font-bold">₱@(((decimal)ViewBag.ReservedBalance).ToString("N2"))</span>
        </div>
    </div>

    <div class="bg-surface-container-lowest p-space-4 rounded-xl shadow-sm border border-surface-border flex flex-col gap-space-1">
        <span class="font-label-caps text-on-surface-variant uppercase text-[11px] tracking-wider text-primary">Available Balance</span>
        <div class="flex items-baseline gap-space-2">
            <span class="font-headline-md text-headline-md text-primary font-bold">₱@availableBalance.ToString("N2")</span>
        </div>
    </div>
</div>

<div class="grid grid-cols-12 gap-8 items-start">
    <!-- PCF Change Submission Form -->
    <div class="col-span-12 lg:col-span-4">
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border p-6">
            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-4">Submit Change for Verification</h3>
            @if (availableBalance <= 0m)
            {
                <div class="mb-4 rounded-lg border border-audit-pending/30 bg-audit-pending/10 p-space-3 text-[12px] text-audit-pending">
                    No available cash to surrender. Pending surrender requests have already reserved the current PCF balance.
                </div>
            }
            
            <form asp-action="SubmitSurrender" method="post" class="space-y-4">
                @Html.AntiForgeryToken()
                
                <div class="text-danger font-semibold text-sm mb-3">
                    @Html.ValidationSummary(true)
                </div>

                <div>
                    <label class="block text-xs uppercase tracking-wider text-on-surface-variant font-semibold mb-1" for="amount">PCF Change Amount (₱)</label>
                    <input type="number" step="0.01" min="0.01" max="@availableBalance" id="amount" name="amount" required disabled="@(hasAvailableBalance ? null : "disabled")"
                           class="w-full bg-surface-container-low border border-surface-border rounded-lg px-4 py-2.5 text-on-surface focus:outline-none focus:border-primary transition-colors disabled:cursor-not-allowed disabled:opacity-60"
                           placeholder="0.00" />
                </div>

                @if (User.IsInRole("Owner") || User.IsInRole("Manager"))
                {
                    <div>
                        <label class="block text-xs uppercase tracking-wider text-on-surface-variant font-semibold mb-1" for="assignedReceiverId">Verify With</label>
                        <select id="assignedReceiverId" name="assignedReceiverId" disabled="@(hasAvailableBalance ? null : "disabled")"
                                class="w-full bg-surface-container-low border border-surface-border rounded-lg px-4 py-2.5 text-on-surface focus:outline-none focus:border-primary transition-colors disabled:cursor-not-allowed disabled:opacity-60"
                                asp-items="ViewBag.ReviewerUsers">
                            <option value="">Use default routing</option>
                        </select>
                    </div>
                }

                <div>
                    <label class="block text-xs uppercase tracking-wider text-on-surface-variant font-semibold mb-1" for="notes">Notes</label>
                    <textarea id="notes" name="notes" maxlength="255" rows="3" disabled="@(hasAvailableBalance ? null : "disabled")"
                              class="w-full bg-surface-container-low border border-surface-border rounded-lg px-4 py-2 text-on-surface focus:outline-none focus:border-primary transition-colors disabled:cursor-not-allowed disabled:opacity-60"
                              placeholder="Example: DAYO AUG. 6 leftover PCF after expenses"></textarea>
                </div>

                <button type="submit" disabled="@(hasAvailableBalance ? null : "disabled")" class="w-full bg-primary text-on-primary font-semibold py-3 rounded-lg hover:bg-primary/90 transition-all flex items-center justify-center gap-2 shadow-md active:scale-95 text-xs uppercase tracking-wider disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:bg-primary">
                    <span class="material-symbols-outlined text-[18px]">send</span>
                    Submit Change for Verification
                </button>
            </form>
        </div>
    </div>

    <!-- History / Requests List -->
    <div class="col-span-12 lg:col-span-8">
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border overflow-hidden">
            <div class="p-6 border-b border-surface-border flex items-center justify-between">
                <h3 class="font-headline-sm text-headline-sm text-on-surface">Verified PCF Change Returned</h3>
            </div>
            
            <div class="hidden lg:block max-h-[520px] overflow-y-auto overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="sticky top-0 z-10">
                        <tr class="bg-surface-container-low border-b border-surface-border">
                            <th class="px-6 py-4 font-label-caps text-[11px] uppercase tracking-wider text-on-surface-variant">Date</th>
                            <th class="px-6 py-4 font-label-caps text-[11px] uppercase tracking-wider text-on-surface-variant text-right">Amount</th>
                            <th class="px-6 py-4 font-label-caps text-[11px] uppercase tracking-wider text-on-surface-variant">Status</th>
                            <th class="px-6 py-4 font-label-caps text-[11px] uppercase tracking-wider text-on-surface-variant">Notes / Details</th>
                            <th class="px-6 py-4 font-label-caps text-[11px] uppercase tracking-wider text-on-surface-variant text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-border">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="px-6 py-8 text-center text-on-surface-variant font-body-md">
                                    You have no surrender requests yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-on-surface">
                                        @request.RequestDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-right text-on-surface">
                                        ₱@request.DeclaredAmount.ToString("N2")
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @{
                                            var badgeClass = request.Status switch
                                            {
                                                SurrenderStatus.Pending => "bg-audit-pending/10 text-audit-pending border border-audit-pending/20",
                                                SurrenderStatus.Confirmed => "bg-emerald-100 text-emerald-900 border border-emerald-300 dark:bg-emerald-950/50 dark:text-emerald-200 dark:border-emerald-700",
                                                SurrenderStatus.Rejected => "bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400",
                                                SurrenderStatus.Cancelled => "bg-gray-100 text-gray-800 dark:bg-gray-900/30 dark:text-gray-400",
                                                _ => "bg-gray-100 text-gray-800"
                                            };
                                        }
                                        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold @badgeClass">
                                            @request.Status
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-on-surface-variant">
                                        <div class="max-w-xs truncate" title="@request.BuyerNotes">
                                            <span class="font-semibold text-xs">Request:</span> @(string.IsNullOrEmpty(request.BuyerNotes) ? "-" : request.BuyerNotes)
                                        </div>
                                        @if (!string.IsNullOrEmpty(request.ActionNotes))
                                        {
                                            <div class="max-w-xs truncate text-xs text-error mt-0.5" title="@request.ActionNotes">
                                                <span class="font-semibold">Reviewer:</span> @request.ActionNotes
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-center whitespace-nowrap text-sm">
                                        @if (request.Status == SurrenderStatus.Pending)
                                        {
                                            <form asp-action="CancelSurrender" method="post" onsubmit="return confirm('Are you sure you want to cancel this request?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@request.Id" />
                                                <button type="submit" class="text-error hover:text-error-hover font-semibold text-xs uppercase tracking-wider">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-on-surface-variant/40 text-xs">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card Layout (Stitch Responsive Reference) -->
            <div class="block lg:hidden space-y-space-4 p-space-4 max-h-[520px] overflow-y-auto">
                @if (!Model.Any())
                {
                    <div class="text-center text-on-surface-variant font-body-md py-space-6">
                        You have no surrender requests yet.
                    </div>
                }
                else
                {
                    @foreach (var request in Model)
                    {
                        var badgeClass = request.Status switch
                        {
                            SurrenderStatus.Pending => "bg-audit-pending/10 text-audit-pending border border-audit-pending/20",
                            SurrenderStatus.Confirmed => "bg-emerald-100 text-emerald-900 border border-emerald-300",
                            SurrenderStatus.Rejected => "bg-red-100 text-red-800",
                            SurrenderStatus.Cancelled => "bg-gray-100 text-gray-800",
                            _ => "bg-gray-100 text-gray-800"
                        };

                        <article class="bg-surface-container-lowest border border-surface-border rounded-xl p-space-4 flex flex-col gap-space-4 shadow-sm">
                            <div class="flex justify-between items-start">
                                <div>
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Declared Amount</div>
                                    <div class="font-data-mono text-primary font-bold text-[18px]">₱@request.DeclaredAmount.ToString("N2")</div>
                                </div>
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold @badgeClass">
                                    @request.Status
                                </span>
                            </div>
                            <div class="grid grid-cols-1 gap-space-3 bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                                <div>
                                    <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Change Details</div>
                                    <p class="text-body-md text-on-surface">@(string.IsNullOrEmpty(request.BuyerNotes) ? "-" : request.BuyerNotes)</p>
                                    @if (!string.IsNullOrEmpty(request.ActionNotes))
                                    {
                                        <p class="text-[12px] text-audit-error mt-1"><span class="font-semibold">Reviewer:</span> @request.ActionNotes</p>
                                    }
                                </div>
                            </div>
                            <div class="pt-space-3 border-t border-surface-border border-dashed flex justify-between items-center">
                                <div class="flex items-center gap-1.5 text-[11px] text-on-surface-variant">
                                    <span class="material-symbols-outlined text-[16px] text-primary">calendar_today</span>
                                    @request.RequestDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </div>
                                @if (request.Status == SurrenderStatus.Pending)
                                {
                                    <form asp-action="CancelSurrender" method="post" onsubmit="return confirm('Are you sure you want to cancel this request?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@request.Id" />
                                        <button type="submit" class="bg-audit-error/10 text-audit-error px-space-4 py-2 rounded-lg font-label-caps hover:bg-audit-error hover:text-on-primary text-[11px] uppercase transition-all shadow-sm">
                                            Cancel
                                        </button>
                                    </form>
                                }
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
    </div>
</div>
