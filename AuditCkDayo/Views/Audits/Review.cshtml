@model AuditCkDayo.ViewModels.AuditSubmissionViewModel
@{
    ViewData["Title"] = "Review Extracted Invoice";
}

<!-- Header Section -->
<div class="relative flex flex-col lg:flex-row gap-space-6 items-start justify-between">
    <div class="flex flex-col gap-space-2 max-w-2xl">
        <div class="flex items-center gap-space-2 text-primary">
            <span class="material-symbols-outlined text-[20px]">rate_review</span>
            <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">OCR Reconciliation</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-on-surface">Review Receipt Scan</h1>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            Verify the information extracted by the AI engine. Adjust any errors, select the destination establishment, and click submit to send the invoice to your manager.
        </p>
    </div>
</div>

<div class="grid grid-cols-12 gap-space-8 items-start my-space-4">
    <!-- Left Column: Receipt Scan Preview -->
    <div class="col-span-12 lg:col-span-5">
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border overflow-hidden sticky top-24">
            <div class="p-space-4 bg-surface-container-low border-b border-surface-border flex justify-between items-center">
                <span class="font-label-caps text-on-surface-variant uppercase text-[10px]">Uploaded Invoice Documents (@(Model.ReceiptImageUrls?.Count ?? 1))</span>
                <span class="material-symbols-outlined text-primary text-[18px]">receipt</span>
            </div>
            
            <!-- Large Image Preview -->
            <div class="p-space-4 bg-surface-container-highest flex flex-col items-center justify-center min-h-[350px] relative">
                <img id="main-preview" src="@Model.ReceiptImageUrl" class="max-w-full max-h-[500px] object-contain rounded-lg border border-surface-border/50 shadow-sm cursor-pointer hover:scale-[1.01] transition-transform duration-300" alt="Receipt Upload" />
            </div>
            <div class="p-space-3 bg-surface-container-low border-t border-surface-border text-center">
                <span class="text-on-surface-variant text-[11px] font-label-caps uppercase"><span class="material-symbols-outlined text-[14px] align-middle">zoom_in</span> Tap to Inspect</span>
            </div>

            <!-- Thumbnail Selector -->
            @if (Model.ReceiptImageUrls != null && Model.ReceiptImageUrls.Count > 1)
            {
                <div class="p-space-3 bg-surface-container-low border-t border-surface-border flex gap-2 overflow-x-auto">
                    @for (int i = 0; i < Model.ReceiptImageUrls.Count; i++)
                    {
                        <div class="w-16 h-16 flex-shrink-0 bg-black rounded border border-surface-border overflow-hidden cursor-pointer hover:border-primary transition-all @(i == 0 ? "ring-2 ring-primary" : "")" onclick="setPreview(this, '@Model.ReceiptImageUrls[i]')">
                            <img src="@Model.ReceiptImageUrls[i]" class="w-full h-full object-contain" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Right Column: Verification Form -->
    <div class="col-span-12 lg:col-span-7">
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-surface-border overflow-hidden">
            <div class="bg-primary px-space-6 py-space-4 flex justify-between items-center">
                <span class="text-on-primary font-label-caps uppercase tracking-tighter text-[11px]">Reconciliation Form</span>
                <span class="text-on-primary/60 text-[10px] font-data-mono">RECON-v3.0</span>
            </div>

            <form asp-action="SubmitAudit" method="post" class="p-space-8 space-y-space-6">
                <div asp-validation-summary="ModelOnly" class="text-audit-error bg-audit-error/10 border border-audit-error/20 p-space-4 rounded-lg text-body-md text-center"></div>
                
                <input type="hidden" asp-for="ReceiptImageUrl" />
                @if (Model.ReceiptImageUrls != null)
                {
                    for (int i = 0; i < Model.ReceiptImageUrls.Count; i++)
                    {
                        <input type="hidden" name="ReceiptImageUrls[@i]" value="@Model.ReceiptImageUrls[i]" />
                    }
                }

                <!-- Bento Grid Metadata (Stitch Responsive Reference) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-space-4 my-space-4">
                    <div class="bg-surface-container-low rounded-lg p-space-3 border border-surface-border">
                        <div class="text-[9px] uppercase font-bold text-on-surface-variant tracking-wider mb-1">Submitter</div>
                        <div class="flex items-center gap-1.5 text-body-md font-body-md text-on-surface">
                            <span class="material-symbols-outlined text-[16px] text-primary">person</span>
                            @(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity?.Name ?? "Buyer")
                        </div>
                    </div>
                    <div class="bg-surface-container-low rounded-xl p-space-4 border-l-4 border-primary shadow-sm flex flex-col justify-center">
                        <span class="font-label-caps text-on-surface-variant uppercase text-[9px] tracking-wider">Total Claimed Amount</span>
                        <div class="flex items-baseline gap-space-1 mt-1">
                            <span class="text-primary font-bold text-[20px]">₱</span>
                            <span class="font-data-mono text-primary font-bold text-[28px]" id="claimed-amount-display">@Model.Amount.ToString("N2")</span>
                            <span class="text-on-surface-variant text-[10px] font-label-caps uppercase ml-2">PHP</span>
                        </div>
                    </div>
                </div>

                <!-- Establishment and Total Amount -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-space-6">
                    <div class="flex flex-col gap-space-2">
                        <label asp-for="CombinedDestinationId" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Destination / Allocation</label>
                        <select asp-for="CombinedDestinationId" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface appearance-none cursor-pointer" asp-items="ViewBag.CombinedDestinations" required>
                        </select>
                        <input id="main-remarks-input" name="Notes" value="@Model.Notes" class="hidden mt-2 w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all duration-300 text-on-surface" placeholder="Specify custom destination..." />
                        <span asp-validation-for="CombinedDestinationId" class="text-audit-error text-[11px]"></span>
                    </div>

                    <div class="flex flex-col gap-space-2">
                        <label asp-for="Amount" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Total Amount (₱)</label>
                        <input asp-for="Amount" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-data-mono focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" step="0.01" type="number" required />
                        <span asp-validation-for="Amount" class="text-audit-error text-[11px]"></span>
                    </div>
                </div>

                <!-- Description & Date -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-space-6">
                    <div class="flex flex-col gap-space-2">
                        <label asp-for="Description" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Short Description / Purpose</label>
                        <input asp-for="Description" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" placeholder="e.g. Kitchen supplies purchase" required />
                        <span asp-validation-for="Description" class="text-audit-error text-[11px]"></span>
                    </div>

                    <div class="flex flex-col gap-space-2">
                        <label asp-for="EntryDate" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Transaction Date</label>
                        <input asp-for="EntryDate" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface" type="date" required />
                        <span asp-validation-for="EntryDate" class="text-audit-error text-[11px]"></span>
                    </div>
                </div>

                <!-- Notes -->
                <div class="flex flex-col gap-space-2">
                    <label asp-for="Notes" class="font-label-caps text-on-surface-variant uppercase text-[11px] font-semibold">Reviewer Notes (Optional)</label>
                    <textarea asp-for="Notes" class="w-full bg-surface-container-low border border-surface-border rounded-lg px-space-4 py-3 font-body-md focus:outline-none focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all text-on-surface resize-none" rows="2" placeholder="Add extra detail about this purchase..."></textarea>
                </div>

                <!-- Line Items Extracted -->
                <div class="pt-space-4 border-t border-surface-border">
                    <h4 class="font-headline-sm text-headline-sm text-[16px] text-on-surface mb-space-4 flex items-center gap-space-2">
                        <span class="material-symbols-outlined text-primary">list_alt</span>
                        Extracted Line Items
                    </h4>
                    
                    <div class="border border-surface-border rounded-xl">
                        <table class="w-full text-left border-collapse block lg:table">
                            <thead class="hidden lg:table-header-group">
                                <tr class="bg-surface-container-low border-b border-surface-border">
                                    <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px]">Item Description</th>
                                    <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] w-20">Qty</th>
                                    <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] w-28 text-right">Price (₱)</th>
                                    <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] w-28 text-right">Total (₱)</th>
                                    <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] w-64">Split Destination</th>
                                    <th class="px-space-4 py-space-3 font-label-caps text-on-tertiary-container uppercase tracking-wider text-[10px] w-12 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="line-items-body" class="divide-y divide-surface-border block lg:table-row-group space-y-space-4 lg:space-y-0 p-space-4 lg:p-0">
                                @for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr class="hover:bg-surface-container-low/30 transition-colors line-item-row block lg:table-row grid grid-cols-2 gap-x-space-4 gap-y-space-3 p-space-4 border border-surface-border lg:border-0 rounded-xl bg-surface-container-lowest lg:bg-transparent shadow-sm lg:shadow-none">
                                        <td class="col-span-2 lg:col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                                            <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Item Description</label>
                                            <input asp-for="Items[i].Name" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-body-md text-on-surface focus:ring-2 focus:ring-primary/15 focus:outline-none name-input" required />
                                        </td>
                                        <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                                            <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Qty</label>
                                            <input asp-for="Items[i].Quantity" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-center qty-input" type="number" min="1" required />
                                        </td>
                                        <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-right">
                                            <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Price (₱)</label>
                                            <input asp-for="Items[i].Price" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-right price-input" type="number" step="0.01" min="0.00" required />
                                        </td>
                                        <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-right">
                                            <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Total (₱)</label>
                                            <input asp-for="Items[i].Total" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-right total-input" type="number" step="0.01" min="0.00" readonly />
                                        </td>
                                        <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                                            <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Split Destination</label>
                                            @{
                                                var val = "";
                                                if (Model.Items[i].AssignedEstablishmentId.HasValue)
                                                {
                                                    val = $"branch-{Model.Items[i].AssignedEstablishmentId.Value}";
                                                }
                                                else if (Model.Items[i].CostCenterId.HasValue)
                                                {
                                                    val = $"cc-{Model.Items[i].CostCenterId.Value}";
                                                }
                                                else if (!string.IsNullOrEmpty(Model.Items[i].CombinedDestinationId))
                                                {
                                                    val = Model.Items[i].CombinedDestinationId;
                                                }
                                            }
                                            <div class="flex flex-col gap-1">
                                                <select name="Items[@i].CombinedDestinationId" id="Items_@(i)__CombinedDestinationId" class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-body-md text-on-surface focus:ring-2 focus:ring-primary/15 focus:outline-none destination-select">
                                                    @foreach (var opt in (List<SelectListItem>)ViewBag.CombinedDestinations)
                                                    {
                                                        if (opt.Value == val)
                                                        {
                                                            <option value="@opt.Value" selected>@opt.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@opt.Value">@opt.Text</option>
                                                        }
                                                    }
                                                </select>
                                                <input asp-for="Items[i].AllocationNotes" class="hidden w-full bg-surface-container-low border border-surface-border rounded-lg px-2 py-1 font-body-md text-on-surface focus:ring-2 focus:ring-primary/15 focus:outline-none remarks-input transition-all duration-300" placeholder="Specify other destination details..." />
                                            </div>
                                        </td>
                                        <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-center flex items-center justify-end lg:justify-center">
                                            <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Action</label>
                                            <button type="button" class="text-audit-error hover:scale-110 transition-transform remove-row-btn" onclick="removeRow(this)">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-space-3 flex justify-end">
                        <button type="button" class="bg-surface-container text-on-surface border border-surface-border px-4 py-2 rounded-lg font-label-caps hover:bg-surface-container-high transition-all text-[11px] uppercase flex items-center gap-1 shadow-sm" onclick="addRow()">
                            <span class="material-symbols-outlined text-[16px]">add</span> Add Line Item
                        </button>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="pt-space-6 flex gap-space-4 border-t border-surface-border">
                    <button type="submit" id="submitReviewBtn" class="flex-1 bg-primary text-on-primary py-3 rounded-lg font-label-caps uppercase tracking-widest hover:brightness-110 active:scale-[0.98] transition-all text-[12px] flex items-center justify-center gap-space-2">
                        <span class="material-symbols-outlined">send</span>
                        Submit Audit Invoice
                    </button>
                    <a asp-action="Upload" class="px-space-8 py-3 text-on-surface-variant border border-surface-border rounded-lg font-label-caps uppercase tracking-widest hover:bg-surface-container-low transition-all text-[12px] text-center">
                        Discard
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setPreview(el, src) {
        document.getElementById('main-preview').src = src;
        // Remove ring from all thumbnails
        el.parentElement.querySelectorAll('.ring-2').forEach(thumb => {
            thumb.classList.remove('ring-2', 'ring-primary');
        });
        // Add ring to clicked thumbnail
        el.classList.add('ring-2', 'ring-primary');
    }

    function reindexRows() {
        const rows = document.querySelectorAll('#line-items-body .line-item-row');
        rows.forEach((row, idx) => {
            // Update Name inputs
            const nameInput = row.querySelector('.name-input');
            if (nameInput) {
                nameInput.name = `Items[${idx}].Name`;
                nameInput.id = `Items_${idx}__Name`;
            }

            // Update Quantity inputs
            const qtyInput = row.querySelector('.qty-input');
            if (qtyInput) {
                qtyInput.name = `Items[${idx}].Quantity`;
                qtyInput.id = `Items_${idx}__Quantity`;
            }

            // Update Price inputs
            const priceInput = row.querySelector('.price-input');
            if (priceInput) {
                priceInput.name = `Items[${idx}].Price`;
                priceInput.id = `Items_${idx}__Price`;
            }

            // Update Total inputs
            const totalInput = row.querySelector('.total-input');
            if (totalInput) {
                totalInput.name = `Items[${idx}].Total`;
                totalInput.id = `Items_${idx}__Total`;
            }

            // Update destination select
            const destSelect = row.querySelector('.destination-select');
            if (destSelect) {
                destSelect.name = `Items[${idx}].CombinedDestinationId`;
                destSelect.id = `Items_${idx}__CombinedDestinationId`;
            }

            // Update remarks input
            const remarksInput = row.querySelector('.remarks-input');
            if (remarksInput) {
                remarksInput.name = `Items[${idx}].AllocationNotes`;
                remarksInput.id = `Items_${idx}__AllocationNotes`;
            }
    }

    function calculateRowTotal(row) {
        const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
        const price = parseFloat(row.querySelector('.price-input').value) || 0;
        const total = qty * price;
        row.querySelector('.total-input').value = total.toFixed(2);
        calculateOverallTotal();
    }

    function calculateOverallTotal() {
        let sum = 0;
        document.querySelectorAll('#line-items-body .total-input').forEach(input => {
            sum += parseFloat(input.value) || 0;
        });
        const amountField = document.querySelector('input[name="Amount"]');
        if (amountField) {
            amountField.value = sum.toFixed(2);
        }
        const displayVal = document.getElementById('claimed-amount-display');
        if (displayVal) {
            displayVal.innerText = sum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
    }

    function addRow() {
        const body = document.getElementById('line-items-body');
        const newRow = document.createElement('tr');
        newRow.className = 'hover:bg-surface-container-low/30 transition-colors line-item-row block lg:table-row grid grid-cols-2 gap-x-space-4 gap-y-space-3 p-space-4 border border-surface-border lg:border-0 rounded-xl bg-surface-container-lowest lg:bg-transparent shadow-sm lg:shadow-none';
        
        const destinationOptions = document.getElementById('destination-select-template').innerHTML;
        
        newRow.innerHTML = `
            <td class="col-span-2 lg:col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Item Description</label>
                <input class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-body-md text-on-surface focus:ring-2 focus:ring-primary/15 focus:outline-none name-input" required placeholder="New Item" />
            </td>
            <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Qty</label>
                <input class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-center qty-input" type="number" min="1" value="1" required />
            </td>
            <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-right">
                <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Price (₱)</label>
                <input class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-right price-input" type="number" step="0.01" min="0.00" value="0.00" required />
            </td>
            <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-right">
                <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Total (₱)</label>
                <input class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-data-mono text-on-surface text-[13px] focus:ring-2 focus:ring-primary/15 focus:outline-none text-right total-input" type="number" step="0.01" min="0.00" value="0.00" readonly />
            </td>
            <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2">
                <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Split Destination</label>
                <div class="flex flex-col gap-1">
                    <select class="w-full bg-transparent border lg:border-0 border-surface-border rounded lg:rounded-none px-3 py-2 lg:px-2 lg:py-1 font-body-md text-on-surface focus:ring-2 focus:ring-primary/15 focus:outline-none destination-select">
                        ${destinationOptions}
                    </select>
                    <input class="hidden w-full bg-surface-container-low border border-surface-border rounded-lg px-2 py-1 font-body-md text-on-surface focus:ring-2 focus:ring-primary/15 focus:outline-none remarks-input transition-all duration-300" placeholder="Specify other destination details..." />
                </div>
            </td>
            <td class="col-span-1 block lg:table-cell p-0 lg:px-space-4 lg:py-space-2 text-center flex items-center justify-end lg:justify-center">
                <label class="block lg:hidden font-label-caps text-on-surface-variant text-[9px] uppercase mb-1">Action</label>
                <button type="button" class="text-audit-error hover:scale-110 transition-transform remove-row-btn" onclick="removeRow(this)">
                    <span class="material-symbols-outlined text-[18px]">delete</span>
                </button>
            </td>
        `;
        body.appendChild(newRow);
        
        // Setup event listeners on new row
        const qtyInput = newRow.querySelector('.qty-input');
        const priceInput = newRow.querySelector('.price-input');
        qtyInput.addEventListener('input', () => calculateRowTotal(newRow));
        priceInput.addEventListener('input', () => calculateRowTotal(newRow));
        const mainVal = document.getElementById('CombinedDestinationId').value;
        const destSelect = newRow.querySelector('.destination-select');
        if (destSelect) {
            destSelect.value = mainVal;
            destSelect.addEventListener('change', () => updateRemarksVisibility(newRow));
        }

        reindexRows();
        calculateRowTotal(newRow);
        updateRemarksVisibility(newRow);
    }

    function removeRow(btn) {
        const row = btn.closest('tr');
        row.remove();
        reindexRows();
        calculateOverallTotal();
    }

    function updateRemarksVisibility(row) {
        const destSelect = row.querySelector('.destination-select');
        const remarksInput = row.querySelector('.remarks-input');
        if (destSelect && remarksInput) {
            const selectedText = destSelect.options[destSelect.selectedIndex]?.text || '';
            if (selectedText.toLowerCase() === 'others') {
                remarksInput.classList.remove('hidden');
                remarksInput.removeAttribute('disabled');
            } else {
                remarksInput.classList.add('hidden');
                remarksInput.setAttribute('disabled', 'disabled');
            }
        }
    }

    function updateMainRemarksVisibility() {
        const destSelect = document.getElementById('CombinedDestinationId');
        const remarksInput = document.getElementById('main-remarks-input');
        if (destSelect && remarksInput) {
            const selectedText = destSelect.options[destSelect.selectedIndex]?.text || '';
            if (selectedText.toLowerCase() === 'others') {
                remarksInput.classList.remove('hidden');
                remarksInput.removeAttribute('disabled');
            } else {
                remarksInput.classList.add('hidden');
                remarksInput.setAttribute('disabled', 'disabled');
            }
        }
    }

        const mainDestSelect = document.getElementById('CombinedDestinationId');
        if (mainDestSelect) {
            mainDestSelect.addEventListener('change', () => {
                updateMainRemarksVisibility();
                syncDestinations();
            });
            updateMainRemarksVisibility();
            syncDestinations();
        }

        function syncDestinations() {
            const mainVal = document.getElementById('CombinedDestinationId').value;
            document.querySelectorAll('#line-items-body .destination-select').forEach(select => {
                select.value = mainVal;
                select.dispatchEvent(new Event('change'));
            });
        }

        // Bind event listeners to existing rows
        document.querySelectorAll('#line-items-body .line-item-row').forEach(row => {
            const qtyInput = row.querySelector('.qty-input');
            const priceInput = row.querySelector('.price-input');
            qtyInput.addEventListener('input', () => calculateRowTotal(row));
            priceInput.addEventListener('input', () => calculateRowTotal(row));

            const destSelect = row.querySelector('.destination-select');
            if (destSelect) {
                destSelect.addEventListener('change', () => updateRemarksVisibility(row));
            }
            updateRemarksVisibility(row);
        });

        // Lightbox Modal Handlers
        const mainPreview = document.getElementById('main-preview');
        const lightbox = document.getElementById('lightboxModal');
        const lightboxImg = document.getElementById('lightbox-img');

        function openLightbox() {
            if (lightbox && lightboxImg && mainPreview) {
                lightboxImg.src = mainPreview.src;
                lightbox.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            }
        }

        function closeLightbox() {
            if (lightbox) {
                lightbox.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }

        mainPreview?.addEventListener('click', openLightbox);
        window.closeLightbox = closeLightbox;
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeLightbox();
        });
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector("form");
        const submitBtn = document.getElementById("submitReviewBtn");
        if (form && submitBtn) {
            form.addEventListener("submit", function () {
                submitBtn.disabled = true;
                submitBtn.innerText = "Submitting...";
            });
        }
    });
</script>

