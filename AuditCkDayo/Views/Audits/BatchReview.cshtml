@model List<AuditCkDayo.ViewModels.AuditSubmissionViewModel>
@{
    ViewData["Title"] = "Processed Audit Invoices";
    var total = Model.Sum(a => a.Amount);
}

<div class="space-y-space-6">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-space-4">
        <div>
            <div class="flex items-center gap-space-2 text-primary">
                <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Batch Audit Review</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Processed OCR Audits</h1>
            <p class="font-body-md text-on-surface-variant">Review every processed receipt group, add more audits, then submit the batch together.</p>
        </div>
    </div>
    <div asp-validation-summary="ModelOnly" class="rounded-lg border border-red-200 bg-red-50 px-space-4 py-space-3 text-red-700 text-sm"></div>

    <section class="overflow-hidden rounded-xl border border-surface-border bg-surface-container-lowest shadow-sm">
        <div class="px-space-6 py-space-4 border-b border-surface-border flex items-center justify-between">
            <h2 class="font-headline-sm text-headline-sm text-on-surface">Processed OCR table</h2>
            <span class="font-data-mono text-data-mono text-primary">@Model.Count audit(s) · ₱@total.ToString("N2")</span>
        </div>

        @if (!Model.Any())
        {
            <div class="px-space-6 py-space-8 text-center text-on-surface-variant font-body-md">
                No processed audits have been added yet.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse" id="batchAuditTable">
                    <thead>
                        <tr class="border-b border-surface-border bg-surface-container-low/50">
                            <th class="px-space-6 py-space-3 text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant font-label-caps w-[60px]">#</th>
                            <th class="px-space-6 py-space-3 text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant font-label-caps">Description</th>
                            <th class="px-space-6 py-space-3 text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant font-label-caps text-center w-[120px]">Receipt files</th>
                            <th class="px-space-6 py-space-3 text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant font-label-caps text-right w-[140px]">Amount</th>
                            <th class="px-space-6 py-space-3 text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant font-label-caps text-center w-[130px]">Date</th>
                            <th class="px-space-6 py-space-3 text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant font-label-caps text-center w-[60px]"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Count; i++)
                        {
                            <tr class="border-b border-surface-border/60 hover:bg-surface-container-low/40 transition-colors cursor-pointer group"
                                onclick="openAuditDraftViewer(this)"
                                data-index="@i"
                                data-description="@Model[i].Description"
                                data-amount="₱@Model[i].Amount.ToString("N2")"
                                data-amount-raw="@Model[i].Amount.ToString("F2")"
                                data-date="@Model[i].EntryDate.ToString("yyyy-MM-dd")"
                                data-notes="@Model[i].Notes"
                                data-details="@System.Text.Json.JsonSerializer.Serialize(Model[i].Items.Select(d => new { name = d.Name, qty = d.Quantity, price = d.Price, total = d.Quantity * d.Price, pnlCategoryId = d.PnlCategoryId ?? (d.PnlSection == AuditCkDayo.Models.PnlExpenseSection.COGS ? -1 : -2) }))"
                                data-receipt-url="@(Model[i].ReceiptImageUrls?.FirstOrDefault() ?? Model[i].ReceiptImageUrl ?? "")">
                                <td class="px-space-6 py-space-4 text-[13px] font-data-mono text-on-surface-variant">@(i + 1)</td>
                                <td class="px-space-6 py-space-4 text-[14px] text-on-surface font-semibold">@Model[i].Description</td>
                                <td class="px-space-6 py-space-4 text-center">
                                    <span class="inline-flex items-center justify-center bg-surface-container rounded-full px-2.5 py-0.5 text-[12px] font-data-mono text-on-surface-variant font-semibold min-w-[28px]">@(Model[i].ReceiptImageUrls?.Count ?? 0)</span>
                                </td>
                                <td class="px-space-6 py-space-4 text-right text-[14px] font-data-mono text-primary font-bold">₱@Model[i].Amount.ToString("N2")</td>
                                <td class="px-space-6 py-space-4 text-center text-[13px] font-data-mono text-on-surface-variant">@Model[i].EntryDate.ToString("yyyy-MM-dd")</td>
                                <td class="px-space-6 py-space-4 text-center" onclick="event.stopPropagation();">
                                    <form asp-action="RemoveAuditDraft" method="post" class="inline" onsubmit="return confirm('Remove this audit draft?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="index" value="@i" />
                                        <button type="submit" class="opacity-0 group-hover:opacity-100 text-on-surface-variant hover:text-error transition-all p-1 rounded-lg hover:bg-error/10 cursor-pointer" title="Remove draft">
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="bg-surface-container-low/30 border-t border-surface-border">
                            <td colspan="3" class="px-space-6 py-space-3 text-[12px] font-label-caps uppercase tracking-wider text-on-surface-variant font-semibold text-right">Total</td>
                            <td class="px-space-6 py-space-3 text-right text-[15px] font-data-mono text-primary font-bold" id="batchTotalAmount">₱@total.ToString("N2")</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </section>

    <div class="flex flex-wrap gap-space-3">
        <a asp-action="Upload" class="rounded-lg border border-surface-border px-space-6 py-space-3 text-[12px] font-label-caps uppercase tracking-widest text-on-surface-variant hover:bg-surface-container-low transition-colors">Add More Audits</a>
        @if (Model.Any())
        {
            <form asp-action="SubmitAuditBatch" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="rounded-lg bg-primary px-space-6 py-space-3 text-[12px] font-label-caps uppercase tracking-widest text-on-primary hover:brightness-110 transition-all">Submit All Audit Invoices</button>
            </form>
        }
    </div>
</div>

<!-- Audit Viewer / Editor Modal -->
<div id="auditDraftViewerModal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-labelledby="draftViewerTitle">
    <div id="draftViewerBackdrop" class="absolute inset-0 bg-primary/80 backdrop-blur-sm"></div>
    <div class="relative z-10 h-full w-full p-space-4 lg:p-space-6 flex items-center justify-center">
        <section class="bg-surface-container-lowest border border-surface-border rounded-xl shadow-2xl w-full max-w-7xl max-h-[92vh] overflow-y-auto overflow-x-hidden lg:overflow-hidden grid grid-cols-1 lg:grid-cols-[minmax(0,1.4fr)_minmax(380px,0.6fr)]">
            <!-- Left: Receipt image -->
            <div class="bg-surface-container-highest min-h-[320px] max-h-[92vh] flex flex-col items-center justify-center gap-space-3 p-space-6 overflow-auto">
                <img id="draft-viewer-receipt" src="" alt="Full receipt image" class="max-w-full max-h-[75vh] object-contain rounded-lg shadow-lg bg-white" />
                <div id="draft-viewer-receipt-error" class="hidden max-w-md text-center text-on-primary bg-primary/90 border border-on-primary/10 rounded-xl p-space-4">
                    <p class="text-[13px]">Receipt preview could not load here. Open the receipt image directly.</p>
                </div>
                <a id="draft-viewer-receipt-link" href="#" target="_blank" rel="noopener" class="inline-flex items-center gap-space-2 bg-primary text-on-primary px-space-4 py-space-2 rounded-lg text-[11px] font-label-caps uppercase hover:brightness-125 transition-colors">
                    <span class="material-symbols-outlined text-[16px]">open_in_new</span>
                    Open Receipt Image
                </a>
            </div>
            <!-- Right: Editable details -->
            <aside class="p-space-6 overflow-y-auto max-h-[92vh] space-y-space-4 flex flex-col">
                <div class="flex items-start justify-between gap-space-4">
                    <div>
                        <span class="font-label-caps text-on-surface-variant uppercase text-[10px] tracking-widest">Audit Draft Editor</span>
                        <h2 id="draftViewerTitle" class="font-headline-md text-headline-md text-on-surface mt-0.5">Edit Details</h2>
                    </div>
                    <button type="button" id="closeDraftViewerBtn" class="bg-surface-container text-on-surface-variant hover:text-error border border-surface-border rounded-lg p-2 transition-colors cursor-pointer flex-shrink-0" aria-label="Close audit viewer">
                        <span class="material-symbols-outlined text-[20px]">close</span>
                    </button>
                </div>

                <input type="hidden" id="draft-edit-index" value="" />

                <!-- Editable fields -->
                <div class="space-y-space-3">
                    <div>
                        <label for="draft-edit-description" class="block text-[10px] font-label-caps uppercase tracking-widest text-on-surface-variant mb-1">Description / Purpose</label>
                        <input type="text" id="draft-edit-description" class="w-full rounded-lg border border-surface-border bg-surface-container-lowest px-space-3 py-space-2 text-[14px] text-on-surface font-semibold focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors" />
                    </div>
                    <div class="grid grid-cols-2 gap-space-3">
                        <div>
                            <label for="draft-edit-date" class="block text-[10px] font-label-caps uppercase tracking-widest text-on-surface-variant mb-1">Date</label>
                            <input type="date" id="draft-edit-date" class="w-full rounded-lg border border-surface-border bg-surface-container-lowest px-space-3 py-space-2 text-[14px] font-data-mono text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors" />
                        </div>
                        <div>
                            <label class="block text-[10px] font-label-caps uppercase tracking-widest text-on-surface-variant mb-1">Total Amount</label>
                            <div id="draft-edit-total" class="font-data-mono text-primary text-[20px] font-bold py-space-2">₱0.00</div>
                        </div>
                    </div>
                    <div>
                        <label for="draft-edit-notes" class="block text-[10px] font-label-caps uppercase tracking-widest text-on-surface-variant mb-1">Notes</label>
                        <textarea id="draft-edit-notes" rows="2" class="w-full rounded-lg border border-surface-border bg-surface-container-lowest px-space-3 py-space-2 text-[13px] text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-colors resize-none" placeholder="Add notes..."></textarea>
                    </div>
                </div>

                <!-- Editable line items -->
                <div class="border-t border-surface-border pt-space-3 flex-1 flex flex-col min-h-0">
                    <div class="flex items-center justify-between mb-space-2">
                        <h3 class="text-[10px] font-label-caps uppercase tracking-widest text-on-surface-variant">Line Items</h3>
                        <button type="button" id="addLineItemBtn" class="inline-flex items-center gap-1 text-[11px] font-label-caps uppercase text-primary hover:text-primary/70 transition-colors cursor-pointer">
                            <span class="material-symbols-outlined text-[16px]">add</span> Add Item
                        </button>
                    </div>
                    <div class="overflow-x-auto border border-surface-border rounded-lg flex-1">
                        <table class="w-full text-left border-collapse text-[12px]">
                            <thead>
                                <tr class="border-b border-surface-border bg-surface-container-low/50">
                                    <th class="px-space-3 py-space-2 text-[10px] font-label-caps uppercase tracking-wider text-on-surface-variant font-semibold">Item</th>
                                    <th class="px-space-3 py-space-2 text-[10px] font-label-caps uppercase tracking-wider text-on-surface-variant font-semibold text-center w-[60px]">Qty</th>
                                    <th class="px-space-3 py-space-2 text-[10px] font-label-caps uppercase tracking-wider text-on-surface-variant font-semibold text-right w-[90px]">Price</th>
                                    <th class="px-space-3 py-space-2 text-[10px] font-label-caps uppercase tracking-wider text-on-surface-variant font-semibold text-right w-[90px]">Total</th>
                                    <th class="px-space-3 py-space-2 w-[36px]"></th>
                                </tr>
                            </thead>
                            <tbody id="draft-viewer-items-body"></tbody>
                            <tfoot>
                                <tr class="border-t border-surface-border bg-surface-container-low/30">
                                    <td colspan="3" class="px-space-3 py-space-2 text-[10px] font-label-caps uppercase tracking-wider text-on-surface-variant font-semibold text-right">Subtotal</td>
                                    <td id="draft-items-subtotal" class="px-space-3 py-space-2 text-right font-data-mono text-primary font-bold text-[13px]">₱0.00</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Save / Discard buttons -->
                <div class="flex gap-space-3 pt-space-2 border-t border-surface-border">
                    <button type="button" id="saveDraftChangesBtn" class="flex-1 rounded-lg bg-primary px-space-4 py-space-3 text-[12px] font-label-caps uppercase tracking-widest text-on-primary hover:brightness-110 transition-all cursor-pointer inline-flex items-center justify-center gap-space-2">
                        <span class="material-symbols-outlined text-[16px]">save</span>
                        Save Changes
                    </button>
                    <button type="button" id="discardDraftChangesBtn" class="rounded-lg border border-surface-border px-space-4 py-space-3 text-[12px] font-label-caps uppercase tracking-widest text-on-surface-variant hover:bg-surface-container-low transition-colors cursor-pointer">
                        Discard
                    </button>
                </div>
            </aside>
        </section>
    </div>
</div>

<!-- Toast notification -->
<div id="draftSaveToast" class="fixed bottom-6 right-6 z-[200] hidden">
    <div class="bg-primary text-on-primary px-space-6 py-space-3 rounded-lg shadow-xl text-[13px] font-label-caps inline-flex items-center gap-space-2">
        <span class="material-symbols-outlined text-[18px]">check_circle</span>
        <span id="draftSaveToastMsg">Changes saved</span>
    </div>
</div>

<script>
    // Store CSRF token for AJAX
    const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    // Current draft state for editing
    let currentDraftIndex = -1;
    let currentItems = [];

    function openAuditDraftViewer(row) {
        const modal = document.getElementById('auditDraftViewerModal');
        const img = document.getElementById('draft-viewer-receipt');
        const link = document.getElementById('draft-viewer-receipt-link');
        const tbody = document.getElementById('draft-viewer-items-body');

        currentDraftIndex = parseInt(row.getAttribute('data-index'));
        document.getElementById('draft-edit-index').value = currentDraftIndex;

        // Populate editable fields
        document.getElementById('draft-edit-description').value = row.getAttribute('data-description') || '';
        document.getElementById('draft-edit-date').value = row.getAttribute('data-date') || '';
        document.getElementById('draft-edit-total').textContent = row.getAttribute('data-amount') || '₱0.00';
        document.getElementById('draft-edit-notes').value = row.getAttribute('data-notes') || '';

        // Populate receipt image
        const receiptUrl = row.getAttribute('data-receipt-url');
        if (receiptUrl) {
            img.src = receiptUrl;
            img.classList.remove('hidden');
            link.href = receiptUrl;
            link.classList.remove('hidden');
            document.getElementById('draft-viewer-receipt-error').classList.add('hidden');
        } else {
            img.classList.add('hidden');
            link.classList.add('hidden');
            document.getElementById('draft-viewer-receipt-error').classList.remove('hidden');
        }

        // Parse and render editable line items
        const detailsJson = row.getAttribute('data-details');
        currentItems = [];
        if (detailsJson) {
            try {
                currentItems = JSON.parse(detailsJson) || [];
            } catch (e) { currentItems = []; }
        }
        renderEditableItems();
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function renderEditableItems() {
        const tbody = document.getElementById('draft-viewer-items-body');
        tbody.innerHTML = '';
        if (currentItems.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center py-space-4 text-on-surface-variant text-[12px]">No items listed. Click "Add Item" to add one.</td></tr>';
            updateSubtotal();
            return;
        }
        currentItems.forEach((item, idx) => {
            const tr = document.createElement('tr');
            tr.className = 'border-b border-surface-border/40 hover:bg-surface-container-low/30 transition-colors';
            tr.innerHTML = `
                <td class="px-space-3 py-space-2">
                    <input type="text" value="${escapeHtml(item.name)}" data-field="name" data-idx="${idx}"
                           class="w-full bg-transparent border-0 border-b border-transparent hover:border-surface-border focus:border-primary text-[12px] font-semibold text-on-surface py-0.5 px-0 focus:outline-none transition-colors" />
                </td>
                <td class="px-space-3 py-space-2 text-center">
                    <input type="number" value="${item.qty}" min="1" data-field="qty" data-idx="${idx}"
                           class="w-full text-center bg-transparent border-0 border-b border-transparent hover:border-surface-border focus:border-primary text-[12px] font-data-mono text-on-surface-variant py-0.5 px-0 focus:outline-none transition-colors" />
                </td>
                <td class="px-space-3 py-space-2 text-right">
                    <input type="number" value="${parseFloat(item.price).toFixed(2)}" step="0.01" min="0" data-field="price" data-idx="${idx}"
                           class="w-full text-right bg-transparent border-0 border-b border-transparent hover:border-surface-border focus:border-primary text-[12px] font-data-mono text-on-surface-variant py-0.5 px-0 focus:outline-none transition-colors" />
                </td>
                <td class="px-space-3 py-space-2 text-right font-data-mono text-primary font-bold text-[12px] item-total">
                    ₱${(item.qty * parseFloat(item.price)).toFixed(2)}
                </td>
                <td class="px-space-3 py-space-2 text-center">
                    <button type="button" onclick="removeItem(${idx})" class="text-on-surface-variant hover:text-error transition-colors p-0.5 rounded cursor-pointer hover:bg-error/10">
                        <span class="material-symbols-outlined text-[14px]">close</span>
                    </button>
                </td>`;
            tbody.appendChild(tr);
        });

        // Attach input listeners for live recalculation
        tbody.querySelectorAll('input').forEach(input => {
            input.addEventListener('input', handleItemEdit);
        });
        updateSubtotal();
    }

    function handleItemEdit(e) {
        const idx = parseInt(e.target.dataset.idx);
        const field = e.target.dataset.field;
        if (field === 'name') {
            currentItems[idx].name = e.target.value;
        } else if (field === 'qty') {
            currentItems[idx].qty = parseInt(e.target.value) || 1;
        } else if (field === 'price') {
            currentItems[idx].price = parseFloat(e.target.value) || 0;
        }
        // Recalculate that row's total
        const row = e.target.closest('tr');
        const total = currentItems[idx].qty * currentItems[idx].price;
        currentItems[idx].total = total;
        row.querySelector('.item-total').textContent = `₱${total.toFixed(2)}`;
        updateSubtotal();
    }

    function updateSubtotal() {
        const subtotal = currentItems.reduce((sum, item) => sum + (item.qty * item.price), 0);
        document.getElementById('draft-items-subtotal').textContent = `₱${subtotal.toFixed(2)}`;
        document.getElementById('draft-edit-total').textContent = `₱${subtotal.toFixed(2)}`;
    }

    function removeItem(idx) {
        currentItems.splice(idx, 1);
        renderEditableItems();
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text || '';
        return div.innerHTML.replace(/"/g, '&quot;');
    }

    // Add new line item
    document.getElementById('addLineItemBtn').addEventListener('click', function() {
        currentItems.push({ name: '', qty: 1, price: 0, total: 0, pnlCategoryId: -2 });
        renderEditableItems();
        // Focus the new item name input
        const inputs = document.querySelectorAll('#draft-viewer-items-body input[data-field="name"]');
        if (inputs.length > 0) inputs[inputs.length - 1].focus();
    });

    // Save changes
    document.getElementById('saveDraftChangesBtn').addEventListener('click', async function() {
        const idx = currentDraftIndex;
        if (idx < 0) return;

        const btn = this;
        btn.disabled = true;
        btn.textContent = 'Saving...';

        try {
            // Save items first
            const itemsPayload = currentItems.map(item => ({
                Name: item.name,
                Quantity: parseInt(item.qty) || 1,
                Price: parseFloat(item.price) || 0,
                Total: (parseInt(item.qty) || 1) * (parseFloat(item.price) || 0),
                PnlCategoryId: item.pnlCategoryId || -2
            }));

            const itemsRes = await fetch(`/Audits/UpdateAuditDraftItems?index=${idx}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': csrfToken
                },
                body: JSON.stringify(itemsPayload)
            });
            const itemsData = await itemsRes.json();

            // Then save description, date, notes
            const formData = new FormData();
            formData.append('index', idx);
            formData.append('description', document.getElementById('draft-edit-description').value);
            formData.append('amount', itemsData.newAmount || 0);
            formData.append('entryDate', document.getElementById('draft-edit-date').value);
            formData.append('notes', document.getElementById('draft-edit-notes').value);
            formData.append('__RequestVerificationToken', csrfToken);

            await fetch('/Audits/UpdateAuditDraft', {
                method: 'POST',
                body: formData
            });

            showToast('Changes saved successfully');
            setTimeout(() => window.location.reload(), 600);
        } catch (err) {
            showToast('Failed to save changes');
            btn.disabled = false;
            btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">save</span> Save Changes';
        }
    });

    // Discard changes (close without saving)
    document.getElementById('discardDraftChangesBtn').addEventListener('click', hideModal);

    function hideModal() {
        document.getElementById('auditDraftViewerModal').classList.add('hidden');
        document.body.style.overflow = '';
    }

    function showToast(msg) {
        const toast = document.getElementById('draftSaveToast');
        document.getElementById('draftSaveToastMsg').textContent = msg;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 2500);
    }

    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('auditDraftViewerModal');
        const closeBtn = document.getElementById('closeDraftViewerBtn');
        const backdrop = document.getElementById('draftViewerBackdrop');

        if (closeBtn) closeBtn.addEventListener('click', hideModal);
        if (backdrop) backdrop.addEventListener('click', hideModal);

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
                hideModal();
            }
        });
    });
</script>
