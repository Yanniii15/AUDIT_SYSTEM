@model IEnumerable<AuditCkDayo.Models.Notification>
@{
    ViewData["Title"] = "Notification History";
    var unreadCount = Model.Count(n => n.ReadAt == null);
}

<div id="pageVoiceSummary" class="sr-only">
    System notifications. Unread notifications: @Model.Count(n => n.ReadAt == null).
    @if (Model.Any())
    {
        var first = Model.First();
        <text>Newest notification: @first.Title, @first.Message.</text>
    }
</div>

<div class="relative flex flex-col gap-space-6">
    <section class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-space-4">
        <div class="space-y-space-2 max-w-2xl">
            <div class="flex items-center gap-space-2 text-primary">
                <span class="material-symbols-outlined text-[20px]">notifications_active</span>
                <span class="font-label-caps uppercase tracking-widest text-on-surface-variant">Notification Center</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface">Notification History</h1>
            <p class="font-body-md text-on-surface-variant leading-relaxed">
                Review system alerts, branch verification updates, surrender requests, and fund movement notices in one clean timeline.
            </p>
        </div>

        @if (unreadCount > 0)
        {
            <form asp-controller="Notifications" asp-action="MarkAllAsRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="bg-primary text-on-primary px-space-6 py-3 rounded-lg font-label-caps uppercase tracking-widest hover:brightness-110 transition-all text-[12px] flex items-center gap-space-2 shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">done_all</span>
                    Mark all read (@unreadCount)
                </button>
            </form>
        }
    </section>

    @if (!Model.Any())
    {
        <section class="bg-surface-container-lowest rounded-xl border border-surface-border shadow-sm p-space-8 text-center">
            <div class="mx-auto w-12 h-12 rounded-full bg-surface-container flex items-center justify-center mb-space-4">
                <span class="material-symbols-outlined text-primary">notifications_off</span>
            </div>
            <h2 class="font-headline-sm text-on-surface mb-space-2">No notifications yet</h2>
            <p class="font-body-md text-on-surface-variant">New approvals, delivery checks, and cash movement alerts will appear here.</p>
        </section>
    }
    else
    {
        <section class="bg-surface-container-lowest rounded-xl border border-surface-border shadow-sm overflow-hidden">
            <div class="px-space-6 py-space-4 border-b border-surface-border flex items-center justify-between">
                <div>
                    <h2 class="font-headline-sm text-on-surface">All Alerts</h2>
                    <p class="text-[12px] text-on-surface-variant">Newest notifications appear first.</p>
                </div>
                <span class="font-data-mono text-primary text-[13px]">@Model.Count() total</span>
            </div>

            <div class="divide-y divide-surface-border">
                @foreach (var notification in Model)
                {
                    var isUnread = notification.ReadAt == null;
                    var icon = notification.Category switch
                    {
                        "BranchVerify" => "local_shipping",
                        "AuditSubmit" => "receipt_long",
                        "Surrender" => "payments",
                        "Funding" => "account_balance_wallet",
                        _ => "notifications"
                    };

                    <article class="group px-space-6 py-space-4 flex gap-space-4 @(isUnread ? "bg-primary/5" : "bg-surface-container-lowest") hover:bg-surface-container-low transition-colors">
                        <div class="mt-1 w-10 h-10 rounded-xl @(isUnread ? "bg-primary text-on-primary" : "bg-surface-container text-on-surface-variant") flex items-center justify-center flex-shrink-0">
                            <span class="material-symbols-outlined text-[20px]">@icon</span>
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-space-2">
                                <div class="flex items-center gap-space-2 min-w-0">
                                    @if (isUnread)
                                    {
                                        <span class="w-2 h-2 rounded-full bg-audit-pending flex-shrink-0"></span>
                                    }
                                    <h3 class="font-body-md font-semibold text-on-surface truncate">@notification.Title</h3>
                                </div>
                                <time class="font-data-mono text-[11px] text-on-surface-variant whitespace-nowrap">@notification.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy • hh:mm tt")</time>
                            </div>

                            <p class="font-body-md text-[13px] text-on-surface-variant leading-relaxed mt-space-2">@notification.Message</p>

                            <div class="flex items-center justify-between mt-space-3 gap-space-3">
                                <span class="px-space-3 py-1 bg-surface-container rounded-full border border-surface-border text-[10px] font-label-caps uppercase text-on-surface-variant">@notification.Category</span>

                                @if (isUnread)
                                {
                                    <form asp-controller="Notifications" asp-action="MarkAsRead" asp-route-id="@notification.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-[11px] font-label-caps uppercase text-primary hover:underline bg-transparent border-0 p-0">Mark as read</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-[11px] text-on-surface-variant font-label-caps uppercase">Read</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>
