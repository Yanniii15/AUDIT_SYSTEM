<%# Mobile Dashboard Header %>
<div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 25px; font-family: sans-serif;">
  
  <%# Total Spent Card %>
  <div style="background: #dc3545; color: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
    <p style="margin: 0; font-size: 0.8em; text-transform: uppercase; opacity: 0.9;">Total Spent Today</p>
    <h1 style="margin: 5px 0;">₱<%= number_with_precision(@total_amount, precision: 2) %></h1>
  </div>

  <%# Audit Card %>
  <div style="background: #007bff; color: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
    <p style="margin: 0; font-size: 0.8em; text-transform: uppercase; opacity: 0.9;">Expected Cash in Drawer</p>
    <h1 style="margin: 5px 0;">₱<%= number_with_precision(@expected_cash, precision: 2) %></h1>
    <small>Starting: ₱<%= number_with_precision(@starting_cash, precision: 2) %></small>
  </div>

</div>

<hr style="border: 0; border-top: 1px solid #eee; margin: 20px 0;">

<%# Your Table goes here - wrap it in a div for mobile scrolling %>
<div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
  <%# Existing Table Code... %>
</div>
<p style="color: green"><%= notice %></p>
<div style="text-align: right; margin-bottom: 10px; font-family: sans-serif;">
  Logged in as: <strong><%= current_user.name %></strong> 
  (<%= current_user.role %>) |
  <%= button_to "Logout", destroy_user_session_path, method: :delete, style: "background: none; border: none; color: #d9534f; cursor: pointer; text-decoration: underline; display: inline;" %>
</div>
<div style="display: flex; justify-content: space-between; align-items: center;">
  <h1>Daily Audit Dashboard</h1>
  <% if current_user.role == 'admin' %>
    <%= link_to "View History / Reports 📅", report_expenses_path, style: "text-decoration: none; color: #555; border: 1px solid #ccc; padding: 5px 10px; border-radius: 4px;" %>
  <% end %>
</div>

<p style="color: #666;">Showing audit for: <strong><%= Date.today.strftime("%B %d, %Y") %></strong></p>

<div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 30px; border: 1px solid #ddd; display: flex; justify-content: space-around; box-shadow: 2px 2px 5px rgba(0,0,0,0.05);">
  <div style="text-align: center;">
    <small style="text-transform: uppercase; color: #888;">Starting Float</small><br>
    <strong style="font-size: 1.4em;"><%= number_to_currency(@starting_cash, unit: "₱") %></strong>
  </div>
  
  <div style="text-align: center;">
    <small style="text-transform: uppercase; color: #888;">Total Expenses Today</small><br>
    <strong style="font-size: 1.4em; color: #d9534f;"><%= number_to_currency(@total_amount, unit: "₱") %></strong>
  </div>
  
  <div style="text-align: center; border-left: 2px solid #ddd; padding-left: 30px;">
    <small style="text-transform: uppercase; color: #888;">Expected Cash in Box</small><br>
    <strong style="font-size: 1.6em; color: #5cb85c;"><%= number_to_currency(@expected_cash, unit: "₱") %></strong>
  </div>
</div>

<table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
  <thead>
    <tr style="background-color: #333; color: white; text-align: left;">
      <th style="padding: 12px;">Description</th>
      <th style="padding: 12px;">Amount</th>
      <th style="padding: 12px;">Dept</th>
      <th style="padding: 12px;">Source</th>
      <th style="padding: 12px;">Verified</th>
      <th style="padding: 12px;">Actions</th>
      <th style="padding: 12px;">Auditor</th>
      <th style="padding: 12px;">Notes</th>
    </tr>
  </thead>

  <tbody>
    <% if @expenses.any? %>
      <% @expenses.each do |expense| %>
        <tr style="border-bottom: 1px solid #eee;">
          <td style="padding: 12px;"><%= expense.description %></td>
          <td style="padding: 12px; font-weight: bold;"><%= number_to_currency(expense.amount, unit: "₱") %></td>
          <td style="padding: 12px;"><%= expense.department %></td>
          <td style="padding: 12px;"><%= expense.pcf_source %></td>
          <td style="padding: 12px; text-align: center;"><%= expense.is_verified ? "✅" : "❌" %></td>
          <td style="padding: 12px;"><%= link_to "Edit", edit_expense_path(expense), style: "color: #0275d8;" %></td>
          <td style="padding: 12px;"><%= expense.user.name %></td>
          <td style="padding: 12px; font-size: 0.85em; color: #555;"><%= expense.notes %></td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="6" style="padding: 30px; text-align: center; color: #999;">
          No expenses recorded yet for today.
        </td>
      </tr>
    <% end %>
  </tbody>
  
  <tfoot>
    <tr style="background-color: #e6f7ff; font-weight: bold;">
      <td style="padding: 12px; text-align: right;">TODAY'S TOTAL:</td>
      <td style="padding: 12px;"><%= number_to_currency(@total_amount, unit: "₱") %></td>
      <td colspan="4"></td>
    </tr>
  </tfoot>
</table>

<br>

<div style="text-align: center; margin-top: 20px;">
  <%= link_to "➕ RECORD NEW EXPENSE", new_expense_path, style: "padding: 15px 30px; background: #0275d8; color: white; text-decoration: none; border-radius: 5px; font-weight: bold; font-size: 1.1em;" %>
</div>