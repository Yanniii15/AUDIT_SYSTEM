<div id="<%= dom_id expense %>">
  <div>
    <strong>Entry date:</strong>
    <%= expense.entry_date %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= expense.description %>
  </div>

  <div>
    <strong>Amount:</strong>
    <%= expense.amount %>
