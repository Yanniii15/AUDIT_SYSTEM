<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  /* 📱 MOBILE RESPONSIVE RULES */
  .resp-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; background: white; padding: 20px 24px; border-radius: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); border: 1px solid #f1f5f9; }
  .resp-filter-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 30px; }
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  
  @media (max-width: 768px) {
    .resp-header { flex-direction: column; align-items: flex-start; gap: 15px; }
    .resp-header a { width: 100%; justify-content: center; }
    
    /* Stack the filter form and the total box */
    .resp-filter-grid { grid-template-columns: 1fr; }
    
    /* Make the filter form inputs stack */
    .mobile-form-stack { flex-direction: column; align-items: stretch !important; }
    .mobile-form-stack input[type="submit"] { width: 100%; margin-top: 10px; }
    
    td, th { padding: 12px 15px !important; }
  }
</style>

<div style="font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; min-height: 100vh; padding: 30px 15px;">
  <div style="max-width: 1000px; margin: 0 auto;">

    <%# --- TOP NAVIGATION --- %>
    <div class="resp-header">
      <div>
        <h2 style="margin: 0; color: #0f172a; font-size: 1.5rem; letter-spacing: -0.025em;">Audit <span style="color: #0ea5e9; font-weight: 800;">History</span></h2>
        <p style="margin: 0; color: #64748b; font-size: 0.875rem;">Master record of all petty cash transactions</p>
      </div>
      <%= link_to root_path, style: "background: #f1f5f9; color: #475569; padding: 10px 18px; text-decoration: none; border-radius: 12px; font-weight: 600; font-size: 0.875rem; border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 8px;" do %>
        <span>←</span> Back to Dashboard
      <% end %>
    </div>

    <%# --- FILTER & SUMMARY SECTION --- %>
    <div class="resp-filter-grid">
      
      <%# Filter Form %>
      <div style="background: white; padding: 24px; border-radius: 24px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);">
        <p style="margin: 0 0 15px 0; font-size: 0.75rem; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px;">Filter Records</p>
        <%= form_with url: report_expenses_path, method: :get, local: true, class: "mobile-form-stack", style: "display: flex; gap: 12px; align-items: flex-end;" do |f| %>
          <div style="flex: 1;">
            <%= f.label :start_date, "FROM", style: "display: block; font-size: 0.65rem; font-weight: 700; color: #64748b; margin-bottom: 5px;" %>
            <%= f.date_field :start_date, value: params[:start_date], style: "width: 100%; padding: 10px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 0.9rem; background: #f8fafc;" %>
          </div>
          <div style="flex: 1;">
            <%= f.label :end_date, "TO", style: "display: block; font-size: 0.65rem; font-weight: 700; color: #64748b; margin-bottom: 5px;" %>
            <%= f.date_field :end_date, value: params[:end_date], style: "width: 100%; padding: 10px; border-radius: 10px; border: 1px solid #cbd5e1; font-size: 0.9rem; background: #f8fafc;" %>
          </div>
          <%= f.submit "Filter", style: "background: #1e293b; color: white; border: none; padding: 11px 20px; border-radius: 10px; font-weight: 700; cursor: pointer; font-size: 0.85rem;" %>
        <% end %>
      </div>

      <%# Total Spent Highlights %>
      <div style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 24px; border-radius: 24px; color: white; display: flex; flex-direction: column; justify-content: center; box-shadow: 0 10px 15px -3px rgba(15, 23, 42, 0.2);">
        <p style="margin: 0; font-size: 0.75rem; font-weight: 700; color: #38bdf8; text-transform: uppercase; letter-spacing: 1px;">Period Total Spent</p>
        <h2 style="margin: 10px 0 0 0; font-size: 2rem; font-weight: 800; letter-spacing: -1px;">
          <%= number_to_currency(@expenses.sum(:amount), unit: "₱") %>
        </h2>
      </div>
    </div>

    <%# --- DATA TABLE --- %>
    <div style="background: white; border-radius: 24px; border: 1px solid #e2e8f0; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05); overflow: hidden;">
      <div class="table-scroll">
        <table style="width: 100%; border-collapse: collapse; min-width: 800px;">
          <thead>
            <tr style="text-align: left; background: #f8fafc;">
              <th style="padding: 18px 24px; color: #94a3b8; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Date</th>
              <th style="padding: 18px 24px; color: #94a3b8; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Details</th>
              <th style="padding: 18px 24px; color: #94a3b8; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Dept</th>
              <th style="padding: 18px 24px; color: #94a3b8; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px;">Custodian</th>
              <th style="padding: 18px 24px; color: #94a3b8; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; text-align: right;">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% if @expenses.any? %>
              <% @expenses.each do |expense| %>
                <tr style="border-top: 1px solid #f1f5f9; transition: background 0.2s;">
                  <td style="padding: 20px 24px; font-size: 0.85rem; color: #475569; font-weight: 600;">
                    <%= expense.entry_date ? expense.entry_date.strftime("%b %d, %Y") : "N/A" %>
                  </td>
                  <td style="padding: 20px 24px;">
                    <span style="display: block; color: #1e293b; font-weight: 700; font-size: 0.95rem;"><%= expense.description %></span>
                    <span style="font-size: 0.7rem; color: #94a3b8; font-weight: 500;">ID: #<%= expense.id %></span>
                  </td>
                  <td style="padding: 20px 24px;">
                    <span style="background: #f1f5f9; color: #475569; padding: 4px 10px; border-radius: 8px; font-size: 0.75rem; font-weight: 700;"><%= expense.department.presence || "General" %></span>
                  </td>
                  <td style="padding: 20px 24px;">
                    
                    <%# 🟢 THE FIX IS HERE: Safe Navigation for Deleted Users %>
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <div style="width: 28px; height: 28px; background: #e0f2fe; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; color: #0ea5e9; font-size: 0.65rem;">
                        <%= expense.user ? expense.user.email[0..1].upcase : "??" %>
                      </div>
                      <span style="font-weight: 600; color: #334155; font-size: 0.85rem;">
                        <%= expense.user ? expense.user.email.split('@').first.capitalize : "Deleted Account" %>
                      </span>
                    </div>

                  </td>
                  <td style="padding: 20px 24px; text-align: right; color: #1e293b; font-weight: 800; font-size: 1.1rem;">
                    <%= number_to_currency(expense.amount, unit: "₱") %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="5" style="padding: 60px; text-align: center; color: #94a3b8; font-size: 0.9rem;">
                  No transaction records found for the selected dates.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# --- FOOTER --- %>
    <p style="text-align: center; color: #94a3b8; font-size: 0.8rem; margin-top: 30px; font-weight: 500;">
      © 2026 Barbie - Makoi. All Rights Reserved.
    </p>

  </div>
</div>