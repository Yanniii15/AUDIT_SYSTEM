<div style="display: flex; justify-content: space-between; align-items: center;">
  <h1>Expense History Report</h1>
  <%= link_to "⬅️ Back to Dashboard", root_path, style: "text-decoration: none; color: #0275d8;" %>
</div>

<div style="background: #f4f4f4; padding: 20px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #ddd;">
  <%= form_with url: report_expenses_path, method: :get, local: true, class: "filter-form" do |f| %>
    <label>From:</label>
    <%= f.date_field :start_date, value: @start_date, style: "padding: 5px; margin-right: 15px;" %>
    
    <label>To:</label>
    <%= f.date_field :end_date, value: @end_date, style: "padding: 5px; margin-right: 15px;" %>
    
    <%= f.submit "Generate Report", style: "padding: 6px 15px; background: #333; color: white; border: none; border-radius: 4px; cursor: pointer;" %>
  <% end %>
</div>

<div style="margin-bottom: 20px; font-size: 1.2em;">
  Showing records from <strong><%= @start_date %></strong> to <strong><%= @end_date %></strong><br>
  Total Expenses: <strong style="color: #d9534f;"><%= number_to_currency(@total_amount, unit: "₱") %></strong>
</div>

<table style="width: 100%; border-collapse: collapse; box-shadow: 0 0 10px rgba(0,0,0,0.1);">
  <thead>
    <tr style="background-color: #555; color: white; text-align: left;">
      <th style="padding: 12px;">Date</th>
      <th style="padding: 12px;">Description</th>
      <th style="padding: 12px;">Department</th>
      <th style="padding: 12px;">Amount</th>
      <th style="padding: 12px;">Source</th>
    </tr>
  </thead>
  <tbody>
    <% if @expenses.any? %>
      <% @expenses.each do |expense| %>
        <tr style="border-bottom: 1px solid #ddd;">
          <td style="padding: 12px;"><%= expense.entry_date.strftime("%Y-%m-%d") %></td>
          <td style="padding: 12px;"><%= expense.description %></td>
          <td style="padding: 12px;"><%= expense.department %></td>
          <td style="padding: 12px; font-weight: bold;"><%= number_to_currency(expense.amount, unit: "₱") %></td>
          <td style="padding: 12px;"><%= expense.pcf_source %></td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="5" style="padding: 20px; text-align: center; color: #999;">No records found for this date range.</td>
      </tr>
    <% end %>
  </tbody>
</table>