<%= form_with(model: expense) do |form| %>
  <% if expense.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(expense.errors.count, "error") %> prohibited this expense from being saved:</h2>

      <ul>
        <% expense.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :entry_date, style: "display: block" %>
    <%= form.date_field :entry_date %>
  </div>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.textarea :description %>
  </div>

  <div>
    <%= form.label :amount, style: "display: block" %>
    <%= form.text_field :amount %>
  </div>

  <div class="field" style="margin-bottom: 15px;">
     <%= form.label :department, style: "display: block; font-weight: bold; margin-bottom: 5px;" %>
     
     <%# 1. We added "Others" to the list, and gave the select an ID %>
     <%= form.select :department, 
           ["Dayo", "CKR Main", "CKR Branch 2", "CKR Branch 4", "Others"], 
           { prompt: "Select a Department..." }, 
           { id: "department_dropdown", style: "width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #ccc; font-size: 1em;" } 
     %>
     
     <%# 2. This is the hidden text box that will pop up %>
     <input type="text" id="custom_department_input" placeholder="Please specify the department..." style="display: none; width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #ccc; font-size: 1em; margin-top: 10px; box-sizing: border-box;">
   </div>

   <%# 3. The JavaScript logic to handle the toggle %>
   <script>
     document.addEventListener("DOMContentLoaded", function() {
       const dropdown = document.getElementById("department_dropdown");
       const customInput = document.getElementById("custom_department_input");

       dropdown.addEventListener("change", function() {
         if (this.value === "Others") {
           // Show the text box
           customInput.style.display = "block";
           // Hijack the database name so the custom text gets saved instead of the word "Others"
           customInput.name = "expense[department]";
           dropdown.name = ""; 
         } else {
           // Hide the text box
           customInput.style.display = "none";
           // Give the name back to the dropdown
           dropdown.name = "expense[department]";
           customInput.name = "";
         }
       });
     });
   </script>

  <div>
    <%= form.label :is_verified, style: "display: block" %>
    <%= form.checkbox :is_verified %>
  </div>

  <div style="margin-bottom: 15px;">
  <%= form.label :notes, "Audit Notes / Discrepancy Details", style: "display: block; font-weight: bold;" %>
  <%= form.text_area :notes, placeholder: "e.g., Short by ₱5.00 due to lack of coins", style: "width: 100%; height: 80px; border-radius: 4px; border: 1px solid #ccc; padding: 10px;" %>
  </div>

  <div style="margin: 20px 0; padding: 15px; border: 2px solid #007bff; border-radius: 10px;">
  <%= form.label :receipt_photo, "📸 Take Receipt Photo", style: "display: block; font-weight: bold;" %>
  <%= form.file_field :receipt_photo, accept: 'image/*', capture: :camera %>
  </div>
  
  <div>
    <%= form.submit %>
  </div>
<% end %>
