<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div style="font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; background-image: radial-gradient(#e2e8f0 1px, transparent 1px); background-size: 20px 20px;">
  
  <div style="width: 100%; max-width: 450px;">
    
    <%# --- BRANDING --- %>
    <div style="text-align: center; margin-bottom: 30px;">
      <h1 style="margin: 0; color: #0f172a; font-size: 1.75rem; font-weight: 800; letter-spacing: -1px;">
        Barbie - Makoi Auditing Sytem <span style="color: #0ea5e9;">Pro</span>
      </h1>
      <p style="margin: 8px 0 0 0; color: #64748b; font-size: 0.95rem; font-weight: 500;">Secure Auditing Access</p>
    </div>

    <%# --- LOGIN CARD --- %>
    <div style="background: white; padding: 40px; border-radius: 24px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.05), 0 8px 10px -6px rgba(0,0,0,0.05); border: 1px solid #e2e8f0;">
      
      <h2 style="margin: 0 0 25px 0; color: #1e293b; font-size: 1.25rem; font-weight: 700; text-align: center;">Welcome Back</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        
        <%# Email Field %>
        <div style="margin-bottom: 20px;">
          <%= f.label :email, style: "display: block; font-size: 0.85rem; font-weight: 700; color: #475569; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "name@company.com", 
              style: "width: 100%; padding: 12px 16px; border-radius: 12px; border: 1px solid #cbd5e1; font-size: 1rem; color: #1e293b; box-sizing: border-box; outline-color: #0ea5e9; background: #f8fafc;" %>
        </div>

        <%# Password Field %>
        <div style="margin-bottom: 20px;">
          <%= f.label :password, style: "display: block; font-size: 0.85rem; font-weight: 700; color: #475569; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;" %>
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", 
              style: "width: 100%; padding: 12px 16px; border-radius: 12px; border: 1px solid #cbd5e1; font-size: 1rem; color: #1e293b; box-sizing: border-box; outline-color: #0ea5e9; background: #f8fafc;" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 25px;">
            <%= f.check_box :remember_me, style: "width: 18px; height: 18px; cursor: pointer; accent-color: #0ea5e9;" %>
            <%= f.label :remember_me, style: "font-size: 0.9rem; color: #64748b; font-weight: 500; cursor: pointer;" %>
          </div>
        <% end %>

        <%# Submit Button %>
        <div style="margin-bottom: 20px;">
          <%= f.submit "Sign In to Dashboard", style: "width: 100%; background: linear-gradient(135deg, #0ea5e9 0%, #2563eb 100%); color: white; padding: 14px; border: none; border-radius: 12px; font-weight: 700; font-size: 1rem; cursor: pointer; box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.2); transition: transform 0.2s;" %>
        </div>
      <% end %>

      <%# Links Section %>
      <div style="text-align: center; border-top: 1px solid #f1f5f9; padding-top: 20px; margin-top: 10px;">
        <%= render "devise/shared/links" %>
      </div>
    </div>

    <p style="text-align: center; color: #94a3b8; font-size: 0.8rem; margin-top: 30px; font-weight: 500;">
      © 2026 Barbie - Makoi. All Rights Reserved.
    </p>

  </div>
</div>